<Window x:Class="Wuhuicl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Wuhuicl.App.Pages"
        xmlns:ctl="clr-namespace:Wuhuicl.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WUHUICL 武慧启动器" Width="1360" Height="860" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowGrad}"
        Foreground="{DynamicResource Fg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- 原版在 Windows 上是 frame:false + roundedCorners:true + backgroundMaterial:'acrylic'，
         并且明确写了 transparent 只给非 win32 用：layered window 会绕过 DWM 合成，
         缩放和内存都吃亏。所以这里窗口本体不透明，圆角交给 DWM（代码里设 corner preference）。
         WPF 侧用 CaptionHeight=0 自绘拖拽：只有 72px 顶栏可拖，和原版 app-region 一致。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <!-- ==================== 窗内私有资源，前缀 Sh（shell）====================
         Themes/Controls.xaml 是跨页共享层（归人工维护，本轮不可改）；这一批只服务主窗自己的
         三个 App.vue 弹窗（整合包导入 / 启动失败 / 配置不兼容）与顶栏浮层的行族，
         按同一原则留在窗内资源作用域。行号全部指 KAMUCL-1.1.5/src/renderer/src/App.vue
         的 style 段（注意它的最终生效值：同特异性后写的那条赢）。 -->
    <Window.Resources>

        <!-- ============ 一、通用弹窗壳：styles.css:527-563 ＋ ui-system.css:37-40 ============ -->
        <!-- .modal-mask：fixed inset 0 / z 10000 / flex 居中 / 底 var(mask)＝Overlay / backdrop blur(10)。
             原版的 100vw/100vh 减项在 WPF 没有视口单位，由代码 ApplyViewportCaps() 按窗口实际尺寸
             写回各卡片的 MaxWidth/MaxHeight（styles.css:546-547 ＋ ui-system.css:38）。 -->
        <Style x:Key="Sh.ModalMask" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Overlay}"/>
        </Style>
        <!-- mask-in：opacity 0→1 / 0.2s ease（styles.css:537 ＋ :564-568）。
             与本页日志窗那条动画同一参数，做成一档给两个模态共用。 -->
        <Style x:Key="Sh.ModalMaskIn" TargetType="Border" BasedOn="{StaticResource Sh.ModalMask}">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1"
                                                          KeySpline="0.25,0.1 0.25,1"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- modal-in：220ms ease-out（令牌 motion-enter ＋ cubic-bezier(.2,.7,.3,1)），
             opacity 0→1 ＋ translateY 6→0（styles.css:554 ＋ :569-572；scale(.99) 不足半个像素，
             与本页日志窗一样只做位移）。放在卡片自己的 Style 里，因为两张卡的 BasedOn 不同。 -->
        <!-- .modal：width min(460px,100vw 减 48) / max-height calc(100vh 减 96)，ui-system.css:38 后写
             把上界收成 calc(100vh 减 32) 并加 max-width calc(100vw 减 32)、overflow auto /
             底 surface-raised（＝Card）/ border 1 border / radius radius-lg 14 / padding space-5 24 / shadow-lg -->
        <Style x:Key="Sh.Modal" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="460"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
        </Style>
        <!-- .modal-title（App.vue:1575 的 h3）：App.vue 的 style 段没有这条规则，styles.css /
             ui-system.css 也没有 → 落到 UA 的 h3 ＝ 1.17em(14×1.17≈16.4)/bold，
             全局 * 复位把 margin 归零。与 ModsPage.xaml:210 的 MpModalTitle 同一结论：16/Bold。 -->
        <Style x:Key="Sh.ModalTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- .modal-actions：flex / align center / justify flex-end / gap space-3 12 / margin-top space-5 24
             （styles.css:557-563，ui-system.css:40 追加 flex-wrap wrap） -->
        <Style x:Key="Sh.ModalActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,24,0,0"/>
        </Style>
        <!-- 顶栏浮层里的 .btn.btn-sm.btn-ghost：面板是 Teleport 到 body 的，不在 .content 里，
             所以 ui-system.css:17 的 min-height 32 不生效，走 styles.css:258-263 ＝
             min-height calc(ctl-h 36 减 8)＝28 / padding 4 12 / 13px / radius-sm 6。 -->
        <Style x:Key="Sh.BtnSmFloat" TargetType="Button" BasedOn="{StaticResource BtnSmGhost}">
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <!-- 同上但只有 .btn.btn-sm（不带 btn-ghost）：透明底 ＋ 透明描边，字 text（styles.css:158-177） -->
        <Style x:Key="Sh.BtnSmPlain" TargetType="Button" BasedOn="{StaticResource BtnSm}">
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <!-- .input::placeholder（styles.css:318-321）：text-dim ＋ opacity .7。
             WPF 的 TextBox 没有 placeholder，按 SettingsPage:241-252 的既有手法用覆盖层。
             这里的 input 在 Teleport 层里，字号是 styles.css:313 的 text-md 14（不是 ui-system.css:15 的 .content 分支）。 -->
        <Style x:Key="Sh.Placeholder" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Margin" Value="13,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- ============ 二、配置不兼容弹窗（App.vue:1532-1541 ＋ :1720-1724） ============ -->
        <!-- .menu-overlay（styles.css:577-581）只给 fixed inset 0 / z 90，没有底色也没有模糊；
             .cfg-mismatch-mask（App.vue:1721）后写并压成 z 9600 ＋ display grid / place-items center，
             同样不写 background → 这一层是全透明的挡点击层，不是遮罩。
             两条同特异性（menu-overlay 是全局单类，cfg-mismatch-mask 是 scoped 双特异性）→ 
             mask 的 z-index 与居中生效，overlay 的 fixed inset 0 保留。 -->
        <Style x:Key="Sh.CfgMask" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- .card（styles.css:450-457）＋ .cfg-mismatch-modal（:1722）：
             card 基线给 radius 14 / border 1 / 底 card / box-shadow var(shadow)（＝CardShadow），
             这条把宽收成 min(460px,90vw)、padding 收成 20 22，并排成 column flex / gap 12。
             ui-system.css:13 只在 .content 里取消 card 阴影，这层挂在 body 上 → 阴影保留。 -->
        <Style x:Key="Sh.CfgModal" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Width" Value="460"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
        </Style>
        <!-- .upd-modal-title（:1723）：margin 0 / font-size 17px（h3 的 UA 粗体保留） -->
        <Style x:Key="Sh.UpdModalTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- .upd-modal-actions（:1724）：flex / justify flex-end / gap 10（不是 modal-actions 的 12） -->
        <Style x:Key="Sh.UpdModalActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- ============ 三、启动失败弹窗（App.vue:1573-1586 ＋ :2313-2325） ============ -->
        <!-- .launchfail-modal（:2314）：width 480px 定值；.modal 的 max-width/max-height 仍由
             ui-system.css:38 兜着（代码里写回）。 -->
        <Style x:Key="Sh.LaunchFailModal" TargetType="Border" BasedOn="{StaticResource Sh.Modal}">
            <Setter Property="Width" Value="480"/>
        </Style>
        <!-- .launchfail-text（:2317-2325）：13px / line-height 1.7 / text-dim / word-break break-all /
             max-height 220 / overflow-y auto / white-space pre-wrap -->
        <Style x:Key="Sh.LaunchFailText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxHeight" Value="220"/>
        </Style>

        <!-- ============ 四、整合包导入弹窗 mp-族（App.vue:1591-1712 ＋ :2452-2624） ============ -->
        <!-- .mp-modal（:2452-2456）：width min(620px, 100vw 减 40) / max-height 88vh / overflow-y auto。
             scoped（特异性 0,2,0）压过全局 .modal 的 460 宽与 calc(100vh 减 32) 高；
             620 与 88vh 的实际上界由 ApplyViewportCaps() 写回 MaxWidth/MaxHeight。 -->
        <Style x:Key="Sh.MpModal" TargetType="Border" BasedOn="{StaticResource Sh.Modal}">
            <Setter Property="Width" Value="620"/>
        </Style>
        <!-- .mp-title（:2457-2460）：font-size text-lg 16 / margin-bottom space-4 16。
             是 h3：UA 粗体 1.17em 被这条的 16px 压住，字重仍来自 UA ＝ bold。 -->
        <Style x:Key="Sh.MpTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <!-- .mp-loading（:2461-2466）：flex 居中 / gap space-2 8 / padding space-3 0 上下 12 -->
        <Style x:Key="Sh.MpLoading" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <!-- .mp-tags（:2467-2471）：flex wrap / gap 8。WrapPanel 没有 Gap 属性，项间距靠每项右距 8
             （原版 gap 同样不在行尾占位），容器本身在实例上写。 -->
        <!-- .mp-summary（:2472-2476）：margin space-2 0 0 / text-dim / 12px -->
        <Style x:Key="Sh.MpSummary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <!-- .mp-label（:2477-2481）：13px / text-dim / margin space-4 0 space-2 0 ＝ 16 0 8 -->
        <Style x:Key="Sh.MpLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <!-- .mp-name-label（:2528-2530）：flex-shrink 0 → 不参与截断 -->
        <Style x:Key="Sh.MpNameLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <!-- .mp-name-value（:2531-2539）：text-dim / 溢出省略；.mp-name-opt.active 时转 accent-2。
             原版的父子选择器在 WPF 里用「祖先 RadioButton 的 IsChecked」DataTrigger 等价表达。 -->
        <Style x:Key="Sh.MpNameValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- .mp-name-opt（:2487-2509）：flex 居中 gap 8 / width 100% / padding 8 12 /
             radius 999（≈32 高的行收成 16，走 CssRadius.Pill 动态收缩，绝不写 999）/
             border 1 border / 底 card-2 / 字 text 13 / 左对齐；
             hover（:2503）只把描边转 text-dim；.active（:2506-2509）描边 accent ＋ 底 accent-soft。
             整行是 RadioButton（原版是 button ＋ 假 radio，语义就是单选）。 -->
        <Style x:Key="Sh.MpNameOpt" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="12,8" ctl:CssRadius.Pill="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- .mp-radio（:2510-2521）：14×14、border 2 text-dim；
                                     active 时 border 转 accent ＋ box-shadow inset 0 0 0 3px card,
                                     inset 0 0 0 8px accent ＝ 从内边算 3px card 环＋到心的 8px accent
                                     （10 见方的 padding box 上 8px 已铺满），净结果：3px card 环 ＋ 4px accent 心。
                                     几何用三层圆表达：12 见方＋2 描边＝外沿 14（WPF 描边跨在几何线上）。 -->
                                <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                                    <Ellipse x:Name="ring" Width="12" Height="12" StrokeThickness="2"
                                             Stroke="{DynamicResource Fg2}" Fill="Transparent"/>
                                    <Ellipse x:Name="disc" Width="10" Height="10" Opacity="0"
                                             Fill="{DynamicResource Card}"/>
                                    <Ellipse x:Name="dot" Width="4" Height="4" Opacity="0"
                                             Fill="{DynamicResource Accent}"/>
                                </Grid>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Fg2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="disc" Property="Opacity" Value="1"/>
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .mp-conflict-actions label / .mp-replace-confirm 共用一条规则（:2564-2577）：
             flex 居中 gap 8 / min-height 48 / padding 12 / border 1 border / radius 10 / line-height 1.4；
             hover 底 card-2；:has(input:checked) → 描边 accent ＋ 底 accent-soft。
             两个变体分别做成 RadioButton（重新命名/新实例/更新/覆盖）与 CheckBox（确认替换）。
             字色：label 不是 button，没有 .mp-name-opt 那条 color:text 的覆盖，
             继承的是 .mp-conflict 的 text-dim（:2553）→ 这里 Foreground 用 Fg2。 -->
        <Style x:Key="Sh.MpConflictOpt" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" MinHeight="48" Padding="12" CornerRadius="10"
                                Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- .mp-conflict input（:2594-2600）：accent-color accent / 18×18 / margin 0 /
                                     flex-shrink 0。type=radio 在 Chromium 是正圆，勾选态为 accent 实心＋内白点。 -->
                                <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="ring" Width="16" Height="16" StrokeThickness="2"
                                             Stroke="{DynamicResource BorderStrong}" Fill="Transparent"/>
                                    <Ellipse x:Name="dot" Width="8" Height="8" Opacity="0"
                                             Fill="{DynamicResource Accent}"/>
                                </Grid>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <!-- .mp-replace-confirm{line-height:1.4}（App.vue:2591）：
                                             RadioButton 上没有 LineHeight，只能挂在内容器的隐式 TextBlock 上 -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="LineHeight" Value="17"/>
                                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .mp-replace-confirm（同 :2564-2577）：label 包 checkbox，整行可点；字色继承 .mp-conflict 的 text-dim -->
        <Style x:Key="Sh.MpReplaceConfirm" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="b" MinHeight="48" Padding="12" CornerRadius="10"
                                Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 18×18 的 accent-color checkbox：Chromium 是圆角方块，
                                     勾选＝accent 实心＋on-accent 对勾，未勾＝透明底＋中性描边 -->
                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="3" VerticalAlignment="Center">
                                    <Border x:Name="box" CornerRadius="3" BorderThickness="2"
                                            BorderBrush="{DynamicResource BorderStrong}" Background="Transparent">
                                        <!-- 对勾：模板里没有 ContentControl 祖先，不能用 IconStroke 那套继承取色，
                                             颜色在下面 IsChecked 触发器里直接给 on-accent -->
                                        <Path x:Name="tick" Stroke="{DynamicResource BorderStrong}" StrokeThickness="2.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M4,9 L7.5,12.5 L13,5" Stretch="Uniform" Opacity="0"
                                              Fill="{x:Null}"/>
                                    </Border>
                                </Border>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <!-- .mp-replace-confirm{line-height:1.4}（App.vue:2591）：
                                             CheckBox 上没有 LineHeight，只能挂到内容器的隐式 TextBlock -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="LineHeight" Value="17"/>
                                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Opacity" Value="1"/>
                                <Setter TargetName="tick" Property="Stroke" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .mp-keysync-opt（:2578-2593）：flex align-start gap 8 / margin-top 12 / padding 12 /
             border 1 / radius 10 / line-height 1.5 / 12px text-dim；hover 底 card-2；
             :has(:checked) → 描边 accent ＋ 底 accent-soft ＋ 字色转 text；
             它的 input（:2593）accent-color accent、margin-top 2、flex-shrink 0（没给尺寸＝UA 13×13）。 -->
        <Style x:Key="Sh.MpKeysyncOpt" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="b" Padding="12" CornerRadius="10" Margin="0,12,0,0"
                                Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Grid VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="13" Height="13" CornerRadius="2"
                                        VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Border x:Name="box" CornerRadius="2" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource BorderStrong}" Background="Transparent">
                                        <Path x:Name="tick" Stroke="{DynamicResource BorderStrong}" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M3,7 L5.6,9.8 L10,4" Stretch="Uniform" Opacity="0"
                                              Fill="{x:Null}"/>
                                    </Border>
                                </Border>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Opacity" Value="1"/>
                                <Setter TargetName="tick" Property="Stroke" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .mp-impact（:2604-2612）：padding 8 / radius radius-sm 6 / 底 card-2 / line-height 1.55；
             .danger（:2610）字色转 danger。字色基线继承 .mp-conflict 的 text-dim、12px。 -->
        <Style x:Key="Sh.MpImpact" TargetType="Border">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        </Style>
        <!-- .mp-error（:2613-2618）：13px / danger / line-height 1.7 / word-break break-all -->
        <Style x:Key="Sh.MpError" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- .mp-actions（:2619-2624）：flex 右对齐 / gap space-3 12 / margin-top space-5 24 -->
        <Style x:Key="Sh.MpActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,24,0,0"/>
        </Style>

        <!-- ============ 五、下载中心行族（App.vue:1451-1493 ＋ :2240-2312） ============ -->
        <!-- .dl-item：padding space-3 space-4 ＝ 12 16 / border-bottom 1 border（:2240-2243）。
             最后一行的下边线由 .notice-item:last-child 那条同类规则去掉，原版 .dl-item 没有 last-child
             豁免 → 尾行仍带线，这里照原样保留。 -->
        <Style x:Key="Sh.DlItem" TargetType="Border">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- .dl-title（:2255-2261）：13px / 600 / 溢出省略。
             .dl-error .dl-title（:2268）转 danger，由代码在失败行上直接改 Foreground。 -->
        <Style x:Key="Sh.DlTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- .dl-sub（:2262-2267）：margin-top space-1 4 / 12px / line-height 1.5 / break-all / muted -->
        <Style x:Key="Sh.DlSub" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <!-- .dl-bar（:2271-2277）：margin-top space-2 8 / 高 5 / radius 999（＝2.5，半高）/ 底 card-2 / overflow hidden -->
        <Style x:Key="Sh.DlBar" TargetType="Border">
            <Setter Property="Height" Value="5"/>
            <Setter Property="CornerRadius" Value="2.5"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <!-- .dl-bar-fill（:2278-2283）：高 100% / radius 999（2.5）/ 底 90° accent-2→accent（＝BarFill） -->
        <Style x:Key="Sh.DlBarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="2.5"/>
            <Setter Property="Background" Value="{DynamicResource BarFill}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- .dl-stage .dl-bar（:2288）：后写且更特异（0,2,0 压 :2271 的 0,1,0）→ 高 3、margin-top 6，
             圆角半高＝1.5 -->
        <Style x:Key="Sh.DlStageBar" TargetType="Border" BasedOn="{StaticResource Sh.DlBar}">
            <Setter Property="Height" Value="3"/>
            <Setter Property="CornerRadius" Value="1.5"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <!-- .dl-dismiss（:2301-2312）：透明底无边 / text-dim / font-size text-md 14 / padding 0 4 /
             line-height 1，内容是「×」；hover 字色转 text。
             原版没给宽高：盒尺寸＝字形宽 ＋ 左右各 4，line-height 1 把高收到 14 → 
             宽高都不写，由内容里的 TextBlock（LineHeight 14）撑出来。 -->
        <Style x:Key="Sh.DlDismiss" TargetType="Button">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .dl-stage（:2285）：min-width 0 / padding 9 10 / border 1 border / radius 9 / 底 card-2 -->
        <Style x:Key="Sh.DlStage" TargetType="Border">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        </Style>
        <!-- .dl-stage-heading（:2286）：flex space-between gap 8 / 12px / 600；
             .dl-stage.is-done 时整条转 accent（:2289）——is-done 在父级，代码改这层 Foreground -->
        <Style x:Key="Sh.DlStageHeading" TargetType="Grid">
            <Setter Property="TextElement.FontSize" Value="12"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        </Style>
        <!-- .dl-stage-detail（:2287）：溢出省略 / 12px / margin-top 3 / muted -->
        <Style x:Key="Sh.DlStageDetail" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- ============ 六、通知行族（App.vue:1405-1412 ＋ :2326-2361） ============ -->
        <!-- .notice-item：flex gap 12 / min-height row-h 42 / padding 12 16 / border-bottom 1 /
             最后一行无线（:2334）/ 13px。字号走 TextElement（Border 不是 Control，没有 FontSize 属性）。 -->
        <Style x:Key="Sh.NoticeItem" TargetType="Border">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="TextElement.FontSize" Value="13"/>
        </Style>
        <!-- .notice-text（:2354-2357）：line-height 1.5 / break-all -->
        <Style x:Key="Sh.NoticeText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- .notice-time（:2358-2361）：12px / text-dim -->
        <Style x:Key="Sh.NoticeTime" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        </Style>
        <!-- .notice-empty（:2207-2216）：flex 居中 / min-height 96 / padding 16 / 居中 / text-dim / 13px -->
        <Style x:Key="Sh.NoticeEmpty" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16"/>
        </Style>

        <!-- ============ 七、更新日志行族（App.vue:1426-1433 ＋ :2154-2175） ============ -->
        <!-- .note-version ＋ .note-version（:2154-2158）：margin-top 12 / border-top 1 dashed / padding-top 12。
             虚线要贴在盒顶（CSS 的 border 在 padding 之外），所以 Padding 留 0，
             12 的 padding-top 由内容自己的 Margin 承担；WPF 的 Border 画不出 dashed，
             虚线用同位 Rectangle 叠（与 DropMask 的 dashed 同一手法）。 -->
        <Style x:Key="Sh.NoteVersion" TargetType="Border">
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <!-- .note-head（:2159-2164）：flex baseline gap 12 / margin 0 0 8 -->
        <Style x:Key="Sh.NoteHead" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- .note-ver（:2165-2168）：700 / 13px（text-sm） -->
        <Style x:Key="Sh.NoteVer" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- .note-changes（:2169-2175）：margin 0 / padding-left 16 / line-height 1.7 / 12px / 字色 text。
             li 的圆点是 UA list-style disc（全局 * 复位只清 margin/padding，不清 list-style）→ 逐条一个点。
             行本身用 Grid 两列（点 Auto ＋ 文字 *）表达，12px 由这条 Style 的 TextElement 继承下去。 -->
        <Style x:Key="Sh.NoteChangeRow" TargetType="Grid">
            <Setter Property="TextElement.FontSize" Value="12"/>
        </Style>

        <!-- ============ 八、侧栏残项：sidebar-health 与导航子项几何（App.vue:1950-2005） ============ -->
        <!-- .nav-label（:1875-1877）：font-weight 500 ＝ WPF Medium；
             .nav-item.active .nav-label（:1878-1880）才是 600，那条由 Nav 模板的 IsChecked 触发器给
             （模板触发器优先级高于样式 Setter，所以这里用 Setter 不会顶掉选中态的 SemiBold）。 -->
        <Style x:Key="Sh.Nav" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="Sh.NavParent" TargetType="ToggleButton" BasedOn="{StaticResource NavParent}">
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <!-- .nav-sub-item（:1929-1957）：40 高 / padding-left 32 / 13px，且
             .nav-sub-item .nav-icon 是 17 盒 ＋ 内层 svg 16（:1950-1957），
             主导航才是 20 盒 / 19 svg（:1862-1874）。共享字典的 NavSub 复用 Nav 的 20/19 模板，
             Controls.xaml 不可改，所以这里在窗内重写模板的图标列，只把 20/19 换成 17/16。
             .nav-sub-item::before 那颗 5px 圆点是 content:none（:1935-1946）→ 原版根本不渲染，跳过。 -->
        <Style x:Key="Sh.NavSub" TargetType="RadioButton" BasedOn="{StaticResource NavSub}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border Background="Transparent" CornerRadius="10"/>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                                                Style="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                                        Converter={StaticResource StyleByKey}}"/>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .sidebar-health（:1959-2005）：grid 8px / minmax(0,1fr) / 14px，gap 8 /
             min-height row-h 42 / margin 12 / padding 0 12 / border 1 / radius 10 /
             底 color-mix(card 48%, transparent)（用 48% 不透明度的 Card 叠加等价表达）/
             字 text-dim 12 / 500 / 左对齐；hover 底 card-2、字 text（:1978-1981）。 -->
        <Style x:Key="Sh.SidebarHealth" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border MinHeight="42" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource Line}">
                            <Grid>
                                <!-- 48% card 底：hover 时换成实色 card-2（:1979） -->
                                <Border x:Name="tint" CornerRadius="9" Background="{DynamicResource Card}"
                                        Opacity="0.48"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                <Setter TargetName="tint" Property="Background" Value="{DynamicResource CardSoft}"/>
                                <Setter TargetName="tint" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 九、拖拽遮罩（App.vue:2419-2449） ============ -->
        <!-- .drop-box：column 居中 gap 16 / padding 48 / border 2 dashed accent / radius 14 /
             底 color-mix(accent 8%, card)（＝Card 垫底再叠 8% 的 accent，用 Accent8 画刷）/ 字 accent。
             Border 画不出 dashed，虚线用同位 Rectangle 叠；描边跨在几何线上，所以内缩 1px 后
             外沿正好落在盒边（半径 13＋1＝14，与 CSS 的 border-box 对齐）。 -->
        <Style x:Key="Sh.DropBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
        </Style>
        <Style x:Key="Sh.DropBoxTint" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource Accent8}"/>
        </Style>
        <Style x:Key="Sh.DropBoxDash" TargetType="Rectangle">
            <Setter Property="RadiusX" Value="13"/>
            <Setter Property="RadiusY" Value="13"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="4 3"/>
        </Style>
        <!-- .drop-title（:2446-2449 ＋ :1556 文案）：text-lg 16 / 600 / accent，与图标之间是 .drop-box 的 gap 16 -->
        <Style x:Key="Sh.DropTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>

    </Window.Resources>

    <Border x:Name="ShellRoot" Background="{DynamicResource WindowGrad}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="ShellHost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- .app-bg（App.vue:1229 ＋ 样式 :1738-1743）：fixed inset 0 / z 0 / pointer-events none
                 的自定义背景层（纯色或图片 ＋ 透明度 ＋ 模糊，来自 bgStyle）。
                 它排在 .shell 之下、靠 shell 自身的半透明底（:1733 的 color-mix(bg 78%, transparent) ＋
                 backdrop-filter）才透得出来；这里的窗口本体是不透明实底（WindowGrad），
                 所以这层现在即使画上背景也看不见 → 保留几何正确的空壳并 Collapsed，
                 等背景设置（皮肤/图片选择）接入时，要连同 ShellRoot 的底色一起换成带 alpha 的画刷。 -->
            <Border x:Name="AppBgLayer" Grid.Column="0" Grid.ColumnSpan="2"
                    Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- ==================== 侧栏 208 ==================== -->
            <Border Grid.Column="0" Background="{DynamicResource NavBg}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- .logo-area：88 高，padding 0 16，gap 12（App.vue:1764-1771）。
                         .brand-head（App.vue:1772-1780）是玩家皮肤的脸，不是应用图标：
                         42×42 / radius 10 / 1px rgba(255,255,255,.26) / 0 3px 12px rgba(0,0,0,.18) / pixelated -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border x:Name="BrandHead" Width="42" Height="42" CornerRadius="10"
                                BorderBrush="#43FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270"
                                                  Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                        <!-- .logo-text（:1781-1785）：column / gap space-1 4 -->
                        <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- .logo-name（:1786-1793）：20px / 700 / line-height 1.2 / letter-spacing 2px。
                                 WPF 的 TextBlock 没有字距属性（同 HomePage:614、AccountsPage:183 的既有处理），
                                 这 2px×7 字≈14px 的加宽表达不了，留给渲染层。 -->
                            <TextBlock Grid.Row="0" Text="WUHUICL" FontSize="20" FontWeight="Bold"
                                       LineHeight="24" LineStackingStrategy="BlockLineHeight"/>
                            <!-- .logo-version（:1794-1800）：align-self flex-end / padding-right 2 /
                                 12px / accent-2 / opacity .85 -->
                            <TextBlock Grid.Row="2" Text="v0.1.0" FontSize="12" HorizontalAlignment="Right"
                                       Margin="0,0,2,0" Foreground="{DynamicResource AccentHi}" Opacity="0.85"/>
                        </Grid>
                    </StackPanel>

                    <!-- .nav（App.vue:1802-1810）：flex column / gap 4 / padding 4 12 12 / overflow-y auto。
                         .nav-label（:1875-1877）500、选中 600（:1878）；.nav-icon 20 盒 / 19 svg（:1862-1874）。
                         水滴层与选条层是独立绝对定位层（原版 .nav-bubble :1837 / .nav-selection :1849），
                         几何由代码测量后做 300ms cubic-bezier(.22,1,.36,1) 位移。 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                        <Grid Margin="12,4,12,12">
                            <Canvas x:Name="NavHost" IsHitTestVisible="False">
                                <!-- .nav-bubble：App.vue:1842 底色是 135° 渐变（accent-soft 80% → hover）
                                     外加 0 3px 12px #00000008；它跟着悬停项跑，无悬停时停在选中项 -->
                                <Border x:Name="NavBubble" CornerRadius="10" Opacity="0"
                                        Background="{DynamicResource NavPill}"/>
                                <!-- .nav-selection：App.vue:1854 只有 box-shadow inset 3px 0 0 accent，
                                     本身没有底色，永远停在选中项。原版量得 3px 宽的直边竖条
                                     （月牙两端的加宽不到 1px），所以这里用定位容器 + 3px 圆角竖条；
                                     直接给 Border 设单边 BorderThickness 会画成一个大括号弧。 -->
                                <Border x:Name="NavSel" CornerRadius="10" Background="Transparent">
                                    <Border Width="3" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                            HorizontalAlignment="Left"/>
                                </Border>
                            </Canvas>
                            <StackPanel x:Name="NavList">
                                <RadioButton x:Name="NavHome" Style="{StaticResource Sh.Nav}"
                                             GroupName="nav" Tag="Icon.Home"
                                             Content="首页" IsChecked="True" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavVersions" Style="{StaticResource Sh.Nav}"
                                             GroupName="nav" Tag="Icon.Game"
                                             Content="游戏版本" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <ToggleButton x:Name="NavResources" Style="{StaticResource Sh.NavParent}"
                                              Tag="Icon.Resources" Content="资源管理"
                                              Checked="NavExpand_Changed" Unchecked="NavExpand_Changed"
                                              MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <!-- .nav-sub（:1896-1907）：grid-template-rows 0fr→1fr，190ms ease-out ＋ margin 4 0；
                                     WPF 没有等价物，用高度测量后做同参数的 DoubleAnimation（代码 NavExpand_Changed）。
                                     子项的淡入/位移（:1915-1925）同样留在代码，本轮没接。 -->
                                <StackPanel x:Name="NavSubList" Height="0" ClipToBounds="True"
                                            Visibility="Collapsed">
                                    <!-- .nav-sub-inner（:1908-1914）：overflow hidden / column / gap 4 / min-width 0。
                                         .nav-sub-item 的 padding-left 32 = 导航内缩 16 + 再缩 16 -->
                                    <StackPanel Margin="16,0,0,0">
                                        <RadioButton x:Name="NavMods" Style="{StaticResource Sh.NavSub}"
                                             GroupName="nav" Tag="Icon.Mods"
                                                     Content="模组" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <RadioButton x:Name="NavPacks" Style="{StaticResource Sh.NavSub}"
                                             GroupName="nav"
                                                     Tag="Icon.ResourcePacks" Content="资源包" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <RadioButton x:Name="NavShaders" Style="{StaticResource Sh.NavSub}"
                                             GroupName="nav"
                                                     Tag="Icon.Shaders" Content="光影包" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <RadioButton x:Name="NavRecordings" Style="{StaticResource Sh.NavSub}"
                                             GroupName="nav"
                                                     Tag="Icon.Changelog" Content="录像" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <!-- 子项顺序照 App.vue:158-186：mods/packs/shaders/recordings/bridge/servers。
                                             MOD 面板是桥接参数编辑器（BridgeView），服务器是服务器条目管理（ServersView），
                                             两者与主导航的「联机」互不相干，不能并成一块。 -->
                                        <RadioButton x:Name="NavBridge" Style="{StaticResource Sh.NavSub}"
                                             GroupName="nav" Tag="Icon.Bridge"
                                                     Content="MOD 面板" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <RadioButton x:Name="NavServers" Style="{StaticResource Sh.NavSub}"
                                             GroupName="nav" Tag="Icon.Servers"
                                                     Content="服务器" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                    </StackPanel>
                                </StackPanel>
                                <RadioButton x:Name="NavOnline" Style="{StaticResource Sh.Nav}"
                                             GroupName="nav" Tag="Icon.Friends"
                                             Content="联机" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavDefaults" Style="{StaticResource Sh.Nav}"
                                             GroupName="nav" Tag="Icon.Keys"
                                             Content="默认配置" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavSkin" Style="{StaticResource Sh.Nav}"
                                             GroupName="nav" Tag="Icon.Skin"
                                             Content="皮肤" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavCommunity" Style="{StaticResource Sh.Nav}"
                                             GroupName="nav" Tag="Icon.Community"
                                             Content="社区资源" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavSettings" Style="{StaticResource Sh.Nav}"
                                             GroupName="nav" Tag="Icon.Settings"
                                             Content="设置" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- .sidebar-health（App.vue:1305-1314 ＋ 样式 :1959-2005）：几何见 Sh.SidebarHealth。
                         .sidebar-health i（:1982-1996）＝ 7×7 圆点 ＋ box-shadow 0 0 0 3px 的光环，
                         光环按 tone 换色：ok→ok/ok-soft（默认）、is-busy→accent/accent-soft、
                         is-error→danger/danger-soft。数据源是 launcherHealth（:743-750），
                         由代码 SetLauncherHealth(tone,text) 写回；box-shadow 不占位，所以 13 的光环溢出 8 的列。 -->
                    <Button Grid.Row="2" Style="{StaticResource Sh.SidebarHealth}" Margin="12" Padding="12,0"
                            HorizontalContentAlignment="Stretch" Click="Notice_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="8" VerticalAlignment="Center">
                                <Ellipse x:Name="HealthRing" Width="13" Height="13" Fill="{DynamicResource OkSoft}"/>
                                <Ellipse x:Name="HealthDot" Width="7" Height="7" Fill="{DynamicResource Ok}"/>
                            </Grid>
                            <TextBlock x:Name="HealthText" Grid.Column="1" Text="全部系统运行正常"
                                       Margin="8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <ContentControl Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center"
                                            Style="{DynamicResource Icon.ChevronRight}"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- .main-area（App.vue:1318 ＋ 样式 :2008-2013）：flex 1 / min-width 0 / column ＝ 顶栏＋内容 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- .topbar（:1320 ＋ :2016-2027）：72 高 / padding 0 24（space-5）/ gap 16 /
                     space-between / 底 color-mix(bg-2 78%, transparent)＝NavBg / 下边线 1 /
                     唯一可拖区（-webkit-app-region:drag → 代码 Topbar_MouseDown）。
                     max-width 1080 时收成 68 高（:2410-2412），窄窗分支本轮未接。 -->
                <Border Grid.Row="0" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,0,0,1" Padding="24,0" MouseLeftButtonDown="Topbar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- .topbar 是 flex：[top-back?] .topbar-spacer(flex:1，:2060) + gap 16 + .top-actions(:2068)，
                                 所以格言只在动作区左边的带子里居中，不是整条顶栏居中 -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- .top-back：36×36（ctl-h）/ radius 6 / card-2 底 / 1px color-mix(border 70%) /
                             字色 text-dim，hover 才变 text ＋ 描边 border-strong（App.vue:2033-2058）。
                             v-if="canGoBack && currentView !== 'home'"（:1321）→ 由代码控制显隐 -->
                        <Button x:Name="BtnTopBack" Grid.Column="0" Style="{StaticResource TopBack}"
                                Visibility="Collapsed" Margin="0,0,16,0"
                                ToolTip="返回上一个页面" Click="Back_Click">
                            <!-- 左指箭头是 App.vue:1328 的 Icon.Back；Icon.ChevronLeft 复刻的是 :1313 那条，方向朝右，别混用 -->
                            <ContentControl Width="16" Height="16" Style="{DynamicResource Icon.Back}"/>
                        </Button>
                        <!-- .topbar-spacer（:1330 ＋ :2060）：flex 1 / min-width 0 / align-self stretch，
                             里面只放 CreatorMotto -->
                        <ctl:CreatorMotto x:Name="Motto" Grid.Column="1" Margin="0,0,16,0"/>
                        <!-- .top-actions（:1332 ＋ :2068-2073）：flex 居中 / gap space-1 4 / 不拖拽 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- .top-btn.dl-toggle（:1333）：v-if currentView !== home；
                                 .dl-toggle（:2221）只是 position:relative，给 .dl-badge 当定位父 -->
                            <Button x:Name="BtnTopDownload" Style="{StaticResource TopBtn}" Margin="0" Click="OpenDl_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Width="15" Height="15" VerticalAlignment="Center"
                                                    Style="{DynamicResource Icon.Download}"/>
                                    <!-- .dl-badge（:1340 ＋ :2224-2236）：min-width 16 / 高 16 / padding 0 4 /
                                         radius 999（半高 8）/ 底 accent / 字 on-accent 12·700 居中（＝DlBadge 档） -->
                                    <Border x:Name="DlBadge" Style="{StaticResource DlBadge}"
                                            Margin="8,0,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="DlBadgeText" Text="0" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentFg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <!-- .top-btn（:1342 onImportClick）：与下载同为 .top-btn，同样只在非首页出现 -->
                            <Button x:Name="BtnTopImport" Style="{StaticResource TopBtn}" Margin="4,0,0,0"
                                    Click="Import_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Width="15" Height="15" VerticalAlignment="Center"
                                                    Style="{DynamicResource Icon.Upload}"/>
                                    <TextBlock Text="导入" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- .top-icon-btn.dl-toggle（:1350-1358）：只在首页「且有活动任务」时出现，
                                 里面是 .dl-badge.compact（:2131-2138）：absolute top 2 / right 0 /
                                 min-width 14 / 高 14 / 12px（半高圆角＝7）。任务计数未接入 → 整颗按钮 Collapsed。 -->
                            <Button x:Name="BtnTopHomeDl" Style="{StaticResource TopIconBtn}" Margin="4,0,0,0"
                                    Visibility="Collapsed" ToolTip="下载中心" Click="OpenDl_Click">
                                <Grid>
                                    <ContentControl Width="17" Height="17" Style="{DynamicResource Icon.Download}"/>
                                    <Border x:Name="DlBadgeCompact" Style="{StaticResource DlBadge}"
                                            MinWidth="14" Height="14" CornerRadius="7"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,2,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="DlBadgeCompactText" Text="0" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentFg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <!-- .top-icon-btn.dl-toggle（:1359）：首页第二颗图标钮是「更新日志」-->
                            <Button x:Name="BtnTopHistory" Style="{StaticResource TopIconBtn}" Margin="4,0,0,0"
                                    ToolTip="更新日志" Click="History_Click">
                                <ContentControl Width="17" Height="17" Style="{DynamicResource Icon.Changelog}"/>
                            </Button>
                            <!-- .top-icon-btn（:1366 ＋ :2099-2120）：36×36 / radius 10 / svg 17 -->
                            <Button x:Name="BtnTopNotice" Style="{StaticResource TopIconBtn}" Margin="4,0,0,0"
                                    ToolTip="通知" Click="Notice_Click">
                                <Grid>
                                    <ContentControl Width="17" Height="17" Style="{DynamicResource Icon.Bell}"/>
                                    <!-- .bell-dot：7×7 圆点，absolute top 7 / right 8，描边 1.5 走 bg-2
                                         （App.vue:1371 + :2121-2129），有未读通知时才出现 -->
                                    <Ellipse x:Name="BellDot" Width="7" Height="7" Fill="{DynamicResource Accent}"
                                             Stroke="{DynamicResource NavBg}" StrokeThickness="1.5"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,7,8,0" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <!-- .top-divider（:1375 ＋ :2363-2369）：1×20 / 底 border / margin 0 8 -->
                            <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="8,0"/>
                            <!-- .win-btn（:1377-1391 ＋ :2371-2395）：38×36 / radius 10 / svg 15；
                                 .win-close:hover 底 danger ＋ 白字（:2392） -->
                            <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Click="Min_Click">
                                <ContentControl Width="15" Height="15" Style="{DynamicResource Icon.Minimize}"/>
                            </Button>
                            <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Click="Max_Click">
                                <ContentControl x:Name="MaxIcon" Width="15" Height="15" Style="{DynamicResource Icon.Maximize}"/>
                            </Button>
                            <Button x:Name="BtnClose" Style="{StaticResource WinClose}" Click="Close_Click">
                                <ContentControl Width="15" Height="15" Style="{DynamicResource Icon.Close}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- .content（:1501 ＋ :2398-2404）：flex 1 / min-height 0 / overflow-y auto /
                     padding space-5 24 / scrollbar-gutter stable（:2406 的 1080 分支收成 16，未接）。
                     里面的每一页就是 .route-view（:1503 ＋ ui-system.css:9 min-width 0），
                     路由切换的 fade 进出场（:1502 ＋ styles.css:648-651）留在代码/页面侧。 -->
                <Grid Grid.Row="1" Margin="24">

                    <!-- ============ 首页 ============ -->
                    <pages:HomePage x:Name="PageHome"/>

                    <!-- ============ 游戏版本 ============ -->
                    <pages:VersionsPage x:Name="PageVersions" Visibility="Collapsed"/>

                    <!-- ============ 设置 ============ -->
                    <pages:SettingsPage x:Name="PageSettings" Visibility="Collapsed"/>
                    <pages:AccountsPage x:Name="PageAccounts" Visibility="Collapsed"/>
                    <pages:SkinsPage x:Name="PageSkins" Visibility="Collapsed"/>
                    <pages:CommunityPage x:Name="PageCommunity" Visibility="Collapsed"/>
                    <pages:ModsPage x:Name="PageMods" Visibility="Collapsed"/>
                    <pages:KeysPage x:Name="PageKeys" Visibility="Collapsed"/>
                    <pages:RecordingsPage x:Name="PageRecordings" Visibility="Collapsed"/>
                    <pages:ServersPage x:Name="PageServers" Visibility="Collapsed"/>
                    <pages:BridgePage x:Name="PageBridge" Visibility="Collapsed"/>
                    <pages:FriendsPage x:Name="PageFriends" Visibility="Collapsed"/>

                    <!-- ============ 未接入页面占位 ============ -->
                    <Border x:Name="PageStub" Visibility="Collapsed" Style="{StaticResource Panel}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,30">
                        <StackPanel MaxWidth="420">
                            <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource AccentSoft}"
                                    HorizontalAlignment="Center">
                                <ContentControl x:Name="StubIcon" Width="26" Height="26"
                                                Style="{DynamicResource Icon.Gear}"/>
                            </Border>
                            <TextBlock x:Name="StubTitle" Text="该模块尚未接入" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock x:Name="StubText" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,8,0,0"
                                       Text="本轮只交付基础链路：版本清单、下载校验、Java 匹配、启动组装与拉起。"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== 启动日志弹窗（原版是 z:9100 的模态窗） ==================== -->
            <Border x:Name="LogOverlay" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="{DynamicResource Overlay}" MouseLeftButtonDown="CloseLog_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <!-- mask-in：遮罩淡入 200ms ease（UI_MOTION.md §3.4） -->
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1"
                                                                      KeySpline="0.25,0.1 0.25,1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="760" MaxHeight="620" CornerRadius="16" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Background="{DynamicResource Card}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5"
                        MouseLeftButtonDown="LogCard_Down">
                    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <!-- modal-in：220ms，opacity 0→1 + translateY 6→0 + scale .99→1，
                                     缓动 ease-out 令牌 = cubic-bezier(.2,.7,.3,1) -->
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                                                          KeySpline="0.2,0.7 0.3,1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="6"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0"
                                                                          KeySpline="0.2,0.7 0.3,1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="18,16">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="启动日志" FontSize="16" FontWeight="Bold"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource Fg2}" Margin="0,3,0,0"
                                           Text="{Binding LogLines.Count, StringFormat={}{0} 行}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnGhost}" MinHeight="32" Padding="10,4"
                                        Content="复制命令" Click="CopyCmd_Click"/>
                                <Button Style="{StaticResource BtnGhost}" MinHeight="32" Padding="10,4"
                                        Content="清空" Margin="8,0,0,0" Click="ClearLog_Click"/>
                                <Button Style="{StaticResource IconBtn}" Width="32" Height="32" Margin="10,0,0,0"
                                        Click="CloseLog_Click">
                                    <ContentControl Width="16" Height="16" Style="{DynamicResource Icon.Close}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                Padding="16,11">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Fg2}"
                                       Text="日志只保留本次会话，关窗即清；复制命令可把完整启动指令贴给别人排查。"/>
                        </Border>
                        <Border MinHeight="220" Background="{DynamicResource LogBody}" Padding="18,14">
                            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                     Style="{StaticResource CardList}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ItemsSource="{Binding LogLines}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5" Foreground="{DynamicResource Fg2}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>
            </Border>

            <!-- ============ 浮层族（原版 Teleport 到 body 的 fixed 层）============
                 通知 / 更新日志 / 下载中心 / 配置不兼容 / 拖拽遮罩 / 启动失败 / 整合包导入。
                 全部横跨 ShellHost 两列（Grid.ColumnSpan＝2），否则会被算进 208 宽的侧栏列里，
                 这版壳层最初就栽在这儿；层的先后次序按原版 z-index 排：
                 notice-mask 9000 ＜ notice-panel 9001 ＜ cfg-mismatch 9600 ＜ drop-mask 9999 ＜ modal-mask 10000。
                 .notice-mask（App.vue:2141-2145）：fixed inset 0 / z 9000 / 无底色，点空白处关闭。 -->
            <Border x:Name="FloatMask" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="Transparent" Visibility="Collapsed"
                    MouseLeftButtonUp="FloatMask_Click"/>

            <!-- .toasts：fixed top 76 / right 24 / column gap 8 / z 200 / pointer-events none
                 （Toasts.vue:38-43） -->
            <ItemsControl x:Name="ToastHost" Grid.Column="0" Grid.ColumnSpan="2"
                          IsHitTestVisible="False" Visibility="Collapsed"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,24,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Toast}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- .toast 左边线是 3px 的 tone 色（border-left-width:3）；
                                     WPF 的 Border 不能四边异色，用一条 3 宽色条等价表达 -->
                                <Border Grid.Column="0" Background="{Binding Tone, Converter={StaticResource BrushByKey}}"
                                        CornerRadius="10,0,0,10"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding Tone, Converter={StaticResource BrushByKey}}"/>
                                    <TextBlock Text="{Binding Text}" Margin="12,0,0,0" FontSize="13"
                                               LineHeight="20" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- .notice-panel（App.vue:1398 ＋ :2176-2195）：fixed top 82 / right 92 / w 320 /
                 max-h 420 / column / radius 14 / border 1 / shadow-lg / 底 card-solid 94% / overflow hidden。
                 这里踩到一个 CSS 陷阱：.notes-panel（:2146）写在 .notice-panel（:2176）之前，同特异性，
                 后写的 .notice-panel 赢 → 更新日志面板的有效宽度是 320／最大高 420，不是 380／480；
                 .dl-panel（:2237）写在 .notice-panel 之后，所以只有宽度收成 380，max-h 仍是 420。
                 blur(24) saturate(130%) 是 backdrop-filter，WPF 没有，用不透明 Card 底近似（同 FloatPanel）。 -->
            <Border x:Name="NoticePanel" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FloatPanel}"
                    Width="320" MaxHeight="420" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,82,92,0">
                <DockPanel>
                    <!-- .notice-head（:1399 ＋ :2196-2202）：flex space-between / padding 12 16 / 下边线 1 -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource FloatPanelHead}">
                        <Grid>
                            <!-- .notice-title（:2203-2206）：14px / 700 -->
                            <TextBlock FontSize="14" FontWeight="Bold" Text="通知"/>
                            <!-- .btn.btn-ghost.btn-sm（:1401）：列表为空时 disabled（opacity .45） -->
                            <Button x:Name="NoticeClearBtn" Style="{StaticResource Sh.BtnSmFloat}"
                                    Content="清空" HorizontalAlignment="Right" IsEnabled="False"
