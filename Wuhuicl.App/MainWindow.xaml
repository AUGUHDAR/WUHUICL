            <!-- .notice-panel.dl-panel（App.vue:1442 ＋ :2237-2239）：w 380 / max-h 420（见 NoticePanel 那条陷阱注释） -->
            <Border x:Name="DlPanel" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FloatPanel}"
