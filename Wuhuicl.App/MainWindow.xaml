                                                <!-- paused：继续＋取消（:1459-1460） -->
                                                <Button x:Name="DlRowResume" Style="{StaticResource Sh.BtnSmFloat}"
                                                        Content="继续" Visibility="Collapsed" Click="Dl_Resume_Click"/>
                                                <Button x:Name="DlRowCancel" Style="{StaticResource Sh.BtnSmFloat}"
                                                        Content="取消" Margin="4,0,0,0" Visibility="Collapsed"
