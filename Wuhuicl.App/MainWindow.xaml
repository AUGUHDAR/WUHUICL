<Window x:Class="Wuhuicl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Wuhuicl.App.Pages"
        xmlns:ctl="clr-namespace:Wuhuicl.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WUHUICL 武慧启动器" Width="1360" Height="860" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowGrad}"
        Foreground="{DynamicResource Fg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- 原版在 Windows 上是 frame:false + roundedCorners:true + backgroundMaterial:'acrylic'，
         并且明确写了 transparent 只给非 win32 用：layered window 会绕过 DWM 合成，
         缩放和内存都吃亏。所以这里窗口本体不透明，圆角交给 DWM（代码里设 corner preference）。
         WPF 侧用 CaptionHeight=0 自绘拖拽：只有 72px 顶栏可拖，和原版 app-region 一致。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="ShellRoot" Background="{DynamicResource WindowGrad}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="ShellHost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 侧栏 208 ==================== -->
            <Border Grid.Column="0" Background="{DynamicResource NavBg}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- .logo-area：88 高，padding 0 16，gap 12。
                         .brand-head（App.vue:1772）是玩家皮肤的脸，不是应用图标：
                         42×42 / radius 10 / 1px rgba(255,255,255,.26) / 0 3px 12px rgba(0,0,0,.18) / pixelated -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border x:Name="BrandHead" Width="42" Height="42" CornerRadius="10"
                                BorderBrush="#43FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270"
                                                  Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                        <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="WUHUICL" FontSize="20" FontWeight="Bold"
                                       LineHeight="24"/>
                            <TextBlock Grid.Row="2" Text="v0.1.0" FontSize="12" HorizontalAlignment="Right"
                                       Margin="0,0,2,0" Foreground="{DynamicResource AccentHi}" Opacity="0.85"/>
                        </Grid>
                    </StackPanel>

                    <!-- .nav：gap 4，padding 4 12 12。
                         水滴层与选条层是独立绝对定位层（原版 .nav-bubble / .nav-selection），
                         几何由代码测量后做 300ms cubic-bezier(.22,1,.36,1) 位移。 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                        <Grid Margin="12,4,12,12">
                            <Canvas x:Name="NavHost" IsHitTestVisible="False">
                                <!-- .nav-bubble：App.vue:1842 底色是 135° 渐变（accent-soft 80% → hover）
                                     外加 0 3px 12px #00000008；它跟着悬停项跑，无悬停时停在选中项 -->
                                <Border x:Name="NavBubble" CornerRadius="10" Opacity="0"
                                        Background="{DynamicResource NavPill}"/>
                                <!-- .nav-selection：App.vue:1854 只有 box-shadow inset 3px 0 0 accent，
                                     本身没有底色，永远停在选中项。原版量得 3px 宽的直边竖条
                                     （月牙两端的加宽不到 1px），所以这里用定位容器 + 3px 圆角竖条；
                                     直接给 Border 设单边 BorderThickness 会画成一个大括号弧。 -->
                                <Border x:Name="NavSel" CornerRadius="10" Background="Transparent">
                                    <Border Width="3" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                            HorizontalAlignment="Left"/>
                                </Border>
                            </Canvas>
                            <StackPanel x:Name="NavList">
                                <RadioButton x:Name="NavHome" Style="{StaticResource Nav}"
                                             GroupName="nav" Tag="Icon.Home"
                                             Content="首页" IsChecked="True" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavVersions" Style="{StaticResource Nav}"
                                             GroupName="nav" Tag="Icon.Game"
                                             Content="游戏版本" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <ToggleButton x:Name="NavResources" Style="{StaticResource NavParent}"
                                              Tag="Icon.Resources" Content="资源管理"
                                              Checked="NavExpand_Changed" Unchecked="NavExpand_Changed"
                                              MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <!-- .nav-sub：原版是 grid-template-rows 0fr→1fr，190ms ease-out；
                                     WPF 没有等价物，用高度测量后做同参数的 DoubleAnimation -->
                                <StackPanel x:Name="NavSubList" Height="0" ClipToBounds="True"
                                            Visibility="Collapsed">
                                    <!-- .nav-sub-item 的 padding-left 32 = 导航内缩 16 + 再缩 16 -->
                                    <StackPanel Margin="16,0,0,0">
                                        <RadioButton x:Name="NavMods" Style="{StaticResource NavSub}"
                                             GroupName="nav" Tag="Icon.Mods"
                                                     Content="模组" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <RadioButton x:Name="NavPacks" Style="{StaticResource NavSub}"
                                             GroupName="nav"
                                                     Tag="Icon.ResourcePacks" Content="资源包" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <RadioButton x:Name="NavShaders" Style="{StaticResource NavSub}"
                                             GroupName="nav"
                                                     Tag="Icon.Shaders" Content="光影包" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <RadioButton x:Name="NavRecordings" Style="{StaticResource NavSub}"
                                             GroupName="nav"
                                                     Tag="Icon.Changelog" Content="录像" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <!-- 子项顺序照 App.vue:158-186：mods/packs/shaders/recordings/bridge/servers。
                                             MOD 面板是桥接参数编辑器（BridgeView），服务器是服务器条目管理（ServersView），
                                             两者与主导航的「联机」互不相干，不能并成一块。 -->
                                        <RadioButton x:Name="NavBridge" Style="{StaticResource NavSub}"
                                             GroupName="nav" Tag="Icon.Bridge"
                                                     Content="MOD 面板" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                        <RadioButton x:Name="NavServers" Style="{StaticResource NavSub}"
                                             GroupName="nav" Tag="Icon.Servers"
                                                     Content="服务器" Checked="Nav_Checked"
                                                     MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                    </StackPanel>
                                </StackPanel>
                                <RadioButton x:Name="NavOnline" Style="{StaticResource Nav}"
                                             GroupName="nav" Tag="Icon.Friends"
                                             Content="联机" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavDefaults" Style="{StaticResource Nav}"
                                             GroupName="nav" Tag="Icon.Keys"
                                             Content="默认配置" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavSkin" Style="{StaticResource Nav}"
                                             GroupName="nav" Tag="Icon.Skin"
                                             Content="皮肤" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavCommunity" Style="{StaticResource Nav}"
                                             GroupName="nav" Tag="Icon.Community"
                                             Content="社区资源" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                                <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}"
                                             GroupName="nav" Tag="Icon.Settings"
                                             Content="设置" Checked="Nav_Checked"
                                             MouseEnter="NavItem_Enter" MouseLeave="NavItem_Leave"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- .sidebar-health：min-height 42，grid 8px / 1fr / 14px，gap 8，margin 12 -->
                    <Button Grid.Row="2" Style="{StaticResource BtnGhost}" Height="42" Margin="12" Padding="12,0"
                            HorizontalContentAlignment="Stretch" Click="Notice_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource Ok}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="全部系统运行正常" FontSize="12" Margin="8,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"
                                       TextTrimming="CharacterEllipsis"/>
                            <ContentControl Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center"
                                            Style="{DynamicResource Icon.ChevronRight}"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== 右区：顶栏 72 + 内容 ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- .topbar：72 高，padding 0 24，唯一拖拽区 -->
                <Border Grid.Row="0" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,0,0,1" Padding="24,0" MouseLeftButtonDown="Topbar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- .topbar 是 flex：[top-back?] spacer(flex:1) + gap 16 + top-actions，
                                 所以格言只在动作区左边的带子里居中，不是整条顶栏居中 -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- .top-back：36×36（ctl-h）/ radius 6 / card-2 底 / 1px color-mix(border 70%) /
                             字色 text-dim，hover 才变 accent-2（App.vue:2033-2045）。
                             v-if="canGoBack && currentView !== 'home'"（:1321）→ 由代码控制显隐 -->
                        <Button x:Name="BtnTopBack" Grid.Column="0" Style="{StaticResource TopBack}"
                                Visibility="Collapsed" Margin="0,0,16,0"
                                ToolTip="返回上一个页面" Click="Back_Click">
                            <!-- 左指箭头是 App.vue:1328 的 Icon.Back；Icon.ChevronLeft 复刻的是 :1313 那条，方向朝右，别混用 -->
                            <ContentControl Width="16" Height="16" Style="{DynamicResource Icon.Back}"/>
                        </Button>
                        <ctl:CreatorMotto x:Name="Motto" Grid.Column="1" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- App.vue:1333 下载按钮 v-if currentView !== home；首页只有有下载任务时才出图标钮 -->
                            <Button x:Name="BtnTopDownload" Style="{StaticResource TopBtn}" Click="OpenDl_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Width="15" Height="15" VerticalAlignment="Center"
                                                    Style="{DynamicResource Icon.Download}"/>
                                    <TextBlock Text="下载" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Border x:Name="DlBadge" Style="{StaticResource Tag}" Margin="8,0,0,0"
                                            Background="{DynamicResource Accent}" Visibility="Collapsed">
                                        <TextBlock x:Name="DlBadgeText" Text="0" FontSize="11" Foreground="#FFFFFFFF"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <!-- App.vue:1342 导入按钮：与下载同为 .top-btn，同样只在非首页出现 -->
                            <Button x:Name="BtnTopImport" Style="{StaticResource TopBtn}" Margin="8,0,0,0"
                                    Click="Import_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Width="15" Height="15" VerticalAlignment="Center"
                                                    Style="{DynamicResource Icon.Upload}"/>
                                    <TextBlock Text="导入" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- App.vue:1359 首页那个图标钮是「更新日志」而不是历史列表（Icon.Changelog 本来就对）；
                                 App.vue:1351 另有一个「下载中心」图标钮，只在首页且有活动任务时出现，等下载队列接入再补 -->
                            <Button x:Name="BtnTopHistory" Style="{StaticResource IconBtn}" Width="36" Margin="4,0,0,0"
                                    ToolTip="更新日志" Click="History_Click">
                                <ContentControl Width="15" Height="15" Style="{DynamicResource Icon.Changelog}"/>
                            </Button>
                            <Button Style="{StaticResource IconBtn}" Width="36" Margin="2,0,0,0"
                                    ToolTip="通知" Click="Notice_Click">
                                <ContentControl Width="15" Height="15" Style="{DynamicResource Icon.Bell}"/>
                            </Button>
                            <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="10,0"/>
                            <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Click="Min_Click">
                                <ContentControl Width="15" Height="15" Style="{DynamicResource Icon.Minimize}"/>
                            </Button>
                            <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Click="Max_Click">
                                <ContentControl x:Name="MaxIcon" Width="15" Height="15" Style="{DynamicResource Icon.Maximize}"/>
                            </Button>
                            <Button x:Name="BtnClose" Style="{StaticResource WinClose}" Click="Close_Click">
                                <ContentControl Width="15" Height="15" Style="{DynamicResource Icon.Close}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- .content：padding 24，滚动条槽常驻 -->
                <Grid Grid.Row="1" Margin="24">

                    <!-- ============ 首页 ============ -->
                    <pages:HomePage x:Name="PageHome"/>

                    <!-- ============ 游戏版本 ============ -->
                    <pages:VersionsPage x:Name="PageVersions" Visibility="Collapsed"/>

                    <!-- ============ 设置 ============ -->
                    <pages:SettingsPage x:Name="PageSettings" Visibility="Collapsed"/>
                    <pages:AccountsPage x:Name="PageAccounts" Visibility="Collapsed"/>
                    <pages:SkinsPage x:Name="PageSkins" Visibility="Collapsed"/>
                    <pages:CommunityPage x:Name="PageCommunity" Visibility="Collapsed"/>
                    <pages:ModsPage x:Name="PageMods" Visibility="Collapsed"/>
                    <pages:KeysPage x:Name="PageKeys" Visibility="Collapsed"/>
                    <pages:RecordingsPage x:Name="PageRecordings" Visibility="Collapsed"/>
                    <pages:ServersPage x:Name="PageServers" Visibility="Collapsed"/>
                    <pages:BridgePage x:Name="PageBridge" Visibility="Collapsed"/>
                    <pages:FriendsPage x:Name="PageFriends" Visibility="Collapsed"/>

                    <!-- ============ 未接入页面占位 ============ -->
                    <Border x:Name="PageStub" Visibility="Collapsed" Style="{StaticResource Panel}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,30">
                        <StackPanel MaxWidth="420">
                            <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource AccentSoft}"
                                    HorizontalAlignment="Center">
                                <ContentControl x:Name="StubIcon" Width="26" Height="26"
                                                Style="{DynamicResource Icon.Gear}"/>
                            </Border>
                            <TextBlock x:Name="StubTitle" Text="该模块尚未接入" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock x:Name="StubText" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,8,0,0"
                                       Text="本轮只交付基础链路：版本清单、下载校验、Java 匹配、启动组装与拉起。"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== 启动日志弹窗（原版是 z:9100 的模态窗） ==================== -->
            <Border x:Name="LogOverlay" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="{DynamicResource Overlay}" MouseLeftButtonDown="CloseLog_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <!-- mask-in：遮罩淡入 200ms ease（UI_MOTION.md §3.4） -->
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1"
                                                                      KeySpline="0.25,0.1 0.25,1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="760" MaxHeight="620" CornerRadius="16" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Background="{DynamicResource Card}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5"
                        MouseLeftButtonDown="LogCard_Down">
                    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <!-- modal-in：220ms，opacity 0→1 + translateY 6→0 + scale .99→1，
                                     缓动 ease-out 令牌 = cubic-bezier(.2,.7,.3,1) -->
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                                                          KeySpline="0.2,0.7 0.3,1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="6"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0"
                                                                          KeySpline="0.2,0.7 0.3,1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="18,16">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="启动日志" FontSize="16" FontWeight="Bold"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource Fg2}" Margin="0,3,0,0"
                                           Text="{Binding LogLines.Count, StringFormat={}{0} 行}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnGhost}" MinHeight="32" Padding="10,4"
                                        Content="复制命令" Click="CopyCmd_Click"/>
                                <Button Style="{StaticResource BtnGhost}" MinHeight="32" Padding="10,4"
                                        Content="清空" Margin="8,0,0,0" Click="ClearLog_Click"/>
                                <Button Style="{StaticResource IconBtn}" Width="32" Height="32" Margin="10,0,0,0"
                                        Click="CloseLog_Click">
                                    <ContentControl Width="16" Height="16" Style="{DynamicResource Icon.Close}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                Padding="16,11">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Fg2}"
                                       Text="日志只保留本次会话，关窗即清；复制命令可把完整启动指令贴给别人排查。"/>
                        </Border>
                        <Border MinHeight="220" Background="{DynamicResource LogBody}" Padding="18,14">
                            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                     Style="{StaticResource CardList}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ItemsSource="{Binding LogLines}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5" Foreground="{DynamicResource Fg2}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
