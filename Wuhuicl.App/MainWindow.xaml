                    </Grid>
                </DockPanel>
            </Border>

            <!-- .menu-overlay.cfg-mismatch-mask（App.vue:1532 ＋ styles.css:577-581 ＋ App.vue:1721）：
                 铺满整窗、全透明、只挡点击并把卡片居中（原版这层没有底色也没有 backdrop-filter），
                 z 9600 在拖拽遮罩（9999）之下、模态（10000）之上。
                 .card.cfg-mismatch-modal（:1533 ＋ :1722）：min(460,90vw) / padding 20 22 / column / gap 12。
                 文案照 :1534-1538 三条原文。配置版本兼容检查（configMismatch）未接入 → 整层 Collapsed。 -->
            <Border x:Name="CfgMismatchMask" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource Sh.CfgMask}" Visibility="Collapsed">
                <Border x:Name="CfgMismatchCard" Style="{StaticResource Sh.CfgModal}">
                    <StackPanel>
                        <TextBlock Text="配置文件版本不兼容" Style="{StaticResource Sh.UpdModalTitle}"/>
                        <!-- p.muted：字号继承 body 的 text-md 14，字色 text-dim；与上下兄弟之间是 gap 12 -->
                        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Foreground="{DynamicResource Fg2}"
                                   Text="当前配置文件由更新版本的启动器创建，可能包含本版本不认识的格式。可以继续尝试使用（可能异常），或重置为默认设置（原配置会自动备份）。"/>
                        <!-- .upd-modal-actions（:1724）：flex 右对齐 / gap 10（不是 modal-actions 的 12） -->
                        <StackPanel Style="{StaticResource Sh.UpdModalActions}" Margin="0,12,0,0">
                            <Button Content="继续尝试" Style="{StaticResource BtnGhost}" Click="Cfg_Keep_Click"/>
                            <Button Content="重置设置" Style="{StaticResource BtnDanger}" Margin="10,0,0,0"
                                    Click="Cfg_Reset_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- .drop-mask（App.vue:1549 ＋ :2419-2430）：fixed inset 0 / z 9999 / flex 居中 /
                 底 color-mix(accent 16%, transparent)＝Accent16 / blur(24) saturate(130%) / pointer-events none。
                 .drop-box（:2431-2448）：column 居中 gap 16 / padding 48 / border 2 dashed accent /
                 radius 14 / 底 color-mix(accent 8%, card) ＝ Card 垫底再叠 8% accent / 字 accent；
                 svg 48×48；.drop-title 16/600。原版没有给盒宽，宽度由那句长文案撑出来，
                 所以这里让内容自排（Padding 48），不再写死 320×180。
                 Border 画不出 dashed → 2px 虚线用同位 Rectangle 叠；blur(24) 还欠 MaskBlur。 -->
            <Border x:Name="DropMask" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource Accent16}" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource Sh.DropBox}"/>
                    <Border Style="{StaticResource Sh.DropBoxTint}"/>
                    <Rectangle Style="{StaticResource Sh.DropBoxDash}"/>
                    <!-- padding 48 ＋ 2px 边框 ＝ 内容距盒边 50；gap 16 落在图标与标题之间 -->
                    <StackPanel Margin="50" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl Width="48" Height="48" HorizontalAlignment="Center"
                                        Foreground="{DynamicResource Accent}"
                                        Style="{DynamicResource Icon.Upload}"/>
                        <!-- .drop-title（:1556 原文） -->
                        <TextBlock Text="松开导入：存档 / 整合包 / MOD / 外置登录提供商"
                                   Style="{StaticResource Sh.DropTitle}"/>
                    </StackPanel>
