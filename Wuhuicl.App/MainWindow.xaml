            <!-- .modal-mask（App.vue:1573 ＋ styles.css:527-538）＋ .modal.launchfail-modal（:2314-2316）：
                 480 宽，标题走 h3 的 UA 粗体，.launchfail-text（:2317）13px / line-height 1.7 /
                 text-dim / break-all / max-height 220 / 纵向滚动 / white-space pre-wrap，
                 动作行是通用 .modal-actions（styles.css:557）：右对齐 gap 12 / margin-top 24，
                 三颗钮＝查看原因(btn-ghost) ＋ 关闭(btn-ghost) ＋ 导出错误日志(btn-gold ＋ 14×14 下载图标)。
                 启动失败捕获（launchFail）未接入 → 整层 Collapsed。 -->
            <Border x:Name="LaunchFailMask" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource Sh.ModalMaskIn}" Visibility="Collapsed"
                    MouseLeftButtonDown="LaunchFail_Mask_Down">
                <Border x:Name="LaunchFailCard" MouseLeftButtonDown="ModalCard_Down">
                    <!-- modal-in：220ms ease-out 的 opacity 0→1 ＋ translateY 6→0
                         （styles.css:554 ＋ :569-574；原版还有 scale(.99)，与本页日志窗同一取舍） -->
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Sh.LaunchFailModal}">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value><TranslateTransform/></Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                                                          KeySpline="0.2,0.7 0.3,1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="6"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0"
                                                                          KeySpline="0.2,0.7 0.3,1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock x:Name="LaunchFailTitle" Style="{StaticResource Sh.ModalTitle}"/>
                        <!-- 标题与正文之间原版没有间距（* 把 p/h3 的 margin 清 0，两条规则都不补 margin） -->
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LaunchFailText" Style="{StaticResource Sh.LaunchFailText}"/>
                        </ScrollViewer>
                        <StackPanel Style="{StaticResource Sh.ModalActions}">
                            <Button Content="查看原因" Style="{StaticResource BtnGhost}"
                                    Click="LaunchFail_Reason_Click"/>
                            <Button Content="关闭" Style="{StaticResource BtnGhost}" Margin="12,0,0,0"
                                    Click="LaunchFail_Close_Click"/>
                            <Button x:Name="LaunchFailExportBtn" Style="{StaticResource BtnGold}" Margin="12,0,0,0"
                                    Click="LaunchFail_Export_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Width="14" Height="14" VerticalAlignment="Center"
                                                    Style="{DynamicResource Icon.Download}"/>
                                    <TextBlock x:Name="LaunchFailExportText" Text="导出错误日志"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ==================== 整合包导入确认弹窗（App.vue:1591-1712 ＋ :2452-2624）====================
                 .modal-mask ＋ .modal.mp-modal：宽 min(620px, 100vw 减 40) / 最高 88vh / 纵向滚动，
                 上限由代码 ApplyViewportCaps() 按窗口尺寸写回。
                 三态互斥：.mp-loading（probing）／info 主体／解析失败，
                 整合包解析（probeModpack）与实例冲突表（existingInstances）都没有接 → 
                 只有标题与三态壳可见性由代码 SetModpackState 管，内容一律 Collapsed。 -->
            <Border x:Name="MpMask" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource Sh.ModalMaskIn}" Visibility="Collapsed"
                    MouseLeftButtonDown="Mp_Mask_Down">
                <Border x:Name="MpModalCard" Padding="0" MouseLeftButtonDown="ModalCard_Down">
                    <!-- 同 .modal 的 modal-in（styles.css:554 ＋ :569-574），220ms ease-out -->
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Sh.MpModal}">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value><TranslateTransform/></Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                                                          KeySpline="0.2,0.7 0.3,1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0" Value="6"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0"
                                                                          KeySpline="0.2,0.7 0.3,1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel>
                            <!-- .mp-title（:1593 ＋ :2457）：16px / margin-bottom 16 -->
                            <TextBlock Text="导入整合包" Style="{StaticResource Sh.MpTitle}"/>

                            <!-- .mp-loading（:1596 ＋ :2461-2466）：flex 居中 gap 8 / padding 12 0，
                                 里面是全局 .spin（styles.css:683-691，14×14 的 accent 环）＋ .muted「解析中…」 -->
                            <StackPanel x:Name="MpLoading" Style="{StaticResource Sh.MpLoading}"
                                        Visibility="Collapsed">
                                <ContentControl Style="{StaticResource Spin}"/>
                                <TextBlock Text="解析中&#x2026;" Foreground="{DynamicResource Fg2}" FontSize="14"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="MpInfoBody" Visibility="Collapsed">
                                <!-- .mp-tags（:1603 ＋ :2467-2471）：flex wrap / gap 8。
                                     FORMAT_TAG_CLASS（:518-522）：mrpack→tag-success（ok-soft/ok）、
                                     curseforge→tag-gold（accent-soft/accent-2）、fullpack→tag-cyan（cyan-soft/cyan）。
                                     .tag 基线见 Controls.xaml:92（padding 2 8 ＋ 1px 透明边 ＋ line-height 1.6）。 -->
                                <WrapPanel>
                                    <Border x:Name="MpTagFormat" Style="{StaticResource Tag}" Margin="0,0,8,0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="MpTagFormatText" Style="{StaticResource TagText}"/>
                                    </Border>
                                    <Border x:Name="MpTagMc" Style="{StaticResource Tag}" Margin="0,0,8,0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="MpTagMcText" Style="{StaticResource TagText}"/>
                                    </Border>
                                    <Border x:Name="MpTagLoader" Style="{StaticResource Tag}" Margin="0,0,8,0"
                                            Background="{DynamicResource AccentSoft}" Visibility="Collapsed">
                                        <TextBlock x:Name="MpTagLoaderText" Style="{StaticResource TagText}"
                                                   Foreground="{DynamicResource AccentHi}"/>
                                    </Border>
                                    <Border x:Name="MpTagVersion" Style="{StaticResource Tag}" Margin="0,0,8,0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="MpTagVersionText" Style="{StaticResource TagText}"/>
                                    </Border>
                                </WrapPanel>

                                <!-- .mp-summary（:1616 ＋ :2472-2476）：margin-top 8 / 12px / text-dim -->
                                <TextBlock x:Name="MpSummary" Style="{StaticResource Sh.MpSummary}"/>

                                <!-- .mp-label（:1622 ＋ :2477-2481）：13px text-dim / margin 16 0 8 -->
                                <TextBlock Text="目标游戏文件夹" Style="{StaticResource Sh.MpLabel}"/>
                                <!-- select.select（:1623 ＋ styles.css:304-341）：宽 100% / 最低 36 /
                                     padding 8 12（右侧再留 32 给箭头）/ radius 10 / card-2 底 / 14px。
                                     选项来自 store.settings.folders（名称＋默认标记＋路径），未接入。 -->
                                <ComboBox x:Name="MpFolderSelect" FontSize="14"/>

                                <TextBlock Text="实例命名" Style="{StaticResource Sh.MpLabel}"/>
                                <!-- .mp-name-opts（:1630 ＋ :2482-2486）：column / gap 8 -->
                                <StackPanel>
                                    <RadioButton x:Name="MpNameFromFile" Style="{StaticResource Sh.MpNameOpt}"
                                                 GroupName="mpname" IsChecked="True" Margin="0,0,0,8">
                                        <!-- .mp-name-text（:2522-2527）：flex baseline gap 8 / min-width 0 -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="使用压缩包文件名" Style="{StaticResource Sh.MpNameLabel}"/>
                                            <TextBlock x:Name="MpNameFromFileValue" Style="{StaticResource Sh.MpNameValue}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="MpNameFromInner" Style="{StaticResource Sh.MpNameOpt}"
                                                 GroupName="mpname">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="使用整合包名称" Style="{StaticResource Sh.MpNameLabel}"/>
                                            <TextBlock x:Name="MpNameFromInnerValue" Style="{StaticResource Sh.MpNameValue}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <!-- input.input.mp-custom-name（:1654 ＋ :2540-2543）：宽 100% / margin-top 8 /
                                     maxlength 120 / placeholder「自定义实例名称」 -->
                                <Grid Margin="0,8,0,0">
                                    <TextBox x:Name="MpCustomName" Style="{StaticResource Input}" FontSize="14"
                                             MaxLength="120"/>
                                    <TextBlock x:Name="MpCustomNameHint" Text="自定义实例名称"
                                               Style="{StaticResource Sh.Placeholder}"/>
                                </Grid>

                                <!-- .mp-conflict（:1656 ＋ :2544-2600）：grid gap 8 / margin-top 12 / padding 12 /
                                     border 1 且颜色是 color-mix(accent-deep 48%, border) /
                                     底 color-mix(accent-deep 8%, card) / radius 10 / 12px text-dim，
                                     里面 strong（:2555）字色转 text。
                                     WPF 画不出 color-mix，两层各画一遍再按 48%／8% 不透明度叠：
                                     底＝Card，叠 8% AccentLo；描边＝Line，再叠一层 48% 的 AccentLo 描边。
                                     内容需要 existingInstances（同包同版本／同名冲突）才能填 → 整块 Collapsed。 -->
                                <Grid x:Name="MpConflict" Margin="0,12,0,0" Visibility="Collapsed"
                                      TextElement.FontSize="12">
                                    <Border CornerRadius="10" Background="{DynamicResource Card}"/>
                                    <Border CornerRadius="10" Background="{DynamicResource AccentLo}" Opacity="0.08"/>
                                    <Border CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                                    <Border CornerRadius="10" BorderBrush="{DynamicResource AccentLo}"
                                            BorderThickness="1" Opacity="0.48" IsHitTestVisible="False"/>
                                    <!-- padding 12 ＋ 1px 边框内缩 -->
                                    <StackPanel Margin="13" TextElement.Foreground="{DynamicResource Fg2}">
                                        <TextBlock x:Name="MpConflictTitle" FontWeight="Bold"
                                                   Foreground="{DynamicResource Fg}" TextWrapping="Wrap"
                                                   Text="检测到实例冲突或相同整合包版本"/>
                                        <TextBlock x:Name="MpConflictList" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <!-- .mp-conflict-actions（:1661 ＋ :2558-2563）：grid 两列 /
                                             column-gap space-3 12 / row-gap space-2 8 / margin-top space-1 4。
                                             它是 grid 项，父级 gap 8 ＋ 自身 margin-top 4 ＝ 距上 12。 -->
                                        <UniformGrid Columns="2" Margin="0,12,0,0">
                                            <!-- 初值 conflictAction='rename'（App.vue:548）→ 重新命名默认选中 -->
                                            <RadioButton x:Name="MpActRename" Style="{StaticResource Sh.MpConflictOpt}"
                                                         GroupName="mpconflict" Content="重新命名" IsChecked="True"
                                                         Margin="0,0,0,8" Checked="MpConflictAction_Changed"/>
                                            <RadioButton x:Name="MpActNew" Style="{StaticResource Sh.MpConflictOpt}"
                                                         GroupName="mpconflict" Content="作为新实例安装（自动加序号）"
                                                         Margin="12,0,0,8" Checked="MpConflictAction_Changed"/>
                                            <RadioButton x:Name="MpActUpdate" Style="{StaticResource Sh.MpConflictOpt}"
                                                         GroupName="mpconflict" Content="更新现有实例"
                                                         Checked="MpConflictAction_Changed"/>
                                            <RadioButton x:Name="MpActOverwrite" Style="{StaticResource Sh.MpConflictOpt}"
                                                         GroupName="mpconflict" Content="覆盖安装" Margin="12,0,0,0"
                                                         Checked="MpConflictAction_Changed"/>
                                        </UniformGrid>
                                        <!-- .select.mp-existing-select（:1669 ＋ :2601）：margin-top space-1 4，
                                             同样叠父级 gap 8 ＝ 12；选项＝同目录下冲突实例（＋「同一整合包版本」后缀） -->
                                        <ComboBox x:Name="MpExistingSelect" FontSize="14" Margin="0,12,0,0"
                                                  Visibility="Collapsed"/>
                                        <!-- .mp-impact（:1674 ＋ :2604-2612）：padding 8 / radius 6 / card-2 底 /
                                             line-height 1.55；.danger（覆盖安装时，:2610）字色转 danger。
                                             两段文案照 :1676 与 :1679 原文，由代码按 conflictAction 二选一。 -->
                                        <Border x:Name="MpImpact" Style="{StaticResource Sh.MpImpact}"
                                                Margin="0,8,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="MpImpactText" TextWrapping="Wrap" LineHeight="19"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{DynamicResource Fg2}"/>
                                        </Border>
                                        <!-- .mp-replace-confirm（:1682 ＋ :2564-2577）：与 conflict-actions 的 label 同一条规则，
                                             文案照 :1684（「更新」／「覆盖」随 conflictAction 变） -->
                                        <CheckBox x:Name="MpReplaceConfirm" Style="{StaticResource Sh.MpReplaceConfirm}"
                                                  Margin="0,8,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="MpReplaceConfirmText" TextWrapping="Wrap"
                                                       LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>

                                <!-- .mp-keysync-opt（:1690 ＋ :2578-2593）：出现条件＝包内有作者预设键位
                                     且设置里开了默认按键同步；文案照 :1692 原文 -->
                                <CheckBox x:Name="MpKeysyncOpt" Style="{StaticResource Sh.MpKeysyncOpt}"
                                          Visibility="Collapsed">
                                    <TextBlock Text="该整合包含作者预设键位（options.txt）。用启动器默认按键替换预设键位；其余设置保留。不勾选则保留作者预设。"
                                               TextWrapping="Wrap" LineHeight="18"
                                               LineStackingStrategy="BlockLineHeight"/>
                                </CheckBox>

                                <!-- .mp-error（:1695／:1698 ＋ :2613-2618）：13px danger / line-height 1.7 / break-all。
                                     原版这条没有 margin（* 复位把 p 的边距清成 0），所以紧贴上一块，
                                     这里不额外补间距。两条各占一个：名称冲突提示 ＋ 通用错误 -->
                                <TextBlock x:Name="MpNameError" Style="{StaticResource Sh.MpError}"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="MpErrorText" Style="{StaticResource Sh.MpError}"
                                           Visibility="Collapsed"/>

                                <!-- .mp-actions（:1700 ＋ :2619-2624）：flex 右对齐 / gap 12 / margin-top 24 -->
                                <StackPanel Style="{StaticResource Sh.MpActions}">
                                    <Button Content="取消" Style="{StaticResource BtnGhost}" Click="Mp_Cancel_Click"/>
                                    <Button Content="确认导入" Style="{StaticResource BtnGold}" Margin="12,0,0,0"
                                            Click="Mp_Confirm_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 解析失败分支（:1707-1712）：.mp-error ＋ .mp-actions（只有一颗关闭钮） -->
                            <StackPanel x:Name="MpErrorBody" Visibility="Collapsed">
                                <TextBlock x:Name="MpFatalError" Style="{StaticResource Sh.MpError}"/>
                                <StackPanel Style="{StaticResource Sh.MpActions}">
                                    <Button Content="关闭" Style="{StaticResource BtnGhost}" Click="Mp_Cancel_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
