                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="DlRowSub" Style="{StaticResource Sh.DlSub}"/>
                                        <Border Style="{StaticResource Sh.DlBar}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="DlBarFillCol" Width="35*"/>
                                                    <ColumnDefinition x:Name="DlBarRestCol" Width="65*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="DlRowBarFill" Grid.Column="0"
                                                        Style="{StaticResource Sh.DlBarFill}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel x:Name="DlStagesHost" Margin="0,14,0,0">
                                            <Border x:Name="DlStageShell" Style="{StaticResource Sh.DlStage}"
                                                    Visibility="Collapsed">
                                                <StackPanel>
                                                    <Grid Style="{StaticResource Sh.DlStageHeading}">
                                                        <!-- space-between gap 8：标签列 *，状态列 Auto，中间 8 -->
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="DlStageLabel" Grid.Column="0"
