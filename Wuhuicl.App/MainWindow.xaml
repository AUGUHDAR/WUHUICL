                                                <!-- cancelling：单颗禁用钮（:1462） -->
                                                <Button x:Name="DlRowCancelling" Style="{StaticResource Sh.BtnSmFloat}"
                                                        Content="正在取消&#x2026;" IsEnabled="False"
                                                        Visibility="Collapsed"/>
                                                <!-- done / cancelled / error：.dl-dismiss（:1465），内容是「×」，
                                                     line-height 1 → 字形高就是行高 -->
                                                <Button x:Name="DlRowDismiss" Style="{StaticResource Sh.DlDismiss}"
                                                        Margin="4,0,0,0" Visibility="Collapsed"
