                                                                   Foreground="{DynamicResource Fg}"/>
                                                        <TextBlock x:Name="DlStageState" Grid.Column="2"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Fg2}"/>
                                                    </Grid>
                                                    <TextBlock x:Name="DlStageDetail"
                                                               Style="{StaticResource Sh.DlStageDetail}"/>
                                                    <Border Style="{StaticResource Sh.DlStageBar}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition x:Name="DlStageBarFillCol" Width="0*"/>
                                                                <ColumnDefinition x:Name="DlStageBarRestCol" Width="100*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="1.5"
                                                                    Background="{DynamicResource BarFill}"
                                                                    HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
