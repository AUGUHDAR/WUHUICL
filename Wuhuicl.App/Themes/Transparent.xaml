<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 主题「默认·黑紫」(transparent)。源 token 逐字取自 KAMUCL types.ts，派生按原版公式计算。 -->
  <Color x:Key="C.Bg">#232323</Color>
  <Color x:Key="C.Nav">#181818</Color>
  <Color x:Key="C.Card">#282828</Color>
  <Color x:Key="C.CardSoft">#272727</Color>
  <Color x:Key="C.Line">#3f3f3f</Color>
  <Color x:Key="C.Fg">#f5f5f5</Color>
  <Color x:Key="C.Fg2">#b4b4b4</Color>
  <Color x:Key="C.Fg3">#797979</Color>
  <Color x:Key="C.Accent">#9475ed</Color>
  <Color x:Key="C.AccentHi">#b29cf2</Color>
  <Color x:Key="C.AccentLo">#735bb9</Color>
  <Color x:Key="C.AccentFg">#ffffff</Color>
  <Color x:Key="C.Ok">#68dc88</Color>
  <Color x:Key="C.Warn">#f0b55a</Color>
  <Color x:Key="C.Danger">#ff6b73</Color>
  <Color x:Key="C.Cyan">#9ed7e9</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
  <SolidColorBrush x:Key="NavBg" Color="{StaticResource C.Nav}"/>
  <SolidColorBrush x:Key="Card" Color="{StaticResource C.Card}"/>
  <SolidColorBrush x:Key="CardSoft" Color="{StaticResource C.CardSoft}"/>
  <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}"/>
  <SolidColorBrush x:Key="Fg" Color="{StaticResource C.Fg}"/>
  <SolidColorBrush x:Key="Fg2" Color="{StaticResource C.Fg2}"/>
  <SolidColorBrush x:Key="Fg3" Color="{StaticResource C.Fg3}"/>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
  <SolidColorBrush x:Key="AccentHi" Color="{StaticResource C.AccentHi}"/>
  <SolidColorBrush x:Key="AccentLo" Color="{StaticResource C.AccentLo}"/>
  <SolidColorBrush x:Key="AccentFg" Color="{StaticResource C.AccentFg}"/>
  <SolidColorBrush x:Key="Ok" Color="{StaticResource C.Ok}"/>
  <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}"/>
  <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}"/>
  <SolidColorBrush x:Key="Cyan" Color="{StaticResource C.Cyan}"/>
  <SolidColorBrush x:Key="BorderStrong" Color="#808080"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#249475ED"/>
  <SolidColorBrush x:Key="Hover" Color="#12F5F5F5"/>
  <SolidColorBrush x:Key="HeroChipBg" Color="#7A090D0E"/>
  <SolidColorBrush x:Key="LoaderFg" Color="#FFF6FFF8"/>
  <SolidColorBrush x:Key="Overlay" Color="#B8020506"/>
  <!-- BEGIN 运行时派生色（tools/gen_theme_mixins.py 生成，勿手改） -->
  <Color x:Key="C.NavActiveFg">#E5E1F4</Color>
  <SolidColorBrush x:Key="NavActiveFg" Color="{StaticResource C.NavActiveFg}"/>
  <LinearGradientBrush x:Key="NavPill" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#1D9475ED"/>
    <GradientStop Offset="1" Color="#12F5F5F5"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentHiSoft" Color="#57B29CF2"/>
  <SolidColorBrush x:Key="OkSoft" Color="#2168DC88"/>
  <SolidColorBrush x:Key="CyanSoft" Color="#219ED7E9"/>
  <SolidColorBrush x:Key="DangerSoft" Color="#21FF6B73"/>
  <SolidColorBrush x:Key="DangerBorder" Color="#57FF6B73"/>
  <SolidColorBrush x:Key="ChipBg" Color="#24B4B4B4"/>
  <SolidColorBrush x:Key="AccentPick" Color="#0D9475ED"/>
  <SolidColorBrush x:Key="Accent16" Color="#299475ED"/>
  <SolidColorBrush x:Key="Accent8" Color="#149475ED"/>
  <SolidColorBrush x:Key="DragTint" Color="#2E9475ED"/>
  <Color x:Key="C.CheckBorder">#8B8B8B</Color>
  <SolidColorBrush x:Key="CheckBorder" Color="{StaticResource C.CheckBorder}"/>
  <Color x:Key="C.CheckBorderOn">#6A5A96</Color>
  <SolidColorBrush x:Key="CheckBorderOn" Color="{StaticResource C.CheckBorderOn}"/>
  <SolidColorBrush x:Key="CheckBgOn" Color="#0D9475ED"/>
  <SolidColorBrush x:Key="LoaderBg" Color="#9F52487F"/>
  <SolidColorBrush x:Key="LogBody" Color="#6B232323"/>
  <SolidColorBrush x:Key="Idle" Color="#FF9CA3AF"/>
  <LinearGradientBrush x:Key="BarFill" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="{StaticResource C.AccentHi}"/>
    <GradientStop Offset="1" Color="{StaticResource C.Accent}"/>
  </LinearGradientBrush>
  <!-- END 运行时派生色 -->
  <SolidColorBrush x:Key="Scroll" Color="#52B4B4B4"/>

  <LinearGradientBrush x:Key="WindowGrad" StartPoint="0,0" EndPoint="0.35,1">
    <GradientStop Offset="0" Color="#252525"/>
    <GradientStop Offset="1" Color="#28262d"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="{StaticResource C.AccentHi}"/>
    <GradientStop Offset="0.55" Color="{StaticResource C.Accent}"/>
    <GradientStop Offset="1" Color="{StaticResource C.AccentLo}"/>
  </LinearGradientBrush>

  <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270"
                    Opacity="0.16" Color="#000000"/>
  <DropShadowEffect x:Key="PopShadow" BlurRadius="55" ShadowDepth="20" Direction="270"
                    Opacity="0.42" Color="#000000"/>
  <!-- .loader-option.active 的 box-shadow 0 0 14px accent 12%（GameView.vue:1501，1.1.10 新增）：
       本工程 CSS blur 与 WPF BlurRadius 按 1:1 换算，与 PopShadow 同一口径；
       ShadowDepth 0 ＝ CSS 的 offsets 全 0，透明度取 12% 而不是写角色彩。 -->
  <DropShadowEffect x:Key="LoaderGlow" BlurRadius="14" ShadowDepth="0" Opacity="0.12"
                    Color="{StaticResource C.Accent}"/>
</ResourceDictionary>
