    <!-- ============ 首页 hero ============ -->
    <!-- .hero-kicker：min-height 34 / padding 5 10 / radius 7 / 12px/650 / 深色玻璃底 -->
    <Style x:Key="HeroKicker" TargetType="Border">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="#7A090D0E"/>
        <Setter Property="BorderBrush" Value="#21FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- .loader-badge：padding 5 11 / radius 999 / 11px/650 — HomeView.vue:831
         首页 hero 的「原版」「正式版」徽章；radius 999 在浏览器里收缩成 min(高,宽)/2≈12，用 Pill 复现 -->
    <Style x:Key="LoaderBadge" TargetType="Border">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="ctl:CssRadius.Pill" Value="True"/>
        <!-- 底色是主题派生的 accent 30%（HomeView.vue:831），不能写死成黑紫那一套的值，
             否则蓝白/橙黑主题下徽章会变成一块不相干的深色 -->
        <Setter Property="Background" Value="{DynamicResource LoaderBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource LoaderFg}"/>
        <!-- 边框是 color-mix(accent-2 34%, transparent)，不是 accent-soft（HomeView.vue:831） -->
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHiSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- .hero-settings：52 高，左半圆角 10 -->
    <Style x:Key="HeroSettings" TargetType="Button">
        <Setter Property="Height" Value="52"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFF4F7F5"/>
        <Setter Property="Background" Value="#940A1011"/>
        <Setter Property="BorderBrush" Value="#24FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10,0,0,10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C2131D1D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeroBtn" TargetType="Button" BasedOn="{StaticResource HeroSettings}"/>

    <!-- .hero-more：52×52，右半圆角 10，左边框由前一个按钮提供 -->
    <Style x:Key="HeroMore" TargetType="Button" BasedOn="{StaticResource HeroSettings}">
        <Setter Property="Width" Value="52"/>
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0,1,1,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,10,10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C2131D1D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .launch-progress：覆盖在启动按钮左侧的半透明白，宽度即百分比 -->
    <Style x:Key="LaunchProgress" TargetType="ProgressBar">
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="Foreground" Value="#73FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .launch-main：min-height 56 / 21px/800 / 左半 radius 14，进度是半透明白覆盖层 -->
    <Style x:Key="LaunchMain" TargetType="Button">
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="14,0,0,14" ClipToBounds="True">
                        <Grid>
                            <ProgressBar x:Name="prog" Value="{Binding Progress}" Maximum="100"
                                         Style="{StaticResource LaunchProgress}"
                                         VerticalAlignment="Stretch"
                                         Visibility="{Binding Busy, Converter={StaticResource BoolVis}}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.94"/>
                        </Trigger>
                        <!-- 原版禁用态是 filter:saturate(.75)，按钮仍然实心；
                             用 0.45 透明度会把整块（含白字）洗成灰，视觉差很远 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .launch-arrow：48 宽，右半 radius 14，左侧 1px 分隔线 -->
    <Style x:Key="LaunchArrow" TargetType="Button">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="0,14,14,0">
                        <Border BorderBrush="#38FFFFFF" BorderThickness="1,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.94"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .runtime-item：padding 10 12，hover 出 accent-soft 浮块（radius 12，上下各缩 4px） -->
    <Style x:Key="RuntimeCell" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12"
                            Margin="4,0" Padding="12,10">
                        <Grid>
                            <!-- .runtime-blob：accent 10% 的浮块，opacity 180ms + scale .97→1 200ms -->
                            <Border x:Name="hv" Background="{DynamicResource AccentSoft}" CornerRadius="12"
                                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Border.RenderTransform>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- .runtime-item:hover { color: accent-2 }（HomeView.vue:873）：
                                 只有继承色的 strong 会变，small 与首个 svg 各自有显式色 -->
                            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="hv"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="hv"
                                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="hv"
                                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="hv"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="hv"
                                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0.97"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="hv"
                                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0.97"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CellBtn" TargetType="Button" BasedOn="{StaticResource RuntimeCell}"/>

    <!-- .instance-play：40×34，radius 8 -->
    <Style x:Key="SquareBtn" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <!-- .instance-play 的图标色是 accent-2（HomeView.vue:909） -->
        <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 列表 ============ -->
    <Style x:Key="CardList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .home-dashboard .instance-card：min-height 72 / padding 12 / 无圆角无描边，只留底边线 -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <ContentPresenter Margin="12" MinHeight="48" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .version-row：min-height 42 / padding 8 12 / radius 10 / hover card-2 -->
    <Style x:Key="RowCard" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" Margin="0,2" CornerRadius="10" Padding="12,8">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CardSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 输入 ============ -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
        <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>

    <!-- .switch：40×22，滑块 14，左边距 3，选中位移 18 → 21（原版 translate(18px,-50%) 从 3 起） -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="track" Width="40" Height="22" CornerRadius="11"
                            Background="{DynamicResource CardSoft}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <Ellipse x:Name="knob" Width="14" Height="14" Fill="{DynamicResource Fg2}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 原版选中态是纯色 accent（styles.css:396-399），不是 accent-grad -->
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                            <Setter TargetName="knob" Property="Margin" Value="21,0,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{DynamicResource CardSoft}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <!-- 箭头内联画，不依赖图标字典的合并顺序 -->
                            <Path Grid.Column="1" Style="{StaticResource IconStroke}"
                                  Data="M6,9 L12,15 L18,9" StrokeThickness="2"
                                  Width="14" Height="14" Stretch="Uniform" Margin="8,0,0,0"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"/>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="10" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="300" Margin="0,4,0,0" Padding="8">
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .select-menu-option：min-height 42 / padding 4 12 / radius 6 -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .float-menu 菜单项：min-height 34 / padding 0 10 / radius 7 / 12px -->
    <Style x:Key="MenuItem2" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                <!-- .menu-item:hover / .active：底 accent-soft、字 accent-2（styles.css:618-624） -->
                <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PopupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <!-- .theme-option：48 高，preview 46×32，radius 6 -->
    <Style x:Key="ThemeChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{DynamicResource CardSoft}" MinHeight="48"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <!-- .theme-option.active .theme-label：字色是 accent 本体、600（SettingsView.vue:1578-1580），
                                 与 .capsule.active 用 accent-2 不同，别混用 -->
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 进度条 / 滚动条 ============ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <!-- .dl-bar-fill / .mem-slider-fill 的底是 90° 两停 accent-2→accent，
             不是 135° 三停的 accent-grad（App.vue:2281、SettingsView.vue:1719） -->
        <Setter Property="Foreground" Value="{DynamicResource BarFill}"/>
        <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Rectangle x:Name="PART_Indicator" RadiusX="3" RadiusY="3"
                                       HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动条槽固定 8px（对应 ::-webkit-scrollbar{width:8px;height:8px}） -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Scroll}" CornerRadius="4"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
