<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Wuhuicl.App"
                    xmlns:ctl="clr-namespace:Wuhuicl.App.Controls">

    <!-- 尺寸一律取 docs/UI_GEOMETRY_HOME.md 的实测值，不要凭感觉调（CSS 变量名去掉前缀写）：
         ctl-h 36 / row-h 42 / space-* 4·8·12·16·24·32·48 / text-* 12·13·14·16·20·26
         radius-sm 6 radius-md 10 radius-lg 14；hero 20、状态条 15、导航项 48、子项 40
         这里不设 FontFamily：隐式样式会压过属性继承，图标字符会被换成中文字体渲染成豆腐块。 -->

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <local:BoolVis x:Key="BoolVis"/>
    <local:InvertBool x:Key="InvBool"/>
    <local:CountVis x:Key="CountVis"/>
    <local:BrushByKey x:Key="BrushByKey"/>
    <local:StyleByKey x:Key="StyleByKey"/>

    <!-- 这里绝不能设 Foreground：样式 setter 的优先级高于属性继承，
         会把按钮模板里靠继承取色的文字（开始游戏 / 版本设置）压成 Fg 深色。
         前景色由 Window.Foreground 继承下来，控件模板各自设。 -->
    <Style TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="PageSub" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
    </Style>
    <!-- .instances-head h2 = 17px/750 -->
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Lbl14" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Micro" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
    </Style>

    <!-- ============ 矢量图标底座：82 个描边型 + 8 个实心型 ============ -->
    <!-- 原版 90 处都是 stroke/fill = currentColor，即跟随继承下来的文字色。
         这里等价做法是绑到宿主 ContentControl 的 Foreground（它自己继承自按钮/窗口），
         绝不能写死 Fg——否则启动按钮、行内播放键这类彩底上的图标会变成深色。 -->
    <Style x:Key="IconStroke" TargetType="Path">
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
    <Style x:Key="IconFill" TargetType="Path">
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"/>
        <Setter Property="Stroke" Value="{x:Null}"/>
    </Style>

    <!-- ============ 卡片：.content .card 是平面的（box-shadow:none） ============ -->
    <!-- 样式键名绝不能与主题画刷键同名：StaticResource 从应用资源往回找时先命中主题字典，
         把 SolidColorBrush 赋给 Style 会在解析期抛异常（Card 就踩过，和早先的 Nav 同一类）。
         所以卡片样式叫 Panel，不叫 Card。tools/check_resource_keys.py 会守住这条。 -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="CardTight" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="CardBox" TargetType="Border" BasedOn="{StaticResource Panel}"/>

    <!-- .tag：padding 2/8，radius 999，12px，line-height 1.6，border 1px transparent
         — styles.css:459-472。透明边框不是多余的：CSS 里它照样占 2px 盒高（25.2），
           不给的话 WPF 的标签会矮 4~6，行里看起来比原版小一圈。
           radius 走 CssRadius.Pill：原版的 999 被浏览器收缩成 min(高,宽)/2≈12.6，
           WPF 写死 999 会画成浅透镜（用户点名的"椭圆"）。 -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
        <Setter Property="ctl:CssRadius.Pill" Value="True"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border" BasedOn="{StaticResource Tag}"/>

    <!-- .tag 里的文字：line-height 1.6 决定胶囊高度（12px → 19.2 → 盒 25.2），
         WPF 默认行高只有 ~1.28em，所以每个标签文字都要走这个样式补 LineHeight -->
    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
    </Style>

    <!-- .result-head .tag（CommunityView.vue:1080）压成 11px + border:0 → 行高 11×1.6=17.6 -->
    <Style x:Key="TagTextSm" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <!-- 区块标题前的主题色短竖线在界面里内联画（4×17 radius 2），
         不做成共享 Border 资源：同一个 UIElement 实例不能挂到多个父节点上。 -->

    <!-- ============ 按钮 ============ -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True"
                            CornerRadius="{Binding Path=(ctl:CssRadius.Round), RelativeSource={RelativeSource TemplatedParent}}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <!-- .btn:active = transform: scale(0.985)，140ms ease（styles.css:184-186） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b"
                                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="0.985"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b"
                                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="0.985"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b"
                                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="1"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b"
                                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="1"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .btn-gold：accent 渐变实心 + on-accent 文字 -->
    <Style x:Key="BtnGold" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.94"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BtnGold}"/>

    <!-- .btn-ghost：card-2 底 + 描边 -->
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}"/>

    <!-- .btn-danger：浅红底 + 红字，不实心 -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Overlay}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .btn-sm：32 高（ctl-h 36 减 8），radius radius-sm 6，13px（styles.css:258-263） -->
    <Style x:Key="BtnSm" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ctl:CssRadius.Round" Value="6"/>
    </Style>

    <!-- .btn.btn-sm.btn-ghost：32 高 / 13px / radius 6 / card-2 底 + 描边，hover 描边转强
         （styles.css:220-238 的 .btn-ghost 叠 :258-263 的 .btn-sm，原版版本行每行一个） -->
    <Style x:Key="BtnSmGhost" TargetType="Button" BasedOn="{StaticResource BtnSm}">
        <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .icon-btn：32×32，radius 6，内层 svg 16×16 -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 圆角走 CssRadius.Round，默认 6 = .icon-btn（styles.css:281）；顶栏图标钮要 10 -->
        <Setter Property="ctl:CssRadius.Round" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="{Binding Path=(ctl:CssRadius.Round), RelativeSource={RelativeSource TemplatedParent}}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Grid>
                            <!-- hover 底色用独立覆盖层做透明度渐变：直接动画 Background 会改到共享的主题画刷 -->
                            <Border x:Name="hv" Background="{DynamicResource CardSoft}" Opacity="0"
                                    CornerRadius="{Binding Path=(ctl:CssRadius.Round), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="hv"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.13" Value="1"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="hv"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.13" Value="0"
                                                                  KeySpline="0.25,0.1 0.25,1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                        </Trigger>
                        <!-- .icon-btn:active = scale(0.93)，140ms（styles.css:290-292） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .top-icon-btn：36×36、radius-md 10、底透明、字 text-dim，hover 底 card-2 + 字 text，
         内层 svg 17×17（App.vue:2099-2118）。跟 .icon-btn（32/r6/hover accent-2/15px）不是一种东西，
         之前顶栏直接复用 IconBtn，尺寸、圆角、hover 色全偏。 -->
    <Style x:Key="TopIconBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="ctl:CssRadius.Round" Value="10"/>
        <Style.Triggers>
            <!-- 样式触发器优先级高于模板触发器，所以这里能压住 IconBtn 的 hover accent-2 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .dl-badge：下载数角标，min-width 16 / 高 16 / padding 0 4 / radius 999（=8）/
         底 accent / 字 on-accent 12·700 居中（App.vue:2224-2235）。
         别用 .tag 的 Tag 样式：那是 padding 2 8 + 1px 边框 + line-height 1.6 ≈ 25 高，大一圈。 -->
    <Style x:Key="DlBadge" TargetType="Border">
        <Setter Property="MinWidth" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ 浮层面板（通知 / 更新日志 / 下载中心） ============ -->
    <!-- .notice-panel 基线：radius var(radius) 14、border 1 border、底 card-solid 94%、shadow-lg、overflow hidden
         （App.vue:2176-2195）。宽度与 top/right 各面板不同，写在宿主上。
         原版还有 backdrop-filter blur(24) saturate(130%)：WPF 没有窗口内实时背景模糊，
         这里用不透明 Card 底近似（面板本来就压在内容上），差值记在 UI_LAYERS.md。 -->
    <Style x:Key="FloatPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- .notice-head：flex / space-between / padding 12 16 / 下边线 1（App.vue:2196-2201） -->
    <Style x:Key="FloatPanelHead" TargetType="Border">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- .toast：flex gap 12 / max-width 360 / padding 12 16 / radius 10 / 底 surface-raised /
         border 1 + 左边 3（tone 色）/ shadow-lg / 13px lh 1.5（Toasts.vue:44-56） -->
    <Style x:Key="Toast" TargetType="Border">
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- .spin：加载指示环。原版 14×14、border 2 color-mix(accent 16%)、顶边 accent、50% 圆角
         （GameView.vue:2016 / HomeView.vue:944 / ContentSkeleton.vue）。
         必须挂在 ContentControl 上：WPF 的 Border 没有 Template 属性，样式里给 Template 会报 MC4005。
         旋转动画归 UI_MOTION 待办（0.8s linear infinite）。 -->
    <Style x:Key="Spin" TargetType="ContentControl">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="7" BorderThickness="2"
                                BorderBrush="{DynamicResource AccentSoft}"/>
                        <Path Data="M1,7 A6,6 0 0,1 13,7" Stroke="{DynamicResource Accent}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="{x:Null}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .win-btn：38×36 -->
    <Style x:Key="WinBtn" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CardSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- .win-close:hover = danger 底 + 白字 -->
    <Style x:Key="WinClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinClose}"/>

    <!-- .top-btn：36 高，padding 0 12，13px -->
    <Style x:Key="TopBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
                <!-- .top-btn:hover 的字色是 accent-2 而不是 accent（App.vue:2092） -->
                <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .top-back：36×36（ctl-h）/ radius 6 / card-2 底 / 1px color-mix(border 70%,transparent) /
         字色 text-dim，svg 16×16；hover → 字色 text + 描边 border-strong（App.vue:2033-2058）。
         disabled 只是 opacity .62，WPF 的 IsEnabled=False 会连带压住整块，这里用 Opacity 表达 -->
    <Style x:Key="TopBack" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.62"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 左侧导航 ============ -->
    <!-- .nav-item：48 高 / padding 0 16 / gap 12 / radius 10；hover 与选中都不加底色，
         选中态只画左侧 3px 竖条（原版 inset 3px 0 0 accent），标签 500→600 -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Height" Value="48"/>
        <!-- .nav 是 flex 列且 gap 4（App.vue:1806），每项自带下边距凑出节距 52 -->
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border Background="Transparent" CornerRadius="10"/>
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0" Width="19" Height="19" VerticalAlignment="Center"
                                            Style="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource StyleByKey}}"/>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- .nav-item.active 的字色不是 text 变量本身，而是 text 84% + accent 16%（App.vue:1833） -->
                            <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- .nav-sub-item：40 高，左缩进 32，13px -->
    <Style x:Key="NavSub" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- .nav-parent：与导航项同尺寸，但右侧多一个 14×14 尖角（.nav-caret），
         展开时 rotate(90deg) 0.18s ease（App.vue:1884-1891）。它是展开开关，不是页面。 -->
    <Style x:Key="NavParent" TargetType="ToggleButton">
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0" Width="19" Height="19" VerticalAlignment="Center"
                                            Style="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource StyleByKey}}"/>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            <Viewbox Grid.Column="3" Width="14" Height="14" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="caret" Style="{StaticResource IconStroke}"
                                          Data="M9,6 L15,12 L9,18" StrokeThickness="2"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caret" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 分段/胶囊/搜索：原版同一模式复制了三遍，这里只留一份 ============ -->
    <!-- .game-tab：height 36 / padding 0 20 / radius 6（GameView.vue:2169，覆盖 :1892 的 24 与 ctl-h）。
         选中态的底色与 2px 下划线由 .game-tabs-blob 那层画（见页面里的 TabsBlob），这里只换字色 -->
    <Style x:Key="PillTab" TargetType="RadioButton">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .capsule：height 36 / padding 0 16 / radius 999（GameView.vue:1681-1696）
         原版的 999 在 36 高上被浏览器收缩成 18；字面 999 在 WPF 里是浅透镜，所以显式给 18。
         色：底 card-2、边 border、字 text-dim（不是 .btn 的 text）；hover 只改字色，边框不动
         （:1694-1696 `.capsule:hover{color:var(text)}`，BtnGhost 那条 border-strong hover 要按下来） -->
    <Style x:Key="Capsule" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="ctl:CssRadius.Round" Value="18"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .capsule.active：边 accent、底 accent-soft、字 accent-2（GameView.vue:1700-1704） -->
    <Style x:Key="CapsuleOn" TargetType="Button" BasedOn="{StaticResource Capsule}">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
    </Style>

    <!-- .tool-search：height 36 / padding 0 12 / radius 999 / min-width 180（GameView.vue:1638-1660）
         原版是 div + 内层 input，这里做成 Border 样式，占位文字由页面放 TextBlock -->
    <Style x:Key="ToolSearch" TargetType="Border">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="ctl:CssRadius.Pill" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- .settings-scopes .btn：15px/650 min-height 38 padding 8 18，选中靠底色（SettingsView.vue:1839-1840） -->
    <!-- .settings-scopes .btn：38 高 15px/650 padding 8 18；未选中就是 .btn 默认
         （Card 底 + Line 描边），选中 [aria-current] 换 AccentSoft 底 + accent-2 字、
         边框透明（SettingsView.vue:1839-1840） -->
    <Style x:Key="ScopeTab" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{DynamicResource Card}" CornerRadius="10"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                            <!-- .settings-scopes [aria-current] 的字色是 accent-2（SettingsView.vue:1840） -->
                            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .settings-categories .btn：border 0 radius 6 min-height 32 padding 6 12 13px（:1842） -->
    <Style x:Key="CatPill" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <!-- .settings-categories [aria-current] 字色是 accent（SettingsView.vue:1241 作用域块） -->
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .collapse-head：min-height 42 padding 10 18，右侧 7×7 箭头旋转 45°（:1852 + :1377-1390） -->
    <Style x:Key="CollapseHead" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path Grid.Column="1" x:Name="arrow" Width="8" Height="8" Stretch="Uniform"
                                  Data="M2,6 L8,12 L14,6" Stroke="{DynamicResource Fg2}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="arrow" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .mirror-option：min-height 36 / padding 0 16 / radius 999 / gap 8（SettingsView.vue:1794-1809）。
         单选版：样式有 TargetType，Button 版不能套在 RadioButton 上（会抛样式类型异常） -->
    <Style x:Key="CapsuleRadio" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True" ctl:CssRadius.Pill="True"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <!-- .capsule.active / .mirror-option.active：底 accent-soft、边 accent、字 accent-2
                                 （HomeLayoutEditor.vue:404、GameView.vue:1700、SettingsView.vue:1817-1820） -->
                            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
