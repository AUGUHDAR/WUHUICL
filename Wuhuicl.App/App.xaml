<Application x:Class="Wuhuicl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wuhuicl.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 顺序固定：[0] 控件样式，[1] 色值主题（运行时整体替换），[2] 矢量图标。
                     主题槽必须是 [1]，ThemeManager.ThemeIndex 就按这个位置写死。 -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Transparent.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolVis x:Key="BoolVis"/>
            <local:FavTipConverter x:Key="FavTip"/>
            <local:InvertBool x:Key="InvBool"/>
            <local:CountVis x:Key="CountVis"/>
            <local:BrushByKey x:Key="BrushByKey"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
