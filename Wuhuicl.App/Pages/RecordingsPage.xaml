                    <!-- ····· 空态 ·····
                         .card.empty：text-align center / padding 40（:91，压住全局 .content .empty 的 32 16 — ui-system.css:44），
                         再被 :92 的 .recording-workspace > .empty 收成透明底 / 无边框 / min-height 220 / 无阴影；
                         .empty 本体是 flex column 居中 gap 16（styles.css:515-524）。
                         两条文案按 :75 由 data.entries.length 二选一，常态收起（有 4 条占位数据） -->
                    <Border x:Name="EmptyBlock" MinHeight="220" Padding="40" Background="Transparent"
                            BorderThickness="0" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock x:Name="EmptyTextNoMatch" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg2}" FontSize="14"
                                       Visibility="Collapsed"
                                       Text="没有匹配的录像，请调整搜索或筛选。"/>
                            <!-- 占位：等录像列表接入（这条只在目录真的为空时出，:75；静态四行下永远走上一条） -->
                            <TextBlock x:Name="EmptyTextNoData" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg2}" FontSize="14"
                                       Text="暂无录像。可导入 .mcpr 或 Flashback .zip，或在游戏中完成录制并保存。"/>
                            <!-- v-if data.entries.length 的清除筛选（:75） -->
                            <Button x:Name="ClearFilterBtn" Style="{StaticResource BtnGhost}" Content="清除筛选"
                                    Margin="0,16,0,0" HorizontalAlignment="Center" Visibility="Collapsed"
                                    Click="ClearFilter_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ····· .actions.pagination：v-if pages > 1（:83），每页 40 条（:22）→ 4 条数据恒为 1 页，常态收起。
                         justify-content:center（:91）→ WrapPanel 水平居中；gap 8 沿用 .recording-controls 之外的一层 .actions（:92 的 .actions gap 8） -->
                    <WrapPanel x:Name="PaginationRow" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed">
                        <Button x:Name="PrevPageBtn" Style="{StaticResource BtnGhost}" Content="上一页"
                                Margin="0,0,8,0" IsEnabled="False"/>
                        <TextBlock x:Name="PageText" Text="1 / 1 · 4 个录像" FontSize="14" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Button x:Name="NextPageBtn" Style="{StaticResource BtnGhost}" Content="下一页" IsEnabled="False"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ==================== .card.recording-results（:85，工作区之外） ====================
                 details.card 基线 padding 22（:91）→ :92 收成 padding 12 16；max-height 300 + overflow auto（:91）
                 → MaxHeight 300 配 ScrollViewer（overflow:auto 是按需出槽，不套 §6.5 的常驻槽）。
                 v-if results.length 且带 open 属性（:85）→ 常态收起，正文默认展开 -->
            <Border x:Name="ResultsBlock" Style="{StaticResource Panel}" Padding="12,16" MaxHeight="300"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="ResultsSummary" Style="{StaticResource RecSummary}" FontSize="14"
                                Content="上次操作结果" Tag="ResultsBody" Click="Disclosure_Toggle_Click"/>
                        <StackPanel x:Name="ResultsBody" Margin="0,8,0,0">
                            <!-- 原文是「name：已完成 → path」（:85），箭头段套 .muted.path（12px + text-dim，:91）；
                                 WPF 里 TextBlock 的 Text 属性与 Inlines 互斥，所以整句用 Run 拼 -->
                            <TextBlock FontSize="14" TextWrapping="Wrap">
                                <Run Text="2026-09-30_21-44-07.mp4：已完成"/>
                                <Run FontSize="12" Foreground="{DynamicResource Fg2}"
                                     Text=" → D:\Games\Wuhuicl\recordings\library\2026-09-30_21-44-07.mp4"/>
                            </TextBlock>
                            <!-- .failed{color:danger}（:91）；占位：等 recordings:operate 的返回结果接入（:47） -->
                            <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Danger}"
                                       Text="replay_2026-09-28_19-02-33.mcpr：目标实例正在运行，需先关闭游戏"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ConfirmModal（:86）：本页无自定义模态 → 走 docs §0 的通用 .modal 配方（width min(460, 100vw 减 48) —
                 styles.css:545-555，再被 ui-system.css:38 收 max-width/max-height）。按任务口径本轮不做弹窗，
                 所以「复制到实例」「移入回收站」两个按钮只留确认前的 disabled 态，不铺浮层。 -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
