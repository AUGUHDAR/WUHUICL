            </Button>

            <!-- .page-head{flex column; gap:4} styles.css:498-502；.content .page-head{margin-bottom:space-2=8} ui-system.css:11 -->
            <StackPanel Margin="0,12,0,8">
                <!-- .content .page-title：24px / line-height 1.35 — ui-system.css:12（覆盖 styles.css:503-508 的 20px） -->
                <TextBlock Style="{StaticResource PageTitle}" Text="账号" LineHeight="32.4"/>
                <!-- .page-sub：13px text-dim — styles.css:509-512；标题下 gap 4 -->
                <TextBlock Style="{StaticResource PageSub}" Text="管理微软正版、离线与外置 Yggdrasil 账号"
