                        <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap" LineHeight="19.2"
                                   Margin="0,0,0,12"
                                   Text="通过微软设备代码完成正版授权，武慧启动器不会接触你的微软密码。"/>
                        <!-- 第二段只有 .muted（color text-dim，字号继承 body 14px — styles.css:125-128），无 mode-description -->
                        <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="22.4"
                                   Foreground="{DynamicResource Fg2}"
                                   Text="SSL 证书验证已启用：校验证书链、域名及有效期，证书异常时终止登录。"/>
                        <!-- .ms-btn{flex-shrink:0} — :777-780。面板内三段与按钮之间没有任何 margin，
