                        <StackPanel>
                            <Grid>
                                <!-- .input：min-height 36 / padding 8 12 / radius 10 / 14px
                                     （styles.css:304-317 + ui-system.css:15）；maxlength=16 — :436。
                                     :class 的 input-error（:433，规则 :769-771 = border-color danger）
                                     由 Offline_TextChanged 换 BorderBrush 资源表达 -->
                                <TextBox x:Name="TxtOffline" Style="{StaticResource Input}" FontSize="14"
