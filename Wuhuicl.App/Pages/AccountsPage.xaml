                        </StackPanel>
                        <!-- .add-btn{flex-shrink:0} — :777-780；文案 :445 -->
                        <Button Grid.Column="2" x:Name="BtnAddOffline" Style="{StaticResource BtnGold}"
                                Content="添加离线账号" VerticalAlignment="Top" IsEnabled="False"/>
                        <!-- 占位：等账号功能接入 —— 写库走引擎侧 addOfflineAccount（:54），
                             契约 §5 的白名单里没有这条命令，按钮只做 :442 的禁用态反馈 -->
                    </Grid>

                    <!-- 外置 Yggdrasil：.ygg-panel{display:grid; gap:space-4=16} — :449-513 / :781-784 -->
                    <StackPanel x:Name="PanelYgg" Margin="0,16,0,0">

                        <!-- .provider-head{flex; space-between; align-center; gap:12} — :785-791，模板 :450-461 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <!-- strong 继承 body 14px + UA 加粗（styles.css:125-128）— :452 -->
                                <TextBlock Text="认证提供商" FontSize="14" FontWeight="Bold"/>
                                <!-- .provider-head .mode-description{margin:space-1 0 0 = 4 0 0} — :798-800，
                                     基线 :753-757 的 12px / line-height 1.6 / text-dim -->
                                <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap" LineHeight="19.2"
                                           Margin="0,4,0,0"
                                           Text="可输入 API Root，或把皮肤站卡片、URL、JSON/TXT 配置拖到窗口。"/>
                            </StackPanel>
                            <!-- .provider-head-actions{flex; wrap; justify-end; gap:space-2=8} — :792-797 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- .btn.btn-ghost.btn-sm = 32 高 / padding 4 12 / 13px / radius 6 /
                                     card-2 底 + 描边（styles.css:220-237 + :258-263 + ui-system.css:17）
                                     → 共享键 BtnSmGhost。文案 :457 / :459 -->
                                <Button x:Name="BtnCheckRuntime" Style="{StaticResource BtnSmGhost}"
                                        Content="检查运行组件"/>
                                <Button x:Name="BtnAddProvider" Style="{StaticResource BtnSmGhost}"
                                        Margin="8,0,0,0" Content="添加提供商" Click="AddProvider_Click"/>
                                <!-- 占位：等账号功能接入 —— checkYggdrasilRuntime(:226) 要 prepareYggdrasilRuntime，
                                     契约 §5 未暴露；「添加提供商」按 :459 打开下面的提供商弹窗 -->
                            </StackPanel>
                        </Grid>

                        <!-- .provider-list{grid; gap:space-2=8} — :801-804，模板 :462-477。
                             v-if providers.length → 端口没有提供商数据源（listYggdrasilProviders :148），
                             所以整块按空态收起，只留一行几何正确的行壳（名称与 apiRoot 是数据，留空串）。
                             代码侧克隆时逐行补 0,0,0,8 的下边距表达 gap -->
                        <StackPanel x:Name="ProviderList" Margin="0,16,0,0" Visibility="Collapsed">
                            <Border Style="{StaticResource ProvItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- .provider-item strong{margin-right:space-2=8; font-size:text-sm 13} — :812-815 -->
                                            <TextBlock x:Name="ProviderItemName" Text="" FontSize="13"
                                                       FontWeight="Bold" Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <!-- span.tag.tag-danger — :466 的 v-if provider.insecure：
                                                 .tag（styles.css:459-472）radius 999 / padding 2 8 / 12px / 行高 1.6，
                                                 .tag-danger（:483-486）底 danger-soft + 字 danger -->
                                            <Border Style="{StaticResource Tag}" Visibility="Collapsed">
                                                <TextBlock Text="HTTP 不安全" Style="{StaticResource TagText}"
                                                           Foreground="{DynamicResource Danger}"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- .provider-url{max-width:520; margin-top:space-1=4; ellipsis; mono 12} — :816-823 -->
                                        <TextBlock x:Name="ProviderItemUrl" Style="{StaticResource Micro}"
                                                   FontFamily="{StaticResource MonoFont}" MaxWidth="520"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Text=""/>
                                    </StackPanel>
                                    <!-- .btn.btn-danger.btn-sm「删除」— :469-476 -->
                                    <Button Grid.Column="2" Style="{StaticResource AcBtnSmDanger}"
                                            Content="删除" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- .provider-empty — :824-831，模板 :478：
                             padding 12 / border 1px dashed border / radius-sm 6 / 12px text-dim / 居中。
                             文案里的 littleskin.cn 是模板内联的 code 元素（无专属规则 → UA 等宽 + 继承 12px 与 text-dim） -->
                        <Grid x:Name="ProviderEmpty" Style="{StaticResource AcProviderEmpty}">
                            <Rectangle RadiusX="6" RadiusY="6" SnapsToDevicePixels="True"
                                       Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeDashArray="3 2"/>
                            <TextBlock Style="{StaticResource AcProviderEmptyText}"><Run Text="尚未添加提供商。可直接输入 "/><Run FontFamily="{StaticResource MonoFont}">littleskin.cn</Run><Run Text=" 后探测。"/></TextBlock>
                        </Grid>

                        <!-- .ygg-login-grid{grid-template-columns:1fr 1fr; gap:space-3=12} — :832-836，模板 :480-511 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- label:first-child{grid-column:1/-1} — :843-845 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                <!-- label{grid; gap:space-2=8; color:text-dim; font-size:text-xs 12} — :837-842 -->
                                <TextBlock Style="{StaticResource Micro}" Text="提供商"/>
                                <!-- select.select（:483-488）＝ min-height 36 / padding 8 12（右侧留 32 给箭头）/
                                     radius 10 / card-2 底 / 14px（ui-system.css:15）→ 共享 ComboBox 模板。
                                     v-for providers 无数据源 → 只留 :484 那条 disabled 占位项 -->
                                <ComboBox x:Name="ProviderPick" Margin="0,8,0,0" FontSize="14" SelectedIndex="0">
                                    <ComboBoxItem Content="请选择提供商"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Style="{StaticResource Micro}" Text="账号或邮箱"/>
                                <!-- input.input（:492）：没有 maxlength，不要自己加 -->
                                <TextBox Style="{StaticResource Input}" FontSize="14" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource Micro}" Text="密码"/>
                                <!-- type=password（:499）：WPF PasswordBox 没有共享模板，
                                     外面套一层 .input 度量的 Border（36 高 / padding 8 12 / radius 10 / 14px） -->
                                <Border Margin="0,8,0,0" MinHeight="36" CornerRadius="10" Padding="13,9"
                                        Background="{DynamicResource CardSoft}" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1">
                                    <PasswordBox Background="Transparent" BorderThickness="0" FontSize="14"
                                                 Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                                                 VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <!-- .ygg-login-btn{align-self:end; min-height:36} — :846-849，文案 :509 -->
                            <Button Grid.Row="4" Grid.Column="0" x:Name="BtnYggLogin"
                                    Style="{StaticResource BtnGold}"
                                    VerticalAlignment="Bottom" Content="登录"/>
                            <!-- 占位：等账号功能接入 —— onYggLogin(:259) 要 loginYggdrasil，契约 §5 未暴露 -->
                        </Grid>

                        <!-- .security-note{color:ok; font-size:text-xs 12} — :850-853，文案 :512 -->
                        <TextBlock Style="{StaticResource Micro}" Foreground="{DynamicResource Ok}"
                                   TextWrapping="Wrap" Margin="0,16,0,0"
                                   Text="密码只用于本次认证请求，不会保存；令牌由 Windows 安全存储加密。"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 账号列表卡（.card）— :516-562 ============ -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                <StackPanel>
                    <!-- .section-title 13/700/margin-bottom 12 — :710-715；计数照抄 :518 的 store.accounts.length -->
                    <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,12"
                               Text="{Binding AccountList.Count, StringFormat=我的账号（{0}）}"/>

                    <!-- 空态 .empty.list-empty（模板 :519-521）：
                         .empty{column; center; gap:16; color:text-dim; text-align:center} styles.css:515-524
                         + .content .empty{min-height:120; padding:32 16} ui-system.css:44
                         + .list-empty{padding:space-6 space-5 = 32 24} — :856-858（scoped 与 ui-system 同权重、
                         scoped 注入在后者之后，取 32 24） -->
                    <Border MinHeight="120" Padding="24,32"
                            Visibility="{Binding HasNoAccount, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Micro}" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="还没有账号，先添加一个离线账号或登录微软账号吧"/>
                    </Border>

                    <ListBox Style="{StaticResource CardList}" ItemContainerStyle="{StaticResource AccRowItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding AccountList}" SelectedItem="{Binding SelectedAccount}"
                             Visibility="{Binding HasNoAccount, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- .account-row{flex; align-center; gap:space-3=12} — :864-874；
                                     列序 = 头像 / 12 / meta(*) / 12 / 动作（:530-559 的 DOM 顺序） -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 头像是 Avatar.vue 的根节点，class 是 mc-avatar（不是 .avatar：
                                         AccountsView:883-895 那条 .avatar 选择器在本页匹配不到任何元素，
                                         Vue 的 scoped 只会把 data-v 加到子组件根节点上，类名还得对上，
                                         所以 42 圆圈 + 16px 那套是死代码）。
                                         生效的是 Avatar.vue 自己的两条：
                                         .mc-avatar{width/height 42 内联；border-radius:radius-md=10；
                                         image-rendering:pixelated；flex-shrink:0} — Avatar.vue:53-58
                                         .mc-avatar.letter（无皮肤图那条分支）：居中 flex + 800 + on-accent +
                                         accent 渐变底 + border-radius:50% — :59-67，字号内联 round(42*0.42)=18px -->
                                    <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center">
                                        <Border CornerRadius="10" ClipToBounds="True">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,42,42" RadiusX="10" RadiusY="10"/>
                                            </Border.Clip>
                                            <Image Source="{Binding Avatar}" Width="42" Height="42"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <!-- v-else 的首字母兜底：SkinRenderer.Face（ThemeManager.cs:192）永远返回位图
                                             （无 skin.png 时现算 Steve），所以这条分支在端口里取不到，
                                             几何按 :59-67 建好后收起等接线 -->
                                        <Border x:Name="AvatarLetter" CornerRadius="21" Width="42" Height="42"
                                                Background="{DynamicResource AccentGrad}" Visibility="Collapsed">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource AccentFg}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- .account-meta{flex:1; column; gap:space-1=4; min-width:0} — :896-902 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <!-- .account-name{row; align-center; gap:space-2=8; weight:600; nowrap; overflow:hidden} — :903-910，字号继承 body 14 -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Lbl14}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="300"
                                                       VerticalAlignment="Center"/>
                                            <!-- 账号类型标签：原版按 type 挑 tag-gold / tag-cyan / 无底 — :534-539，
                                                 配色见上面的 AcKindTag / AcKindTagText。
                                                 文案：AccountRow.KindText（:51）是外壳给的标签；
                                                 原版 :316 的 yggdrasil 是「外置 · 提供商名」，KindText 目前是「外置登录」，
                                                 差一个字面量，已记进交付说明 -->
                                            <Border Style="{StaticResource AcKindTag}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource AcKindTagText}"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- span.muted.uuid{font-size:text-xs 12; 等宽} — :911-914，
                                             内容是 acc.uuid.slice(0, 8) — :541 -->
                                        <TextBlock Style="{StaticResource Micro}"
                                                   FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0"
                                                   Text="{Binding Model.Uuid, Converter={StaticResource Uuid8}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- .selected-badge{inline-flex; font-size:text-xs 12; color:accent} — :915-921，
                                             显示条件就是 :543 的 selected -->
                                        <TextBlock Text="使用中" FontSize="12" Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolVis}}"/>
                                        <!-- v-else-if selectingId（:544）：切换账号途中的 .spin，
                                             与「使用中」互斥；样式走共享 Spin（styles.css:683-691 的 14×14 环） -->
                                        <ContentControl Style="{StaticResource Spin}" Visibility="Collapsed"/>
                                        <!-- 验证会话（:545-552）与删除（:553-559）都是 .btn.btn-sm（32 高 /
                                             padding 4 12 / 13px / radius 6）。
                                             验证会话原版只对 yggdrasil 出现（v-if acc.type==='yggdrasil'），
                                             端口目前只能加离线账号 → 先常驻 Collapsed，按 Model.Kind 决定显隐交给代码侧 -->
                                        <Button Style="{StaticResource BtnSmGhost}" Margin="12,0,0,0"
                                                Content="验证会话" Visibility="Collapsed"/>
                                        <Button Style="{StaticResource AcBtnSmDanger}" Margin="12,0,0,0"
                                                Content="删除"/>
                                        <!-- 占位：等账号功能接入 —— onRemove(acc)(:368) 与 onRefreshAccount(:300)
                                             都不在契约 §5 白名单，不挂事件 -->
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <!-- ====================================================================
         三个弹窗：原版全在 Teleport to="body" 里（:565-667），.modal-mask 是 fixed 层，
         所以放在 ScrollViewer 之外。全部默认 Collapsed，显隐与内容交给代码侧（x:Name 已给）。
         blur(10) 需要 MaskBlur.Attach(宿主 Grid, 本层, 壳层, 10) 在打开瞬间快照底层。
         ==================================================================== -->

    <!-- ==================== 弹窗一：微软设备码登录（:566-596） ====================
         .modal.ms-modal（:927-929）text-align:center —— WPF 没有 text-align：
         块级子项各自 HorizontalAlignment=Center，多行文字 TextWrapping + TextAlignment=Center。 -->
    <Border x:Name="ModalMs" Panel.ZIndex="10000" Style="{StaticResource AcModalMask}"
            Visibility="Collapsed">
        <Border Style="{StaticResource AcModal}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <TextBlock Style="{StaticResource AcModalTitle}" Text="微软账号登录"
                               TextAlignment="Center"/>
                    <TextBlock Style="{StaticResource AcMsTip}" TextAlignment="Center"
                               Text="请在浏览器中打开验证地址，输入下方代码完成授权。登录成功后本窗口会自动关闭。"/>

                    <!-- button.user-code（:573-575）：内容是 ms.info.userCode，登录开始前没有值 → 空壳 -->
                    <Button x:Name="MsUserCode" Style="{StaticResource AcUserCode}">
                        <TextBlock x:Name="MsUserCodeText" Text="" FontFamily="{StaticResource MonoFont}"
                                   FontSize="26" FontWeight="Bold"/>
                    </Button>

                    <!-- p.copy-hint.copied（:576-579）：v-if ms.autoCopied，默认不在 → Collapsed。
                         .copied{color:ok}（:964-966）；内层 svg 12×12 stroke-width 3 -->
                    <StackPanel x:Name="MsCopiedHint" Style="{StaticResource AcCopyHint}"
                                Visibility="Collapsed">
                        <ContentControl Width="12" Height="12" VerticalAlignment="Center"
                                        Foreground="{DynamicResource Ok}"
                                        Style="{StaticResource AcIcon.Check}"/>
                        <TextBlock Text="已自动复制到剪贴板，到验证页直接粘贴即可" FontSize="12"
                                   Foreground="{DynamicResource Ok}" Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- p.muted.copy-hint（:580）：v-else 分支，默认就在 -->
                    <StackPanel x:Name="MsCopyHint" Style="{StaticResource AcCopyHint}">
                        <TextBlock Text="点击代码即可复制" FontSize="12"
                                   Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- .ms-uri-row{flex; gap:12} — :967-970；行内 .input{flex:1; min-width:0; font-size:13}
                         与 .btn{flex-shrink:0}（:971-978）。input 是 readonly（:583）
                         → .input[readonly]{opacity:.7; cursor:default}（styles.css:327-331） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MsUri" Style="{StaticResource AcUriInput}" IsReadOnly="True"
                                 Opacity="0.7" Text=""/>
                        <Button Grid.Column="2" x:Name="BtnOpenVerify" Style="{StaticResource BtnGold}"
                                Content="打开验证页面"/>
                    </Grid>

                    <!-- .ms-waiting（:587-590）：v-if ms.waiting，开始轮询才出现 → 收起 -->
                    <StackPanel x:Name="MsWaiting" Style="{StaticResource AcMsWaiting}" Visibility="Collapsed">
                        <ContentControl Style="{StaticResource Spin}"/>
                        <TextBlock Text="正在等待授权完成…" FontSize="14" Foreground="{DynamicResource Fg2}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource AcModalActions}">
                        <Button x:Name="BtnMsCancel" Style="{StaticResource BtnGhost}" Content="取消登录"
                                Click="MsCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>

    <!-- ==================== 弹窗二：外置登录提供商探测与确认（:599-641） ====================
         .modal.provider-modal{width:min(620px, calc(100vw 减 40px))} — :993-995 -->
    <Border x:Name="ModalProvider" Panel.ZIndex="10000" Style="{StaticResource AcModalMask}"
            Visibility="Collapsed" MouseDown="ProviderMask_MouseDown">
        <Border Style="{StaticResource AcModal}" Width="620" MaxWidth="620">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <TextBlock Style="{StaticResource AcModalTitle}" Text="添加外置登录提供商"/>
                    <TextBlock Style="{StaticResource AcMsTip}"
                               Text="支持 API Root、authlib-injector 拖拽 URI，以及武慧启动器提供商 JSON/TXT 文件。"/>

                    <!-- label.provider-input-label（:603-612）：span 标签 + textarea.input.provider-source。
                         原先这段被内联进 ygg 面板，那是模板里没有的结构，已按 :603 搬回弹窗内 -->
                    <StackPanel Style="{StaticResource AcProviderLabel}">
                        <TextBlock Style="{StaticResource Micro}" Text="API Root 或配置内容"/>
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="TxtProviderSource" Style="{StaticResource AcProviderSource}"/>
                            <!-- placeholder :609；textarea 无专属 placeholder 规则，跟 .input::placeholder
                                 同色（text-dim / opacity .7，styles.css:318-321），字号跟正文 12px 等宽 -->
                            <TextBlock x:Name="PhProviderSource" Text="例如：https://littleskin.cn/api/yggdrasil"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="13,9,0,0"
                                       Foreground="{DynamicResource Fg2}" Opacity="0.7"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- label.insecure-confirm（:613-616）：v-if requireInsecure，探测到明文 HTTP 才出现 → 收起。
                         整行 align-items:flex-start → 复选框与文字都顶对齐 -->
                    <Border x:Name="InsecureConfirm" Style="{StaticResource AcInsecure}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AllowInsecure" VerticalAlignment="Top" FontSize="12"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource AcInsecureText}" VerticalAlignment="Top"
                                       Text="我了解 HTTP 会以明文传输账号与密码，仍要连接该服务"/>
                        </Grid>
                    </Border>

                    <!-- p.provider-error（:617）：v-if error 才渲染 → 收起，文案代码侧填 -->
                    <TextBlock x:Name="ProviderError" Style="{StaticResource AcProviderError}" Text=""/>

                    <!-- .provider-preview（:618-626）：v-if candidate → 默认收起。
                         六行的左列标签是模板里的字面量（:619-624），值全在 candidate 上 → 值留空由代码填。
                         行 grid = 108px + minmax(0,1fr)、gap 8（:1035-1040）；行间距 8 由外层 StackPanel 的下边距表达 -->
                    <Border x:Name="ProviderPreview" Style="{StaticResource AcProviderPreview}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource AcPreviewKey}" Text="名称"/>
                                <TextBlock Grid.Column="2" x:Name="PreviewName" Style="{StaticResource AcPreviewStrong}" Text=""/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource AcPreviewKey}" Text="API Root"/>
                                <TextBlock Grid.Column="2" x:Name="PreviewApiRoot" Style="{StaticResource AcPreviewCode}" Text=""/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource AcPreviewKey}" Text="Auth Server"/>
                                <TextBlock Grid.Column="2" x:Name="PreviewAuthServer" Style="{StaticResource AcPreviewCode}" Text=""/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource AcPreviewKey}" Text="Account Server"/>
                                <TextBlock Grid.Column="2" x:Name="PreviewAccountServer" Style="{StaticResource AcPreviewCode}" Text=""/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource AcPreviewKey}" Text="Session Server"/>
                                <TextBlock Grid.Column="2" x:Name="PreviewSessionServer" Style="{StaticResource AcPreviewCode}" Text=""/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource AcPreviewKey}" Text="Skin Domains"/>
                                <TextBlock Grid.Column="2" x:Name="PreviewSkinDomains" Style="{StaticResource AcPreviewCode}" Text=""/>
                            </Grid>
                            <!-- p.ali-note（:625）：v-if candidate.aliRedirected → 收起，文案是字面量 -->
                            <TextBlock x:Name="PreviewAliNote" Style="{StaticResource AcAliNote}"
                                       Text="已按 ALI 标头解析到实际 API Root。"/>
                        </StackPanel>
                    </Border>

                    <!-- .modal-actions.provider-actions（:627-639）：三个 .btn（非 sm，36 高 / 14px / radius 10） -->
                    <StackPanel Style="{StaticResource AcModalActions}">
                        <Button x:Name="BtnProviderCancel" Style="{StaticResource BtnGhost}" Content="取消"
                                Click="ProviderCancel_Click"/>
                        <Button x:Name="BtnProbe" Style="{StaticResource BtnGhost}" Margin="12,0,0,0"
                                Content="识别并校验"/>
                        <Button x:Name="BtnProviderSave" Style="{StaticResource BtnGold}" Margin="12,0,0,0"
                                Content="确认保存"/>
                        <!-- 占位：等账号功能接入 —— probeYggdrasilProvider(:181) 与
                             saveYggdrasilProvider(:201) 都不在契约 §5 白名单 -->
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>

    <!-- ==================== 弹窗三：多角色选择（:644-666） ====================
         .profile-modal（:645）在 :671-1094 的样式块里没有任何规则，纯 hook → 宽度走共享 .modal 460 -->
    <Border x:Name="ModalProfile" Panel.ZIndex="10000" Style="{StaticResource AcModalMask}"
            Visibility="Collapsed">
        <Border Style="{StaticResource AcModal}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <!-- 标题是插值「选择 {{ providerName }} 角色」— :646，端口没有 providerName 数据源，
                         整句由代码侧写进 ProfileTitle（默认按空串渲染成「选择 角色」的骨架） -->
                    <TextBlock x:Name="ProfileTitle" Style="{StaticResource AcModalTitle}" Text="选择 角色"/>
                    <TextBlock Style="{StaticResource AcMsTip}"
                               Text="此账号拥有多个角色，请选择本次要保存并启动的角色。"/>

                    <!-- .profile-options{grid; gap:space-2=8; margin-top:space-4=16} — :1057-1061。
                         行数 = profileModal.profiles（:649 的 v-for），端口没有角色数据源 →
                         只建一行几何正确的行壳，不编造角色内容。
                         代码侧克隆时逐行补 0,0,0,8 的下外边距（最后一行不给，否则 .modal-actions 的
                         margin-top 24 会变成 32）；选中行整行换成 AcProfileOptionOn（:1074-1077） -->
                    <StackPanel x:Name="ProfileOptions" Margin="0,16,0,0">
                        <Border x:Name="ProfileOptionShell" Style="{StaticResource AcProfileOption}"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- input type=radio（:654）无专属规则 → UA 原生圆点，13×13 -->
                                <RadioButton x:Name="ProfileOptionPick" VerticalAlignment="Center"
                                             GroupName="ProfilePick"/>
                                <!-- span：角色名，14px 继承正文，色 text — :655 -->
                                <TextBlock Grid.Column="2" x:Name="ProfileOptionName" Text="" FontSize="14"
                                           Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <!-- code：profile.id.slice(0, 8) — :656，配色走 :1044-1049 的共用规则
                                     （mono 12 / color text / overflow-wrap anywhere） -->
                                <TextBlock Grid.Column="4" x:Name="ProfileOptionId"
                                           Style="{StaticResource AcPreviewCode}" Text=""/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Style="{StaticResource AcModalActions}">
                        <Button x:Name="BtnProfileCancel" Style="{StaticResource BtnGhost}" Content="取消"
                                Click="ProfileCancel_Click"/>
                        <Button x:Name="BtnProfileUse" Style="{StaticResource BtnGold}" Margin="12,0,0,0"
                                Content="使用此角色"/>
                        <!-- 占位：等账号功能接入 —— selectYggdrasilProfile(:285) 不在契约 §5 白名单 -->
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
    </Grid>
</UserControl>
