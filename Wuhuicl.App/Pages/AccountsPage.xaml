                            </Grid>
                            <!-- p.field-error{margin-top:space-2=8; font-size:text-xs 12; color:danger} — :772-776 -->
                            <TextBlock x:Name="ErrOffline" FontSize="12" Foreground="{DynamicResource Danger}"
