<UserControl x:Class="Wuhuicl.App.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Wuhuicl.App.Controls"
             xmlns:p="clr-namespace:Wuhuicl.App.Pages">

    <!-- 账号页复刻 KAMUCL-1.1.5/src/renderer/src/views/AccountsView.vue（模板 :384-668，样式 :671-1094）。
         几何一律取"最终生效值"：ui-system.css 的 .content 覆盖块（:10/:11/:12/:15/:17/:44）与
         styles.css 的共享类（.btn .input .select .tag .modal .modal-mask .modal-actions .empty .spin .muted）
         都压在各页 scoped 之上或之前，逐条在下面注出处。
         本页私有样式键一律 Ac/Acc 前缀（契约 §4：与主题画刷裸名撞车会在加载期抛异常）。
         注释里不写 CSS 自定义属性名的双横杠前缀（XAML 注释不允许连续两个减号，MC3000）。

         本轮补的缺口（机器台账 23 个未命中类）全部落在三个 Teleport 弹窗上：
         .modal-mask/.modal/.modal-title/.modal-actions/.ms-modal/.ms-tip/.user-code/.copy-hint/.copied/
         .ms-uri-row/.ms-waiting/.provider-modal/.provider-input-label/.provider-source/.insecure-confirm/
         .provider-error/.provider-preview/.ali-note/.provider-actions/.profile-modal/.profile-options/
         外加页内的 .provider-empty/.add-btn/.ms-btn/.remove-btn/.input-error/.spin/.tag-gold/.tag-cyan。 -->
    <UserControl.Resources>

        <!-- .account-type-tabs button：min-height 36 / padding 0 8 / radius 6 / 12px / text-dim，透明底 — :726-741 -->
        <Style x:Key="AccTab" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- button:hover { color: text } — :742-744 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .account-type-tabs button.active = 实心 accent 渐变 + on-accent + 600 — :745-749 -->
        <Style x:Key="AccTabActive" TargetType="Button" BasedOn="{StaticResource AccTab}">
            <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <!-- 选中项 hover 也必须留在 on-accent，否则继承来的 hover 会把白字染黑 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .back-btn：padding 8 12 / radius 6 / 无边框 / 透明底 / 13px text-dim，hover 出 card-2 + accent-2 — :685-704 -->
        <Style x:Key="AccBack" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .provider-item：min-height 42 / padding 12 / border 1 / radius 10 / card-2 — :805-811
             （display flex + space-between + align center + gap 12 在 :785-791 与 .provider-head 共用） -->
        <Style x:Key="ProvItem" TargetType="Border">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- .account-row：min-height 42 / padding 12 16 / border 1 / radius 10 / card-2 底 — :864-874
             hover 边框 accent-deep（→ AccentLo，styles.css:89 #c2570a 对上 BlackOrange.xaml:14 #c25a11）— :876-878
             选中 = accent 边框 + AccentSoft 底 — :879-882 -->
        <Style x:Key="AccRowItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- .account-list{gap:space-2=8} — :859-863 → 行间隔 8（WPF 无 gap，用行下边距表达） -->
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" MinHeight="42" Padding="16,12" CornerRadius="10"
                                Background="{DynamicResource CardSoft}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLo}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 弹窗骨架 ============ -->
        <!-- .modal-mask（styles.css:527-538）：fixed inset 0 / z 10000 / flex 居中 / 底 mask + blur 10。
             WPF 无视口单位：横向 Padding 24 拿到 min(460, 100vw 减 48)，纵向 48 拿到 calc(100vh 减 96)。
             （ui-system.css:38 又把 max-width/max-height 放宽到 减 32，这里保持与 VpModal 同一套壳几何。）
             backdrop-filter blur(10) XAML 表达不了，要 Services/MaskBlur.cs 在代码里快照底层，
             这里只铺 Overlay 底色（＝原版的 mask 变量）。 -->
        <Style x:Key="AcModalMask" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Overlay}"/>
            <Setter Property="Padding" Value="24,48"/>
        </Style>

        <!-- .modal（styles.css:545-555 + ui-system.css:37）：width min(460, 100vw 减 48) /
             max-height calc(100vh 减 96) / overflow-y auto / 底 surface-raised（取 Card）/
             border 1 / radius-lg 14 / padding space-5=24 / 阴影 lg -->
        <Style x:Key="AcModal" TargetType="Border">
            <Setter Property="Width" Value="460"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
        </Style>

        <!-- .modal-title — :930-934：font-size text-lg 16 / 700 / margin 0 0 space-3=12。
             styles.css 与 ui-system.css 里没有 .modal-title 规则，本页 scoped 就是最终值。
             h3 的 UA 版式（1.17em + 上下 margin）被 :671 之后的这条与 * { margin:0 }（styles.css:111）一起抹掉。 -->
        <Style x:Key="AcModalTitle" TargetType="TextBlock" BasedOn="{StaticResource Lbl14}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- p.muted.ms-tip — :935-938：font-size text-sm 13（scoped 压过 ui-system 的正文 14）/ line-height 1.6；
             .muted（styles.css:677-679）只给 color text-dim → Micro 已带 Fg2 -->
        <Style x:Key="AcMsTip" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20.8"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- button.user-code — :939-952：margin space-4 auto space-2（inline-block 的 auto 归 0，
             居中靠 .ms-modal 的 text-align:center :927-929）→ 上 16 下 8；
             padding space-4 space-5 = 16 纵向 / 24 横向，加 1px 边框（box-sizing border-box styles.css:111）
             → 内容内缩 25,17；border 1px dashed accent / radius-md 10 / 底 accent-soft / 字 accent-2 /
             mono / text-2xl 26 / 700 / letter-spacing 4px / cursor pointer。
             hover 底 = color-mix(accent 22%, transparent) — :953-955，主题字典没有 22% 档，
             取最接近的 Accent16（16%），差值记进已知偏差。
             letter-spacing 4px WPF 的 TextBlock 没有字距属性，表达不了（同 HomePage:486、SkinsPage 的处理）。 -->
        <Style x:Key="AcUserCode" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
            <Setter Property="Padding" Value="25,17"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Border 画底色与圆角，Rectangle 补 dashed（WPF 的 Border 没有 BorderDashArray）
                             虚线节长是 CSS dashed 的近似，同 SkinsPage.xaml:224-231 的处理 -->
                        <Grid>
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Rectangle RadiusX="10" RadiusY="10" SnapsToDevicePixels="True"
                                       Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"
                                       StrokeDashArray="3 2"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent16}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .copy-hint — :956-963：flex / align center / justify center / gap space-1=4 / 12px /
             margin-bottom space-4=16。flex 项是图标 + 文字，横向排；justify center → 整体居中 -->
        <Style x:Key="AcCopyHint" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- :577 的 svg：viewBox 0 0 24 24 / 12×12 / stroke-width 3 / round cap 的勾。
             图标字典的 Icon.Check（:569）是 stroke-width 2.6，这里是 3，按原样另立一键 -->
        <Style x:Key="AcIcon.Check" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource IconStroke}" StrokeThickness="3"
                                      Data="M20,6 L9,17 L4,12"/>
                            </Canvas>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .ms-uri-row — :967-978：flex / gap space-3=12；行内 .input{flex:1; min-width:0; font-size:text-sm 13}
             （scoped 的 .ms-uri-row .input 压过 ui-system.css:15 给 .input 的 text-md 14）；.btn{flex-shrink:0} -->
        <Style x:Key="AcUriInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- .ms-waiting — :979-985：flex / align center / justify center / gap space-3=12 / margin-top space-4=16 -->
        <Style x:Key="AcMsWaiting" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>

        <!-- .modal-actions — styles.css:557-563 + ui-system.css:40 + 本页 :986-992（三条数值一致）：
             flex / align center / justify flex-end / gap space-3=12 / margin-top space-5=24 / flex-wrap。
             .provider-actions（:1054-1056）只补一条 justify-content:flex-end，与基线同值 → 三个弹窗共用这一键 -->
        <Style x:Key="AcModalActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,24,0,0"/>
        </Style>

        <!-- label.provider-input-label — :996-1002：grid / gap space-2=8 / margin-top space-4=16 /
             color text-dim / font-size text-xs 12（WPF 无 gap → 子项补 8 的上外边距） -->
        <Style x:Key="AcProviderLabel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>

        <!-- textarea.input.provider-source — :1003-1007：min-height 84 / resize vertical /
             font text-xs 12 行高 1.55 等宽；.input 基线（styles.css:304-317）给 min-height 36、
             padding 8 12、radius 10、card-2 底、border 1、color text（字号被本条 shorthand 覆盖） -->
        <Style x:Key="AcProviderSource" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="MinHeight" Value="84"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- 原版 .provider-source 的 line-height:1.55 落不到 WPF 上：TextBox 没有 LineHeight
                 属性（那是 TextBlock 的），样式里写会直接 MC4005。多行等距要换成只读 TextBlock 才能表达，
                 这里保持单行 12px，差值记进台账。 -->
            <Setter Property="SpellCheck.IsEnabled" Value="False"/>
        </Style>

        <!-- label.insecure-confirm — :1008-1019：flex / align-items flex-start / gap space-2=8 /
             margin-top space-3=12 / padding space-3=12 / border 1px solid color-mix(danger 50%, border) /
             radius-sm 6 / color danger / 12px / line-height 1.5。
             主题字典没有 50/50 混合档，取语义最近的 DangerBorder（danger 34%），差值记进已知偏差 -->
        <Style x:Key="AcInsecure" TargetType="Border">
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <!-- .insecure-confirm 里的 span：color danger + 12px + line-height 1.5 由上面继承下来 -->
        <Style x:Key="AcInsecureText" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- .provider-empty — :824-831：padding space-3=12 / border 1px dashed border / radius-sm 6 /
             color text-dim / 12px / text-align center。默认就在（v-else，providers 为空时） -->
        <Style x:Key="AcProviderEmpty" TargetType="Grid">
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <Style x:Key="AcProviderEmptyText" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <!-- padding 12 + 1px 边框（box-sizing border-box）→ 文字内缩 13 -->
            <Setter Property="Margin" Value="13"/>
        </Style>

        <!-- .provider-error — :1020-1025：margin-top space-3=12 / danger / 12px / line-height 1.5 -->
        <Style x:Key="AcProviderError" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- .provider-preview — :1026-1034：grid / gap space-2=8 / margin-top space-4=16 / padding space-3=12 /
             border 1 / radius-md 10 / card-2 底。
             > div（:1035-1040）：grid 108px + minmax(0,1fr) / gap 8 / 12px；
             span（:1041-1043）：color text-dim；
             code（:1044-1049，与 .profile-options code 共用）：overflow-wrap anywhere / color text / mono 12。
             行数是模板里写死的 6 条（:619-624），值来自 candidate → 整块 v-if，默认 Collapsed -->
        <Style x:Key="AcProviderPreview" TargetType="Border">
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <!-- .provider-preview span：12px text-dim -->
        <Style x:Key="AcPreviewKey" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <!-- .provider-preview code：12px 等宽、回到 text 色、超长换行（overflow-wrap anywhere） -->
        <Style x:Key="AcPreviewCode" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- .provider-preview 第一行的值位是 strong（:619）：UA 加粗，12px 继承 div，色 text -->
        <Style x:Key="AcPreviewStrong" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- p.ali-note — :1050-1053：color ok / 12px。grid gap 8 → 上外边距 8 -->
        <Style x:Key="AcAliNote" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- .profile-options label — :1062-1073：grid auto 1fr auto / align center / gap space-3=12 /
             min-height row-h 42 / padding space-2 space-3 = 8 纵向 12 横向 / border 1 / radius-md 10 /
             card-2 底 / cursor pointer；字号未设 → 继承 .modal 里的正文 14px -->
        <Style x:Key="AcProfileOption" TargetType="Border">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <!-- .profile-options label.selected — :1074-1077：border accent + 底 accent-soft -->
        <Style x:Key="AcProfileOptionOn" TargetType="Border" BasedOn="{StaticResource AcProfileOption}">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>

        <!-- .btn.btn-danger.btn-sm.remove-btn — styles.css:239-248 + :258-263 + ui-system.css:17：
             32 高 / padding 4 12 / 13px / radius-sm 6，红字红边不实心（配色沿用共享 BtnDanger）。
             .remove-btn（:922-924）只补一条 flex-shrink:0 -->
        <Style x:Key="AcBtnSmDanger" TargetType="Button" BasedOn="{StaticResource BtnDanger}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ctl:CssRadius.Round" Value="6"/>
        </Style>

        <!-- .tag 的按类型配色（styles.css:473-482）：
             .tag-gold（release/微软）= 底 accent-soft + 字 accent-2；
             .tag-cyan（snapshot/外置）= 底 cyan-soft + 字 cyan；
             离线走 .tag 基线（底 color-mix(text-dim 14%) → ChipBg，字 text-dim）。
             :536 的三元式挑这三个类，AccountRow.Model.Kind 就是 offline|microsoft|yggdrasil -->
        <Style x:Key="AcKindTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model.Kind}" Value="microsoft">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.Kind}" Value="yggdrasil">
                    <Setter Property="Background" Value="{DynamicResource CyanSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AcKindTagText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model.Kind}" Value="microsoft">
                    <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.Kind}" Value="yggdrasil">
                    <Setter Property="Foreground" Value="{DynamicResource Cyan}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 等宽前 8 位：acc.uuid.slice(0, 8) — :541。AccountRow 没暴露截断属性（契约 §5 不许加），
             截断放在这一层做，绑的是真实存在的 Model.Uuid -->
        <p:UuidPrefix x:Key="Uuid8"/>
    </UserControl.Resources>

    <!-- 根层是 Grid：原版的 .modal-mask 是 Teleport 到 body 的 fixed 节点（styles.css:527-530），
         放进 ScrollViewer 会被裁被滚；与 ScrollViewer 平级才铺得满（同 VersionsPage.xaml:282-285 的做法）。
         面板只覆盖 .content 那块（MainWindow.xaml:259 的 Grid Margin 24），
