                             （两个 details.card.group.layout-setting，都没 open → 只有 summary 行：
                             HomeLayoutEditor.vue:183 + :324，scoped :494-499 = padding 0 / summary flex center gap 12
                             padding 14 18 / 14px 600 / small 12px text-dim 400 / ::after '⌄' 靠右、展开转 180°），
                             展开体里的行一律不造。 -->
                        <StackPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <ToggleButton x:Name="BackgroundHead" Style="{StaticResource StLayoutSummary}"
                                                  Padding="18,14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="窗口背景" FontSize="14" FontWeight="SemiBold"/>
                                            <!-- .layout-setting>summary small：12px / text-dim / 400（:498） -->
