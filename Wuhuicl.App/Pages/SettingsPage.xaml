<UserControl x:Class="Wuhuicl.App.Pages.SettingsPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="clr-namespace:Wuhuicl.App.Controls"
               Loaded="SettingsPage_Loaded">

    <!-- 版式来源：SettingsView.vue（模板 :592-1230，样式 :1232-1892）+ docs/UI_GEOMETRY_PAGES.md §2。
         取最终生效值：@media 之后那串压缩单行规则（:1833-1885）优先级同级但源码在后，压过前面的基线。
         XAML 注释里不能出现连续两个减号，所以 CSS 变量一律写成 var(space-3) 这种去前缀形式。

         骨架：.settings-page 是 display:grid !important（:1834）
           grid-template-columns minmax(0,1fr) minmax(220px,340px)
           grid-template-rows auto auto auto minmax(0,1fr)，gap 10，padding 0，max-width 1080，position relative
           行1 = page-head(列1) + settings-search(列2)；行2 = settings-scopes；行3 = settings-categories；
           行4 = settings-body（页内滚动）。.settings-navigation 是 display:contents（:1836），
           它自己在 :1233 的 sticky/padding/radius 全都不渲染，所以不做外层卡片。
         导航：2 个 scope（启动器设置 / 游戏设置）+ 8 个分类（settingsCatalog.ts:2-14），
           原版 v-show 一次只显示一个分类的主体（:613 :689 :717 :763 :777 :794 :972 :1019 :1053 :1124），
           这里用「scope 单选 → 外层容器可见性」套「分类单选 → 内层容器可见性」两层声明式切换：
           两个 scope 各用独立 GroupName，等于原版 lastCategories 的按范围记忆选择（:47-49）。 -->

    <UserControl.Resources>
        <!-- .capsule（HomeLayoutEditor 的模式/方式选择胶囊）：30 高 / padding 0 14 / 胶囊圆 /
             底 card-2 描边 13px；选中底 accent-soft + 字 accent（SettingsView:1242 的选中态同款）。
             键名 St 前缀，避免与画刷键同名（契约 §4）。 -->
        <Style x:Key="StCapsule" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="ctl:CssRadius.Pill" Value="True"/>
        </Style>

        <!-- 胶囊选中态：由代码按 Tag 比对设置值切换 -->
        <Style x:Key="StCapsuleOn" TargetType="Button" BasedOn="{StaticResource StCapsule}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
        </Style>


        <!-- .content .page-title = var(text-title) 24px / line-height 1.35（ui-system.css:6 + :12），
             它压过 styles.css:503-508 的 20px；700 字重来自 styles.css:506，契约 §2 也写 24px/Bold。
             24 × 1.35 = 32.4 → 取 32（BridgePage 同款处理）。 -->
        <Style x:Key="StPageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="32"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>

        <!-- .settings-body .group-title：15px（:1853 覆盖 :1334 的 13px）+ margin-bottom 8（:1853），
             字重 700（:1335），line-height 1.5（:1337）→ 15 × 1.5 = 22.5 取 23 -->
        <Style x:Key="StGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- .download-mirror-options .group-title 压回 13px（:1883），margin-bottom 8 仍按 :1853 -->
        <Style x:Key="StGroupTitleSm" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- .settings-body .group-hint：12px / line-height 1.6 / margin 6 0（:1855 覆盖 :1339-1343）；
             .muted 给 text-dim 字色（styles.css:677）。12 × 1.6 = 19.2 取 19（同 TagText 的处理） -->
        <Style x:Key="StGroupHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- .group-error：12px / margin 0 / danger（:1344-1348） -->
        <Style x:Key="StGroupError" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- .feature-row：flex space-between gap 12 / min-height 40 / padding 6 0 / border-bottom 1 border
             （:1400-1408 的 min-height 与 padding 被 :1875 收成 6 0，下边线仍来自 :1407）；
             .feature-row:last-child 无边（:1409） -->
        <Style x:Key="StFeatureRow" TargetType="Border">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <!-- feature-grid 的行间 gap 8 沿用 collapse-body（:1851），CSS gap 用 Margin 表达 -->
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- .feature-section-title：margin 8 0 2 / 12px / text-dim，且 grid-column 1/-1（:1874）；
             上面再加上 grid 的 row-gap 8 → 16 -->
        <Style x:Key="StSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>

        <!-- .upd-row：flex center gap 12 wrap / min-height 38 / margin 0 / padding 6 0
             （:1247 的 padding 8 0 被 :1885 压成 6 0）；行间距 = collapse-body 的 gap 8（:1851），用 Margin 表达 -->
        <Style x:Key="StUpdRow" TargetType="Border">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- .upd-label：宽 84 / flex none / 13px / text-dim（:1248） -->
        <Style x:Key="StUpdLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Width" Value="84"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- .collapse-head：min-height 42 / padding 10 18（:1852），标题在里面 margin 0（:1854）；
             .collapse-head:hover .group-title 转 accent-2（:1374）；标题字重 700（:1335） -->
        <Style x:Key="StCollapseHead" TargetType="ToggleButton" BasedOn="{StaticResource CollapseHead}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 原生 details > summary：.content details>summary 只加了 cursor:pointer（ui-system.css:76），
             UA 的小三角 marker 仍然画出来（只有 .collapse-head 写了 list-style:none，:1368）。
             未展开朝右、展开朝下，marker 用当前文字色（::marker 继承 summary 的字色）。 -->
        <Style x:Key="StSummary" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="mark" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M0,0 L4,4 L0,8 Z" Margin="0,0,6,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                </Path>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .java-detected>summary：padding 10 0 / text-dim / 13px（:1881） -->
        <Style x:Key="StDetectedSummary" TargetType="ToggleButton" BasedOn="{StaticResource StSummary}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>

        <!-- .plugin-row：flex center gap 12 / min-height 42（row-h）/ padding 8 12 / border 1 / radius 10（:1295） -->
        <Style x:Key="StPluginRow" TargetType="Border">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- .java-item：flex center gap 8 / min-height 42 / padding 4 12 / border-top 1 / 13px（:1466-1474） -->
        <Style x:Key="StJavaItem" TargetType="Border">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- .memory-refresh：无描边无底 / accent-2 / 12px / padding 0 / flex none nowrap（:1744-1754 + :1880） -->
        <Style x:Key="StLinkBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- .java-item-hide：无描边无底 / text-dim / 14px（text-md）/ padding 0 4 / radius 6，
             hover 转 danger + danger-soft（:1488-1500） -->
        <Style x:Key="StHideBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="ctl:CssRadius.Round" Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                    <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .input 在设置页里的等宽变体：全局 .mono 给了字体族（styles.css:680-682），
             本页 .mono 又压成 13px（:1822）。PasswordBox 没有全局模板，照 Input 的几何补一份，
             否则高级里那行密钥会是系统白框。 -->
        <Style x:Key="StPassword" TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框的占位文字：WPF 的 TextBox 没有 placeholder，原版是 .input::placeholder
             （字色 text-dim + opacity .7，styles.css:318-321）。这里用覆盖层 TextBlock 复现，
             基础态隐藏，靠各自的 DataTrigger 在宿主 Text 为空时出现。 -->
        <Style x:Key="StPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- .layout-setting>summary：display flex / center / gap 12 / padding 14 18 / 14px 600，
             箭头是 ::after content '⌄' 靠右、文字 dim，展开后 rotate 180（HomeLayoutEditor.vue scoped :495-498）。
             flex 的 summary 不画 UA 三角 marker，所以这条模板里 marker 换成右侧的 ⌄ 字形 -->
        <Style x:Key="StLayoutSummary" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="mark" Text="&#x2304;" FontSize="14"
                                           FontWeight="Normal" Foreground="{DynamicResource Fg2}"
                                           VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .settings-search-results：absolute right 0 / top 48 / z 20 / width min(480px,100%) /
             max-height 60vh + overflow auto / padding 12 / 底 surface-solid(Card) / border 1 / radius 10 / shadow（:1845），
             display grid + gap 8 来自 :1239（:1845 没改 display）。窗口高 860（MainWindow.xaml:8）→ 60vh ≈ 516。
             原版只在查询词非空时渲染（v-if settingsQuery.trim()，:603） -->
        <Style x:Key="StSearchResults" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="480"/>
            <Setter Property="MaxHeight" Value="516"/>
            <Setter Property="Margin" Value="0,48,0,0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <!-- shadow 令牌在主题字典里（PopShadow），契约 §4 要求主题资源一律 DynamicResource；
                 Controls.xaml:353 也是这么用的，共享同一个 Freezable 没问题 -->
            <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1080">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="0" Width="*"/>
            <ColumnDefinition MinWidth="220" MaxWidth="340" Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 行1列1：.page-head（只有 h1，:594-597） ==================== -->
        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource StPageTitle}"
                   VerticalAlignment="Center" Text="设置"/>

        <!-- ==================== 行1列2：.settings-search 里只有一个 input（:600 + :1234-1236）
             原版没有放大镜、没有标签文字，别自己加。占位文字见 StPlaceholder ==================== -->
        <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
            <TextBox x:Name="TxtSearch" Style="{StaticResource Input}"/>
            <TextBlock Text="搜索：内存、Java、动画、下载…">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StPlaceholder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- ==================== 行2：.settings-scopes（:601 + :1838-1840）
             gap 6；按钮 15px/650 min-height 38 padding 8 18，选中靠 AccentSoft 底 + accent-2 字 ==================== -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <RadioButton x:Name="ScopeLauncher" Style="{StaticResource ScopeTab}" Content="启动器设置"
                         GroupName="StScope" IsChecked="True"/>
            <RadioButton x:Name="ScopeGame" Style="{StaticResource ScopeTab}" Content="游戏设置"
                         GroupName="StScope" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- ==================== 行3：.settings-categories（:602 + :1841-1842）
             border-bottom 1 + padding 0 0 8 + gap 4；按钮 border 0 / radius 6 / min-height 32 / padding 6 12 / 13px。
             两个 scope 各一条胶囊行，靠 scope 单选切换可见性（原版 visibleCategories 按 scope 过滤，:46） ==================== -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,10,0,0">
            <Grid>
                <WrapPanel Visibility="{Binding IsChecked, ElementName=ScopeLauncher,
                                               Converter={StaticResource BoolVis}}">
                    <RadioButton x:Name="CatAppearance" Style="{StaticResource CatPill}" Content="外观"
                                 GroupName="StCatLauncher" IsChecked="True"/>
                    <RadioButton x:Name="CatGeneral" Style="{StaticResource CatPill}" Content="行为与登录"
                                 GroupName="StCatLauncher" Margin="4,0,0,0"/>
                    <RadioButton x:Name="CatDownloads" Style="{StaticResource CatPill}" Content="下载"
                                 GroupName="StCatLauncher" Margin="4,0,0,0"/>
                    <RadioButton x:Name="CatFeatures" Style="{StaticResource CatPill}" Content="功能与插件"
                                 GroupName="StCatLauncher" Margin="4,0,0,0"/>
                    <RadioButton x:Name="CatAbout" Style="{StaticResource CatPill}" Content="关于与更新"
                                 GroupName="StCatLauncher" Margin="4,0,0,0"/>
                </WrapPanel>
                <WrapPanel Visibility="{Binding IsChecked, ElementName=ScopeGame,
                                               Converter={StaticResource BoolVis}}">
                    <RadioButton x:Name="CatGame" Style="{StaticResource CatPill}" Content="运行环境"
                                 GroupName="StCatGame" IsChecked="True"/>
                    <RadioButton x:Name="CatDisplay" Style="{StaticResource CatPill}" Content="游戏窗口"
                                 GroupName="StCatGame" Margin="4,0,0,0"/>
                    <RadioButton x:Name="CatDirectories" Style="{StaticResource CatPill}" Content="目录与隔离"
                                 GroupName="StCatGame" Margin="4,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ==================== 行4：.settings-body（:605 + :1843）
             页内滚动、gap 12、padding 2 8 20 0、scrollbar-gutter stable ==================== -->
        <ScrollViewer Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Visible" Padding="0,2,8,20">
            <Grid>

                <!-- .card.empty 读取态（:606-609）：v-if 未加载到设置时才出现。
                     .empty = flex column center gap 16 / padding 32 16 / min-height 120 / text-dim
                     （styles.css:515-522 + ui-system.css:44；.empty 的 padding 在 styles.css 里源码序在 .card 之后，压过 card-pad 20）
                     .spin = 14×14、border 2 accent-soft、上边 accent、radius 50%（styles.css:683-690）；
                     旋转动画按契约 §6.8 留给主控接，这里只出静态环 -->
                <Border Style="{StaticResource Panel}" MinHeight="120" Padding="16,32"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="14" Height="14" HorizontalAlignment="Center">
                            <Ellipse Width="12" Height="12" Stroke="{DynamicResource AccentSoft}" StrokeThickness="2"/>
                            <Path Stroke="{DynamicResource Accent}" StrokeThickness="2" Data="M3,3 A5.6,5.6 0 0 1 11,3"/>
                        </Grid>
                        <TextBlock FontSize="14" Foreground="{DynamicResource Fg2}" TextAlignment="Center"
                                   Margin="0,16,0,0" Text="正在加载设置…"/>
                    </StackPanel>
                </Border>

                <!-- ====================================================== 启动器范围 ====================================================== -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=ScopeLauncher,
                                                 Converter={StaticResource BoolVis}}">

                    <!-- ====================== 分类「外观」：主题 + 减少动态效果(order 1) + 背景(order 2) ====================== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=CatAppearance,
                                                     Converter={StaticResource BoolVis}}">

                        <!-- details.card.group.collapse.open（:613-686）；.collapse padding 0（:1850） -->
