                                            <!-- mode=image 段（:258-357） -->
                                            <StackPanel x:Name="BgImageSection" Visibility="Collapsed">

                                                <!-- .image-preview：图片预览或空态文案（:259-269） -->
                                                <Border x:Name="BgPreviewHost" Height="150" CornerRadius="10"
                                                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                        Background="{DynamicResource CardSoft}" Margin="0,0,0,12"
