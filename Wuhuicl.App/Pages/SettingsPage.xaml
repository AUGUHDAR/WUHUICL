<UserControl x:Class="Wuhuicl.App.Pages.SettingsPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 版式来源：docs/UI_GEOMETRY_PAGES.md §2（SettingsView.vue），取最终生效值：
         .settings-page 是 grid（:1834，display grid !important）
           grid-template-columns: minmax(0,1fr) minmax(220px,340px)
           grid-template-rows: auto auto auto minmax(0,1fr)，gap 10，max-width 1080
         行1 = 页头(列1) + 搜索(列2)；行2 = 范围段；行3 = 分类段（下边线）；行4 = 可滚动主体
         卡片 .card.group padding 14 18（:1849 覆盖 :1331 的 20）；.group-title 15px（:1853）
         折叠卡 .collapse-head min-height 42 padding 10 18（:1852）；.collapse-arrow 7×7 旋转 45°（:1377）
         主题 .theme-options auto-fit minmax(145px,1fr) gap 8（:1862）；.theme-option min-height 48
         padding 6 8 radius 6（:1863）；.theme-preview 46×32 radius 5（:1865）；.tp-check 14×14（:1869）
         内存滑块自绘：轨道 6px，手柄 16×16 带 2px 描边（:1712-1731）
         注释里不写 CSS 变量名的双横杠前缀：XAML 注释不允许连续两个减号。 -->
    <Grid MaxWidth="1080">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="220" Width="*"/>
            <ColumnDefinition MinWidth="220" MaxWidth="340" Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- 行1列1：页头 -->
        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource H1}" Text="设置"/>
            <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,0" Text="改完即存，不需要点保存。"/>
        </StackPanel>

        <!-- 行1列2：.settings-search 里只有一个 input（:1234-1236，:1837 定位到 grid 列 2），
             原版没有放大镜图标 → 别自己加。
             .input：14px（text-md）、min-height 36、padding 8 12、radius 10、底 card-2、边 1 border（styles.css:303-317）
             ::placeholder：text-dim + opacity .7（:318-321） -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,0">
            <TextBox Style="{StaticResource Input}"/>
            <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="14" Opacity="0.7" IsHitTestVisible="False"
                       Foreground="{DynamicResource Fg2}" Text="搜索：内存、Java、动画、下载…"/>
        </Grid>

        <!-- 行2：范围段 .settings-scopes .btn = 15px/650 min-height 38 padding 8 18（:1839） -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <RadioButton Style="{StaticResource ScopeTab}" Content="全局设置" IsChecked="True" GroupName="scope"/>
            <RadioButton Style="{StaticResource ScopeTab}" Content="当前实例" GroupName="scope" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- 行3：分类胶囊 .settings-categories .btn = border 0 radius 6 min-height 32 padding 6 12 13px（:1842） -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,10,0,0">
            <WrapPanel>
                <RadioButton Style="{StaticResource CatPill}" Content="外观" IsChecked="True" GroupName="cat"/>
                <RadioButton Style="{StaticResource CatPill}" Content="运行" GroupName="cat"/>
                <RadioButton Style="{StaticResource CatPill}" Content="下载与网络" GroupName="cat"/>
                <RadioButton Style="{StaticResource CatPill}" Content="账号" GroupName="cat"/>
                <RadioButton Style="{StaticResource CatPill}" Content="游戏目录" GroupName="cat"/>
                <RadioButton Style="{StaticResource CatPill}" Content="关于与更新" GroupName="cat"/>
            </WrapPanel>
        </Border>

        <!-- 行4：.settings-body 页内滚动，gap 12，padding 2 8 20 0（:1843） -->
        <ScrollViewer Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,8,0"
                      VerticalScrollBarVisibility="Visible" Padding="0">
            <StackPanel>

                <!-- ============ 外观 ============ -->
                <!-- 原版是 details.card.group.collapse + summary.collapse-head（SettingsView.vue:660 附近） -->
                <Border Style="{StaticResource Panel}" Padding="0" Margin="0">
                    <StackPanel>
                        <ToggleButton x:Name="ThemeHead" Style="{StaticResource CollapseHead}" Content="主题"
                                      IsChecked="True"/>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=ThemeHead,
                                  Converter={StaticResource BoolVis}}">
                            <StackPanel Margin="18,10,18,14">
                                <TextBlock Style="{StaticResource PageSub}" LineHeight="20" Margin="0,0,0,10"
                                           Text="原版共 6 套，默认「黑紫」。每套只给 9 个源色，其余颜色由原版公式派生（亮度判暗色、accent-2/deep/soft、on-accent 自动黑白）。"/>
                                <!-- .theme-options：auto-fit minmax(145px,1fr) gap 8（:1862）
                                     WPF 无 auto-fit，用 WrapPanel + 固定 152 宽近似（145 下限 + 余量） -->
                                <WrapPanel x:Name="ThemePanel"/>
                                <TextBlock x:Name="TxtThemeNote" Style="{StaticResource Micro}" Margin="0,10,0,0" Text=""/>
                                <!-- .theme-tools：flex justify-between（:1871），提示左、个性化按钮右；
                                     .personalize-btn：accent 边 + accent 字 + AccentSoft 底（:1653-1658） -->
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Micro}" Text="选择基础配色；个性化可继续调整布局、文字和透明度。"
                                               VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource Btn}" MinHeight="32" Padding="12,5"
                                            HorizontalAlignment="Right" Background="{DynamicResource AccentSoft}"
                                            BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource Accent}"
                                            FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Width="15" Height="15" VerticalAlignment="Center"
                                                            Style="{DynamicResource Icon.Sliders}"/>
                                            <TextBlock Text="个性化" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 运行（折叠卡示例，PCL 式） ============ -->
                <Border Style="{StaticResource Panel}" Padding="0" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- .collapse-head：min-height 42 padding 10 18，右侧 7×7 箭头旋转 45° -->
                        <ToggleButton x:Name="MemHead" Style="{StaticResource CollapseHead}" Content="内存与 Java"
                                      IsChecked="True"/>
                        <StackPanel x:Name="MemBody" Visibility="{Binding IsChecked, ElementName=MemHead,
                                  Converter={StaticResource BoolVis}}">
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,10,18,14">
                                <StackPanel>
                                    <!-- .memory-auto-row：grid gap 12 padding 0 0 10 + 下边线（:1878） -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="自动分配内存" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Micro}" Text="按机器空闲内存决定，手动值仅作上限"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                            Padding="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="88"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- .mem-slider：flex:1 height 24；轨道 6px 居中；手柄 16×16 -->
                                            <Grid Height="24" VerticalAlignment="Center">
                                                <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                        Background="{DynamicResource CardSoft}"/>
                                                <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                        HorizontalAlignment="Left" Width="220"
                                                        Background="{DynamicResource BarFill}"/>
                                                <Ellipse Width="16" Height="16" HorizontalAlignment="Left"
                                                         Margin="212,0,0,0" VerticalAlignment="Center"
                                                         StrokeThickness="2" Stroke="{DynamicResource AccentFg}"
                                                         Fill="{DynamicResource Accent}"/>
                                            </Grid>
                                            <TextBox Grid.Column="2" Style="{StaticResource Input}" Width="88"
                                                     Text="2048"/>
                                            <TextBox Grid.Column="4" Style="{StaticResource Input}" Width="88"
                                                     Text="4096"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Style="{StaticResource PageSub}" Text="Java 路径（留空 = 按版本自动选择）"
                                               Margin="0,14,0,0"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtJava" LostFocus="Setting_Changed"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="浏览"
                                                Click="BrowseJava_Click"/>
                                    </Grid>
                                    <!-- .java-list：radius 10 overflow hidden，max-height 200，item min-height 42 -->
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"
                                            Margin="0,10,0,0" MaxHeight="200" ClipToBounds="True">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                                            <StackPanel>
                                                <Border Background="{DynamicResource CardSoft}" Padding="12,8">
                                                    <TextBlock Style="{StaticResource Micro}" Text="检测到的 Java（1）"/>
                                                </Border>
                                                <Grid MinHeight="42">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="12,4">
                                                        <TextBlock Text="Java 21 · 64-bit" FontSize="13"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource Fg2}"
                                                                   Text="C:\Program Files\Java\jdk-21\bin\javaw.exe"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                    <!-- 占位：等 Java 管理接入 -->
                                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <CheckBox x:Name="ChkAutoJava" Content="自动选择匹配的 Java 版本"
                                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        <CheckBox x:Name="ChkFull" Content="全屏启动" Margin="26,0,0,0"
                                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                    </StackPanel>
                                    <!-- .feature-grid：两列 column-gap 24（:1872）；.feature-row min-height 40 -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource PageSub}" Text="最小内存 (MB)"/>
                                            <TextBox x:Name="TxtMin" Margin="0,6,0,0" LostFocus="Setting_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource PageSub}" Text="最大内存 (MB)"/>
                                            <TextBox x:Name="TxtMax" Margin="0,6,0,0" LostFocus="Setting_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource PageSub}" Text="窗口宽"/>
                                            <TextBox x:Name="TxtW" Margin="0,6,0,0" LostFocus="Setting_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource PageSub}" Text="窗口高"/>
                                            <TextBox x:Name="TxtH" Margin="0,6,0,0" LostFocus="Setting_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 下载与网络 ============ -->
                <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="下载与网络" FontSize="15" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkMirror" Content="使用国内镜像加速（BMCLAPI）" Margin="0,10,0,0"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <!-- .mirror-options gap 12；.mirror-option 36 高 padding 0 16 radius 999（:1789-1809） -->
                                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource CapsuleRadio}" Content="官方源" IsChecked="True"
                                         GroupName="mirror"/>
                            <RadioButton Style="{StaticResource CapsuleRadio}" Content="BMCLAPI" GroupName="mirror"
                                         Margin="0,0,8,0"/>
                            <RadioButton Style="{StaticResource CapsuleRadio}" Content="自定义镜像" GroupName="mirror"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource PageSub}" Text="镜像根地址" Margin="0,14,0,0"/>
                        <TextBox x:Name="TxtMirror" Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}"
                                 FontSize="12" LostFocus="Setting_Changed"/>
                        <TextBlock Style="{StaticResource PageSub}" Text="附加 JVM 参数（空格分隔）" Margin="0,12,0,0"/>
                        <TextBox x:Name="TxtJvmArgs" Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}"
                                 FontSize="12" LostFocus="Setting_Changed"/>
                        <TextBlock Style="{StaticResource PageSub}" Text="附加游戏参数" Margin="0,12,0,0"/>
                        <TextBox x:Name="TxtGameArgs" Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}"
                                 FontSize="12" LostFocus="Setting_Changed"/>
                    </StackPanel>
                </Border>

                <!-- ============ 账号 ============ -->
                <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="账号" FontSize="15" FontWeight="SemiBold"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewName" MaxLength="16"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnGold}" Content="添加离线账号"
                                    Click="AddAccount_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtAcctErr" Margin="0,8,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource Warn}" Text=""/>
                    </StackPanel>
                </Border>

                <!-- ============ 游戏目录 ============ -->
                <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,12,0,24">
                    <StackPanel>
                        <TextBlock Text="游戏目录" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource PageSub}" Margin="0,6,0,0"
                                   Text="默认在启动器数据目录下的 minecraft 文件夹，独立于官方启动器。"/>
                        <TextBlock Text="{Binding Paths.Root}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="打开目录" Click="OpenDir_Click"/>
                            <Button Style="{StaticResource BtnGhost}" Content="更换目录…" Margin="10,0,0,0"
                                    Click="ChangeDir_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
