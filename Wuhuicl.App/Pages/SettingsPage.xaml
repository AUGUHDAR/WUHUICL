                                                <!-- .bg-row 背景图片：导入单张…（:270-281）；K 的「添加多张/自动切换」是轮播列表管理，
                                                     预渲染版先落单张主链路 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="背景图片" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Button x:Name="BgPickBtn" Style="{StaticResource BtnSmGhost}" Content="导入单张…"
                                                            Click="BgPick_Click"/>
                                                    <TextBlock x:Name="BgPathText" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                                               Text="未选择"/>
                                                </StackPanel>

                                                <!-- .bg-row 显示方式（:317-330）：填充 / 适应 / 裁切 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="显示方式" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Button x:Name="BgFitFill" Style="{StaticResource StCapsule}" Tag="fill"
                                                            Content="填充" Click="BgFit_Click"/>
                                                    <Button x:Name="BgFitFit" Style="{StaticResource StCapsule}" Tag="fit"
                                                            Content="适应" Margin="8,0,0,0" Click="BgFit_Click"/>
                                                    <Button x:Name="BgFitCrop" Style="{StaticResource StCapsule}" Tag="crop"
                                                            Content="裁切" Margin="8,0,0,0" Click="BgFit_Click"/>
                                                </StackPanel>

                                                <!-- .bg-row 图片透明度（:331-343）：滑条值＝1 减 不透明度，显示的百分比越大越透 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="图片透明度" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Slider x:Name="BgOpacitySlider" Width="200" Minimum="0" Maximum="1" SmallChange="0.05"
                                                            LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center" ValueChanged="BgOpacity_Changed"/>
                                                    <TextBlock x:Name="BgOpacityVal" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0" Text="50%"/>
                                                </StackPanel>

                                                <!-- .bg-row 图片模糊（:344-356）：0-40px 步进 2 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="图片模糊" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Slider x:Name="BgBlurSlider" Width="200" Minimum="0" Maximum="40" SmallChange="2"
                                                            LargeChange="4" TickFrequency="2" IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center" ValueChanged="BgBlur_Changed"/>
                                                    <TextBlock x:Name="BgBlurVal" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0" Text="0px"/>
                                                </StackPanel>

                                                <!-- :357 的说明行 -->
                                                <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                                                           Text="透明度越高图片越透；图片模糊单独控制清晰度。系统桌面毛玻璃由操作系统管理，不受这两个图片选项影响。"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Padding="0">
                                <StackPanel>
                                    <ToggleButton x:Name="ThumbnailHead" Style="{StaticResource StLayoutSummary}"
                                                  Padding="18,14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="首页启动卡图片" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Margin="12,0,0,0" FontSize="12" FontWeight="Normal"
                                                       Foreground="{DynamicResource Fg2}"
                                                       Text="内置插画、自定义图片与轮播"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Border Padding="18,0,18,14"
                                            Visibility="{Binding IsChecked, ElementName=ThumbnailHead,
                                                          Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ====================== 分类「行为与登录」：.settings-grid 两行 group-inline（:1019-1050） ====================== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=CatGeneral,
                                                     Converter={StaticResource BoolVis}}">
                        <!-- .settings-page .settings-grid：单列、gap 12、align-items start（:1846 覆盖 :1317-1322） -->
                        <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
