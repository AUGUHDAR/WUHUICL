                                                <Button x:Name="BgModeColor" Style="{StaticResource StCapsule}" Tag="color"
                                                        Content="纯色" Margin="8,0,0,0" Click="BgMode_Click"/>
                                                <Button x:Name="BgModeImage" Style="{StaticResource StCapsule}" Tag="image"
                                                        Content="图片" Margin="8,0,0,0" Click="BgMode_Click"/>
                                            </StackPanel>

                                            <!-- mode=color 的色板行（:245-256）：K 是原生取色器，WPF 没有对应控件，
                                                 落成预设色板 + 当前 hex 文本，语义等价（选一个纯色） -->
                                            <StackPanel x:Name="BgColorRow" Orientation="Horizontal" Margin="0,0,0,12"
                                                        Visibility="Collapsed">
                                                <TextBlock Text="背景色" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel x:Name="BgColorSwatches" Orientation="Horizontal"/>
                                                <TextBlock x:Name="BgColorHex" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"
