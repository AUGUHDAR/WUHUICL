                                                       Text="桌面玻璃、颜色与图片"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <!-- .layout-setting-body：padding 0 18 14（:499）。
                                         组件体复刻 1.1.10 HomeLayoutEditor.vue:221-359（背景段）：
                                         模式三胶囊（系统桌面/纯色/图片 :233-243）＋ color 的色板行（:245-256）＋
                                         image 的 预览/导入/显示方式/透明度/模糊（:258-357）。
                                         .bg-row：flex align-center gap 12；标签 .muted.bg-label 12px。 -->
                                    <Border Padding="18,0,18,14"
                                            Visibility="{Binding IsChecked, ElementName=BackgroundHead,
                                                          Converter={StaticResource BoolVis}}">
                                        <StackPanel>

                                            <!-- .layout-head：列流，右侧「恢复默认」btn-sm ghost（:227） -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
