                    <!-- ====================== 分类「下载」：.settings-grid 里一个下载 collapse（:717-762） ====================== -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=CatDownloads,
                                                     Converter={StaticResource BoolVis}}">
                        <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,12">
                            <StackPanel>
                                <ToggleButton x:Name="DownloadHead" Style="{StaticResource StCollapseHead}"
