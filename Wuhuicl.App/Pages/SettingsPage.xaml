                                        <TextBlock Grid.Column="0" Text="最大线程数" FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource Input}" Text="16"
                                                 HorizontalAlignment="Stretch"/>
                                    </Grid>
                                    <Grid MinHeight="44" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="速度限制（KiB/s）" FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource Input}" Text="0"
