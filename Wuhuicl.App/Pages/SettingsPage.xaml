            </ScrollViewer>
        </Border>

        <!-- ==================== 弹窗一：版本回退（:1168-1195）
             外壳是 UpdateDialogShell.vue：backdrop fixed inset 0 / z 9500 / grid place-items center /
             padding 24 / 底 var(mask) + blur 12（:33），面板 width min(620px,100%) /
             max-height min(760px, 100dvh-48px) / flex column / 底 card-solid / border 1 border-strong /
             radius 20 / overflow hidden（:34），三段内边距与分隔线见 :35-37。
             （brief 里写的 .modal-mask + .modal 是 styles.css:527-556 的通用弹窗，
             SettingsView 这两个对话框走的是 UpdateDialogShell，所以照组件本体做）
             backdrop-filter 需要 MaskBlur.Attach 在代码里快照底层（Services/MaskBlur.cs），XAML 表达不了，
             这里只铺 Overlay 底色。原版 v-if rollback.open → 默认不渲染。 ==================== -->
        <Border x:Name="ModalRollback" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="2"
                Panel.ZIndex="10000" Background="{DynamicResource Overlay}" Padding="24"
                Visibility="Collapsed">
            <!-- .update-dialog：flex column，底 Card（card-solid 在主题里就是 Card） -->
            <Border Width="620" MaxHeight="760" CornerRadius="20" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <DockPanel>
                    <!-- .update-dialog-header：padding 24 26 18 + border-bottom 1（:35） -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                            Padding="26,24,26,18">
                        <StackPanel>
                            <!-- .upd-modal-head：flex start space-between gap 12（:1268）；
                                 .upd-modal-title：22px / line-height 1.4 / margin 0（:1269）；
                                 关闭钮 .icon-btn：32×32 / radius 6 / 内层 svg 16×16（styles.css:266-280） -->
                            <Grid VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="版本回退" FontSize="22" FontWeight="Bold"
                                           LineHeight="31" LineStackingStrategy="BlockLineHeight"/>
                                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="32" Height="32"
                                        VerticalAlignment="Top" ToolTip="关闭">
                                    <ContentControl Width="16" Height="16" Style="{DynamicResource Icon.Close}"/>
                                </Button>
                            </Grid>
                            <!-- .upd-modal-subtitle：margin-top 10 / 12px（:1267）// 占位：等版本号注入 -->
                            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource Fg2}"
                                       Text="当前 v1.1.5 · 选择要恢复的历史版本"/>
                        </StackPanel>
                    </Border>
                    <!-- .update-dialog-footer：padding 18 26 + border-top 1（:37） -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                            Padding="26,18">
                        <!-- .upd-modal-actions：flex end gap 12 / margin-top 24 / wrap（:1288） -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="取消"/>
                            <Button Style="{StaticResource BtnGold}" Content="回退到选中版本" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- .update-dialog-content：padding 22 26 / overflow auto / line-height 1.65（:36） -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22">
                        <StackPanel>
                            <!-- .upd-risk：margin 0 0 18 / padding 12 14 / radius 10 / 12px 500 /
                                 底 danger 10% + 边 danger 26% + danger 字（:1270-1275）；⚠ 是原文字形 -->
                            <Border Margin="0,0,0,18" Padding="14,12" CornerRadius="10"
                                    Background="{DynamicResource DangerSoft}"
                                    BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1">
                                <TextBlock FontSize="12" FontWeight="Medium" LineHeight="19"
                                           LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Danger}"
                                           TextWrapping="Wrap"
                                           Text="&#x26a0; 旧版本可能不兼容新配置格式。回退前将自动备份当前版本，可随时还原。"/>
                            </Border>
                            <!-- .upd-release-list：column gap 10（:1276）；列表为空时原版渲染
                                 div.empty（:1189）→ 「没有可回退的历史版本」（.empty 几何同读取态） -->
                            <StackPanel>
                                <Border MinHeight="120" Padding="16,32">
                                    <TextBlock FontSize="14" Foreground="{DynamicResource Fg2}"
                                               TextAlignment="Center" HorizontalAlignment="Center"
                                               Text="没有可回退的历史版本"/>
                                </Border>
                                <!-- .upd-release-item：flex gap 14 / align-start / padding 16 / border 1 / radius 10，
                                     选中 = accent 边 + accent-soft 底；radio margin-top 5（:1277-1284）；
                                     .upd-release-main（:1283）：flex wrap / align baseline / gap 8 / min-width 0，
                                     里面是 .upd-release-ver（:1284 font-weight 650 → WPF SemiBold，字号继承 14）
                                     与 .upd-release-date（:1285 ＋ .muted：12px text-dim）；
                                     .upd-release-summary（:1286 ＋ .muted）：12px ＋ flex-basis 100% → 独占一行，
                                     与上一行的间距就是 main 的 gap 8。// 占位：等 Release 列表接入 -->
                                <StackPanel Visibility="Collapsed">
                                    <Border Padding="16" CornerRadius="10" BorderBrush="{DynamicResource Accent}"
                                            BorderThickness="1" Background="{DynamicResource AccentSoft}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Grid.Column="0" Margin="0,5,0,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="2">
                                                <WrapPanel>
                                                    <TextBlock Text="v1.1.4" FontWeight="SemiBold"/>
                                                    <TextBlock Text="2026-01-01 12:00" FontSize="12"
                                                               Foreground="{DynamicResource Fg2}" Margin="8,0,0,0"/>
                                                </WrapPanel>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}"
                                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                                           Text="本次更新的摘要（release body 的首段）"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- ==================== 弹窗二：从本地文件安装更新（:1198-1227）
             外壳同上（UpdateDialogShell.vue:33-37）。原版 v-if localUpdate.confirming → 默认不渲染 ==================== -->
        <Border x:Name="ModalLocalUpdate" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="2"
                Panel.ZIndex="10000" Background="{DynamicResource Overlay}" Padding="24"
                Visibility="Collapsed">
            <Border Width="620" MaxHeight="760" CornerRadius="20" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                            Padding="26,24,26,18">
                        <!-- 这个弹窗只有 head 一行（:1200-1205），没有副标题 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="安装本地更新包" FontSize="22" FontWeight="Bold"
                                       LineHeight="31" LineStackingStrategy="BlockLineHeight"/>
                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="32" Height="32"
                                    VerticalAlignment="Top" ToolTip="关闭">
                                <ContentControl Width="16" Height="16" Style="{DynamicResource Icon.Close}"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                            Padding="26,18">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="取消"/>
                            <!-- 校验通过才是 btn-gold，否则 btn-danger（:1221-1225）；
                                 .btn-danger = 红字红边不实心（styles.css:240-243） -->
                            <Button Style="{StaticResource BtnGold}" Content="确认安装" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22">
                        <StackPanel>
                            <!-- .upd-local-file：margin 0 / 600 / 13px / break-all（:1289）
                                 // 占位：文件名与体积来自 pickLocalUpdateFile()，未接入 -->
                            <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="安装包文件名 · 0.0 MB"/>
                            <!-- .upd-local-check：flex gap 12 / 13px / baseline / margin-top 16，
                                 首个 span 宽 72 + text-dim（:1290-1291）；
                                 .upd-ok = accent-2、.upd-warn = danger（:1292-1293）。
                                 这里给的是原版在校验失败时的兜底文案（:1211 与 :1217），不造数据 -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="版本校验" FontSize="13"
                                           Foreground="{DynamicResource Fg2}"/>
                                <TextBlock Grid.Column="2" FontSize="13" Foreground="{DynamicResource Danger}"
                                           TextWrapping="Wrap"
                                           Text="&#x26a0; 无法从文件名识别版本号，继续需自担风险"/>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="完整性校验" FontSize="13"
                                           Foreground="{DynamicResource Fg2}"/>
                                <TextBlock Grid.Column="2" FontSize="13" Foreground="{DynamicResource Danger}"
                                           TextWrapping="Wrap"
                                           Text="&#x26a0; 无法联网校验，请确认文件来自官方渠道，风险自担"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
