                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource StGroupTitleSm}" Text="下载镜像"/>
                                        <WrapPanel>
                                            <RadioButton Style="{StaticResource CapsuleRadio}" Content="官方源"
                                                         GroupName="StMirror"/>
                                            <!-- store.settings.mirror 默认 bmclapi（settings.ts:51）→ 默认选中镜像那颗 -->
                                            <RadioButton Style="{StaticResource CapsuleRadio}"
