<UserControl x:Class="Wuhuicl.App.Pages.SkinsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Wuhuicl.App.Controls">

    <!-- 皮肤与披风页复刻 KAMUCL-1.1.5/src/renderer/src/views/SkinsView.vue。
         该文件有两个 scoped style 块：前块 :602-1080 是 flex 版基线，后块 :1081-1109 把整页改写成
         CSS Grid（UI_GEOMETRY_PAGES.md §6 开头就点明「以后者为准」），所以本页所有顶层几何取 :1081-1109，
         后块没覆盖到的细节（卡片头、分段控件、披风/历史行内度量）才回落到前块的行号。
         后块 :1085 把 .row-main/.row-sub 设成 display:contents（两个包裹 div 不再渲染），
         因此 WPF 里也不给它们建容器：三个 pane 直接当顶层 grid 的子项摆槽位。
         下面 4 个页内样式都是契约 §2 覆盖不到的形状，键名一律 Skin 前缀，避免与 §4 画刷键撞名：
         · SkinPaneHead / SkinPaneTitle —— .pane-head 42 高 + 8 下边距（:675-682）、.pane-title 13/700（:683-687），
           §2 的 Dim 是 13 非粗、Lbl14 是 14 SemiBold，都对不上；
         · SkinSegItem(+Active) —— .seg-btn 高 100% / padding 0 16 / 12px（:833-857），§2 无同形按钮样式；
         · SkinCapeItem —— .cape-item 是「常驻 card-2 底 + 1px 描边 + 内部 58px 网格」（:897-911 + :1097），
           RowCard/RowItem 都是列表行配方（无描边、hover 才出底），表达不出来；
         · SkinStatusStrip —— .status-strip（ui-system.css:41-42）§2 未收录。
         注释里的 CSS 变量一律去掉负号前缀写（themes/Controls.xaml:5 的规矩），因为 XML 注释不允许出现连续两个减号。 -->
    <UserControl.Resources>

        <!-- .pane-head：row / space-between / gap 12 / min-height row-h 42 / margin-bottom space-2 8 — :675-682 -->
        <Style x:Key="SkinPaneHead" TargetType="Grid">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- .pane-title：margin 0 / 13px（text-sm）/ 700 — :683-687 -->
        <Style x:Key="SkinPaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- .seg-btn：position relative / height 100% / padding 0 16（space-4）/ radius 6 / 无底无边 / 12px text-dim — :833-850
             :hover:not(.active) color text — :851-853（过渡色属动画，本轮不做，契约 §6.8） -->
        <Style x:Key="SkinSegItem" TargetType="Button">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .seg-btn.active：color on-accent / 600 — :854-857（.active 的底色由 .seg-blob 提供，见下方 SegBlob） -->
        <Style x:Key="SkinSegItemActive" TargetType="Button" BasedOn="{StaticResource SkinSegItem}">
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <!-- 选中项 hover 必须留在 on-accent，否则上面的 hover 会把彩底上的字染成深色 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .cape-item：基线 :897-911（card-2 底 / border 1 / radius 10 / padding 12 8）
             最终几何 :1097（grid 58px minmax(0,1fr) × 两行 / gap 8 12 / min-height 100 / padding 12 / 文字左对齐）
             hover 边框 accent-deep（→ AccentLo，与 AccountsPage 对同一变量的映射一致）— :912-915
             translateY(-2px) 与 .active 的 accent 边框属交互态/动画，本轮只做静态结构（契约 §6.8） -->
        <Style x:Key="SkinCapeItem" TargetType="Button">
            <Setter Property="MinHeight" Value="100"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLo}"/>
                            </Trigger>
                            <!-- .cape-item:disabled{opacity:.6} — :916-919 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .status-strip：flex wrap / gap 12 / padding 12 16 / radius 10 / margin-bottom 12 / 13px / accent-soft 底 — ui-system.css:41
             .status-strip.error：bg danger-soft / color text — ui-system.css:42；
             danger-soft 在契约 §4 里没有对应键（§4 只给到 Danger 实色），故 error 态保留 AccentSoft 底 + Danger 前景与描边，
             不新造颜色（§4 硬规矩）。 -->
        <Style x:Key="SkinStatusStrip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <!-- 外层 Grid 只为承载 .drag-hint（模板 :493，样式 :747-758）：
         原版是 position absolute / inset 0，理论上的包含块是 .row-sub（:661 给过 position relative），
         但后块 :1085 把 .row-main/.row-sub 全改成了 display:contents —— 不生成盒子就当不成包含块，
         于是 .drag-hint 实际是按初始包含块（整个视口）铺满的，且 .content 的 overflow 也裁不掉它。
         WPF 没有「按视口定位」这一说，页面元素最多铺满自己所在的宿主区，所以这里做成铺满本页；
         与原版的一致部分是：accent 18% 底（DragTint）／accent-2 字／13px／600／居中／padding 0 24／
         radius-lg 14／pointer-events none；差异是原版连侧栏和顶栏一起罩住。记进 UI_PARITY_LEDGER。
         dragover 本身属功能 → 先 Collapsed。 -->
    <Grid>
    <!-- .content：overflow-y auto + scrollbar-gutter stable（槽宽 8，已由全局样式定）— UI_GEOMETRY_PAGES.md §0 / App.vue:2398-2404；页边距 24 由宿主给 -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="0,0,8,0">

        <!-- ============ .skins-page 最终顶层：grid / minmax(260px,2fr) minmax(300px,3fr) / align-items start / gap 16 — :1083
             （覆盖 :609-614 的 flex column + max-width 1080；:605 另给所有 pane min-width min(100%,280px)）
             fr → *，minmax 的下界用列 MinWidth 表达（契约 §6.2/§6.3）；gap 16 用间隔列/间隔行表达（契约 §6.2）。
             槽位：:1084 让 .skins-page 的**直接子元素**中的 page-head / status-strip / need-ms 跨 1/-1；
                   template 的直接子只有 page-head(:344) 与 need-ms(:352)，两个 .status-strip 分别嵌在
                   pane-info(:429) 与 pane-history(:537) 内，所以它们不跨整行，照原结构留在 pane 里。
                   .pane-preview 列1行2（:1086）；.skin-operation-panel 列2行2（:1088）；.pane-history 跨 1/-1 行3（:1092）。
             断点 @max-1050 转单列 minmax(0,1fr)（:1103-1107）、@max-650 .cape-grid 转 1 列（:1108）：
             WPF 无 media query，本轮按宽窗单态实现，窄窗退化等主控统一加响应式再补。 ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="3*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 行1 · grid-column 1/-1：.page-head（模板 :347；scoped :1088 让 .skins-page > :is(.page-head,...) 跨整行）============
                 .page-head 基线 styles.css:542-546 是 flex column + gap 4；整条被 scoped :1089「.skins-page > .page-head」改写成
                 flex-direction row / align-items center / justify-content space-between / gap 12（scoped 带 data-v 属性选择器，特异性(0,3,0) 高于
                 styles.css 的 .page-head(0,1,0) 与 ui-system.css 的 .content .page-head(0,2,0)）。
                 margin-bottom 8（space-2）来自 ui-system.css:11「.content .page-head」，:1089 没动 margin，两值并存。
                 ui-system.css:62「.content :is(.page-head,...){flex-wrap:wrap;gap:12px}」在 @media(max-width:900) 内，1360 宽窗口不生效（死样式，仅注释）。 -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- .skin-page-heading：1.1.10 模板 :348 新增的包裹层（1.1.5 里 title/sub 直接散在 .page-head 内）。
                     scoped :1090 只给它 min-width:0，没有设 display → 仍是普通块（等价竖排 title+sub）。
                     WPF 里 min-width:0 的可收缩语义由上面的 * 列承担（列可压缩、文字靠 Wrap 折行，不会把按钮挤出）。 -->
                <StackPanel Grid.Column="0">
                    <!-- .page-title：模板 :348「h1 皮肤与披风」。scoped SkinsView.vue:620-623「.skins-page .page-title」= text-xl 20 / 700，
                         它（带 data-v 属性）压过 ui-system.css:12「.content .page-title」的 var(text-title) 24px（text-title 只在 ui-system.css:6 定义为 24，styles.css 没有它）；
                         ui-system.css:60 的 22px 在 @media(max-width:900) 内 → 1360 宽不生效（死样式）。
                         letter-spacing 0 / line-height 1.35 仍来自 styles.css:547-552「.page-title」→ LineHeight 27。
                         （不用 §2 的 PageTitle 样式，那是 24px，压不过本页的 20px 覆盖。） -->
                    <TextBlock Text="皮肤与披风" FontSize="20" FontWeight="Bold" LineHeight="27"/>
                    <!-- .page-sub：模板 :349-351「p」。scoped SkinsView.vue:624-627「.skins-page .page-sub」= text-xs 12 / text-dim，
                         压过 styles.css:553-555「.page-sub」的 text-sm 13（§2 Micro 即 12px + Fg2）。
                         margin-top 4 来自 scoped :1090「.skin-page-heading .page-sub{margin:4px 0 0}」——styles.css:111-115 的星号通配重置把 p/h1 的基础 margin 归零，
                         这 4 现在是唯一的顶距（不再靠旧版 .page-head 的 flex gap 4）。
                         // 占位：等皮肤档案接入 —— 文案取模板 :350 的非外置分支；外置分支是「查看 {providerName} 的角色材质」 -->
                    <TextBlock Style="{StaticResource Micro}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="管理微软正版账号的皮肤与披风"/>
                </StackPanel>

                <!-- .skin-editor-entry：模板 :352「button.btn.btn-gold 绘制皮肤」。scoped :1091 覆盖 padding 8px 14px / min-height 36 / flex none / width auto；
                     底 accent-grad、字 on-accent、600、radius-md 10 全走 §2 的 BtnGold（其内 .btn 基线 styles.css:199-220、.btn-gold styles.css:241；
                     ui-system.css:16「.content :is(.btn,.icon-btn){flex-shrink:0}」在 WPF 里由 Auto 列天然满足）。
                     §2 Btn 默认 padding 16,8（CSS 上 8 左 16），skin-editor-entry 把横向收到 14（CSS padding 上下 8 左右 14 → WPF 14,8），min-height 36 = ctl-h 与默认同值。
                     align-items center → VerticalAlignment Center（行高由左侧 title+sub 撑高，按钮居中）。
                     // 占位：等皮肤编辑器接入 —— 原版 @click 置 editorOpen=true（:352，另 :346 挂 SkinEditor 本体），契约 §1 本轮不挂事件、不碰编辑器本体。 -->
                <Button Grid.Column="2" Style="{StaticResource BtnGold}" Content="绘制皮肤"
                        Padding="14,8" MinHeight="36" VerticalAlignment="Center"/>
            </Grid>

            <!-- ============ 行3 · 列1：.pane-preview（grid-column:1 / grid-row:2）— :1086 ============
                 .skins-page .card：padding 20（card-pad）/ radius 14（radius-lg）— :625-630 → §2 Panel
                 backdrop-filter blur(24px) saturate(130%)（:628-629）WPF 无等价物，卡片按契约 §6.4 保持平面无阴影。
                 拖拽反馈本轮不做：.row-main.drag-over{box-shadow:0 0 0 3px var(accent-soft)} — :661-663
                 + .row-main.drag-over .pane{outline:2px solid var(accent)} — :1102（WPF 无 outline，需外层套 Border 或 Adorner 表达）。 -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Panel}" MinWidth="280" VerticalAlignment="Top">
                <StackPanel>

                    <!-- .pane-head（:675-682）：3D 预览 + 右侧 .pane-tools -->
                    <Grid Style="{StaticResource SkinPaneHead}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SkinPaneTitle}" Text="3D 预览"/>
                        <!-- .pane-tools：row / align center / gap 8（space-2）— :688-692
                             原版整块 tools 是 v-if="!loadingProfile && currentSkin?.dataUrl"（:374），本轮无档案 → 常驻展示几何 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- .seg：position relative / inline-flex / gap 2 / height 36（ctl-h）/ padding 3 / border 1 / radius 10 / card-2 — :811-820 -->
                            <Border x:Name="AnimSeg" Height="36" Padding="3" CornerRadius="10"
                                    Background="{DynamicResource CardSoft}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <Grid x:Name="AnimSegGrid">
                                    <!-- .seg-blob：absolute / top 3 / bottom 3 / radius 6（radius-sm）/ accent-grad 实心渐变 — :823-832
                                         left/width 由 updateAnimSegBlob() 量 .seg-btn 后写入（:63-87）。
                                         不量的话 blob 一直是 0 宽且 opacity 0，而 .active 的字色是 on-accent（白），
                                         在白底卡片上就等于"选中项消失"——所以这里必须测，动画可以后补。 -->
                                    <Border x:Name="SegBlob" Width="0" Opacity="0" HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch" Margin="0,3" CornerRadius="6"
                                            Background="{DynamicResource AccentGrad}" IsHitTestVisible="False"/>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 默认 previewAnim = 'walk' — :59，故「行走」取 active 态 -->
                                        <Button x:Name="SegWalk" Style="{StaticResource SkinSegItemActive}" Content="行走" Click="Seg_Click"/>
                                        <!-- gap 2 — :815 -->
                                        <Button x:Name="SegIdle" Style="{StaticResource SkinSegItem}" Click="Seg_Click"
                                                Content="待机" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- .pane-tools .icon-btn：36×36（ctl-h，覆盖 styles.css:266-301 的全局 32×32），内层 svg 16×16 — :693-703
                                 原版「回正视角」图标是内联「圆圈 + 四向刻度」（:395-398），§3 的 43 个键里没有这个几何，
                                 几何已按源补成 Icon.ResetView（圆圈 r7.5 + 四向刻度，stroke 1.8）；
                                 title 走 ToolTip（:394）。之前用 Icon.Restore 是个圆角方块，看着像个空框 -->
                            <Button x:Name="BtnResetView" Style="{StaticResource IconBtn}" Width="36" Height="36"
                                    Margin="8,0,0,0" ToolTip="回正视角">
                                <ContentControl Width="16" Height="16" Style="{DynamicResource Icon.ResetView}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- .preview-3d{sv3d-height:380px; position:relative} — :715-718
                         .viewer3d{width:100%; height:var(sv3d-height); radius 10} — SkinViewer3D.vue:124（§6/§13）
                         .pane-preview .viewer3d{min-height:320px} — :1087
                         // 占位：等 3D 皮肤预览接入 —— WebGL 人偶（SkinViewer3D）本轮不做，只留 380 高容器与纸娃娃位图层 -->
                    <Grid x:Name="SkinViewport" Height="380" MinHeight="320">

                        <!-- .preview-3d-empty：height var(sv3d-height) / border 1px dashed border-strong / radius 10 / card-2 底 / overflow hidden — :719-728
                             WPF 的 Border 画不出 dashed（StrokeDashArray 只在 Shape 上有），所以拆成两层：
                             Border 给底色 + 圆角 + 裁切，同位置的 Rectangle 用 StrokeDashArray 3 2 补虚线（虚线节长是 CSS dashed 的近似） -->
                        <Grid x:Name="PreviewEmptyState">
                            <Border CornerRadius="10" ClipToBounds="True"
                                    Background="{DynamicResource CardSoft}"/>
                            <Rectangle RadiusX="10" RadiusY="10" SnapsToDevicePixels="True"
                                       Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                                       StrokeDashArray="3 2"/>
                            <!-- .preview-placeholder：column / align center / gap 8 / 12px text-dim — :735-742 -->
                            <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- .preview-placeholder svg 40×40 opacity .6 — :743-747；
                                     原版是内联「人形」svg（:416-419）→ §3 里的 Icon.User，颜色由宿主 Foreground 走 currentColor（契约 §6.7） -->
                                <ContentControl Width="40" Height="40" Opacity="0.6"
                                                Foreground="{DynamicResource Fg2}"
                                                Style="{DynamicResource Icon.User}"/>
                                <TextBlock Style="{StaticResource Micro}" Margin="0,8,0,0" Text="暂无皮肤"/>
                            </StackPanel>
                        </Grid>

                        <!-- 纸娃娃位图占位：现成素材是 SkinRenderer.PaperDoll（ThemeManager.cs:187，由 skin.png 现算），
                             HomePage 的 SkinDoll 走的同源路径（MainWindow.xaml.cs:45）。
                             契约 §5 的 LaunchSession 白名单里没有 SkinPreview 属性 → 这里不写 Binding（绑不存在的属性等于静默失效的假实现），
                             Source 由主控接线；NearestNeighbor 对应原版 image-rendering:pixelated（:937/:996）。 -->
                        <!-- SkinViewer3D 的 WPF 等价（SkinDollHost = 快照 + 悬浮真 3D）：拖拽 yaw/pitch、
                             滚轮缩放、双击回正，行走/待机切 Walk（previewAnim 默认 walk，SkinsView.vue:61）；
                             几何/相机/动画参数 1:1 抄 skinview3d v3.4.2 + SkinViewer3D.vue -->
                        <Border CornerRadius="10" ClipToBounds="True" Margin="12">
                            <ctl:SkinDoll3D x:Name="SkinDoll" Walk="True"/>
                        </Border>

                        <!-- .skin-overlay 配方：absolute left 12 / right 12 / bottom 12，min-height 34，padding 7 10，radius 9，
                             border 1，11px / weight 550（= FontWeights.Medium），card 78% 半透明底 + blur(12px) — HomeView.vue:949（施工任务要求的角落层配方）
                             WPF 无 backdrop-filter，半透明底只能取 §4 的实色画刷 Card（HomeView 的 color-mix 78% 表达不出来）。
                             // 占位：等皮肤功能接入 —— 原版这一层只在 loading / 未登录 / 出错三态出现（HomeView.vue:649-651），文案取 loading 态 -->
                        <!-- .skin-overlay：原版只在 loading / 未登录 / 出错三态出现（HomeView.vue:649-651），
                             本页皮肤已就绪 → 常收起；结构保留等接入时切 Visible -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="12"
                                MinHeight="34" Padding="10,7" CornerRadius="9"
                                Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock Text="正在加载皮肤…" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource Fg2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- .muted.viewer-tip（styles.css:677 ＋ :729-734）：margin-top 8 / 12px text-dim / 居中，
                         文案 :411
                         原版挂在 v-if="!loadingProfile && currentSkin?.dataUrl" 分支里（:403-411）；本页无状态源，先按静态文案铺出来 -->
