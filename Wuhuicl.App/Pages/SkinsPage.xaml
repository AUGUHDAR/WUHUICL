                                            IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource BtnGold}" Content="换回"
                                                    MinHeight="32" Padding="12,4" FontSize="13"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource BtnDanger}" Content="删除"
                                                    MinHeight="32" Padding="12,4" FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- .tag-gold（classic 分支 — styles.css:474-478） -->
                            <Grid MinHeight="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Tag}"
                                        HorizontalAlignment="Left" Background="{DynamicResource AccentSoft}">
                                    <TextBlock Text="经典" Style="{StaticResource TagText}" Foreground="{DynamicResource AccentHi}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Style="{StaticResource Micro}" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Text="0 天前"/>
                            </Grid>
                            <Border MinHeight="20">
                                <TextBlock Style="{StaticResource Micro}" Padding="3,1"
                                           TextTrimming="CharacterEllipsis" Text="skin_2026.png"/>
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ============ 行3 · grid-column 1/-1：need-ms（:1084 跨整行） ============
                 .need-ms：card + empty，column / 居中 / gap 16（space-4）/ padding 48 20（space-7 card-pad）/ 文字居中 — :352 + :1055-1063
                 .need-ms-text：14px（text-md）— :1070-1072
                 原版是 v-if="!canViewProfile"（:352），与上面两个 pane 互斥；canViewProfile = 微软 或 外置账号（:21）。
                 // 占位：等账号类型接入 —— 契约 §5 只有 HasNoAccount，表达不了「是哪种账号」，所以不写假绑定，默认收起由主控决定显隐。 -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Panel}"
                    Padding="20,48" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <!-- .need-ms-icon：52×52 / accent / opacity .8 — :1064-1069；
                         原版是内联「披风人形」svg（:353-355），§3 无此几何 → 取最接近的 Icon.Skin，颜色给宿主 Foreground（契约 §6.7） -->
                    <ContentControl Width="52" Height="52" HorizontalAlignment="Center" Opacity="0.8"
                                    Foreground="{DynamicResource Accent}"
                                    Style="{DynamicResource Icon.Skin}"/>
                    <TextBlock FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420" Margin="0,16,0,0" HorizontalAlignment="Center"
                               Text="皮肤与披风需要微软正版账号或外置 Yggdrasil 账号"/>
                    <!-- .need-ms .btn：min-height 36 — :1073-1078（§2 BtnGold 已给）；
                         原版点击是 store.currentView='accounts'（:357）→ 契约 §1 不让页面调 MainWindow，本轮不挂事件 -->
                    <Button x:Name="BtnGoAccounts" Style="{StaticResource BtnGold}" Content="去登录"
                            HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
        <!-- .drag-hint：见文件末尾外层 Grid 的注释。文案照抄 :493 的「松开以选择皮肤文件」 -->
        <Border x:Name="SkinDragHint" CornerRadius="14" Background="{DynamicResource DragTint}"
                TextElement.Foreground="{DynamicResource AccentHi}" IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="24,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="松开以选择皮肤文件"/>
        </Border>
    </Grid>
</UserControl>
