                        <Border Grid.Column="2" Height="18" CornerRadius="6" VerticalAlignment="Center"
                                HorizontalAlignment="Left" MaxWidth="585" Background="{DynamicResource Hover}"/>
                        <Border Grid.Column="4" Width="76" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Background="{DynamicResource Hover}"/>
                    </Grid>
                    <Grid Height="48" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="76"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" VerticalAlignment="Center"
                                Background="{DynamicResource Hover}"/>
                        <Border Grid.Column="2" Height="18" CornerRadius="6" VerticalAlignment="Center"
