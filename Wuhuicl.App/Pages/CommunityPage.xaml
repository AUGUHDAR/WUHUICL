    <!-- ==================== 下载模态框 .modal-mask + .modal.download-modal（:639-698） ====================
         .modal-mask（styles.css:527-538）：fixed inset 0 / z 10000 / flex center / 底 mask（＝Overlay）/ blur 10。
         backdrop-filter blur 需 MaskBlur.Attach 在代码里快照底层（Services/MaskBlur.cs），XAML 表达不了，这里只铺 Overlay 底色。
         v-if modal.open → 默认 Collapsed。 -->
    <Border x:Name="DownloadModal" Panel.ZIndex="10000" Visibility="Collapsed"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Overlay}">
        <!-- .download-modal（:962-966）：width min(740, 100vw-40) / max-height 88vh / overflow-y auto。
