    <!-- ==================== 视口级浮层（fixed / absolute 的等价层，都在 ScrollViewer 之外） ==================== -->

    <!-- .menu-overlay（:518 标记 + styles.css:577-581）：fixed inset 0 / z 90，透明的点击捕获层（点外面关下拉）。
         v-if versionDropdownOpen 与浮层同开关 → 默认 Collapsed；捕获点击＝代码（Popup 关闭 / 事件路由）。 -->
    <Border x:Name="VerMenuOverlay" Panel.ZIndex="90" Visibility="Collapsed"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

    <!-- .float-menu.ver-filter-menu（:519-534 标记，:582-596 的 .float-menu 基 + :801-809 的 .ver-filter-menu 覆盖）
         底 card-solid 96%（＝Card）/ border 1 border / radius radius-md 10 / padding space-2 8 / shadow-lg / z 9001，
         覆盖项：top calc(100%+4px) / left 0 / right 0（＝贴 .ver-filter 宽）/ max-height 260 / overflow-y auto。
         绝对定位相对 .ver-filter（left/right/top）是运行时按锚点矩形算的 → 下面给标称位置，宽度/Left/Top 由主控代码定。 -->
    <Border x:Name="VerFilterMenu" Panel.ZIndex="9001" Visibility="Collapsed" Width="260"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="230,150,0,0"
            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
