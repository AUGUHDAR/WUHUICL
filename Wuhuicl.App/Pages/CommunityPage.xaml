                        <Border Grid.Column="4" Width="76" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Background="{DynamicResource Hover}"/>
                    </Grid>
                    <Grid Height="48" Margin="0,0,0,12">
