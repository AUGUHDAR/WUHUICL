                    <TextBlock x:Name="DownloadPackTip" Visibility="Collapsed" Style="{StaticResource Dim}"
                               FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap"
                               Text="整合包将下载后自动创建独立实例并安装"/>

                    <!-- .modal-actions（:691-697，样式 :1073-1079）：flex end / gap 12 / margin-top 24 / wrap。
                         .btn.btn-ghost 取消 + .btn.btn-gold（含 v-if downloading 的 .spin，文案 确认下载/下载中…）。都是全尺寸 .btn(36)。 -->
                    <WrapPanel HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="DownloadCancelBtn" Style="{StaticResource BtnGhost}" Content="取消"
                                Margin="0,0,12,0"/>
                        <Button x:Name="DownloadConfirmBtn" Style="{StaticResource BtnGold}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Spin}" Margin="0,0,8,0" Visibility="Collapsed"
                                        x:Name="DownloadSpin"/>
                                <TextBlock x:Name="DownloadConfirmText" Text="确认下载" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>

    <!-- ==================== ModInstallDialog（:701 引用 → components/ModInstallDialog.vue） ====================
         .modal-mask（:31 内联 z-index 10020）＋ .modal.modinstall-modal（:48-52 width min(640,100vw-40) / max-height 85vh / scroll）＋
         通用 .modal 底（card-solid/border/radius 14/padding 24/shadow-lg）。v-if modRequest → 默认 Collapsed。 -->
    <Border x:Name="ModInstallModal" Panel.ZIndex="10020" Visibility="Collapsed"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Overlay}">
        <Border Style="{StaticResource CmModal}" Width="640" MaxHeight="700">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- .modal-title 16/700 margin 0 0 8（:33 + :53-57） -->
                    <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,8" Text="安装 MOD 与前置"/>
                    <!-- .modinstall-sub（:34 + :58-63）：muted 12 / margin 0 / line-height 1.6 / word-break；主行 + 换行 folder。代码注入实例信息 -->
                    <TextBlock x:Name="ModInstallSub" FontSize="12" Foreground="{DynamicResource Fg2}" LineHeight="19"
                               LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                               Text="实例 · MC 版本 · Loader&#10;实例目录"/>
                    <!-- .modal-loading（:35 + :64-69）：flex center gap 12 / padding 16 0，.spin + .muted。v-if busy → 默认 Collapsed -->
                    <StackPanel x:Name="ModInstallLoading" Visibility="Collapsed" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,16">
                        <ContentControl Style="{StaticResource Spin}" Margin="0,0,12,0"/>
                        <TextBlock Style="{StaticResource Dim}" VerticalAlignment="Center"
                                   Text="正在读取 MOD 元数据与递归前置关系…"/>
                    </StackPanel>

                    <!-- .dependency-row（:37 + :70）：flex center gap 12 / min-height row-h 42 / padding 8 0 / border-bottom 1。
                         v-for plan.files → 有 .tag（缺失前置/所选 MOD，用基态 .tag＝ChipBg+Fg2）+ .dependency-name（flex1，两行 MarqueeText：文件/版本）。
                         两条几何占位，plan 未载入时整块 Collapsed。 -->
                    <StackPanel x:Name="ModInstallDeps" Visibility="Collapsed">
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Tag}">
                                    <TextBlock Style="{StaticResource TagText}" Text="所选 MOD"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Text="sodium-0.5.8+mc1.20.1.jar"/>
                                    <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Text="0.5.8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Tag}">
                                    <TextBlock Style="{StaticResource TagText}" Text="缺失前置"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Text="fabric-api-0.92.1.jar"/>
                                    <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Text="0.92.1"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- .modal-note（:38 + :72）：13px / line-height 1.6 / text-dim。v-if plan.missing.length → 默认 Collapsed -->
                    <TextBlock x:Name="ModInstallMissing" Visibility="Collapsed" FontSize="13" LineHeight="21"
                               LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Fg2}"
                               TextWrapping="Wrap" Text="元数据要求："/>
                    <!-- .modal-error（:39 + :73）：danger / pre-wrap / 13px，v-for plan.warnings → 默认 Collapsed -->
                    <TextBlock x:Name="ModInstallWarning" Visibility="Collapsed" FontSize="13"
                               Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
                    <!-- :40 固定的那条 .modal-note（有 plan 时常驻） -->
                    <TextBlock x:Name="ModInstallNote" Visibility="Collapsed" FontSize="13" LineHeight="21"
                               LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Fg2}"
                               TextWrapping="Wrap"
                               Text="是否一键下载缺失前置并安装？已有兼容前置将复用；若检测到冲突，将停止且不覆盖原文件。"/>
                    <!-- .modal-error（:42 + :73）：v-if error，出错文案 → 默认 Collapsed -->
                    <TextBlock x:Name="ModInstallError" Visibility="Collapsed" FontSize="13"
                               Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>

                    <!-- .modal-actions（:43 + :74）：flex end / gap 12 / margin-top 24 / wrap。
                         .btn.btn-ghost（取消 / 关闭并重新选择）+ .btn.btn-gold（v-if plan：确认安装 / 一键下载前置并安装）。 -->
                    <WrapPanel HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="ModInstallCancel" Style="{StaticResource BtnGhost}" Content="取消"
                                Margin="0,0,12,0"/>
                        <Button x:Name="ModInstallConfirm" Style="{StaticResource BtnGold}" Visibility="Collapsed"
                                Content="确认安装"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>

    <!-- ==================== SelectMenu 浮层 .select-menu-float（SelectMenu.vue:86-103，样式 :131-170） ====================
         closed 按钮（.select-menu-btn）本页已用 SelectBtn 表达（:74-84）；这里补 open 列表。
         .select-menu-float（:131-146）：fixed / z 11000 / column gap space-1 4 / padding space-2 8 / border 1 border / radius radius-md 10 /
         底 card-solid 96%（＝Card）+ blur 24（代码 MaskBlur）/ shadow。left/top/minWidth/maxHeight 由 :33-41 按锚点矩形算 → 标称位，主控代码定位。
         .select-menu-option（:147-166）：flex gap 8 / min-height row-h 42 / padding 4 12 / radius radius-sm 6 / 13px / text；
         hover＝底 hover(:165)；.active＝底 accent-soft + 字混 accent(:166) + 600。右侧 v-if 选中项有 check svg（accent，:100）。
         标签是 .select-menu-option-label：grid gap 3，含 label + 可选 small（12px text-dim，:170）。
         .select-menu-empty（:102 + :168）：flex center / min-height row-h 42 / padding 12 / text-dim / 12px。
         一个代表浮层（三条选项 + 空态），v-if open → 默认 Collapsed。 -->
    <Border x:Name="SelectMenuFloat" Panel.ZIndex="11000" Visibility="Collapsed" MinWidth="180" MaxWidth="360"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,150,0,0"
            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="10" Padding="8">
        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 选中项：底 accent-soft + 右侧 check -->
                <Button Style="{StaticResource CmSelectOption}" Background="{DynamicResource AccentSoft}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="全部来源"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="Modrinth / CurseForge"/>
                        </StackPanel>
                        <ContentControl Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center"
                                        Foreground="{DynamicResource Accent}" Style="{DynamicResource Icon.Check}"/>
                    </Grid>
                </Button>
                <!-- 普通项（label 单行，无描述） -->
                <Button Style="{StaticResource CmSelectOption}">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" Text="Modrinth"/>
                </Button>
                <Button Style="{StaticResource CmSelectOption}">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" Text="CurseForge"/>
                </Button>
                <!-- .select-menu-empty「无可选项」：无选项时显示 → 默认 Collapsed -->
                <Border x:Name="SelectMenuEmpty" Visibility="Collapsed" MinHeight="42">
                    <TextBlock FontSize="12" Foreground="{DynamicResource Fg2}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="无可选项"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>

    </Grid>
</UserControl>
