<UserControl x:Class="Wuhuicl.App.Pages.CommunityPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="clr-namespace:Wuhuicl.App.Controls">

    <!-- 复刻 KAMUCL-1.1.5/src/renderer/src/views/CommunityView.vue（社区资源页）。
         取值原则：同一选择器多次声明只取最终生效值——:1080 与 :1081 两个后期块覆盖了 :705-960 的基础块。
         注：下面注释里的 CSS 令牌名省略了前导双横线（var(ctl-h) ＝ 源码的 ctl-h 令牌），XML 注释不允许出现双横线。
         检索/加载更多/下载已接 CommunityService（SearchBothAsync / GetModrinthVersionsAsync / GetCurseForgeFilesAsync /
         DownloadFileAsync / GetInstallDir），结果卡由 CommunityPage.xaml.cs 动态渲染；浏览模式 usesPagination=false → 无分页条。 -->

    <UserControl.Resources>

        <!-- .capsule：height calc(var(ctl-h) - 6px)=30 — :761；padding 0 16 — :762；radius 999 — :764；
             border 0（:763，:1080 又用 !important 重申一次）；底 transparent、字 13px text-dim — :765-767 -->
        <Style x:Key="Capsule" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" ctl:CssRadius.Pill="True" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- .capsule:hover{color:var(text)} — :773-775 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .capsule.active 基础是 color:var(on-accent)/600（:776-779），
             被 :1083 `.community-page .capsule.active{color:var(text);background:var(accent-soft)}` 覆盖 → 取后者 -->
        <Style x:Key="CapsuleActive" TargetType="Button" BasedOn="{StaticResource Capsule}">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- SelectMenu.vue：.select-menu-btn min-height 36 / padding 8 12 / radius 10 / 13px，chevron 14×14（台账 §13:291）
             + .select 的 padding-right:32 让位给箭头（台账 §0:19，styles.css:336-340） -->
        <Style x:Key="SelectBtn" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <ContentControl Width="14" Height="14" Margin="0,0,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Foreground="{DynamicResource Fg2}"
                                                Style="{DynamicResource Icon.ChevronDown}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Cm 前缀的本页局部资源（不与主题画刷键同名） ============ -->

        <!-- .spin（styles.css:683-691）：inline-block 14×14 / border 2 accent-soft / border-top-color accent
             / radius 50% / animation spin 0.8s linear infinite → 14×14 的细环 + 一段亮弧转圈。
             WPF 没有 backdrop/CSS border 单边色，这里用 accent-soft 环 + accent 四分之一弧旋转复刻；
             旋转用模板 EventTrigger(Loaded) 常驻 Storyboard，RepeatBehavior=Forever。本页所有加载态共用它。 -->

        <!-- .result-icon box-shadow 0 2px 8px color-mix(accent 8%, transparent) — CommunityView.vue:868。
             色取主题的 C.Accent 本体（DynamicResource 跟主题走），不透明度 0.08 = 8%，ShadowDepth 2/Direction 270 复刻 CSS 的 0 2px 偏移。 -->
        <DropShadowEffect x:Key="CmResultIconShadow" Color="{DynamicResource C.Accent}"
                          BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.08"/>

        <!-- .file-row.active box-shadow: inset 0 0 0 1px accent, 0 4px 14px accent-soft — :1027。
             inset 1px + border 1px（同 accent）→ WPF 用 2px accent 边框等价；外阴影用 accent 16%（accent-soft）DropShadow。 -->
        <DropShadowEffect x:Key="CmActiveRowShadow" Color="{DynamicResource C.Accent}"
                          BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.16"/>

        <!-- .modal（styles.css:545-555）＋ .download-modal/.modinstall-modal 共用的面板底：
             底 card-solid 96%（主题里即 Card）、border 1 border、radius radius-lg 14、padding space-5 24、shadow-lg（主题 PopShadow）。
             居中（原版 .modal-mask 是 flex center）。宽度/最大高在各自弹窗上单独给。 -->
        <Style x:Key="CmModal" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
        </Style>

        <!-- .file-row（:1004-1018）：它是 button，flex gap 12 / padding 12 16 / border 1 / radius radius-md 10
             / 底 card-2（CardSoft）/ 字 text / 左对齐。常态。 -->
        <Style x:Key="CmFileRow" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- .file-row:hover 的底色通道 0.16s（CommunityView.vue:1052）：HoverFade 默认键 Hover；
                 描边转 border-strong 是瞬时通道，保留 Setter -->
            <Setter Property="ctl:HoverFade.Enabled" Value="True"/>
            <Setter Property="ctl:HoverFade.DurationMs" Value="160"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="16,12" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .file-row.active（:1024-1028）：底 accent-soft + 边 accent + inset ring 1px accent + 外阴影 accent-soft。 -->
        <Style x:Key="CmFileRowActive" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect" Value="{DynamicResource CmActiveRowShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="16,12" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CmSectionTab ＝ .community-section（模板 :484 页签；样式 :735）。基础/未选中态：
             min-height var(ctl-h)=36 / padding 0 16 / radius var(radius-sm)=6 / 底 transparent /
             字色 var(text-dim)=Fg2 / font-size 13（=text-sm，font:inherit 只换字号）/ border 0 /
             display flex、align+justify center（ContentPresenter 居中）。
             transition background/color 160ms：原样无 :hover 规则改这两值，只有 .active 会切换，
             属静态渲染不出像素的死动画，故 WPF 不做动画、也不加 hover 触发器。
             .community-section:focus-visible（:738）outline 2 accent 只在键盘焦点态出现 → 本轮不画。 -->
        <Style x:Key="CmSectionTab" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CmSectionTabOn ＝ .community-section.active（样式 :736）：底 var(accent-soft)=AccentSoft、
             字色 var(accent-2)=AccentHi、字重 600（SemiBold）。默认 communityTab=browse（:55）→ 首枚「找资源」用本态。 -->
        <Style x:Key="CmSectionTabOn" TargetType="Button" BasedOn="{StaticResource CmSectionTab}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- CmSectionBadge ＝ .community-section span 计数徽标（样式 :737）：min-width 20 / height 20 /
             padding 0 5 / 底 var(card)=Card / radius 6（硬编码非令牌）/ 字号 11（硬编码）/ tabular-nums。
             文本色未写 → 继承所在页签的 text-dim（Fg2），故本样式不钉 Foreground、内部 TextBlock 也不写死。 -->
        <Style x:Key="CmSectionBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
        </Style>

        <!-- 结果卡的下载钮 .result-dl：原版虽写 class="btn btn-gold btn-sm"，但 ui-system.css:47 强制
             background card-2 / color text / box-shadow none / border 1 border —— 也就是最终态是"中性 ghost"，不是金色（本轮的修正点）。
             hover（ui-system.css:48）才翻成 accent 实心。尺寸沿用 .btn-sm（32/padding 12 4/13/radius 6）。 -->
        <Style x:Key="CmResultDl" TargetType="Button" BasedOn="{StaticResource BtnSm}">
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .menu-item（styles.css:597-616）：min-height row-h 42 / padding 4 12 / radius radius-sm 6 / 13px
             / 透明底 + text 字；hover 与 .active 都是 底 accent-soft + 字 accent-2（:617-624）。版本下拉的行用它。 -->
        <Style x:Key="CmMenuItem" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ctl:CssRadius.Round" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .select-menu-option（SelectMenu.vue:147-166）：flex align-center gap 8 / min-height row-h 42 / padding 4 12
             / radius radius-sm 6 / 透明底 + text 13px / 左对齐；hover 与 [data-focused] 是 底 hover（:165）。
             .active 版（:166 底 accent-soft + 字 混 accent + 600）由实例内联覆盖 Background。 -->
        <Style x:Key="CmSelectOption" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ctl:CssRadius.Round" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- .content：overflow-y auto + scrollbar-gutter:stable，padding 24 由宿主 Grid.Margin 给 — App.vue:2398-2404（契约 §6.5） -->
    <!-- 根容器改为 Grid：原版 .modal-mask / .menu-overlay / .float-menu / .select-menu-float 都是 position fixed
         （视口级、z-index 高于内容）。WPF 等价物 = 与 ScrollViewer 同级、声明在后并带 Panel.ZIndex 的覆盖层：
         既盖得住整页，又不被外层 ScrollViewer 的裁剪/滚动带跑。所有此类浮层默认 Collapsed，由主控在代码里定位与开关
         （SelectMenu.vue:33-41、ver-filter-menu 的 top calc(100%+4px)/left/right 都是运行时按锚点矩形算的）。 -->
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="0,0,8,0">

        <!-- .page：max-width 940 + margin 0 auto — :708-714（:1081 只换了 display/gap，940 这条仍然生效）
             .community-page：display grid / grid-template-columns minmax(0,1fr)（单列）/ gap 12px !important — :1081 -->
        <Grid x:Name="BrowseBody" MaxWidth="940" HorizontalAlignment="Center" VerticalAlignment="Top" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <!-- 单列 grid gap 12（:1116）下的行序：page-head / community-sections / instance-row / search-card / results。
                 新增分区页签占 Row2，其后各项整体下移一行（instance-row→4 / search-card→6 / results→8）。 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ .page-head（:461-464）============ -->
            <!-- flex column gap 4 — styles.css:498-502；.community-page>.page-head{margin:0} — :1081 -->
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource PageTitle}" Text="社区资源"/>
                <!-- .content .page-title 24px/Bold — ui-system.css:12；.page-sub 13px Fg2 — styles.css:509-512 -->
                <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,0"
                           Text="搜索并下载 Modrinth / CurseForge 上的 Mod、整合包、资源包、光影与数据包"/>
            </StackPanel>

            <!-- ============ 分区页签条 .community-sections（模板 :484；样式 :734）============
                 role=tablist。它是 .community-page（:1116 单列 grid）的网格项：align-self flex-start → 顶对齐、取内容高；
                 justify-self 默认 stretch → 横轴撑满列宽（≤940），并非 fit-content（只有 .kind-capsules 才 fit-content）。
                 flex / align-items center / gap 6 / padding 4 / 底 var(card-2)=CardSoft / border 1 var(border)=Line /
                 radius var(radius-md)=10（styles.css:59，非 999 → 用 CornerRadius 不用 Pill）。 -->
            <Border Grid.Row="2" Background="{DynamicResource CardSoft}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="4"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <!-- 页签横排 gap 6（:734）→ 首枚右留 6，第二枚不加左距 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- .community-section（模板 :484 / 样式 :735）；默认 communityTab=browse（:55）→ 本页签落 .active（:736） -->
                    <Button x:Name="TabBrowse" Style="{StaticResource CmSectionTabOn}" Content="找资源" Margin="0,0,6,0" Click="TabBrowse_Click"/>
                    <!-- 第二枚 .community-section（未选中：transparent 底 / text-dim=Fg2 字）。内含 .community-section span 徽标（:737）。
                         徽标数字源 favorites.length（:484），无数据源 → 几何按 :737 出壳、计数占位。 -->
                    <Button x:Name="TabFavs" Style="{StaticResource CmSectionTab}" Click="TabFavs_Click">
                        <!-- .community-section gap 8（:735）＝文本与徽标横向间距 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="已收藏 MOD" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource CmSectionBadge}" Margin="8,0,0,0">
                                <TextBlock x:Name="FavBadge" Text="0" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============ 版本行 .filter-row.instance-row（:466-470）============ -->
            <!-- margin/padding 0 + justify-content flex-end — :1080（gap 12 同为 :1080）；
                 align-items baseline — :706。注：:1081 在单列下把它改回 flex-start，本处按台账 §7 的右对齐做 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- .instance-label（模板 :467，样式 :706）：只有 align-self baseline / line-height 1.4 /
                     white-space nowrap，字号与字色都没写 → 跟 body 的 text-md 14 与 text 色，
                     所以这里不能用 Dim（那是 13＋text-dim，是给 .muted 用的）。
                     align-items:baseline 在 WPF 的横向 StackPanel 里没有对应物（基线对齐只在文本内部），
                     这里按垂直居中做，与相邻按钮的文字基线差约 2px，记进已知偏差。 -->
                <TextBlock Text="选择版本" FontSize="14" LineHeight="19.6"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <!-- .instance-filter{max-width:420px} — :1080；.filter-select{flex:1;min-width:140} — :786-790
                     flex:1 在本行（宽 ≈916）会被 max-width 夹到 420 → WPF 直接写 420 -->
                <Button x:Name="InstanceFilter" Style="{StaticResource SelectBtn}" Width="420"
                        HorizontalAlignment="Right" Click="InstanceSelect_Click">
                    <!-- 占位：等社区检索的实例选择接入（选项来自已安装列表，本轮不绑） -->
                    <TextBlock Text="选择实例…" Foreground="{DynamicResource Fg3}"/>
                </Button>
                <!-- .btn.btn-ghost.btn-sm — :469；btn-sm = 32 高 / padding 12,4 / 13px（§0:19 + 契约 §2） -->
                <Button Style="{StaticResource BtnGhost}" MinHeight="32" Padding="12,4" FontSize="13"
                        Margin="12,0,0,0" Content="使用当前实例" Click="UseInstance_Click"/>
            </StackPanel>

            <!-- ============ 搜索卡 .card.search-card（:472-539）============ -->
            <!-- padding 16 / column / gap 12 — :1080（基线 :717-721 也是 column gap 12）；卡片平面、无阴影（契约 §6.4） -->
            <Border Grid.Row="6" Style="{StaticResource CardTight}">
                <StackPanel>

                    <!-- ·· 分类胶囊 .kind-capsules（:473-485，样式 :734-744）··
                         width:fit-content → HorizontalAlignment=Left — :743
                         background var(card-2)=CardSoft — :742；border 1 var(border) — :740；radius 999 — :741
                         padding 3 — :739；flex wrap — :736-738；gap 2 — :737
                         注：:1081 另把 .community-page .kind-capsules 改成 padding 0 0 8px + border-bottom，本轮按台账 §7 出胶囊壳 -->
                    <Border Background="{DynamicResource CardSoft}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" ctl:CssRadius.Pill="True" Padding="3" HorizontalAlignment="Left">
                        <!-- position:relative — :735；Grid 同格叠放＝绝对定位的等价物（Canvas 层不吃 Measure，指示块再大也不会撑宽胶囊壳） -->
                        <Grid>
                            <Canvas x:Name="CapsulesHost" IsHitTestVisible="False">
                                <!-- .capsule-blob：radius 999 — :748；底 :749 的 accent-grad 被 :1080 覆盖成 accent-soft + 无阴影；
                                     left/top/width/height 在原版全是 JS 内联（:64-74/:89-95）→ 按契约 §6.8 留独立 Border + x:Name，
                                     坐标由本页 MoveBlob() 量取，动画等主控的 Storyboard 库；pointer-events:none — :752 -->
                                <Border x:Name="CapsuleBlob" Width="0" Height="0" Opacity="0" ctl:CssRadius.Pill="True"
                                        Background="{DynamicResource AccentSoft}"/>
                            </Canvas>

                            <!-- z-index:1 — :757；每格右边距 2 = gap 2（:737），最后一格不留 -->
                            <WrapPanel x:Name="KindCapsules">
                                <Button x:Name="CapMod" Style="{StaticResource CapsuleActive}" Content="Mod"
                                        Margin="0,0,2,0" Click="Capsule_Click"/>
                                <Button x:Name="CapModpack" Style="{StaticResource Capsule}" Content="整合包"
                                        Margin="0,0,2,0" Click="Capsule_Click"/>
