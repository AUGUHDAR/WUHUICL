            <Border x:Name="ResultsBlock" Style="{StaticResource Panel}" Padding="12,16" MaxHeight="300"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
