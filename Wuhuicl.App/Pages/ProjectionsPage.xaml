<UserControl x:Class="Wuhuicl.App.Pages.ProjectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 资源管理 · 投影。复刻 KAMUCL-1.1.10/src/renderer/src/views/ProjectionsView.vue（1.1.10 新增页）。
         该页与录像页共用同一族样式（.recordings-page / .recording-*，ProjectionsView.vue:58 直接挂 recordings 类），
         两个 scoped 块取后写的 :95（基线 :94 只在被覆盖处作括号注记），根 max-width 1440 / gap 12（:95 覆盖 :94 的 20）。
         契约 §5 的 LaunchSession 白名单里没有任何投影字段，所以本页不写一个 Binding，
         四行列表、库路径、分页文案全是占位，等 projections:list 接入（ProjectionsView.vue:31 的 IPC）。
         页内样式键统一 Prj 前缀，避开契约 §4 的画刷键名；几何与 RecordingsPage 的 Rec 键完全同值。
         注释里的 CSS 变量一律去掉前导负号写（border / text-dim / card-2），XML 注释不允许连续两个减号。 -->
    <UserControl.Resources>

        <!-- .recording-row：flex align-center / min-height 72 / padding 12 0 / border-bottom 1px — :95（行高与边线同一族） -->
        <Style x:Key="PrjRow" TargetType="Border">
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- .recording-info strong：14 / 700 / overflow-wrap break-word（:95）→ WPF 用 Wrap 表达不断版 -->
        <Style x:Key="PrjName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- .recording-info > div.muted：14 继承 + text-dim，无省略号规则 → 允许换行 -->
        <Style x:Key="PrjMeta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- .path：12px；.recording-info .path 单行省略（:94）；等宽取契约 §2 的 MonoFont -->
        <Style x:Key="PrjPath" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- details 的 summary：无底无边的文字按钮 + Icon.ChevronDown 替身 marker，开合由代码切 Visibility（与录像页同一配方） -->
        <Style x:Key="PrjSummary" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ContentControl Tag="SummaryChevron" Width="14" Height="14" Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource Icon.ChevronDown}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .btn.btn-ghost.btn-sm（:83 的定位文件 / 转换按钮）：BtnSm 叠 BtnGhost 的 card-2 底 + 描边 -->
        <Style x:Key="PrjRowBtn" TargetType="Button" BasedOn="{StaticResource BtnSm}">
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .status-strip：accent-soft 底 / radius 10 / padding 16 12 / 13px — ui-system.css:41 -->
        <Style x:Key="PrjStatusStrip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <!-- 宿主 .content 是 scrollbar-gutter:stable → 滚动条槽常驻，契约 §6.5；右侧 8 是槽宽 -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">

        <!-- .recordings-page：max-width 1440 / margin 0 auto / gap 12（:95 覆盖基线 20）→ 子项 Margin 0,0,0,12 -->
        <StackPanel MaxWidth="1440" HorizontalAlignment="Center" VerticalAlignment="Top" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- ==================== .page-head.recording-heading ====================
                 row / space-between / align-center / gap 16 / flex-wrap — :95。文案照 ProjectionsView.vue:60 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}">
                        <Run Text="投影"/><Run FontSize="13" FontWeight="Normal" Foreground="{DynamicResource Fg2}" Text=" 4 个"/>
                        <!-- 占位：等投影列表接入（原版这里是 data.entries.length，:60） -->
                    </TextBlock>
                    <!-- p.muted：margin 4 0 / 14 继承 / text-dim — :60/:94 -->
                    <TextBlock Margin="0,4" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                               Text="汇总全部绑定目录与隔离实例中的投影文件。"/>
                </StackPanel>

                <!-- .actions gap 8（:95）；三个按钮 打开=ghost / 导入投影…=gold / 刷新=ghost（:60，↻ 是原文字形，契约 §3） -->
                <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenLibrary" Style="{StaticResource BtnGhost}" Content="打开收藏文件夹"
                            Margin="0,0,8,0" ToolTip="打开收藏目录（未接入：projections:open，:42）"/>
                    <Button x:Name="BtnImport" Style="{StaticResource BtnGold}" Content="导入投影…"
                            Margin="0,0,8,0" ToolTip="选择 .litematic / .schem / .schematic / .nbt 导入（未接入：projections:import，:48）"/>
                    <Button x:Name="BtnRefresh" Style="{StaticResource BtnGhost}" Content="↻ 刷新" Click="Refresh_Click"
                            ToolTip="重新读取投影目录（原版 15 秒还有静默自刷新，:53）"/>
                </WrapPanel>
            </Grid>

            <!-- ==================== .recording-library ====================
                 flex / gap 8 / align-center / 12px — :95；.recording-help margin-left auto 顶到行尾。
                 文案照 :61；Grid 没有字号依赖属性，继承型字号写成附加属性 TextElement.FontSize -->
            <Grid Margin="0,0,0,12" TextElement.FontSize="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="导入与收藏保存位置：" Foreground="{DynamicResource Fg2}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="LibraryPathText" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                               ToolTip="完整库路径" Text="D:\Games\Wuhuicl\schematics\library">
                        <!-- 占位：等 data.library 接入（:61）；.recording-library .path 是 overflow-wrap anywhere（:95）→ 用换行而非省略号 -->
                    </TextBlock>
                </Grid>

                <!-- .recording-help：margin-left auto + line-height 1.7（:95）→ LineHeight 20；MaxWidth 420 是防长句拉爆的工程近似（同录像页） -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="420">
                    <Button x:Name="HelpSummary" Style="{StaticResource PrjSummary}" Content="使用说明"
                            Tag="HelpBody" Click="Disclosure_Toggle_Click"/>
                    <TextBlock x:Name="HelpBody" Visibility="Collapsed" Margin="0,4,0,0"
                               FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" LineHeight="20"
                               Text="自动汇总全部已绑定目录中的实例、共享目录与收藏，原投影保持原位。按住投影名称可拖出，勾选后可一起拖出。复制时校验完整性，同名文件自动添加序号。通过「转换」检查格式与游戏版本差异，再生成副本。"/>
                </StackPanel>
            </Grid>

            <!-- ==================== .recording-workspace.card ====================
                 padding 16 / gap 12 / min-height 240 / align-content start — :95；复用 §2 CardTight -->
            <Border Style="{StaticResource CardTight}" MinHeight="240" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Top">

                    <!-- ····· .recording-filters ·····
                         列集 minmax(190px,1.5fr) minmax(160px,1fr) 130px 130px + gap 12 — :95；
                         视觉顺序 搜索 / 文件夹 / 格式 / 位置（:95 用 grid-column:1、grid-row:1 把搜索框提到首轨）。
                         格式下拉五项照 :66（全部格式 + 四个扩展名），位置三项照 :67 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" MinWidth="190"/>
                            <ColumnDefinition Width="*" MinWidth="160"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" FontSize="13"
                                     TextChanged="Search_TextChanged"/>
                            <TextBlock x:Name="SearchHint" Text="搜索投影名称、实例或路径…" FontSize="13"
                                       Foreground="{DynamicResource Fg3}" Margin="13,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- SelectMenu 替身：与 §2 Input 同源度量，直接用隐式 ComboBox 样式（同录像页） -->
                        <ComboBox Grid.Column="1" x:Name="FolderSelect" Margin="12,0,0,0" FontSize="13"
                                  SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <!-- 占位：等 settings.folders 接入（:18 的 folderOptions 由 folders 映射成「名 · 路径」） -->
                            <ComboBoxItem>全部已绑定文件夹</ComboBoxItem>
                            <ComboBoxItem>主库 · D:\Games\Wuhuicl</ComboBoxItem>
                            <ComboBoxItem>外置盘 · E:\MC-Sessions</ComboBoxItem>
                        </ComboBox>
                        <ComboBox Grid.Column="2" x:Name="KindSelect" Margin="12,0,0,0" FontSize="13"
                                  SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem>全部格式</ComboBoxItem>
                            <ComboBoxItem>.litematic</ComboBoxItem>
                            <ComboBoxItem>.schem</ComboBoxItem>
                            <ComboBoxItem>.schematic</ComboBoxItem>
                            <ComboBoxItem>.nbt</ComboBoxItem>
                        </ComboBox>
                        <ComboBox Grid.Column="3" x:Name="SourceSelect" Margin="12,0,0,0" FontSize="13"
                                  SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem>全部位置</ComboBoxItem>
                            <ComboBoxItem>集中收藏</ComboBoxItem>
                            <ComboBoxItem>游戏目录</ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <!-- ····· v-if error 的 .card（:69）：常态收起 ····· -->
                    <Border x:Name="ErrorCard" Style="{StaticResource Panel}" Padding="22" Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- 占位：等 projections:list 的错误文案接入（:32 的 errText） -->
                            <TextBlock Text="投影目录读取失败。" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="ErrorRetryBtn" Style="{StaticResource BtnGhost}" Content="重试"
                                    Click="Refresh_Click"/>
                        </WrapPanel>
                    </Border>

                    <!-- ····· v-if warnings.length 的 details.card（:70） ····· -->
                    <Border x:Name="WarningBlock" Style="{StaticResource Panel}" Padding="22" Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Button x:Name="WarningSummary" Style="{StaticResource PrjSummary}" FontSize="14"
                                    Content="部分目录未读取（2）" Tag="WarningBody" Click="Disclosure_Toggle_Click"/>
                            <StackPanel x:Name="WarningBody" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock FontSize="14" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                                           Text="E:\MC-Sessions\旧存档盘：卷不可访问（未插入）。"/>
                                <TextBlock FontSize="14" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="D:\Games\Wuhuicl\instances\1.8.9-Forge：schematics 目录权限不足。"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ····· v-if loading 的 .status-strip（:76） ····· -->
                    <Border x:Name="StatusStrip" Style="{StaticResource PrjStatusStrip}" Visibility="Collapsed">
                        <TextBlock Text="正在更新投影列表…" FontSize="13" VerticalAlignment="Center"/>
                    </Border>

                    <!-- ····· .recording-controls：grid gap 8 / padding 8 0 / border-bottom 1px（:95）；v-if filtered.length（:71） ····· -->
                    <Border x:Name="ControlsRow" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                        <StackPanel>
                            <WrapPanel>
                                <!-- 四项照 :72 -->
                                <Button x:Name="SelectPageBtn" Style="{StaticResource BtnGhost}" Content="选择当前页"
                                        Margin="0,0,8,8" Click="SelectPage_Click"/>
                                <Button x:Name="SelectAllBtn" Style="{StaticResource BtnGhost}"
                                        Content="全选筛选结果（4）" Margin="0,0,8,8" Click="SelectAll_Click"/>
                                <TextBlock x:Name="SelectedCount" Text="已选 0 项" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <Button x:Name="ClearSelectionBtn" Style="{StaticResource BtnGhost}" Content="清空"
                                        Margin="0,0,0,8" Visibility="Collapsed" Click="ClearSelection_Click"/>
                            </WrapPanel>

                            <!-- .operation-row：v-if selected.length（:73）；
                                 .operation-row :deep(.select-menu-btn){max-width:360px}（:94） -->
                            <WrapPanel x:Name="OperationRow" Visibility="Collapsed" Margin="0,8,0,0">
                                <Button Style="{StaticResource BtnGold}" Content="收集到当前文件夹收藏" Margin="0,0,8,8"
                                        ToolTip="未接入：projections:operate collect（:48）"/>
                                <Button Style="{StaticResource BtnGhost}" Content="提取到文件夹…" Margin="0,0,8,8"
                                        ToolTip="未接入：projections:operate export（:48）"/>
                                <ComboBox x:Name="TargetSelect" MaxWidth="360" FontSize="13"
                                          Margin="0,0,8,8" SelectedIndex="0" SelectionChanged="Target_Changed">
                                    <!-- 第一项是 SelectMenu 的 placeholder 槽（:73 选择目标实例） -->
                                    <ComboBoxItem>选择目标实例</ComboBoxItem>
                                    <ComboBoxItem>1.20.1 · Fabric</ComboBoxItem>
                                    <ComboBoxItem>1.21.4 · NeoForge</ComboBoxItem>
                                </ComboBox>
                                <Button x:Name="CopyToInstanceBtn" Style="{StaticResource BtnGhost}" Content="复制到实例"
                                        Margin="0,0,8,8" IsEnabled="False"
                                        ToolTip="未接入：确认弹窗后 projections:operate dispatch（:73/:89）"/>
                                <Button Style="{StaticResource BtnDanger}" Content="移入回收站" Margin="0,0,0,8"
                                        ToolTip="未接入：确认弹窗后 projections:operate trash（:73/:89）"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ····· .recording-list（:79）：每行 checkbox / info / 双按钮（定位文件 :83 + 转换 :83），
                         元信息格式照 :82：.kind · 来源 · 大小 · N 方块 · 游戏版本 · 修改时间 —— 与录像页的「时长」段不同 ····· -->
                    <StackPanel x:Name="RecordingList" Margin="0,4,0,0">

                        <Border x:Name="Row1" Style="{StaticResource PrjRow}" Tag="litematic|集中收藏">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RowCheck1" Style="{StaticResource Check}" VerticalAlignment="Center"
                                          Checked="Row_Check_Changed" Unchecked="Row_Check_Changed"
                                          ToolTip="选择 城堡大厅.litematic"/>
                                <StackPanel Grid.Column="1" Margin="16,0" Cursor="SizeAll"
                                            ToolTip="按住拖出投影文件（:82 title；拖放需 projections:drag，:38 未接入）">
                                    <TextBlock x:Name="RowName1" Style="{StaticResource PrjName}"
                                               ToolTip="城堡大厅.litematic" Text="城堡大厅.litematic"/>
                                    <TextBlock x:Name="RowMeta1" Style="{StaticResource PrjMeta}" Margin="0,6,0,0"
                                               Text=".litematic · 集中收藏 · 1.2 MB · 18432 方块 · 1.20.1 · 2026/9/28 14:20:11"/>
                                    <TextBlock x:Name="RowPath1" Style="{StaticResource PrjPath}" Margin="0,6,0,0"
                                               ToolTip="D:\Games\Wuhuicl\schematics\library\城堡大厅.litematic"
                                               Text="D:\Games\Wuhuicl\schematics\library"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrjRowBtn}" Content="定位文件" Margin="0,0,8,0"
                                            ToolTip="未接入：projections:open（:42）"/>
                                    <Button Style="{StaticResource PrjRowBtn}" Content="转换"
                                            ToolTip="未接入：ProjectionConvert（:59，检查格式与游戏版本差异后生成副本）"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="Row2" Style="{StaticResource PrjRow}" Tag="schem|游戏目录">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RowCheck2" Style="{StaticResource Check}" VerticalAlignment="Center"
                                          Checked="Row_Check_Changed" Unchecked="Row_Check_Changed"
                                          ToolTip="选择 自动西瓜场.schem"/>
                                <StackPanel Grid.Column="1" Margin="16,0" Cursor="SizeAll"
                                            ToolTip="按住拖出投影文件（:82 title）">
                                    <TextBlock x:Name="RowName2" Style="{StaticResource PrjName}"
                                               ToolTip="自动西瓜场.schem" Text="自动西瓜场.schem"/>
                                    <TextBlock x:Name="RowMeta2" Style="{StaticResource PrjMeta}" Margin="0,6,0,0"
                                               Text=".schem · 游戏目录 · 356.4 KB · 2048 方块 · 1.20.1 · 2026/9/30 19:02:45"/>
                                    <TextBlock x:Name="RowPath2" Style="{StaticResource PrjPath}" Margin="0,6,0,0"
                                               ToolTip="D:\Games\Wuhuicl\instances\1.20.1_Fabric\schematics\自动西瓜场.schem"
                                               Text="D:\Games\Wuhuicl\instances\1.20.1_Fabric\schematics"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrjRowBtn}" Content="定位文件" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource PrjRowBtn}" Content="转换"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="Row3" Style="{StaticResource PrjRow}" Tag="nbt|游戏目录">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RowCheck3" Style="{StaticResource Check}" VerticalAlignment="Center"
                                          Checked="Row_Check_Changed" Unchecked="Row_Check_Changed"
                                          ToolTip="选择 史蒂夫雕像.nbt"/>
                                <StackPanel Grid.Column="1" Margin="16,0" Cursor="SizeAll"
                                            ToolTip="按住拖出投影文件（:82 title）">
                                    <TextBlock x:Name="RowName3" Style="{StaticResource PrjName}"
                                               ToolTip="史蒂夫雕像.nbt" Text="史蒂夫雕像.nbt"/>
                                    <TextBlock x:Name="RowMeta3" Style="{StaticResource PrjMeta}" Margin="0,6,0,0"
                                               Text=".nbt · 游戏目录 · 88.1 KB · 512 方块 · 1.21.4 · 2026/10/2 10:15:30"/>
                                    <TextBlock x:Name="RowPath3" Style="{StaticResource PrjPath}" Margin="0,6,0,0"
                                               ToolTip="D:\Games\Wuhuicl\instances\1.21.4_NeoForge\schematics\史蒂夫雕像.nbt"
                                               Text="D:\Games\Wuhuicl\instances\1.21.4_NeoForge\schematics"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrjRowBtn}" Content="定位文件" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource PrjRowBtn}" Content="转换"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 第四行是「超长文本」用例：名称折行（:95 overflow-wrap break-word）、路径省略号（:94），
                             都不许把 72 高的行撑破；:last-child 的无边框由 ApplyFilter 现算 -->
                        <Border x:Name="Row4" Style="{StaticResource PrjRow}" Tag="litematic|集中收藏">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RowCheck4" Style="{StaticResource Check}" VerticalAlignment="Center"
                                          Checked="Row_Check_Changed" Unchecked="Row_Check_Changed"
                                          ToolTip="选择 超长名字的工业全自动化处理中枢与配套物流系统完整蓝图.litematic"/>
                                <StackPanel Grid.Column="1" Margin="16,0" Cursor="SizeAll"
                                            ToolTip="按住拖出投影文件（:82 title）">
                                    <TextBlock x:Name="RowName4" Style="{StaticResource PrjName}"
                                               Text="超长名字的工业全自动化处理中枢与配套物流系统完整蓝图.litematic"/>
