                                </Border>

                                <!-- .connection-details 最终态：padding 12 0 / 只留 1px 下边线 / 透明底（ui-system.css:77），
                                     summary min-height 36 / 13px（connection.css:42 + :114）。折叠由本页代码切 Visibility。 -->
                                <Border Margin="0,16,0,0" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="0,0,0,1" Padding="0,12">
                                    <StackPanel>
                                        <Button x:Name="BtnLogSummary" Style="{StaticResource SrvSummary}"
                                                HorizontalAlignment="Stretch" Click="DetailsToggle_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl x:Name="LogChevron" Grid.Column="0" Width="14"
                                                                Height="14" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource Fg2}"
                                                                Style="{DynamicResource Icon.ChevronRight}"/>
                                                <!-- 条目数原文是日志条数（summary 结构见 FrpPanel.vue:148）// 占位：等联机功能接入 -->
                                                <TextBlock Grid.Column="2" Text="同步与检测日志 · 3 条"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <!-- .connection-log-viewport：max-height 180 → 220（connection.css:83 + :114）/
                                             padding 12 16（:92）/ radius 10（:91）/ card-2 底 + border 1（:89-90）/
                                             等宽 12px 行高 1.7（:93-95）/ 行间距 2px（:88 的 gap 2px） -->
                                        <Border x:Name="LogBlock" Visibility="Collapsed" Margin="0,12,0,0"
                                                MaxHeight="220" CornerRadius="10" Padding="16,12"
                                                Background="{DynamicResource CardSoft}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <ScrollViewer x:Name="LogViewport" VerticalScrollBarVisibility="Visible"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <!-- 每行一条，格式照 FrpPanel.vue:148 的 stream + text 拼法 // 占位：等联机功能接入 -->
                                                <StackPanel>
                                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               Margin="0,0,0,2" LineHeight="20" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Fg2}"
                                                               Text="[stdout] 已从 默认文件夹 合并 4 条服务器记录"/>
                                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               Margin="0,0,0,2" LineHeight="20" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Fg2}"
                                                               Text="[stdout] ping play.chenguang.cn 32ms"/>
                                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               Margin="0,0,0,2" LineHeight="20" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Fg2}"
                                                               Text="[stderr] sky4.mcexample.top 连接超时"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- .server-connect：width 100% / justify-content space-between / min-height row-h 42
                                     （ServersView.vue:498）。ServerDetails.vue:30 的 scoped 另写了 min-height 44，
                                     台账 §5 记的最终值是 42，本页按 42 出，冲突留在这条注释里。 -->
                                <Button Margin="0,16,0,0" Style="{StaticResource ConnectBtnGold}" MinHeight="42"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="启动并连接" VerticalAlignment="Center"/>
                                        <!-- 右上箭头是文字字形 ↗（ServerDetails.vue:23，契约 §3 允许的字形） -->
                                        <TextBlock Grid.Column="1" Text="↗" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <!-- .server-secondary（= .connection-actions）：gap space-1 4（:499）+ 每个 .btn flex 1 /
                                     padding 4 8（:500）+ justify-content flex-end（ServerDetails.vue:30） -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource ConnectBtnGhost}" Padding="8,4"
                                            Content="编辑服务器"/>
                                    <!-- 原版这里是 details/summary 浮层里再藏一个删除按钮（ServerDetails.vue:24 + scoped :30
                                         的 position absolute / right 0 / z-index 4）。WPF 没有 position absolute，
                                         浮层留独立命名元素 BtnDelete（默认 Collapsed），接线时可换成 Popup。 -->
                                    <Button x:Name="BtnMore" Grid.Column="2" Style="{StaticResource ConnectBtnGhost}"
                                            Padding="8,4" Content="更多" Click="More_Click"/>
                                    <Button x:Name="BtnDelete" Grid.Column="4" Style="{StaticResource ConnectBtnDanger}"
                                            Padding="8,4" Content="删除服务器" Visibility="Collapsed"/>
                                </Grid>

                                <!-- .server-footnote：12px（ServersView.vue:502），文案 ServerDetails.vue:25 -->
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource Micro}" LineHeight="20"
                                           TextWrapping="Wrap"
                                           Text="状态检测失败不一定代表无法进入游戏，仍可尝试连接。"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============ 空态一：完全没有服务器（模板 :370-372 的 v-else-if 分支，与上面的 workspace 互斥）
                 .connection-panel + .connection-empty：min-height 220 / padding 24 / column gap 16 / 居中 /
                 h3 16px（text-lg）/ p 12px text-dim 行高 1.7 max-width 320 居中（connection.css:68-70）
                 内层 .connection-symbol：48×48 + border 1 + radius 10 + accent-soft 底，内 svg 26×26（connection.css:21-23） -->
            <Border x:Name="EmptyAll" Visibility="Collapsed" Style="{StaticResource SrvPanel}" Margin="0,16,0,0">
                <StackPanel MinHeight="220" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <!-- 原版这里是一张手绘的「双层机箱」svg（ServersView.vue:371），§3 的 43 个图标没有对应项，
                             契约 §3 禁止自造几何，故用 Icon.Apps 顶位。 -->
                        <ContentControl Width="26" Height="26" Foreground="{DynamicResource AccentHi}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Style="{DynamicResource Icon.Apps}"/>
                    </Border>
                    <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                               HorizontalAlignment="Center" Text="下一站，去哪个世界？"/>
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Micro}" FontSize="12" LineHeight="20"
                               MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                               Text="添加好友的服务器地址，或同步游戏内的收藏。关联实例后即可快速进入。"/>
                    <Button Style="{StaticResource ConnectBtnGold}" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Content="添加第一个服务器"/>
                </StackPanel>
            </Border>

            <!-- ============ 空态二：搜索无结果（模板 :373 分支） ============ -->
            <Border x:Name="EmptyNoMatch" Visibility="Collapsed" Style="{StaticResource SrvPanel}" Margin="0,16,0,0">
                <StackPanel MinHeight="220" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="Bold" TextAlignment="Center"
                               HorizontalAlignment="Center" Text="没有找到匹配的服务器"/>
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Micro}" FontSize="12" LineHeight="20"
                               MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                               Text="试试其他名称、地址或关键词。"/>
                    <Button x:Name="BtnClearSearch" Style="{StaticResource ConnectBtnGhost}" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Content="清除搜索" Click="ClearSearch_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ 三个模态（ServersView.vue:383-440）============
             .modal-mask.connection-modal：fixed inset 0 / z 10000 / flex centre / 底 mask / blur 10
             （styles.css:527 + connection.css:4）。blur 需要代码侧的 MaskBlur，这里只给 Overlay 底色。
             .modal：min(460px,100vw-48px) / max-h calc(100vh-96px) / padding 24 / radius 14 /
             border 1 / 底 Card / shadow-lg（styles.css:545）。
             .connection-muted：text-dim 12px line-height 1.7（connection.css:8）。
             .modal-label：13px text-dim，margin 16 0 8（styles.css 通用模态标签）。
             .connection-modal .input/.select：宽 100% / min-h 36 / padding 8 12 / radius 10 /
             底 card-2 / 字 text 13（connection.css:13）；.connection-modal .btn：min-h 36 /
             min-w 42 / gap 8 / padding 8 16 / 12px（connection.css:11）。 -->
        <Border x:Name="ModalServerEdit" Background="{DynamicResource Overlay}" Visibility="Collapsed"
                Panel.ZIndex="60">
            <Border Style="{StaticResource Panel}" Width="460" MaxHeight="764" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ServerEditTitle" Text="添加服务器" FontSize="16" FontWeight="Bold"/>
                    <TextBlock FontSize="12" LineHeight="20" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                               Text="只修改启动器记录，不会覆盖游戏内服务器列表。"/>
                    <TextBlock x:Name="ServerEditError" FontSize="12" LineHeight="20" Margin="0,8,0,0"
                               Foreground="{DynamicResource Danger}" Visibility="Collapsed"/>
                    <TextBlock Text="服务器名称" FontSize="13" Foreground="{DynamicResource Fg2}" Margin="0,16,0,8"/>
                    <TextBox Style="{StaticResource Input}" MaxLength="30" FontSize="13"/>
                    <TextBlock Text="服务器地址" FontSize="13" Foreground="{DynamicResource Fg2}" Margin="0,16,0,8"/>
                    <TextBox x:Name="ServerEditAddr" Style="{StaticResource Input}" FontSize="13"
                             FontFamily="{StaticResource MonoFont}" MaxLength="256"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource BtnGhost}" MinWidth="42" Content="取消"
                                Click="SrvCancel_Click"/>
                        <Button Style="{StaticResource BtnGold}" MinWidth="42" Margin="12,0,0,0" Content="保存"
                                Click="SrvSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="ModalServerDelete" Background="{DynamicResource Overlay}" Visibility="Collapsed"
                Panel.ZIndex="60">
            <Border Style="{StaticResource Panel}" Width="460" MaxHeight="764" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="删除服务器" FontSize="16" FontWeight="Bold"/>
                    <!-- .confirm-text：14px / line-height 1.7 / overflow-wrap anywhere（styles.css:561） -->
                    <TextBlock x:Name="ServerDeleteText" FontSize="14" LineHeight="24" TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Text="确定要从启动器删除该服务器吗？这只会删除启动器记录，不会修改 Minecraft 的 servers.dat；下次同步时，游戏内仍存在的条目可能再次出现。"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource BtnGhost}" MinWidth="42" Content="取消"
                                Click="SrvCancel_Click"/>
                        <Button Style="{StaticResource BtnDanger}" MinWidth="42" Margin="12,0,0,0" Content="确认删除"
                                Click="SrvDelete_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="ModalServerJoin" Background="{DynamicResource Overlay}" Visibility="Collapsed"
                Panel.ZIndex="60">
            <Border Style="{StaticResource Panel}" Width="460" MaxHeight="764" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ServerJoinTitle" Text="进入服务器" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="选择游戏实例（将保存关联并启动）" FontSize="13"
                               Foreground="{DynamicResource Fg2}" Margin="0,16,0,8"/>
                    <ComboBox x:Name="ServerJoinInstance" MinHeight="36" FontSize="13"/>
                    <TextBlock x:Name="ServerJoinHint" Style="{StaticResource Micro}" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource BtnGhost}" MinWidth="42" Content="取消"
                                Click="SrvCancel_Click"/>
                        <Button Style="{StaticResource BtnGold}" MinWidth="42" Margin="12,0,0,0" Content="启动"
                                Click="SrvJoin_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
