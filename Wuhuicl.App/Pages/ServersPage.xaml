<UserControl x:Class="Wuhuicl.App.Pages.ServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Wuhuicl.App.Controls">

    <!-- 服务器页，复刻 KAMUCL-1.1.5/src/renderer/src/views/ServersView.vue（:356-380 正文）
         加同族共用组件层 components/connection/*.vue（几何全部在 connection.css，见台账 §12）。
         ServersView 的 style 块是「非 scoped」的（ServersView.vue:448-531），靠 .servers-page 后代选择器
         压 connection.css，所以本页所有数值一律取该块尾部的最终声明（:512-531），基线只在注释里留痕。

         导航位置：App.vue:182-185 ——「服务器」是「资源管理」的子项，和主导航的「联机」（App.vue:117）
         是两个互不相干的 view；原版 ServersView 内部没有任何页签，所以本页也不放 .connect-tabs
         （那条页签带只有 VoxLinkPanel.vue:402 的「创建房间/加入房间/公共大厅」在用）。

         数据：契约 §5 的 LaunchSession 白名单里没有任何服务器条目、ping、实例关联字段，
         所以整页不写一条 Binding，行与详情全部是照原版文案写死的占位内容（每块注释 // 占位：等联机功能接入）。

         注：下面 XML 注释里的 CSS 令牌一律去掉前导双横线书写（写 accent-soft 而不写 var 形式），
         因为 XML 注释内不允许出现连续两个减号，否则 MC3000 会崩掉共用构建。 -->

    <UserControl.Resources>

        <!-- ============ 连接页族按钮：.connect-page .btn 13px + min-width row-h 42（connection.css:11 + :114） ============ -->
        <Style x:Key="ConnectBtnGhost" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="42"/>
        </Style>
        <Style x:Key="ConnectBtnGold" TargetType="Button" BasedOn="{StaticResource BtnGold}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="42"/>
        </Style>
        <Style x:Key="ConnectBtnDanger" TargetType="Button" BasedOn="{StaticResource BtnDanger}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="42"/>
        </Style>
        <!-- .btn.btn-ghost.btn-sm：32 高 / padding 4 12 / radius 6 / 13px（§2 的 BtnSm + ui-system.css:17） -->
        <Style x:Key="ConnectBtnGhostSm" TargetType="Button" BasedOn="{StaticResource BtnSm}">
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        </Style>

        <!-- ============ .connect-tab：min-height 36 / padding 8 16 / radius 10 / border 1 border-strong /
                    card-2 底 / 12px 600 / text-dim（connection.css:77）；hover 文字转 text（:78） ============ -->
        <Style x:Key="ConnectTab" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .connect-tab.active：字色 accent-2 + 底 accent-soft + 边 color-mix(accent 55%, border-strong)（connection.css:79）
             WPF 没有 color-mix，描边退化成 accent 实色。 -->
        <Style x:Key="ConnectTabActive" TargetType="Button" BasedOn="{StaticResource ConnectTab}">
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- ============ .server-list：gap 0 / padding 8 / radius 14 / border 1 / surface-content 底
                    （ServersView.vue:510 + :513；surface-content 在 §2 体系里就是 Panel 用的那张 Card 底） ============ -->
        <Style x:Key="SrvList" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- ============ .connection-panel：radius 14 / border 1 / surface-content 底 / box-shadow none
                    （connection.css:15 + ui-system.css:27，阴影被 ui-system.css:78 关掉，台账 §12） ============ -->
        <Style x:Key="SrvPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <!-- ============ .server-list-item 最终态：min-height 86 / padding 0 4 / 无描边无圆角只留 1px 底边线 /
                    透明底（ServersView.vue:514 + :509 的 border 0 + border-bottom + border-radius 0，
                    覆盖 :463 的 42 高 + radius 10 + border 1 + card 底基线） ============ -->
        <Style x:Key="SrvRow" TargetType="Border">
            <Setter Property="MinHeight" Value="86"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <!-- :hover 的 transform/box-shadow 被 :510 关掉，只剩 background card-2（:472） -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- .active = accent-soft 底 + radius-sm 6，底边线仍留 border（ServersView.vue:515；
             :509 的 inset 3px accent 左线被 :515 的 box-shadow none 关掉）
             注：CornerRadius 6 配单边 border 在 WPF 里会把底角画成圆弧，是近似不是等值。 -->
        <Style x:Key="SrvRowActive" TargetType="Border" BasedOn="{StaticResource SrvRow}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <!-- Style setter 优先级低于 trigger，选中态必须自己再压一次，否则划过就掉底 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ .server-row-button：flex / gap 12 / padding 12 8 / 无边透明底 / 文字继承 text / flex 1
                    （ServersView.vue:475 + :517 + :509） ============ -->
        <Style x:Key="SrvRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ .server-favorite：32×32 / padding 0 / 无边透明底 / 22px 星标字形 / hover 出 accent-soft + accent
                    （ServerListItem.vue:10 + 其 scoped :20-23；order 3 用列序表达，见行注释） ============ -->
        <Style x:Key="SrvFav" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ .connection-status 胶囊：padding 4 12 / radius 999 / 12px 600 / 前置 6×6 圆点走 currentColor
                    （connection.css:24-25）；tone 只换文字色（:26-28 的 ok / danger / accent-2）。
                    用 ContentControl 而不是 Border 承载：Border 没有 Foreground/FontSize，字号与色没法随 tone 继承下去；
                    WPF 也没有 currentColor，圆点在每个 tone 分支里各自显式给同一张画刷。
                    胶囊底是 card-2（connection.css:24），不是 .tag 的 ChipBg；tone 只改字色，不换底。
                    HorizontalAlignment=Right 对应 .server-row-state 的 align-items flex-end（ServersView.vue:485）。 ============ -->
        <Style x:Key="SrvStatus" TargetType="ContentControl">
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border ctl:CssRadius.Pill="True" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SrvStatusOk" TargetType="ContentControl" BasedOn="{StaticResource SrvStatus}">
            <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
        </Style>
        <Style x:Key="SrvStatusPending" TargetType="ContentControl" BasedOn="{StaticResource SrvStatus}">
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
        </Style>
        <Style x:Key="SrvStatusDanger" TargetType="ContentControl" BasedOn="{StaticResource SrvStatus}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>

        <!-- ============ input[type=checkbox] 18×18 + accent-color 主色（ServersView.vue:504）；
                    §2 的 Check 是 13px 原生勾，尺寸与配色都对不上，按原版度量重写 ============ -->
        <Style x:Key="SrvCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bx" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderStrong}"
                                Background="{DynamicResource CardSoft}">
                            <ContentControl x:Name="tick" Width="12" Height="12" Visibility="Collapsed"
                                            Foreground="{DynamicResource AccentFg}"
                                            Style="{DynamicResource Icon.Check}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bx" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="bx" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .server-address：无边透明底 / 13px text-dim 等宽 / cursor copy（ServerDetails.vue:30） -->
        <Style x:Key="SrvAddress" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .server-search 内的 input：无边框无底、继承字号 13（ServersView.vue:455） -->
        <Style x:Key="SrvSearchInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- details/summary 行：min-height ctl-h 36 / 13px text-dim（connection.css:42 + :114） -->
        <Style x:Key="SrvSummary" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- .content：overflow-y auto + scrollbar-gutter stable / padding 24 由宿主 Grid.Margin 给（App.vue:2398-2404，台账 §0）。
         ≥1121 时 .content:has(.servers-page) 改成 overflow hidden、两列各自滚（ServersView.vue:510），
         所以本页根节点自带内层滚动容器，不再套外层 ScrollViewer。
         .connect-page：max-width 1120 / margin 0 auto / flex column gap sec-gap 28（connection.css:3）
         → .servers-page 把 gap 压成 16（ServersView.vue:509）；@min-1121 又把 max-width 压成 1480 并 height 100%（:510 + :529）。
         两档由代码里的 ApplyMetrics() 按视口宽切换（WPF 无 media query）。 -->
    <Grid x:Name="PageRoot" MaxWidth="1120" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 正文 · 服务器（ServersView.vue:357-380） ============
             原版 ServersView 没有任何页签：服务器 / MOD 面板 / 联机是三个互不相干的独立 view
             （App.vue:177-185 里 bridge 与 servers 是资源管理子项，friends 是主导航项），
             所以这里不放 .connect-tabs —— 那条页签带是 VoxLinkPanel.vue:402 内部「创建/加入/公共大厅」用的。 -->
        <StackPanel x:Name="PanelServers" Grid.Row="1">

            <!-- .connection-header：row / space-between / align-center / gap space-5 24 / wrap（connection.css:6），
                 margin 与 padding 被 ServersView.vue:509 清成 0，所以块间只留 16 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- .connection-header h1 基线 26px/700 + letter-spacing -.5px（connection.css:7）
                         → .content .connection-header h1 取 text-title 24px（ui-system.css:6 + :33），最终 24。
                         WPF 的 TextBlock 没有 letter-spacing，这 0.5px 的收紧表达不了，留给字体渲染。 -->
                    <TextBlock Style="{StaticResource H1}" Text="服务器" LineHeight="32"/>
                    <!-- h1 small：12px / 400 / text-dim / margin-left 12（ServersView.vue:509），文案模板 :359
                         // 占位：等联机功能接入（原版是 servers.length 与 onlineCount） -->
                    <TextBlock Margin="12,0,0,4" VerticalAlignment="Bottom" FontSize="12"
                               Foreground="{DynamicResource Fg2}" Text="4 个 · 2 个在线"/>
                </StackPanel>
                <!-- .btn.btn-gold，前缀是全角加号文字字形（ServersView.vue:360；契约 §3：原版这里不是矢量图标） -->
                <Button Grid.Column="2" Style="{StaticResource ConnectBtnGold}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="添加服务器" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- .server-toolbar：flex wrap / gap 12（ServersView.vue:451 基线是 space-3，:509 压成 12） -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- .server-search：flex 1 1 250px / height row-h 42 / padding 0 16 / radius 10 / border 1 / card 底 /
                        内层 svg 18×18 text-dim（ServersView.vue:452 + :454，内部 gap space-2 8 — :452） -->
                <Border Grid.Column="0" Height="42" CornerRadius="10" Padding="16,0"
                        Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                                        Foreground="{DynamicResource Fg2}" Style="{DynamicResource Icon.Search}"/>
                        <Grid Grid.Column="2">
                            <TextBox x:Name="TxtSearch" Style="{StaticResource SrvSearchInput}"
                                     TextChanged="Search_TextChanged"/>
                            <!-- WPF 没有 placeholder，按 AccountsPage 的覆盖文字写法近似（原文 placeholder 见 :363） -->
                            <TextBlock x:Name="SearchPh" Text="搜索名称、地址或服务器介绍" FontSize="13"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg2}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- .connection-actions：flex wrap / align-center / gap space-2 8（connection.css:10）
                     三个 .btn.btn-ghost 文案照 ServersView.vue:364 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ConnectBtnGhost}" Margin="0,0,8,0" Content="刷新状态"/>
                    <Button Style="{StaticResource ConnectBtnGhost}" Margin="0,0,8,0" Content="同步游戏列表"/>
                    <Button x:Name="BtnBatch" Style="{StaticResource ConnectBtnGhost}" Content="批量管理"
                            Click="BatchToggle_Click"/>
                </StackPanel>
            </Grid>

            <!-- .connection-error：border 1 danger / padding 12 16 / radius 10 / 12px 行高 1.7（connection.css:67），
                 模板 :366 的 v-if loadError 分支，本轮常置 Collapsed // 占位：等联机功能接入 -->
            <Border x:Name="LoadErrorBar" Visibility="Collapsed" Margin="0,0,0,16" Padding="16,12"
                    CornerRadius="10" BorderBrush="{DynamicResource Danger}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                               Foreground="{DynamicResource Danger}" Text="读取服务器列表失败：等联机功能接入"/>
                    <Button Grid.Column="2" Style="{StaticResource ConnectBtnGhost}" Content="重试"/>
                </Grid>
            </Border>

            <!-- .server-batch：flex / gap 8 / padding 12 16 / radius 10 / accent-soft 底 / 内部 .btn margin-left auto
                 （ServersView.vue:505-507 + :509 的 gap space-2 8）；v-if selectMode — 模板 :368 -->
            <Border x:Name="BatchBar" Visibility="Collapsed" Margin="0,0,0,16" Padding="16,12"
                    CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    Background="{DynamicResource AccentSoft}">
                <!-- margin-left auto（:507）用 * 空列把删除按钮顶到行尾（契约 §6.2） -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- .check-all：gap 8 / 12px（:505）；checkbox 18×18（:504） -->
                    <CheckBox x:Name="SelectAllCheck" Grid.Column="0" Style="{StaticResource SrvCheck}"
                              Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Micro}" VerticalAlignment="Center"
                               Text="全选搜索结果"/>
                    <!-- 文案是模板 :368 的「已选 selectedCount 项」 // 占位：等联机功能接入 -->
                    <TextBlock x:Name="BatchCountText" Grid.Column="4" Style="{StaticResource Micro}"
                               VerticalAlignment="Center" Text="已选 0 项"/>
                    <Button x:Name="BtnBatchDelete" Grid.Column="6" Style="{StaticResource ConnectBtnDanger}"
                            VerticalAlignment="Center" Content="删除所选" IsEnabled="False"/>
                </Grid>
            </Border>

            <!-- ============ 主体两列 .server-workspace ============
                 基线：minmax(260px,1fr) minmax(300px,1.05fr) / gap 16 / align-items start（ServersView.vue:461 + :512）
                 @min-1121：minmax(360px,1.2fr) minmax(320px,1fr) + min-height 0 + flex 1（:510）
                 @max-1120：单列 minmax(0,1fr) + .server-list max-height 360 + 详情取消 sticky（:530）
                 两列各自 max-height calc(100vh - 270px) + overflow auto + scrollbar-gutter stable（:510）
                 —— 全部由代码里的 ApplyMetrics() 落到 ColumnDefinition 与 ScrollViewer.MaxHeight。 -->
            <Grid x:Name="WorkspaceGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.05*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- 左列 · .server-list（列内 gap 0 — ServersView.vue:510） -->
                <Border Grid.Column="0" Style="{StaticResource SrvList}" VerticalAlignment="Top">
                    <!-- VerticalScrollBarVisibility=Visible 对应 scrollbar-gutter stable（契约 §6.5，槽宽 8 已由全局样式定）
                         MaxHeight 560 只是设计期兜底，运行时由 ApplyMetrics() 写成 100vh 减 270 -->
                    <ScrollViewer x:Name="ServerListScroll" VerticalScrollBarVisibility="Visible"
