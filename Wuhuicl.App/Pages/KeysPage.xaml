<UserControl x:Class="Wuhuicl.App.Pages.KeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Wuhuicl.App.Controls">

    <!-- 默认配置页，复刻 KAMUCL-1.1.5/src/renderer/src/views/KeysView.vue（options.txt / 默认按键预设）。
         数值取 docs/UI_GEOMETRY_PAGES.md §9 的最终值。这个 vue 只有基线块 :227-271 与后写的覆盖块 :273，
         后块把分类导航整段重排了，所以：
         · .cfg-sections 取 :273 的「flex + gap 8 + border-bottom 1 + padding-bottom 8」；
           基线 :229 的 grid repeat(3,minmax(0,1fr)) + padding 18 20 + radius 14 + 1px 描边是死值，没有照抄。
         · 导航按钮 .active 只换底色（accent-soft → AccentSoft）与字色（text → Fg），
           :273 之后没有指示条，所以本页不放任何指示块（与 GameView 的 game-tabs-blob 不同）。
         页内样式一律 Cfg 前缀，避开契约 §4 的画刷键名（tools/check_resource_keys.py 拦同名）。
         注释里的 CSS 令牌一律去掉前导双横线写（accent-soft 指源码的 accent-soft 令牌），
         因为 XML 注释里不允许出现连续两个减号，否则共享工程报 MC3000。

         数据：已接真实后端 —— DefaultKeys / DefaultGameOptions / DefaultResourcePacks（Core 翻译自
         keybindings.ts / gameOptions.ts / defaultResourcePacks.ts），行全部动态生成；
         启动时的 options.txt 同步在 LaunchSession.PlayAsync。 -->
    <UserControl.Resources>

        <!-- ============ 分类导航 .cfg-sections ============ -->
        <!-- .cfg-page .cfg-sections button：flex-direction row / align-center / gap 8 / min-height 40 /
             padding 8 14 / border 0 / radius radius-sm 6 / background transparent — KeysView.vue:273
             strong 14px、small 12px 也出自 :273；基线 :229 的 padding 18 20 + radius 14 + 描边已被覆盖。
             基线 hover 只改 border-color（:229），border 归 0 后 hover 无可视变化，故不做 hover 触发器。 -->
        <Style x:Key="CfgSectionTab" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- button.active = background accent-soft / color text — :273（无指示条，靠底色） -->
        <Style x:Key="CfgSectionTabActive" TargetType="Button" BasedOn="{StaticResource CfgSectionTab}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>

        <!-- ============ 卡片头 ============ -->
        <!-- .cfg-col-head：row / align-flex-start / space-between / gap space-3 12 / margin-bottom space-3 12 / wrap — :234 -->
        <Style x:Key="CfgColHead" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- h3.group-title：.content :is(.group-title,.pane-title) = text-lg 16 / line-height 1.5 — ui-system.css:14
             契约 §2 的 H2 是 17px，对不上，故留页内样式；行高用 TextBlock.LineHeight 表达（16×1.5＝24） -->
        <Style x:Key="CfgGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>

        <!-- .cfg-cat：text-sm 13 / text-dim / margin 0 0 space-2 8 / weight 650 — :248
             13 + text-dim 与契约 §2 Dim 同值，这里只补字重与下边距；WPF 没有 650 这一档，取最近的 SemiBold -->
        <Style x:Key="CfgCat" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- .cfg-group：margin-top space-4 16，first-child 归 0 — :246-247 -->
        <Style x:Key="CfgGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>

        <!-- ============ 行 ============ -->
        <!-- .cfg-row：flex / align-center / gap space-3 12 / padding space-2 8 / radius radius-sm 6 — :249
             hover 底 card-2 → CardSoft — :250。gap 12 用列间隔列表达（契约 §6.2） -->
        <Style x:Key="CfgRowBox" TargetType="Border">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- .cfg-row:hover 底 card-2（KeysView.vue:250）：HoverFade 淡入 CardSoft，130ms 取默认；
                 CfgPackRowBox 经 BasedOn 一并继承过渡 -->
            <Setter Property="ctl:HoverFade.Enabled" Value="True"/>
            <Setter Property="ctl:HoverFade.BrushKey" Value="CardSoft"/>
        </Style>

        <!-- .default-packs .cfg-row：min-height 60 / gap 12 — :273 -->
        <Style x:Key="CfgPackRowBox" TargetType="Border" BasedOn="{StaticResource CfgRowBox}">
            <Setter Property="MinHeight" Value="60"/>
        </Style>

        <!-- .cfg-label：flex 1 / min-width 0 / text-sm 13，颜色继承 button 的 text — :253 + :273
             min-width 0 用 TextTrimming 兜住超长包名（契约 §6.6） -->
        <Style x:Key="CfgLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- .cfg-value（源码类名 .cfg-bind）：min-width 120 / padding space-2 space-3 = 8 12 /
             border 1 / radius radius-sm 6 / 底 card-2 → CardSoft / 字 text-xs 12 — :254-256
             hover 边框换 accent — :259 -->
        <Style x:Key="CfgValue" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .cfg-bind.modified：border-color color-mix(in srgb, accent 55%, border) / background accent-soft — :260
             WPF 没有 color-mix，描边退到 Accent（不新造颜色），底色照原样 AccentSoft -->
        <Style x:Key="CfgValueModified" TargetType="Button" BasedOn="{StaticResource CfgValue}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- .cfg-bind.capturing：border accent / box-shadow 0 0 0 3px accent-soft / color accent-2 → AccentHi — :261
             外扩 3px 的柔光环要 Adorner，本轮不做（契约 §6.8）；层级见 :271 与下方 CaptureRow -->
        <Style x:Key="CfgValueCapturing" TargetType="Button" BasedOn="{StaticResource CfgValue}">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
        </Style>

        <!-- .cfg-reset：26×26 / border 0 / radius 6 / 底透明 / 字 text-dim，内层 svg 13×13 — :262-267
             hover：color accent-2 → AccentHi，底 hover → Hover — :266 -->
        <Style x:Key="CfgReset" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .cfg-clear：position relative / z-index 9001 / 30×30 / border 1 / radius 6 /
             底 card → Card / 字 text → Fg / font-size 22 — :270；字形 × 出自模板 :206（契约 §3 不造几何） -->
        <Style x:Key="CfgClear" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .cfg-sync：inline-flex / align-center / gap space-2 8 / padding space-1 space-2 = 上下 4 左右 8 /
             radius radius-sm 6，hover 底 hover — :237-241（WPF 的 StackPanel 无 Padding，故外层用 Border 承载）
             .cfg-sync-text：text-sm 13 / text-dim / weight 600 — :242 -->
        <Style x:Key="CfgSync" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CfgSyncText" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ 游戏选项区（DefaultGameOptions.vue:80-81 覆盖后的扁平行词表） ============ -->
        <!-- .option-entry：border 0 / 下边线 1 / radius 0 / min-height 48 / padding 10 4 / 透明底（:81）；
             hover 底 hover（:81 .options-entrances .option-entry:hover） -->
        <Style x:Key="VpOptionEntry" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .option-cell input[type=range]（:80）：高 22 / 全宽 / accent 填充；WPF 没有 accent-color，
             模板照 BridgeSlider 的配方（4px 轨道 + accent 已填充段 + 16 圆钮） -->
        <Style x:Key="VpRange" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource CardSoft}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Accent}"
                                                         Stroke="{DynamicResource Card}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .option-toggle（:80 基线）：全宽 / border 1 / radius 8 / padding 9 12 / 底 card / space-between -->
        <Style x:Key="VpOptionToggle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .option-foot button（:80）：无边透明 / accent-2 字 → AccentHi / 12px（:81 覆盖） -->
        <Style x:Key="VpFootBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" Padding="4,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- 根做两层：内层是页面流（.content 里滚动的 .cfg-page），外层留一格给捕获遮罩的接线锚点。
         ScrollViewer 对应 .content 的 scrollbar-gutter stable（docs §0，App.vue:2398-2404）→ 槽常驻，契约 §6.5 -->
    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">

            <!-- .cfg-page：width 100% / max-width 1040 / margin 0 auto — KeysView.vue:227 -->
            <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

                <!-- ==================== .page-head ====================
                     本页无覆盖，全继承：标题 24px（ui-system.css:12 → 契约 §2 PageTitle）、
                     副标 13px Fg2（styles.css:509-512 → PageSub）。
                     间距 = 页级 gap 16（ui-system.css:10）+ .cfg-page>.page-head margin-bottom 24（:228）＝ 40 -->
                <StackPanel Margin="0,0,0,40">
                    <TextBlock Style="{StaticResource PageTitle}" Text="默认配置"/>
                    <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,0"
                               Text="让每个世界，都保留你熟悉的操作习惯。"/>
                </StackPanel>

                <!-- ==================== nav.cfg-sections（分类导航） ====================
                     最终态：flex / gap 8 / flex-wrap / border-bottom 1 / padding-bottom 8 — :273；
                     margin-bottom 24 来自基线 :229 且未被覆盖。flex-wrap 在 WPF 用 WrapPanel，gap 8 用右边距表达 -->
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,8" Margin="0,0,0,24">
                    <WrapPanel>
                        <!-- 3 个分类＝模板 :151-153 的 game / keys / packs；互斥显隐由本页 Section_Click 处理 -->
                        <Button x:Name="SectionGame" Style="{StaticResource CfgSectionTabActive}"
                                Margin="0,0,8,0" Click="Section_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- strong 14px（:273）＋ small 12px text-dim（色 :229 / 字号 :273）；按钮内 gap 8 → 左边距 8 -->
                                <TextBlock Text="游戏选项" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="画面、控制与辅助功能" FontSize="12" Foreground="{DynamicResource Fg2}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SectionKeys" Style="{StaticResource CfgSectionTab}"
                                Margin="0,0,8,0" Click="Section_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- // 占位：等默认配置功能接入（small 文案本该是 keyModifiedCount，computed，契约 §5 无） -->
                                <TextBlock Text="按键配置" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="KeysCount" Text="0 项自定义绑定" FontSize="12" Foreground="{DynamicResource Fg2}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SectionPacks" Style="{StaticResource CfgSectionTab}" Click="Section_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- // 占位：等默认配置功能接入（small 文案本该是 resourcePacks.length） -->
                                <TextBlock Text="默认材质包" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PacksCount" Text="0 个材质包" FontSize="12" Foreground="{DynamicResource Fg2}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- ==================== 分区一：游戏选项（模板 :155 挂 DefaultGameOptions 组件） ====================
                     该组件自身的 .game-options 度量不在 docs §9 里，本页统一改用 §9 的 cfg-row / cfg-value / cfg-reset 词表，
                     让它与同页另两个分区共用一个壳。卡片度量走契约 §2 Panel：radius 14 / padding 20 / border 1 / 底 Card / 无阴影。
                     // 占位：等默认配置功能接入（GAME_OPTIONS、getDefaultGameOptions 都在 api 层） -->
                <Border x:Name="PanelGame" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Style="{StaticResource CfgColHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CfgGroupTitle}" Text="游戏选项"/>
                                <!-- .muted 只给 text-dim（styles.css:677），字号走 §2 Dim；文案 DefaultGameOptions.vue:45 -->
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="按游戏内「Esc → 选项」的入口顺序设置，下次启动时应用。"/>
                            </StackPanel>
                            <!-- 右置操作区：选项同步开关，文案来自 DefaultGameOptions.vue:46 -->
                            <Border Grid.Column="2" Style="{StaticResource CfgSync}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource CfgSyncText}" Text="启动时同步"/>
                                    <CheckBox x:Name="SwOptionSync" Style="{StaticResource Switch}" Margin="8,0,0,0" Checked="OptionSync_Changed" Unchecked="OptionSync_Changed"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- .cfg-scroll：min-height 220 / grid repeat(2,minmax(0,1fr)) / gap 22 / padding-top 12 — :244
                             padding-top 12 → 上边距；gap 22 → 中间间隔列（契约 §6.2）。
                             CSS grid 自动放置是行优先，所以第 1 组落 (0,0)、第 2 组 (0,2)、第 3 组 (1,0)。
                             @max-850 收单列（:245）WPF 无媒体查询，见 KeysPage.xaml.cs 尾注 -->
                        <!-- .options-context（DefaultGameOptions.vue:48-50）：自定义计数 tag + 兼容性预览版本选择 -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Tag}" Padding="8,1" HorizontalAlignment="Left">
                                <TextBlock x:Name="OptionsCustomCount" Style="{StaticResource TagText}" Text="0 项自定义"/>
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Dim}" VerticalAlignment="Center" Text="兼容性预览"/>
                                <ComboBox x:Name="CboPreviewVersion" Width="180" Margin="10,0,0,0" FontSize="13"
                                          SelectionChanged="PreviewVersion_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- .options-note（DefaultGameOptions.vue:52） -->
                        <TextBlock Style="{StaticResource Dim}" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20.8"
                                   Text="只同步你修改的项目，其余保留游戏设置。预览版本用于检查兼容性，启动时会按实际版本转换数值。"/>

                        <!-- .options-warning（:53）：预览版本不支持的自定义项 -->
                        <Border x:Name="OptionsWarning" Margin="0,14,0,0" Padding="12" CornerRadius="10"
                                Background="{DynamicResource AccentSoft}" Visibility="Collapsed">
                            <TextBlock x:Name="OptionsWarningText" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg}"/>
                        </Border>

                        <!-- .options-path（:54）：返回按钮 + 子页路径标题 -->
                        <StackPanel Orientation="Horizontal" Margin="0,25,0,15">
                            <Button x:Name="BtnOptionsBack" Style="{StaticResource BtnGhost}" MinHeight="32"
                                    Padding="12,4" FontSize="13" Content="← 返回" Margin="0,0,12,0"
                                    Visibility="Collapsed" Click="OptionsBack_Click"/>
                            <TextBlock x:Name="TxtOptionsPath" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Text="选项"/>
                        </StackPanel>

                        <!-- controls 子页顶部的两枚入口（:56）：鼠标设置 / 按键控制 -->
                        <Grid x:Name="OptionsSubEntrances" MinHeight="0" Visibility="Collapsed"
                              Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <!-- 选项行动态容器（:58 的 mc-options-grid，行结构沿用本页 cfg-row 词表） -->
                        <Grid x:Name="OptionsGrid" MinHeight="220" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <!-- 子页入口（:70）：每页一格，root 页显示 -->
                        <Grid x:Name="OptionsEntries" MinHeight="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <!-- world-option（:67）与 credits 说明（:71） -->
                        <TextBlock x:Name="CreditsNote" Style="{StaticResource Dim}" Margin="0,16,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap"
                                   Text="Minecraft 的鸣谢与著作权信息请在游戏内查看；此入口不修改配置。"/>

                        <!-- 同步规则说明（:73 的 details 摘要行） -->
                        <TextBlock Style="{StaticResource Dim}" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20.8"
                                   Text="同步规则：只同步已修改的原版选项，未修改项跟随游戏；预览版本不切换实例，启动时按真实版本转换；模组接管的选项需同时检查模组配置。"/>
                    </StackPanel>
                </Border>

                <!-- ==================== 分区二：按键配置（模板 :175-219） ====================
                     // 占位：等默认配置功能接入（getDefaultKeys / setDefaultKey / VANILLA_KEYBINDS 均在 api 与 shared 层） -->
                <Border x:Name="PanelKeys" Style="{StaticResource Panel}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Style="{StaticResource CfgColHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CfgGroupTitle}" Text="按键配置"/>
                                <!-- 模板 :179 的行内 style 把这段 hint 的 margin 收成 2px 0 0 -->
                                <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="对应游戏内「选项 → 控制 → 按键控制」"/>
                            </StackPanel>
                            <!-- .cfg-head-actions：row / align-center / gap space-4 16 / wrap — :236 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <!-- .cfg-sync 的 title 文案照模板 :182 -->
                                <Border Style="{StaticResource CfgSync}"
                                        ToolTip="启动任意版本时，用下方默认按键覆盖该实例 options.txt 的 key 项">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CfgSyncText}" Text="按键设置同步"/>
                                        <!-- .cfg-sync 内 gap space-2 8 — :238 -->
                                        <CheckBox x:Name="SwKeySync" Style="{StaticResource Switch}" Margin="8,0,0,0" Checked="KeySync_Changed" Unchecked="KeySync_Changed"/>
                                    </StackPanel>
                                </Border>
                                <!-- .btn.btn-ghost.btn-sm「全部恢复默认」— 模板 :189；32 高 / padding 12 4 / 13px（§2 BtnSm 度量）
                                     与开关的间隔 16 = .cfg-head-actions 的 gap space-4 — :236 -->
                                <Button x:Name="BtnResetAll" Style="{StaticResource BtnGhost}"
                                        MinHeight="32" Padding="12,4" FontSize="13"
                                        Content="全部恢复默认" Margin="16,0,0,0" Click="ResetAllKeys_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- .cfg-search：width 100% / margin-bottom space-3 12 — :243；控件度量走 §2 Input（36 高 / radius 10）
                             WPF 无 placeholder，用覆盖文字模拟（同 ModsPage） -->
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="TxtKeySearch" Style="{StaticResource Input}" FontSize="13"
                                     TextChanged="Search_TextChanged"/>
                            <TextBlock x:Name="SearchHint" Text="搜索按键名称…" FontSize="13"
                                       Foreground="{DynamicResource Fg3}" Margin="13,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- .cfg-scroll：min-height 220 / repeat(2,minmax(0,1fr)) / gap 22 / padding-top 12 — :244 -->
                        <!-- .cfg-scroll：动态分区容器。组按 CSS grid 的行优先顺序落位（第 n 组 → row n/2, col n%2） -->
                        <Grid x:Name="KeysScroll" MinHeight="220" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 搜索无结果：模板 :217 的 .empty（min-height 120 / padding 32 16） -->
                            <Border x:Name="KeysEmpty" Grid.Column="0" Grid.ColumnSpan="3"
                                    MinHeight="120" Padding="32,16" Visibility="Collapsed">
                                <TextBlock x:Name="KeysEmptyText" Style="{StaticResource Dim}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Text="没有匹配「」的按键"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== 分区三：.default-packs（模板 :156-172） ====================
                     margin-bottom sec-gap 28 — :231；padding 20 — :273（与 §2 Panel 的 20 同值，不重复设）
                     // 占位：等默认配置功能接入（getDefaultResourcePacks / importDefaultResourcePacks 在 api 层）
                     外层 Grid 只为承载 .drag-active（模板 :156 的 :class，样式 :231）：
                     outline 2px solid accent ＋ background accent-soft。WPF 没有 outline 这个「不占布局的外描边」，
                     等价写法是在被描元素外面套一圈 Margin=-2 的 Border：线画在盒子外侧，内容不会被挤动 2px；
                     外沿圆角＝卡片 radius-lg 14 ＋ 线宽 2 ＝ 16（浏览器算 outline 圆角就是这个和）。
                     dragover／dragleave 本身属功能，所以这层先 Collapsed。 -->
                <Grid>
                    <Border x:Name="PacksDragActive" Margin="-2" CornerRadius="16"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                            Background="{DynamicResource AccentSoft}"
                            IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Border x:Name="PanelPacks" Style="{StaticResource Panel}" Margin="0,0,0,28" Visibility="Collapsed">
                    <StackPanel>
                        <!-- .default-packs .cfg-col-head：gap 12 / wrap；首个 div flex 1 / min-width 160 — :273 -->
                        <Grid Style="{StaticResource CfgColHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CfgGroupTitle}" Text="默认材质包"/>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="拖入多个 ZIP 材质包，列表靠后的包优先级更高"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <!-- .btn.btn-ghost「添加材质包…」— 模板 :159 -->
                                <Button x:Name="BtnAddPack" Style="{StaticResource BtnGhost}" Content="添加材质包…"
                                        VerticalAlignment="Center" Margin="0,0,16,0" Click="AddPack_Click"/>
                                <Border Style="{StaticResource CfgSync}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CfgSyncText}" Text="材质包同步"/>
                                        <CheckBox x:Name="SwPackSync" Style="{StaticResource Switch}" Margin="8,0,0,0" Checked="PackSync_Changed" Unchecked="PackSync_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 三行占位包名。列序照模板 :163-167：label / 启用开关 / ↑ / ↓ / 移除，gap 12 全部走间隔列 -->
                        <!-- 动态行容器：按清单逐行生成（label / 启用开关 / ↑ / ↓ / 移除），结构同上面注释的占位行 -->
                        <StackPanel x:Name="PacksHost"/>

                        <!-- v-if 的空态（模板 :169）：有包时不显示，留命名节点给接线 -->
                        <TextBlock x:Name="PacksEmpty" Style="{StaticResource Dim}" Margin="0,8,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap"
                                   Text="将材质包拖到这里，或点击上方按钮添加。"/>

                        <!-- 模板 :171 的说明段。行高走 .default-packs .group-hint 的 line-height 1.6（:273），
                             WPF 用 TextBlock.LineHeight 表达：13（Dim）× 1.6 = 20.8 -->
                        <TextBlock Style="{StaticResource Dim}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   LineHeight="20.8"
                                   Text="添加后自动开启同步。每个材质包可独立启停，下次启动游戏时生效；未启用的包不会复制，并取消其默认启用。关闭总同步不改动实例。原文件和已复制文件保留。"/>
                    </StackPanel>
                </Border>
                </Grid>

                <!-- 读取中：模板 :173 的 .card.empty + .spin。
                     .content .empty = min-height 120 / padding 32 16（ui-system.css:44）
                     .spin 是旋转动画，本轮不做（契约 §6.8），先留独立命名节点给主控接 -->
                <Border x:Name="CardLoading" Style="{StaticResource Panel}" MinHeight="120" Padding="32,16"
                        Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="SpinHint" Style="{StaticResource Dim}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Text="正在读取配置…"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- .menu-overlay.cfg-capture-mask（模板 :221）：.menu-overlay 是全局的
             position fixed / inset 0 / z-index 90（styles.css:577-581，纯点击捕获层，不画任何东西），
             本页又在它上面叠了 .cfg-capture-mask 的 z-index 9000（:269）。
             它要盖住整个窗口，而本页在 ScrollViewer 内，
             所以这里只留一个 0 尺寸的命名锚点，真遮罩层需由主控放进窗口浮层（KeysPage.xaml.cs 尾注有接线说明） -->
        <Border x:Name="CaptureMask" Width="0" Height="0" Panel.ZIndex="9000" Visibility="Collapsed"/>
    </Grid>
</UserControl>
