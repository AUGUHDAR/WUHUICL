                                <!-- .btn.btn-ghost「添加材质包…」— 模板 :159 -->
                                <Button x:Name="BtnAddPack" Style="{StaticResource BtnGhost}" Content="添加材质包…"
                                        VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Border Style="{StaticResource CfgSync}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CfgSyncText}" Text="材质包同步"/>
                                        <CheckBox x:Name="SwPackSync" Style="{StaticResource Switch}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 三行占位包名。列序照模板 :163-167：label / 启用开关 / ↑ / ↓ / 移除，gap 12 全部走间隔列 -->
                        <Border Style="{StaticResource CfgPackRowBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- .default-packs .cfg-label：flex 1 / min-width 0 — :273；title 是包名（模板 :163） -->
                                <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                           ToolTip="faithful-32x.zip" Text="faithful-32x.zip"/>
                                <!-- .cfg-sync.pack-enable：flex none / nowrap — :251，文案「已启用 / 未启用」来自模板 :164 -->
                                <TextBlock Grid.Column="2" Style="{StaticResource CfgSyncText}" Text="已启用"
                                           Margin="0,0,8,0"/>
                                <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="True"
                                          VerticalAlignment="Center"/>
                                <!-- ↑ ↓ 用的是原文字形（模板 :165-166，契约 §3 不造几何）；首行的 ↑ 禁用 -->
                                <Button Grid.Column="6" Style="{StaticResource BtnGhost}" Content="↑"
                                        MinHeight="32" Padding="12,4" FontSize="13" IsEnabled="False"
                                        ToolTip="降低优先级（已是首项）"/>
                                <Button Grid.Column="8" Style="{StaticResource BtnGhost}" Content="↓"
                                        MinHeight="32" Padding="12,4" FontSize="13" ToolTip="提高优先级"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CfgPackRowBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                           ToolTip="CreateAdaptiveV8.zip" Text="CreateAdaptiveV8.zip"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource CfgSyncText}" Text="未启用"
                                           Margin="0,0,8,0"/>
                                <CheckBox Grid.Column="4" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                <Button Grid.Column="6" Style="{StaticResource BtnGhost}" Content="↑"
                                        MinHeight="32" Padding="12,4" FontSize="13" ToolTip="降低优先级"/>
                                <Button Grid.Column="8" Style="{StaticResource BtnGhost}" Content="↓"
                                        MinHeight="32" Padding="12,4" FontSize="13" ToolTip="提高优先级"/>
                                <!-- 移除 — 模板 :167 -->
                                <Button Grid.Column="10" Style="{StaticResource BtnGhost}" Content="移除"
                                        MinHeight="32" Padding="12,4" FontSize="13"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CfgPackRowBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 超长包名：验 min-width 0 + 截断不撑破行（契约 §6.6） -->
                                <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                           ToolTip="SuperDuperDarkRealisticDramaticSurvivalCraft_v3_1_3.zip"
                                           Text="SuperDuperDarkRealisticDramaticSurvivalCraft_v3_1_3.zip"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource CfgSyncText}" Text="已启用"
                                           Margin="0,0,8,0"/>
                                <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="True"
                                          VerticalAlignment="Center"/>
                                <Button Grid.Column="6" Style="{StaticResource BtnGhost}" Content="↑"
                                        MinHeight="32" Padding="12,4" FontSize="13" ToolTip="降低优先级"/>
                                <!-- 末行 ↓ 禁用（模板 :166 的 index === length - 1） -->
                                <Button Grid.Column="8" Style="{StaticResource BtnGhost}" Content="↓"
                                        MinHeight="32" Padding="12,4" FontSize="13" IsEnabled="False"
                                        ToolTip="已是最后一项"/>
                                <Button Grid.Column="10" Style="{StaticResource BtnGhost}" Content="移除"
                                        MinHeight="32" Padding="12,4" FontSize="13"/>
                            </Grid>
                        </Border>

                        <!-- v-if 的空态（模板 :169）：有包时不显示，留命名节点给接线 -->
                        <TextBlock x:Name="PacksEmpty" Style="{StaticResource Dim}" Margin="0,8,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap"
                                   Text="将材质包拖到这里，或点击上方按钮添加。"/>

                        <!-- 模板 :171 的说明段。行高走 .default-packs .group-hint 的 line-height 1.6（:273），
                             WPF 用 TextBlock.LineHeight 表达：13（Dim）× 1.6 = 20.8 -->
                        <TextBlock Style="{StaticResource Dim}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   LineHeight="20.8"
                                   Text="添加后自动开启同步。每个材质包可独立启停，下次启动游戏时生效；未启用的包不会复制，并取消其默认启用。关闭总同步不改动实例。原文件和已复制文件保留。"/>
                    </StackPanel>
                </Border>
                </Grid>

                <!-- 读取中：模板 :173 的 .card.empty + .spin。
                     .content .empty = min-height 120 / padding 32 16（ui-system.css:44）
                     .spin 是旋转动画，本轮不做（契约 §6.8），先留独立命名节点给主控接 -->
                <Border x:Name="CardLoading" Style="{StaticResource Panel}" MinHeight="120" Padding="32,16"
                        Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="SpinHint" Style="{StaticResource Dim}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Text="正在读取配置…"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- .menu-overlay.cfg-capture-mask（模板 :221）：.menu-overlay 是全局的
             position fixed / inset 0 / z-index 90（styles.css:577-581，纯点击捕获层，不画任何东西），
             本页又在它上面叠了 .cfg-capture-mask 的 z-index 9000（:269）。
             它要盖住整个窗口，而本页在 ScrollViewer 内，
             所以这里只留一个 0 尺寸的命名锚点，真遮罩层需由主控放进窗口浮层（KeysPage.xaml.cs 尾注有接线说明） -->
        <Border x:Name="CaptureMask" Width="0" Height="0" Panel.ZIndex="9000" Visibility="Collapsed"/>
    </Grid>
</UserControl>
