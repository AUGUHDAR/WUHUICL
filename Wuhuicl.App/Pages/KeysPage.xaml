<UserControl x:Class="Wuhuicl.App.Pages.KeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 默认配置页，复刻 KAMUCL-1.1.5/src/renderer/src/views/KeysView.vue（options.txt / 默认按键预设）。
         数值取 docs/UI_GEOMETRY_PAGES.md §9 的最终值。这个 vue 只有基线块 :227-271 与后写的覆盖块 :273，
         后块把分类导航整段重排了，所以：
         · .cfg-sections 取 :273 的「flex + gap 8 + border-bottom 1 + padding-bottom 8」；
           基线 :229 的 grid repeat(3,minmax(0,1fr)) + padding 18 20 + radius 14 + 1px 描边是死值，没有照抄。
         · 导航按钮 .active 只换底色（accent-soft → AccentSoft）与字色（text → Fg），
           :273 之后没有指示条，所以本页不放任何指示块（与 GameView 的 game-tabs-blob 不同）。
         页内样式一律 Cfg 前缀，避开契约 §4 的画刷键名（tools/check_resource_keys.py 拦同名）。
         注释里的 CSS 令牌一律去掉前导双横线写（accent-soft 指源码的 accent-soft 令牌），
         因为 XML 注释里不允许出现连续两个减号，否则共享工程报 MC3000。

         数据：契约 §5 的 LaunchSession 白名单里没有任何 options / keybinding 字段，
         所以整页不写一条 Binding（绑不存在的属性会静默失效＝假实现），
         行内容全是与原版同形的静态文案，每块标了「// 占位：等默认配置功能接入」。 -->
    <UserControl.Resources>

        <!-- ============ 分类导航 .cfg-sections ============ -->
        <!-- .cfg-page .cfg-sections button：flex-direction row / align-center / gap 8 / min-height 40 /
             padding 8 14 / border 0 / radius radius-sm 6 / background transparent — KeysView.vue:273
             strong 14px、small 12px 也出自 :273；基线 :229 的 padding 18 20 + radius 14 + 描边已被覆盖。
             基线 hover 只改 border-color（:229），border 归 0 后 hover 无可视变化，故不做 hover 触发器。 -->
        <Style x:Key="CfgSectionTab" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- button.active = background accent-soft / color text — :273（无指示条，靠底色） -->
        <Style x:Key="CfgSectionTabActive" TargetType="Button" BasedOn="{StaticResource CfgSectionTab}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>

        <!-- ============ 卡片头 ============ -->
        <!-- .cfg-col-head：row / align-flex-start / space-between / gap space-3 12 / margin-bottom space-3 12 / wrap — :234 -->
        <Style x:Key="CfgColHead" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- h3.group-title：.content :is(.group-title,.pane-title) = text-lg 16 / line-height 1.5 — ui-system.css:14
             契约 §2 的 H2 是 17px，对不上，故留页内样式；行高用 TextBlock.LineHeight 表达（16×1.5＝24） -->
        <Style x:Key="CfgGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>

        <!-- .cfg-cat：text-sm 13 / text-dim / margin 0 0 space-2 8 / weight 650 — :248
             13 + text-dim 与契约 §2 Dim 同值，这里只补字重与下边距；WPF 没有 650 这一档，取最近的 SemiBold -->
        <Style x:Key="CfgCat" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- .cfg-group：margin-top space-4 16，first-child 归 0 — :246-247 -->
        <Style x:Key="CfgGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>

        <!-- ============ 行 ============ -->
        <!-- .cfg-row：flex / align-center / gap space-3 12 / padding space-2 8 / radius radius-sm 6 — :249
             hover 底 card-2 → CardSoft — :250。gap 12 用列间隔列表达（契约 §6.2） -->
        <Style x:Key="CfgRowBox" TargetType="Border">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .default-packs .cfg-row：min-height 60 / gap 12 — :273 -->
        <Style x:Key="CfgPackRowBox" TargetType="Border" BasedOn="{StaticResource CfgRowBox}">
            <Setter Property="MinHeight" Value="60"/>
        </Style>

        <!-- .cfg-label：flex 1 / min-width 0 / text-sm 13，颜色继承 button 的 text — :253 + :273
             min-width 0 用 TextTrimming 兜住超长包名（契约 §6.6） -->
        <Style x:Key="CfgLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- .cfg-value（源码类名 .cfg-bind）：min-width 120 / padding space-2 space-3 = 8 12 /
             border 1 / radius radius-sm 6 / 底 card-2 → CardSoft / 字 text-xs 12 — :254-256
             hover 边框换 accent — :259 -->
        <Style x:Key="CfgValue" TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .cfg-bind.modified：border-color color-mix(in srgb, accent 55%, border) / background accent-soft — :260
             WPF 没有 color-mix，描边退到 Accent（不新造颜色），底色照原样 AccentSoft -->
        <Style x:Key="CfgValueModified" TargetType="Button" BasedOn="{StaticResource CfgValue}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- .cfg-bind.capturing：border accent / box-shadow 0 0 0 3px accent-soft / color accent-2 → AccentHi — :261
             外扩 3px 的柔光环要 Adorner，本轮不做（契约 §6.8）；层级见 :271 与下方 CaptureRow -->
        <Style x:Key="CfgValueCapturing" TargetType="Button" BasedOn="{StaticResource CfgValue}">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
        </Style>

        <!-- .cfg-reset：26×26 / border 0 / radius 6 / 底透明 / 字 text-dim，内层 svg 13×13 — :262-267
             hover：color accent-2 → AccentHi，底 hover → Hover — :266 -->
        <Style x:Key="CfgReset" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .cfg-clear：position relative / z-index 9001 / 30×30 / border 1 / radius 6 /
             底 card → Card / 字 text → Fg / font-size 22 — :270；字形 × 出自模板 :206（契约 §3 不造几何） -->
        <Style x:Key="CfgClear" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .cfg-sync：inline-flex / align-center / gap space-2 8 / padding space-1 space-2 = 上下 4 左右 8 /
             radius radius-sm 6，hover 底 hover — :237-241（WPF 的 StackPanel 无 Padding，故外层用 Border 承载）
             .cfg-sync-text：text-sm 13 / text-dim / weight 600 — :242 -->
        <Style x:Key="CfgSync" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CfgSyncText" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- 根做两层：内层是页面流（.content 里滚动的 .cfg-page），外层留一格给捕获遮罩的接线锚点。
         ScrollViewer 对应 .content 的 scrollbar-gutter stable（docs §0，App.vue:2398-2404）→ 槽常驻，契约 §6.5 -->
    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">

            <!-- .cfg-page：width 100% / max-width 1040 / margin 0 auto — KeysView.vue:227 -->
            <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

                <!-- ==================== .page-head ====================
                     本页无覆盖，全继承：标题 24px（ui-system.css:12 → 契约 §2 PageTitle）、
                     副标 13px Fg2（styles.css:509-512 → PageSub）。
                     间距 = 页级 gap 16（ui-system.css:10）+ .cfg-page>.page-head margin-bottom 24（:228）＝ 40 -->
                <StackPanel Margin="0,0,0,40">
                    <TextBlock Style="{StaticResource PageTitle}" Text="默认配置"/>
                    <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,0"
                               Text="让每个世界，都保留你熟悉的操作习惯。"/>
                </StackPanel>

                <!-- ==================== nav.cfg-sections（分类导航） ====================
                     最终态：flex / gap 8 / flex-wrap / border-bottom 1 / padding-bottom 8 — :273；
                     margin-bottom 24 来自基线 :229 且未被覆盖。flex-wrap 在 WPF 用 WrapPanel，gap 8 用右边距表达 -->
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,8" Margin="0,0,0,24">
                    <WrapPanel>
                        <!-- 3 个分类＝模板 :151-153 的 game / keys / packs；互斥显隐由本页 Section_Click 处理 -->
                        <Button x:Name="SectionGame" Style="{StaticResource CfgSectionTabActive}"
                                Margin="0,0,8,0" Click="Section_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- strong 14px（:273）＋ small 12px text-dim（色 :229 / 字号 :273）；按钮内 gap 8 → 左边距 8 -->
                                <TextBlock Text="游戏选项" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="画面、控制与辅助功能" FontSize="12" Foreground="{DynamicResource Fg2}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SectionKeys" Style="{StaticResource CfgSectionTab}"
                                Margin="0,0,8,0" Click="Section_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- // 占位：等默认配置功能接入（small 文案本该是 keyModifiedCount，computed，契约 §5 无） -->
                                <TextBlock Text="按键配置" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="3 项自定义绑定" FontSize="12" Foreground="{DynamicResource Fg2}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SectionPacks" Style="{StaticResource CfgSectionTab}" Click="Section_Click">
                            <StackPanel Orientation="Horizontal">
                                <!-- // 占位：等默认配置功能接入（small 文案本该是 resourcePacks.length） -->
                                <TextBlock Text="默认材质包" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="3 个材质包" FontSize="12" Foreground="{DynamicResource Fg2}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- ==================== 分区一：游戏选项（模板 :155 挂 DefaultGameOptions 组件） ====================
                     该组件自身的 .game-options 度量不在 docs §9 里，本页统一改用 §9 的 cfg-row / cfg-value / cfg-reset 词表，
                     让它与同页另两个分区共用一个壳。卡片度量走契约 §2 Panel：radius 14 / padding 20 / border 1 / 底 Card / 无阴影。
                     // 占位：等默认配置功能接入（GAME_OPTIONS、getDefaultGameOptions 都在 api 层） -->
                <Border x:Name="PanelGame" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Style="{StaticResource CfgColHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CfgGroupTitle}" Text="游戏选项"/>
                                <!-- .muted 只给 text-dim（styles.css:677），字号走 §2 Dim；文案 DefaultGameOptions.vue:45 -->
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="按游戏内「Esc → 选项」的入口顺序设置，下次启动时应用。"/>
                            </StackPanel>
                            <!-- 右置操作区：选项同步开关，文案来自 DefaultGameOptions.vue:46 -->
                            <Border Grid.Column="2" Style="{StaticResource CfgSync}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource CfgSyncText}" Text="启动时同步"/>
                                    <CheckBox x:Name="SwOptionSync" Style="{StaticResource Switch}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- .cfg-scroll：min-height 220 / grid repeat(2,minmax(0,1fr)) / gap 22 / padding-top 12 — :244
                             padding-top 12 → 上边距；gap 22 → 中间间隔列（契约 §6.2）。
                             CSS grid 自动放置是行优先，所以第 1 组落 (0,0)、第 2 组 (0,2)、第 3 组 (1,0)。
                             @max-850 收单列（:245）WPF 无媒体查询，见 KeysPage.xaml.cs 尾注 -->
                        <Grid MinHeight="220" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 组：图像 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource CfgGroup}" Margin="0">
                                <TextBlock Style="{StaticResource CfgCat}" Text="图像"/>
                                <Border Style="{StaticResource CfgRowBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- :title 绑的是 option id（模板 :197） -->
                                        <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                                   ToolTip="options.fov" Text="视野"/>
                                        <!-- 视野 90°（原版默认 70）＝已改项，走 .cfg-bind.modified — :260 -->
                                        <Button Grid.Column="2" Style="{StaticResource CfgValueModified}" Content="90 °"/>
                                        <Button Grid.Column="4" Style="{StaticResource CfgReset}" ToolTip="恢复此项默认">
                                            <ContentControl Width="13" Height="13" Style="{DynamicResource Icon.Refresh}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CfgRowBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                                   ToolTip="options.renderDistance" Text="视距"/>
                                        <Button Grid.Column="2" Style="{StaticResource CfgValueModified}" Content="16 区块"/>
                                        <Button Grid.Column="4" Style="{StaticResource CfgReset}" ToolTip="恢复此项默认">
                                            <ContentControl Width="13" Height="13" Style="{DynamicResource Icon.Refresh}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CfgRowBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                                   ToolTip="options.particles" Text="粒子效果"/>
                                        <Button Grid.Column="2" Style="{StaticResource CfgValue}" Content="全部"/>
                                        <!-- .cfg-reset.invisible 的 visibility hidden（:268）＝未改项，WPF Visibility Hidden 等价，保留占位 -->
                                        <Button Grid.Column="4" Style="{StaticResource CfgReset}" Visibility="Hidden"
                                                ToolTip="恢复此项默认">
                                            <ContentControl Width="13" Height="13" Style="{DynamicResource Icon.Refresh}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CfgRowBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                                   ToolTip="options.graphicsMode" Text="图形设置"/>
                                        <Button Grid.Column="2" Style="{StaticResource CfgValue}" Content="流畅"/>
                                        <Button Grid.Column="4" Style="{StaticResource CfgReset}" Visibility="Hidden"
                                                ToolTip="恢复此项默认">
                                            <ContentControl Width="13" Height="13" Style="{DynamicResource Icon.Refresh}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CfgRowBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                                   ToolTip="options.clouds" Text="云"/>
                                        <Button Grid.Column="2" Style="{StaticResource CfgValue}" Content="关闭"/>
                                        <Button Grid.Column="4" Style="{StaticResource CfgReset}" Visibility="Hidden"
                                                ToolTip="恢复此项默认">
                                            <ContentControl Width="13" Height="13" Style="{DynamicResource Icon.Refresh}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CfgRowBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                                   ToolTip="options.fpsLimit" Text="FPS 上限"/>
                                        <Button Grid.Column="2" Style="{StaticResource CfgValue}" Content="120"/>
                                        <Button Grid.Column="4" Style="{StaticResource CfgReset}" Visibility="Hidden"
                                                ToolTip="恢复此项默认">
                                            <ContentControl Width="13" Height="13" Style="{DynamicResource Icon.Refresh}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 组：声音 -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource CfgGroup}" Margin="0">
                                <TextBlock Style="{StaticResource CfgCat}" Text="声音"/>
                                <Border Style="{StaticResource CfgRowBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                                   ToolTip="soundCategory_master" Text="主音量"/>
                                        <Button Grid.Column="2" Style="{StaticResource CfgValue}" Content="70 %"/>
                                        <Button Grid.Column="4" Style="{StaticResource CfgReset}" Visibility="Hidden"
                                                ToolTip="恢复此项默认">
                                            <ContentControl Width="13" Height="13" Style="{DynamicResource Icon.Refresh}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CfgRowBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CfgLabel}"
                                                   ToolTip="soundCategory_music" Text="音乐"/>
                                        <Button Grid.Column="2" Style="{StaticResource CfgValue}" Content="30 %"/>
