<UserControl x:Class="Wuhuicl.App.Pages.BridgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MOD 面板页，复刻 KAMUCL-1.1.5/src/renderer/src/views/BridgeView.vue。
         这页和网络联机没有任何关系：它是「运行中实例的 MOD 参数实时编辑器」，
         文件头注释 :2-6 写明参数元数据（名称/说明/分组/类型/默认值/范围/生效方式）由桥接 MOD 声明，
         页面据此生成开关、滑块、输入框或下拉，并以 MOD 返回的实际结果为准。
         它和 Pages/ServersPage.xaml（服务器）、本页同级的 friends（联机）是三个互不相干的独立 view，
         所以既没有页签也没有模态：BridgeView.vue 全文没有 .connect-tabs、没有 modal、没有子模式，
         根节点只有一个 div.page.bridge-page（:186）。

         层级与度量：
           .page.bridge-page  max-width 860（:289），单列；无断点（UI_GEOMETRY_PAGES.md §8 末行）。
           .content .page  gap 16（ui-system.css:10）→ 块间距用子项 Margin 表达。
           .content .page-head margin-bottom 8（ui-system.css:11）；.page-head 是 column gap 4（styles.css:498-502）；
           .content .page-title 24px 行高 1.35（ui-system.css:12，覆盖 styles.css:503 的 text-xl）；
           .page-sub 13px text-dim（styles.css:509-512）。

         数据：已接真实后端 BridgeService —— 状态（/ping）、清单（/manifest）、修改（/set）、恢复（/reset）
         走 .kamucl-bridge.json 发现文件 + X-Kamucl-Token 本地 HTTP；参数行由代码侧动态生成。

         注：下面 XML 注释里的 CSS 令牌一律去掉前导双横线书写（写 accent-soft 而不写 var 形式），
         XML 注释内不允许出现连续两个减号，否则 XAML 编译直接崩。 -->

    <UserControl.Resources>

        <!-- ============ .btn.btn-ghost.btn-sm：min-height 32 / 13px（ui-system.css:17）+ ghost 的 card-2 底与描边 ============
             原版 :193 的「刷新状态」就是这个组合，§2 的 BtnSm 没带 ghost 配色，这里补底与描边。 -->
        <Style x:Key="BridgeBtnGhostSm" TargetType="Button" BasedOn="{StaticResource BtnSm}">
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        </Style>

        <!-- ============ .bridge-row：flex align-center gap space-4 16 / min-height row-h 42 / padding space-3 0 = 12 0（:311），
                     相邻行之间 1px 顶边线（:312 的 color-mix(border 55%, transparent)，WPF 没有 color-mix，退化成 Line 实色） ============ -->
        <Style x:Key="BridgeRow" TargetType="Border">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ============ .bridge-reset：26×26 / 无边 / radius radius-sm 6 / 透明底 / 文字 text-dim（:325-329），
                     hover 换 accent-2 字色 + hover 底（:330，§4 用 AccentHi 顶 accent-2），内层 svg 13×13（:331） -->
        <Style x:Key="BridgeReset" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="恢复默认"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ .bridge-slider：width 150 + accent-color（:321），是原生 input[type=range]。
                     WPF 没有 accent-color，样式库里也还没有 Slider 配方，所以按 Chrome 的原生观感手写一条最小模板：
                     4px 轨道（card-2 底 + border）+ 左侧已填充段 accent + 16×16 圆形 accent 滑块
                     （16 取自同族 .slider::-moz-range-thumb，styles.css:440-447）。
                     轨道点击翻页（RepeatButton 的 Slider 命令）没有接，滑块拖拽本身可用。
                     Track 的 Orientation 必须显式写 Horizontal（WPF 里它默认 Vertical），
                     顺带说明：这条 Slider 是本页唯一自绘控件模板，样式库还没有 Slider 配方（§2 未收）。
                     高度 22 是让行的 min-height 42 上下居中后与控件区齐平，非原版声明值。 -->
        <Style x:Key="BridgeSlider" TargetType="Slider">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource CardSoft}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Accent}"
                                                         Stroke="{DynamicResource Card}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- .content 是整页滚动容器（App.vue:2398-2404，overflow-y auto + scrollbar-gutter stable + padding 24），
         padding 24 由宿主 Grid.Margin 给；滚动条槽用 Visible 对应 stable（契约 §6.5）。 -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">

        <!-- .bridge-page：max-width 860（:289），源码没有 margin auto，所以靠左而不是居中。
             WPF 的 MaxWidth 配非 Stretch 对齐是按内容宽测量的，取不满 860；
             这里靠卡片内的长句（描述行单行宽 + 控件宽）把宽度顶到上限，是工程近似。 -->
        <Grid x:Name="PageRoot" MaxWidth="860" HorizontalAlignment="Left" VerticalAlignment="Top" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel>

                <!-- ============ 页头（BridgeView.vue:187-190）：没有右侧按钮 ============ -->
                <StackPanel Margin="0,0,0,8">
                    <!-- h1.page-title：24px/700 行高 1.35 → 32.4 取 32（ui-system.css:12 + styles.css:503-508） -->
                    <TextBlock Style="{StaticResource PageTitle}" LineHeight="32" Text="MOD 面板"/>
                    <!-- p.page-sub：13px text-dim（styles.css:509-512），与标题之间 gap 4（styles.css:498-502） -->
                    <TextBlock Style="{StaticResource PageSub}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="游戏运行期间实时读取与修改 MOD 参数；以 MOD 返回的实际结果为准"/>
                </StackPanel>

                <!-- ============ 状态卡 .card.bridge-status（:192-206） ============
                     基线是 flex align-center gap space-3 12 / padding space-4 card-pad = 16 20 / wrap（:290），
                     :332 整块重排为 grid：max-width 960、grid-template-columns 24px minmax(0,1fr)、gap 16、padding 24、min-height 0。
                     .card 底走 Panel（radius 14 / border 1 / padding 20 → 这里被压成 24，box-shadow none 见 ui-system.css:13）。
                     .bridge-status.connected 才把描边换成 color-mix(accent 45%, border)（:291），未连接时留 border。 -->
                <Border x:Name="StatusCard" Style="{StaticResource Panel}" Padding="24" MaxWidth="960">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- grid-template-columns 的第一列 24px：只放那颗 10px 状态点（:332） -->
                            <ColumnDefinition Width="24"/>
                            <!-- minmax(0,1fr)：minmax 的下限用 MinWidth 0 表达（契约 §6.3） -->
                            <ColumnDefinition Width="*" MinWidth="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- .bridge-context：grid-column 1/-1 / row align-center space-between gap 12 /
                                 13px text-dim / border-bottom 1 / padding-bottom 12（:332），内容见 :193 -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 左：实例名（versionLabel(currentVersion)）或「尚未选择游戏实例」（:193 三元式） -->
                                <TextBlock x:Name="CtxText" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg2}"
                                           Text="尚未选择游戏实例"/>
                                <Button x:Name="BtnRefresh" Grid.Column="2" Style="{StaticResource BridgeBtnGhostSm}"
                                        Content="刷新状态" Click="Refresh_Click"/>
                            </Grid>
                        </Border>

                        <!-- .bridge-dot：10×10 圆 / text-dim 底 / margin-top 9（:292 + :332），第二行第一列。
                             .on 态才是 ok 绿 + 呼吸脉冲环（:294 的 box-shadow 与 :295-298 的 bridge-pulse 关键帧），
                             契约 §6.8 本轮不做动画，故留命名 Border 位的等价物：这颗 Ellipse 就叫 BridgeDot，
                             接 Storyboard 时对它加环（注意 §4 未收 ok-soft 这个令牌，脉冲环底要另议）。 -->
                        <Ellipse x:Name="BridgeDot" Grid.Row="1" Grid.Column="0" Width="10" Height="10"
                                 Margin="0,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Fill="{DynamicResource Fg2}"/>

                        <!-- .bridge-status-text：flex 1 / min-width 200 / column gap space-1 4（:300 + :301）
                             + span 行高 1.7（:332）；strong 21px（:332 覆盖 :301 的 text-sm 13）+ .muted 12px（:302） -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,16,0,0" MinWidth="200">
                            <!-- :196 的六态文案（依 v-if 短路顺序）由代码侧 Render() 按真实状态挑选 -->
                            <TextBlock x:Name="TxtStatusTitle" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       Text="先选择游戏实例"/>
                            <!-- :197 与上条一一对应的 muted 行 -->
                            <TextBlock x:Name="TxtStatusDetail" Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="20"
                                       TextWrapping="Wrap" Text="选择已安装加载器的实例后，可安装桥接 MOD。"/>
                            <!-- :198 的 presenceError 段落走 .connection-error（border 1 danger / padding 12 16 / radius 10，
                                 connection.css:67），只有报错才出现 -->
                            <Border x:Name="PresenceError" BorderBrush="{DynamicResource Danger}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,16"
                                    Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="PresenceErrorText" FontSize="12" LineHeight="20"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Danger}"/>
                            </Border>
                        </StackPanel>

                        <!-- .bridge-guide-actions：grid-column 2 / flex wrap align-center gap 12（:332），子项 :201-204。
                             gap 12 用子项右下 Margin 表达。四个子项各自的 v-if 都由代码侧按真实状态控制显隐。 -->
                        <WrapPanel Grid.Row="2" Grid.Column="1" Margin="16,16,0,0">
                            <!-- :201 v-if="!connected && bridgePresent === false" 的 .btn.btn-gold，
                                 busy 时文案换成「安装中…」；:disabled="installingBridge || !currentVersion?.loader" -->
                            <Button x:Name="BtnInstall" Style="{StaticResource BtnGold}" Margin="0,0,12,12"
                                    Content="安装桥接 MOD" Click="Install_Click"/>
                            <!-- :202 v-if="currentVersion && !currentVersion.loader && bridgePresent === false" -->
                            <TextBlock x:Name="TxtPureHint" Margin="0,0,12,12" VerticalAlignment="Center" Style="{StaticResource Micro}"
                                       LineHeight="20" TextWrapping="Wrap" MaxWidth="240" Visibility="Collapsed"
                                       Text="纯净版不加载 MOD，请选择带加载器的实例。"/>
                            <!-- :203 v-if="!connected"；文案是 currentVersion ? 前往首页 : 选择游戏实例，
                                 tone 是 bridgePresent === false ? btn-ghost : btn-gold -->
                            <Button x:Name="BtnNav" Style="{StaticResource BtnGold}" Margin="0,0,12,12"
                                    Content="选择游戏实例" Click="Nav_Click"/>
                            <!-- :204 v-if="connected && params.length" 的 .btn.btn-ghost -->
                            <Button x:Name="BtnResetAll" Style="{StaticResource BtnGhost}" Margin="0,0,12,12"
                                    Content="全部恢复默认" Visibility="Collapsed" Click="ResetAll_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- ============ 参数区（:208-284）：v-if="status?.connected" → 整块默认 Collapsed ============
                     参数行由代码侧按 manifest 动态生成进 ParamList（modId → group 两级聚合，各一张 .bridge-card）。
                     加载态/两种空态的显隐也全在代码侧。 -->
                <StackPanel x:Name="ParamsSection" Visibility="Collapsed" Margin="0,16,0,0">

                    <!-- .bridge-toolbar：display flex（:303）；.bridge-search：flex 1（:304）+ .input 基线
                             min-height ctl-h 36 / padding 8 12 / radius 10 / 14px（styles.css:307-313 + ui-system.css:15）；
                             placeholder 文案见 :210。WPF 没有 placeholder，按覆盖层写法。
                             工具条只在 params.length 时出现（:209 v-if）。 -->
                    <Grid x:Name="ToolbarRow" Visibility="Collapsed">
                        <TextBox x:Name="TxtSearch" Style="{StaticResource Input}" TextChanged="Search_TextChanged"/>
                        <TextBlock x:Name="SearchPh" Text="搜索参数名称、说明、分组…" FontSize="14"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"
                                   Foreground="{DynamicResource Fg2}"/>
                    </Grid>

                    <!-- 动态参数行容器 -->
                    <StackPanel x:Name="ParamList" Margin="0,12,0,0"/>

                    <!-- 加载态 :212 的 .card.empty：正在读取参数清单…（前置 .spin 转圈） -->
                    <Border x:Name="LoadingCard" Style="{StaticResource Panel}" Padding="32,16"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ContentControl Style="{StaticResource Spin}" Width="14" Height="14"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="14" VerticalAlignment="Center" Text="正在读取参数清单…"/>
                        </StackPanel>
                    </Border>

                    <!-- 空态一 :281：没有匹配「搜索词」的参数 -->
                    <Border x:Name="EmptyNoMatch" Style="{StaticResource Panel}" Padding="32,16"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyNoMatchText" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 空态二 :282：桥接 MOD 没有注册任何参数 -->
                    <Border x:Name="EmptyNoParams" Style="{StaticResource Panel}" Padding="32,16"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock FontSize="14" HorizontalAlignment="Center" Text="桥接 MOD 没有注册任何参数"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
