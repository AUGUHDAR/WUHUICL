<UserControl x:Class="Wuhuicl.App.Pages.HomePage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ctl="clr-namespace:Wuhuicl.App.Controls">

    <!-- 版式来源：views/HomeView.vue（模板 :477-763，样式 :765-1034）。
         取值原则：`<style scoped>` 尾部 :1030 与 :1033 两串压缩规则写在所有 @media 之后，同特异度后者胜，
         所以 :782-1028 的大部分基础值是死代码，本文一律取最终生效值并在注释里标出覆盖关系。
         全局层还要算上 ui-system.css（main.ts 里它在 HomeView 的样式之后注入，同特异度压过 scoped）
         与 styles.css:110-113 的 `* { box-sizing:border-box; margin:0; padding:0 }` 复位（h3/p 都不带外边距）。
         XAML 注释里不能出现连续两个减号，CSS 变量一律写成 var(space-1) 这种去前缀形式。 -->

    <!-- ====================================================================
         本页私有样式：键名一律 Hp 前缀（主题画刷键是裸名，同名会在 XAML 加载期
         把 SolidColorBrush 喂给 Style 直接抛异常）。
         带 Template 的样式全部挂在 Button / RadioButton 上：WPF 的 Border 没有
         Template 属性，给 Border 样式的 Setter 写 Template 就是 MC4005。
         每个键都自带模板与触发器，不依赖 BasedOn 继承触发器（WPF 只继承 Setter）。
         ==================================================================== -->
    <UserControl.Resources>

        <!-- .runtime-item（HomeView.vue:871）＋尾部 padding 10 12（:1030）：grid 34/1fr/15、gap 11、
             左对齐、透明底、字 text。
             为什么不用共享的 RuntimeCell：那颗悬停浮块在原版里是 .runtime-strip 的**唯一一个**元素
             （模板 :546，样式 :862-870），由 JS 把 left/width 搬到当前悬停的那格上（脚本 :177-190）；
             RuntimeCell 的模板（Themes/Controls.xaml:990）把它做成了每格各自一份，底色还是 AccentSoft
             （accent 16%）而不是 accent 10%。浮块归位到 RuntimeBlob 那一个元素，这里只留格子本体。 -->
        <Style x:Key="HpRuntimeCell" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12"
                                Margin="4,0" Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- .runtime-item:hover { color: var(accent-2) }（:873）：
                                 只有继承字色的 strong 会变，small 与首个 svg 各自带显式色 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .manage-instances（HomeView.vue:891-893）：inline-flex / gap 7 / min-height 34 / padding 0 12 /
             radius 9 / **有** 1px 描边（施工任务说它没有描边，但 :891 的 border:1px solid var(border)
             没有被任何后续规则覆盖，尾部 :1030 也没提它，docs/UI_GEOMETRY_HOME.md §5.4 也记的是「border 1px」）/
             底 card-2 / 字 text-dim / 12px / weight 550 / svg 15×15。
             hover（:892）字色转 text、描边转 border-strong。
             共享的 BtnGhost 三处不符：字色是 text、radius 10、字重 600，所以另立本键。 -->
        <Style x:Key="HpManageInstances" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .instance-more（HomeView.vue:905-907）：20×20 / radius 7 / 透明底 / 字 text-dim / svg 15×15。
             尾部 :1030 把它从 absolute top 4 right 4 改成 position:static、落到 grid 第 4 列第 1 行，
             所以它是行内的一个格子，不再压在卡片角上；列宽 36 而它只有 20，CSS 柱内默认贴左沿。 -->
        <Style x:Key="HpInstanceMore" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="wash" Background="{DynamicResource Hover}" CornerRadius="7" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- .instance-more:hover { background: var(hover); color: var(text) }（:906） -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wash" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .instance-play（HomeView.vue:909-912）：尾部 :1030 把 38×32 改成 40×34，radius 8 不变，落到第 5 列；
             底色 color-mix(accent 18%, card-2)，字色 accent-2，svg 15×15；
             hover（:910）底色转纯色 accent、字色 on-accent；disabled（:911）opacity .45。
             共享的 SquareBtn 尺寸与圆角对，但底色是 AccentSoft（16% accent 的透明罩），
             不是「18% accent 混进 card-2」，所以这里用两层 Border 复现混色：
             下层实色 card-2（CardSoft），上层 accent 以 Opacity 0.18 压上去；主题切换照样跟着走。
             hover 时把上层罩归零、下层转纯色 accent ＝ 原版的 accent 实心。 -->
        <Style x:Key="HpInstancePlay" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="base" Background="{DynamicResource CardSoft}" CornerRadius="8">
                            <Grid>
                                <Border x:Name="wash" Background="{DynamicResource Accent}" Opacity="0.18"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="base" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="wash" Property="Opacity" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .instance-last（HomeView.vue:904 与尾部 :1030）：字号被尾部从 11px 提到 12px，
             仍是 text-dim、不换行、超长截断；v-if（模板 :592）是没有游玩记录时整条不渲染。
             端口的 LastPlayed 用「未启动过」占位（Services/LaunchSession.cs:150-157），
             所以这里按原语义留「值为空串就收起」的触发器，接上真实 lastPlayed 后自然生效。 -->
        <Style x:Key="HpInstanceLast" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastPlayed}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- .account-copy span（HomeView.vue:923-925）：11px，字色 accent-2；
             未登录那支的 span 带 .offline-state（模板 :631）才是 text-dim。
             原版用 v-if 分两支，端口的数据源是 SelectedAccount：为 null 就走 offline-state 配色。 -->
        <Style x:Key="HpAccountStatus" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                    <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A.8 .account-placeholder（模板 :630，样式 :929）：54×54 / 1px dashed border-strong /
             radius 12 / text-dim / 20px 问号，只在「没有选中账户」那一支出现。
             WPF 的 Border 画不了虚线描边（没有 StrokeDashArray），所以本体是 Grid + Rectangle，
             与 .empty-instances 的虚线框同一套做法。 -->
        <Style x:Key="HpAccountPlaceholder" TargetType="Grid">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 未登录那一支（模板 :629-631）不渲染头像，也不渲染状态点 i：
             两条 DataTrigger 让 v-if / v-else 的互斥关系自己成立，不需要代码切换。 -->
        <Style x:Key="HpAccountAvatar" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HpAccountDot" TargetType="Grid">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A.9 .skin-overlay（模板 :649-651，样式 :949-952）：absolute 左 12 右 12 底 12 / z 2 /
             min-height 34 / flex 居中 gap 9 / padding 7 10 / radius 9 / 描边 1 border /
             底 color-mix(card 78%, transparent) / 字 text-dim / 11px / weight 550 / blur(12)。
             WPF 的 Border 只有一个 Background，半透明底与不透明描边没法同层，
             所以底色交给模板里同圆角的下层 Border（Opacity 0.78），描边与文字保持全不透明；
             backdrop-filter 只能由 Services/MaskBlur.cs 在代码侧快照，XAML 表达不了。
             .action（:950-951）＝ cursor pointer ＋ hover 字色转 text；.error（:952）＝ 字色 danger。
             三个分支默认全收起：原版就是 v-if / v-else-if，且端口没有 skinLoading / skinError 数据源。 -->
        <Style x:Key="HpSkinOverlay" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{DynamicResource Card}" Opacity="0.78" CornerRadius="9"/>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .skin-overlay.error（:952）：字色 danger，仍带 .action 的 hover 转 text（:951）。
             用 Style.Triggers 而不是模板触发器：样式触发器优先级高于模板触发器，压得住基键的 hover。 -->
        <Style x:Key="HpSkinOverlayError" TargetType="Button" BasedOn="{StaticResource HpSkinOverlay}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .float-menu（HomeView.vue:958，scoped 特异度压过全局 styles.css:588）：
             fixed / z 8001 / max-height 280 且自身滚动 / padding 6 / radius 10 / 描边 1 border /
             底 color-mix(card 94%, transparent) / 阴影 shadow-lg / blur(24)。
             94% 与实色 Card 的差值在压住内容的浮层上看不出来，与 Pages/VersionsPage.xaml:158 的
             VpFloatMenu 同一处理；位置由 JS 量触发按钮后写内联（脚本 :402-409 / :421-426），
             所以本体挂在 Canvas 上，代码侧改 Canvas.Left/Top。 -->
        <Style x:Key="HpFloatMenu" TargetType="Border">
            <Setter Property="MaxHeight" Value="280"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
        </Style>

        <!-- .menu-item（HomeView.vue:962-964）：flex / gap 8 / width 100% / min-height 34 / padding 0 10 /
             radius 7 / 12px / weight 500 / 左对齐 / 透明底 / 字 text；
             hover 与 .active（:963）底 accent-soft ＋ 字 accent-2；:disabled（:961）opacity .45。 -->
        <Style x:Key="HpMenuItem" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .menu-item.active（:963）：静止态就带 hover 的配色 -->
        <Style x:Key="HpMenuItemActive" TargetType="Button" BasedOn="{StaticResource HpMenuItem}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
        </Style>
        <!-- .menu-item.danger：静止字色 danger（:964）；hover 走全局 styles.css:636-639
             （特异度 0,4,0 压过 scoped 的 0,3,0）：底 danger-soft、字仍是 danger。
             需要自带模板：基键模板里的 hover 触发器会把字色拽回 accent-2。 -->
        <Style x:Key="HpMenuItemDanger" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .card-float-menu .menu-item（HomeView.vue:960）：min-height 40 / 13px，其余照基键 -->
        <Style x:Key="HpCardMenuItem" TargetType="Button" BasedOn="{StaticResource HpMenuItem}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="HpCardMenuItemDanger" TargetType="Button" BasedOn="{StaticResource HpMenuItemDanger}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- .modal-mask（styles.css:527-537）：fixed inset 0 / z 10000 / flex 居中 / 底 mask / blur(10)。
             本键的 padding 20,16 是按 .java-picker（HomeView.vue:772）算的：
             横向＝width min(580px, 100vw 减 40px) → 左右各 20；
             纵向＝ui-system.css:38 的 max-height calc(100vh 减 32px) → 上下各 16（它压过 styles.css:547 的减 96）。
             .modal 通用宽 min(460px, 100vw 减 48px) 的那两支把 padding 覆盖成 24,16。
             backdrop-filter 交给 Services/MaskBlur.cs（MainWindow.xaml.cs:516 的日志窗就是这么接的）。
             注意：本页浮层只能盖住 .content 这块（MainWindow.xaml:260 的 Grid），
             原版 inset 0 是整个视口；要真盖满窗口得把这几块搬进 MainWindow，超出本页所有权。 -->
        <Style x:Key="HpModalMask" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Overlay}"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <!-- .modal（styles.css:545-556 叠 ui-system.css:37-38）：
             宽 min(460px, 100vw 减 48px)、max-width 100vw 减 32、max-height 100vh 减 32 且自身滚动、
             底 surface-raised（card-solid 97%，主题字典没有该键，取 Card）、描边 1、radius 14（radius-lg）、
             padding 24（var(space-5)）、阴影 shadow-lg。 -->
        <Style x:Key="HpModal" TargetType="Border">
            <Setter Property="Width" Value="460"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
        </Style>

        <!-- 弹窗标题：HomeView.vue 与 ConfirmModal.vue 的 scoped 里都**没有** .modal-title 规则
             （16/700 那条属于 GameView.vue，scoped 不外溢），所以这里渲染的是裸 h3：
             全局复位把 margin 归零，字号是 UA 的 1.17em ＝ 14 × 1.17 ≈ 16.4，字重 bold。 -->
        <Style x:Key="HpModalTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16.4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- .confirm-text（ConfirmModal.vue:35-39）：var(text-md) 14px / line-height 1.7 → 24 /
             word-break break-all；p 的外边距被全局复位归零，所以它紧贴标题 -->
        <Style x:Key="HpConfirmText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- .btn.btn-danger（styles.css:158-178 叠 :240-249）：min-height 36（ctl-h）/ padding 8 16 /
             radius 10（radius-md）/ 14px / 600 / 底 danger-soft / 描边 danger-border / 字 danger；
             hover 底转 color-mix(danger 18%, transparent)。
             共享的 BtnDanger 没有那层浅红底，所以按全局值补齐：下层实色 DangerSoft，
             上层 Danger 以 Opacity 0.18 做 hover 罩（18% danger 直接压上去的观感与混色一致）。 -->
        <Style x:Key="HpBtnDanger" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="wash" Background="{DynamicResource Danger}" Opacity="0"
                                        CornerRadius="9"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wash" Property="Opacity" Value="0.18"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- B.13 .java-option（HomeView.vue:776-781）：label 包 input[type=radio] ＋ span（strong ＋ small）。
             flex / gap 12 / align center / padding 13 / margin-bottom 8 / 描边 1 border / radius 12；
             :has(input:checked)（:777）描边转 accent、底色转 accent-soft；
             input（:778）accent-color accent、flex none —— 原版没给 radio 写几何，走 Chromium UA 默认 13×13；
             strong / small 都是 block（:780），small（:781）margin-top 5 / 11px / text-dim / overflow-wrap anywhere。
             整行做成一个 RadioButton（GroupName＝home-java，与原版 name 属性一致）：点整行都能选。 -->
        <Style x:Key="HpJavaOption" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                                    <Ellipse x:Name="ring" Stroke="{DynamicResource BorderStrong}"
                                             StrokeThickness="1" Fill="Transparent"/>
                                    <Ellipse x:Name="dot" Width="5" Height="5" Opacity="0"
                                             Fill="{DynamicResource AccentFg}"/>
                                </Grid>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- .java-option strong（:780）：display block，字号继承 body 的 var(text-md) 14，字重 bolder -->
        <Style x:Key="HpJavaOptionStrong" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HpJavaOptionSmall" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- .java-picker-description（:774）：12px / text-dim / margin-bottom 16 / overflow-wrap anywhere -->
        <Style x:Key="HpJavaDescription" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- .java-picker .modal-actions（模板 :751，样式 :773）：flex / justify flex-end / gap 10 /
             margin-top 22（它压过全局 styles.css:557-563 的 gap 12 / margin-top 24） -->
        <Style x:Key="HpJavaActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,22,0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- C. 结构规矩：页根是 Grid，滚动主体与固定浮层是它的兄弟节点。
         固定层（遮罩、浮起菜单、模态）绝不能塞进 ScrollViewer：那会跟着滚并被裁。
         滚动的是「整页」（原版的 .content 就是 overflow-y auto 包住 .home-dashboard 两列），
         所以 ScrollViewer 在 .home-dashboard 外面；早先把它放进左列里，右列就永远不参与滚动，
         而且更糟：dashboard 变成 ScrollViewer 的兄弟、又是 HorizontalAlignment=Center，
         星号列在按内容测量时不贡献宽度 → 整页塌成内容宽（实测首页只有 766 宽，正版是 1104）。 -->
    <Grid>

        <!-- .home-dashboard（HomeView.vue:782-791 与尾部 :1030）：
             grid minmax(0,1fr) minmax(250px,290px) / gap 16（尾部覆盖基础 14）/ max-width 1160 / margin 0 auto。
             右列 minmax(250,290) 在本项目的最小窗口（960）下也取满 290（可用宽远大于 250），
             按 docs/UI_GEOMETRY_HOME.md §7 的阶梯先写死 290。
             宽度靠外层 ScrollViewer 的横向拉伸拿到视口宽（这里必须保持默认的 Stretch，
             一旦写 HorizontalAlignment=Center，Grid 就按"内容想要的宽度"排版，星号列不再摊开，
             整页会塌成 766 宽并居中——实测首页左列因此只有 460，正版是 798）；
             MaxWidth 1160 夹住后由 Stretch 自己居中，与 VersionsPage.xaml:402 的 MaxWidth 同一套写法。 -->
        <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="0,0,8,0">
        <Grid MaxWidth="1160">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- 左列 .home-main：flex 列，gap 14（:792-798，尾部未覆盖）→ hero / 状态条 / 最近游戏 -->
            <StackPanel>
                    <!-- .hero-card（模板 :480，样式 :799-809 + 尾部 :1030/:1031）：
                         height var(banner-h) 430 被 max-height 360 夹住 → 实高 360，min-height 320，
                         radius 20，描边 1px color-mix(border 95%, white 4%)（端口没有该混合键，取 Line），
                         底 #17231f，overflow hidden -->
                    <Border Height="360" CornerRadius="20" Background="#FF17231F"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <!-- 原版 .hero-image 是多张叠放、各自 opacity 500ms 交叉淡入（:810-811 ＋ :1033
                                 object-position center 42%）。用 ImageBrush 的 Viewbox（相对图片的归一化裁剪窗）
                                 表达 cover ＋ 42% 锚点：Image ＋ RenderTransform 的基准对齐随布局变化，
                                 实测会在卡片顶部露一条缝。 -->
                            <Grid x:Name="HeroStage" ClipToBounds="True" SizeChanged="HeroStage_SizeChanged">
                                <Border x:Name="HeroImageA" Opacity="1"/>
                                <Border x:Name="HeroImageB" Opacity="0"/>
                            </Grid>
                            <!-- .hero-shade：尾部 :1030 覆盖成竖向渐变
                                 linear-gradient(180deg, rgba(0,0,0,.16), rgba(0,0,0,.18) 30%, rgba(0,0,0,.68)) -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#29000000"/>
                                        <GradientStop Offset="0.3" Color="#2E000000"/>
                                        <GradientStop Offset="1" Color="#AD000000"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- .hero-content（:817 ＋ 尾部 :1030）：padding 24 / justify space-between /
                                 align-items flex-start / 字色 var(bn-text)＝#fff（styles.css:75，不随主题反转） -->
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- .hero-kicker（模板 :495，样式 :818 ＋ 尾部 :1030）：
                                     min-height 34 / padding 5 10 / radius 7 / 12px / weight 650 -->
                                <Border Grid.Row="1" Style="{StaticResource HeroKicker}">
                                    <TextBlock Text="当前版本" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF"/>
                                </Border>

                                <!-- .hero-metadata-slot（模板 :496，样式 :821）：width 100% / position relative，
                                     :821 写的 min-height 130 已被尾部 :1030 的 .hero-metadata-slot{min-height:0} 收掉，
                                     所以这里不预留占位高；里面那层 .hero-metadata（:498 ＋ :822）只有 width 100%，
                                     两层的用处是给 instance-switch 过渡当 key 容器（WPF 没有 Vue 的 Transition 组件，
                                     换实例的淡出淡入记在动效待办）。
                                     .hero-content h1 同样被尾部 :1030 改过：clamp(24,2.6vw,32) ＋ line-height 1.25
                                     ＋ 两行截断，:819 那套 clamp(46,5.2vw,64) ＋ nowrap 已经不生效。 -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,18,0,0">
                                    <!-- .hero-content h1（模板 :499，样式 :819 ＋ 尾部 :1030）：
                                         clamp(24px, 2.6vw, 32px)（1360 窗口下 2.6vw=35 → 取上限 32）、
                                         line-height 1.25 → 40、两行截断（-webkit-line-clamp:2 → MaxHeight 80）、
                                         字重 850（WPF 无该档，取最近的 ExtraBold 800）、
                                         text-shadow 0 4px 24px rgba(0,0,0,.32)（:819 未被后文覆盖）、
                                         margin-top 18。letter-spacing -1px WPF 的 TextBlock 没有对应属性，
                                         差值记进 UI_SPEC 的已知偏差。 -->
                                    <TextBlock x:Name="HeroTitle" Text="还没有安装版本" FontSize="32"
                                               FontWeight="ExtraBold" Foreground="#FFFFFFFF"
                                               LineHeight="40" LineStackingStrategy="BlockLineHeight"
                                               MaxWidth="620" TextWrapping="Wrap"
                                               MaxHeight="80" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                                              Opacity="0.32" Color="#000000"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <!-- .hero-edition（模板 :500-503，样式 :829 ＋ 尾部 :1030）：
                                         flex wrap / align center / gap 10 / margin-top 8 / 17px / weight 650；
                                         .hero-game-version（:830 ＋ 尾部）15px 白色 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock x:Name="HeroGameVersion" Text="" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                                   VerticalAlignment="Center"/>
                                        <Border x:Name="HeroLoader" Style="{StaticResource LoaderBadge}">
                                            <TextBlock x:Name="HeroLoaderText" Text="原版" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#FFF6FFF8"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="HeroSub" FontSize="12.5" Foreground="#CCE8EDF5"
                                               Margin="0,10,0,0" MaxWidth="480" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- .hero-actions（模板 :508，样式 :832 ＋ 尾部 :1030）：flex / width 100% /
                                     margin-top auto / align flex-end / justify space-between / gap 12 / wrap -->
                                <Grid Grid.Row="3">
                                    <!-- .hero-secondary-actions（:509-522，样式 :833-838）：flex align stretch，
                                         .hero-settings 52 高、左半 radius 10，.hero-more 52×52、右半 radius 10 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom">
                                        <Button x:Name="HeroSettings" Style="{StaticResource HeroSettings}"
                                                Click="VersionSettings_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Width="18" Height="18"
                                                                VerticalAlignment="Center"
                                                                Style="{DynamicResource Icon.Gear}"/>
                                                <TextBlock Text="版本设置" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="HeroMore" Style="{StaticResource HeroMore}"
                                                Click="MoreVersion_Click">
                                            <ContentControl Width="19" Height="19"
                                                            Style="{DynamicResource Icon.Ellipsis}"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- .launch-combo（模板 :524，样式 :833 ＋ :841-845）：
                                         display flex / align-items stretch / min-width 310 / height 76 /
                                         radius 14 / overflow hidden。
                                         .launch-main 是 flex:1（:849）→ 在 310 的容器里实宽 310 减 48 ＝ 262，
                                         不是只有 min-width 180，所以这里用两列（星号 ＋ 48）复现；
                                         启动进度覆盖层才能按 .launch-main 的实宽算百分比。
                                         原版这里的组合阴影（:843 color-mix(accent 38%) ＋ inset 白 14%）
                                         没有对应的主题键，且阴影在共享样式 LaunchMain 之外，记进待办。 -->
                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                          Height="76" MinWidth="310">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="HeroPlay" Grid.Column="0" Style="{StaticResource LaunchMain}"
                                                VerticalAlignment="Stretch" Click="Play_Click"
                                                IsEnabled="{Binding CanPlay}">
                                            <Grid>
                                                <!-- A.1 .launch-progress（模板 :531，样式 :853）：
                                                     absolute inset 0 auto 0 0 → 顶到 .launch-main 的 padding box
                                                     左沿、上下铺满；底 rgba(255,255,255,.25)；width ＝ percent%；
                                                     它是 .launch-content（position relative / z-index 1，:532）的
                                                     **下层**，所以排在内容前面。
                                                     负左边距 24 抵掉 .launch-main 的 padding 0 24（:849 ＋ :1030），
                                                     让覆盖层从按钮左边缘起算，与 CSS 的 inset 0 对齐。
                                                     可见性与像素宽由代码算（LaunchSession.Progress 是 0-100，
                                                     宽＝HeroPlay.ActualWidth × Progress / 100）。
                                                     注意：共享模板 LaunchMain（Themes/Controls.xaml:930-933）里
                                                     已经画了一条 ProgressBar，而且它的轨道把 25% 白罩铺满 100% 宽、
                                                     指示条又是 45% 白，与本体的「只有 0 到 percent 那一段 25% 白」不符。
                                                     接线时二选一：收起模板那条只用本元素，或请主控改 LaunchMain。 -->
                                                <Border x:Name="LaunchProgressOverlay" Background="#40FFFFFF"
                                                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                        Margin="-24,0,0,0" Visibility="Collapsed"/>
                                                <!-- .launch-content（模板 :532-535，样式 :850-852）：
                                                     flex center / gap 12 / svg 22×22 / 文字单行截断 -->
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ContentControl Width="22" Height="22"
                                                                    VerticalAlignment="Center"
                                                                    Style="{DynamicResource Icon.Play}"/>
                                                    <TextBlock x:Name="HeroPlayText" Text="开始游戏"
                                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <!-- .launch-arrow（模板 :537，样式 :855 基础 62 被尾部 :1030 的 48 覆盖）/
                                             svg 22×22，左边框 1px rgba(255,255,255,.22) 在共享样式里 -->
                                        <Button x:Name="HeroArrow" Grid.Column="1" Style="{StaticResource LaunchArrow}"
                                                Height="76" ToolTip="选择游戏实例"
                                                Click="PlayOptions_Click">
                                            <ContentControl Width="22" Height="22"
                                                            Style="{DynamicResource Icon.ChevronDown}"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- .runtime-strip（模板 :545，样式 :860 ＋ 尾部 :1030 ＋ :769）：
                         grid 1.12fr 0.95fr 0.92fr / min-height 68（基础 82 作废）/ padding 8 / radius 15 /
                         描边 1 / overflow hidden / 阴影 shadow / blur(18) saturate(130%)；
                         底色是 HomeView.vue:769 的 background:var(surface-content) !important
                         （＝card-solid 94%，端口取 Card），不是 :860 的 color-mix(card 80%) -->
                    <Border x:Name="RuntimeStrip" MinHeight="68" Margin="0,14,0,0" Padding="8" CornerRadius="15"
                            Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="0.95*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="0.92*"/>
                            </Grid.ColumnDefinitions>

                            <!-- A.2 .runtime-blob（模板 :546，样式 :862-870）：absolute top/bottom 0 /
                                 radius 12 / margin var(space-1) 0 ＝ 4 0 /
                                 底 color-mix(in srgb, var(accent) 10%, transparent) / opacity 0→1 ＋ scale .97→1 /
                                 z-index 0（三格是 z-index 1，见 :871）/ pointer-events none；
                                 left 与 width 由 JS 量到当前悬停格（脚本 :177-190）。
                                 10% 混色没有对应的主题键（AccentSoft 14%、AccentPick 5%、Accent8 8%、Accent16 16%），
                                 写死 #1A9475ED 这类字面量会锁色，所以用「Background＝Accent ＋ Opacity＝0.1」：
                                 浮块自身不叠任何子内容，Opacity 后＝10% accent 压过状态条底色，
                                 与 color-mix(accent 10%, transparent) 观感一致，且跟着主题走（近似点在此）。
                                 上下各 -4 抵掉状态条的 padding 8（CSS 的 top/bottom 0 是相对 padding box 量的），
                                 再算上自身 margin 4 0 → 高度＝内高减 8。
                                 left/width 由代码写 Margin.Left 与 Width（同一个 Grid 坐标系，与 .runtime-item 对齐）。 -->
                            <Border x:Name="RuntimeBlob" Panel.ZIndex="0" Background="{DynamicResource Accent}"
                                    Opacity="0" Width="0" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Margin="0,-4,0,-4" CornerRadius="12" IsHitTestVisible="False"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Border.RenderTransform>
                            </Border>

                            <!-- .runtime-item + .runtime-item { border-left: 1px border }（:872）：
                                 分隔线归在右侧格子的左边，画在浮块之上（同为 z 0，文档序在后） -->
                            <Border Grid.Column="1" Background="{DynamicResource Line}"/>
                            <Border Grid.Column="3" Background="{DynamicResource Line}"/>

                            <!-- 第 1 格：运行环境（模板 :547-551） -->
                            <Button x:Name="CellJava" Grid.Column="0" Panel.ZIndex="1"
                                    Style="{StaticResource HpRuntimeCell}"
                                    MouseEnter="RuntimeCell_Enter" Click="PickJava_Click"
                                    ToolTip="选择此实例的 Java：自动或手动">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- .runtime-item > svg:first-child（:874）：27×27，字色 text（默认继承） -->
                                    <ContentControl Grid.Column="0" Width="27" Height="27"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource Icon.Java}"/>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <!-- .runtime-item small（:876）：12px text-dim -->
                                        <TextBlock Text="运行环境" FontSize="12" Foreground="{DynamicResource Fg2}"/>
                                        <!-- .runtime-item strong（:877）：13px / 650 / 单行截断 -->
                                        <TextBlock Text="{Binding RuntimeSummary}" FontSize="13"
                                                   FontWeight="SemiBold" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- .runtime-chevron（:878）：14×14 / text-dim / opacity .7 -->
                                    <ContentControl Grid.Column="2" Width="14" Height="14"
                                                    VerticalAlignment="Center" Opacity="0.7"
                                                    Foreground="{DynamicResource Fg2}"
                                                    Style="{DynamicResource Icon.ChevronRight}"/>
                                </Grid>
                            </Button>

                            <!-- 第 2 格：内存分配（模板 :552-556） -->
                            <Button x:Name="CellMemory" Grid.Column="2" Panel.ZIndex="1"
                                    Style="{StaticResource HpRuntimeCell}"
                                    MouseEnter="RuntimeCell_Enter" Click="GotoMemory_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" Width="27" Height="27"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource Icon.Memory}"/>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="内存分配" FontSize="12" Foreground="{DynamicResource Fg2}"/>
                                        <TextBlock Text="{Binding MemorySummary}" FontSize="13"
                                                   FontWeight="SemiBold" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ContentControl Grid.Column="2" Width="14" Height="14"
                                                    VerticalAlignment="Center" Opacity="0.7"
                                                    Foreground="{DynamicResource Fg2}"
                                                    Style="{DynamicResource Icon.ChevronRight}"/>
                                </Grid>
                            </Button>

                            <!-- 第 3 格：运行状态（模板 :557-561）。点击打开日志弹窗——原版日志是 z 9100 的
                                 模态窗（MainWindow.xaml:300 的 LogOverlay），不是首页里的一张卡 -->
                            <Button x:Name="CellState" Grid.Column="4" Panel.ZIndex="1"
                                    Style="{StaticResource HpRuntimeCell}"
                                    MouseEnter="RuntimeCell_Enter" Click="ToggleLog_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- A.3 .runtime-state > svg:first-child { color: var(accent-2) }（:879）：
                                         第 3 格的首个图标固定 accent-2，不是 .runtime-item 的 text（:874） -->
                                    <ContentControl Grid.Column="0" Width="27" Height="27"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentHi}"
                                                    Style="{DynamicResource Icon.Pulse}"/>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="运行状态" FontSize="12" Foreground="{DynamicResource Fg2}"/>
                                        <!-- .runtime-state strong（:880 与 :883）＋ i（:881-882、:884）：
                                             i 是 7×7 圆点，ready/running 底色 ok、光环 0 0 0 3px ok-soft，
                                             error 换成 danger ＋ danger-soft，idle 只有灰点没有光环；
                                             strong 是 flex / align center / gap 7 / 字色 accent-2，error 档转 danger。
                                             光环不占布局，所以放在 7×7 的网格里向外溢出画。
                                             三档色调全部由 LaunchSession 的 RunStateColor / RunStateRing / RunStateFg
                                             提供（Services/LaunchSession.cs:108-133），
                                             这里不再摆一对「等数据源接入」的 Collapsed 副本。 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Grid Width="7" Height="7" VerticalAlignment="Center">
                                                <Ellipse Width="13" Height="13" HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding RunStateRing, Converter={StaticResource BrushByKey}}"/>
                                                <Ellipse Width="7" Height="7" HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding RunStateColor, Converter={StaticResource BrushByKey}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding RunStateText}" FontSize="13"
                                                       FontWeight="SemiBold" Margin="7,0,0,0"
                                                       Foreground="{Binding RunStateFg, Converter={StaticResource BrushByKey}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ContentControl Grid.Column="2" Width="14" Height="14"
                                                    VerticalAlignment="Center" Opacity="0.7"
                                                    Foreground="{DynamicResource Fg2}"
                                                    Style="{DynamicResource Icon.ChevronRight}"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- .instances-block（模板 :564，样式 :886 与尾部 :1030）：
                         background var(surface-content)（端口取 Card）/ radius var(radius-lg) 14 / padding 16 /
                         margin-top 14。**没有描边**：:886 与 :1030 都没给它 border，
                         所以这里不能像卡片那样套 1px 线（前一版多画了一圈）。 -->
                    <Border Margin="0,14,0,0" Padding="16" CornerRadius="14"
                            Background="{DynamicResource Card}">
                        <StackPanel>
                            <!-- .instances-head（模板 :565，样式 :887 ＋ 尾部 margin-bottom 8）：
                                 flex / align center / justify space-between -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <!-- .instances-head h2::before（:890）：4×17 radius 2 的 var(accent-grad) 短竖线 -->
                                    <Border Width="4" Height="17" CornerRadius="2"
                                            Background="{DynamicResource AccentGrad}"
                                            VerticalAlignment="Center"/>
                                    <!-- .instances-head h2（:888）：17px / 750，与竖线 gap 9 -->
                                    <TextBlock Text="最近游戏" Style="{StaticResource H2}" Margin="9,0,0,0"/>
                                </StackPanel>
                                <!-- A.4 .manage-instances（模板 :567，样式 :891-893）：svg 15×15 ＋ gap 7 -->
                                <Button Style="{StaticResource HpManageInstances}"
                                        HorizontalAlignment="Right" Click="NavVersionsFromButton">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Width="15" Height="15" VerticalAlignment="Center"
                                                        Style="{DynamicResource Icon.Apps}"/>
                                        <TextBlock Text="管理实例" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 空态 .empty-instances（模板 :603，样式 :913）：width 100% / min-height 110 /
                                 dashed 1px border-strong / radius 13 / card 底 / text-dim 居中，整块可点，
                                 里面没有按钮 -->
                            <Grid x:Name="EmptyHint" MinHeight="110" Cursor="Hand"
                                  Background="{DynamicResource Card}"
                                  Visibility="Collapsed" MouseLeftButtonDown="NavVersionsFromButton">
                                <Rectangle RadiusX="13" RadiusY="13" StrokeThickness="1"
                                           Stroke="{DynamicResource BorderStrong}"
                                           StrokeDashArray="4 2" StrokeDashCap="Flat"/>
                                <TextBlock x:Name="EmptyHintText" FontSize="12.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fg2}"
                                           Text="尚未安装游戏实例，点击前往版本管理"/>
                            </Grid>

                            <!-- .instance-grid（模板 :573，样式 :894 与尾部 :1030）：尾部把基础的 4 列网格
                                 改成 display flex / 列方向 / gap 0 → 一个列表，每行一张 .instance-card。
                                 v-if store.installed.length（:573）→ 有实例才渲染，空态由上面的 EmptyHint 顶位 -->
                            <ListBox x:Name="HomeInstalled" Style="{StaticResource CardList}"
                                     ItemContainerStyle="{StaticResource RowItem}"
                                     ItemsSource="{Binding InstalledList}"
                                     SelectedItem="{Binding SelectedInstalled}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- .home-dashboard .instance-card（模板 :574-601，样式 :896 与尾部 :1030）：
                                             grid 36px minmax(0,1fr) auto 36px 40px / gap 12 / align center /
                                             min-height 72（box-sizing 含 padding 12×2 → 内容 48）/ padding 12 /
                                             border:0 只留 border-bottom 1px / radius 0 / 无阴影 / 透明底。
                                             hover 底 var(hover)、selected 底 var(accent-soft)（:1030 末段）
                                             → 由 Themes/Controls.xaml:1097 的 RowItem 容器给。
                                             gap 用间隔列表达。 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- A.5 .instance-icon（模板 :583-584，样式 :900-901 ＋ 尾部 :1030）：
                                                 36×36、align-self center，两个分支：
                                                 v-if versionIconUrl(version) → img.instance-icon.image
                                                 （object-fit contain ＋ image-rendering pixelated），
                                                 否则是内联的草方块 svg（48 视盒，五块多边形）。
                                                 VersionRow 没有图标字段（Services/LaunchSession.cs:13-37）→
                                                 // 占位：图片槽是几何正确的收起壳，等 versionIconUrl 接入。
                                                 模板内的 x:Name 不进页面对象域，接线要按行取容器或直接加字段。 -->
                                            <Image Grid.Column="0" x:Name="InstanceIconImage" Width="36" Height="36"
                                                   Stretch="Uniform" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   Visibility="Collapsed"/>
                                            <ContentControl Grid.Column="0" Width="36" Height="36"
                                                            VerticalAlignment="Center"
                                                            Style="{DynamicResource Icon.GrassBlock}"/>

                                            <!-- .instance-copy（模板 :585-588，样式 :902-904 ＋ 尾部 :1030）：
                                                 列 2、flex 列 gap 4、padding-right 7、align-self center。
                                                 名称 strong 的字号被全局 ui-system.css:23 的
                                                 `.content .instance-copy strong` 从 scoped :903 的 13 提到 **14**
                                                 （注入顺序在 scoped 之后，同特异度后者胜），
                                                 line-height 1.4 → 19.6 取 20，两行截断 → MaxHeight 40。 -->
                                            <StackPanel Grid.Column="2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                                           LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                           MaxHeight="40" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- .instance-copy span（:904 ＋ 尾部 :1030）：11px text-dim 单行截断 -->
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="{DynamicResource Fg2}" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- A.6 .instance-last（模板 :592，样式 :904 ＋ :908 ＋ 尾部 :1030）：
                                                 列 3、第 1 行、字号 12、不换行、text-dim；
                                                 padding-right 42 来自 :908（尾部只改列与字号，没动它）；
                                                 v-if 没有游玩记录时整条不渲染 → HpInstanceLast 的空串触发器 -->
                                            <TextBlock Grid.Column="4" Style="{StaticResource HpInstanceLast}"
                                                       Text="{Binding LastPlayed}" Margin="0,0,42,0"
                                                       VerticalAlignment="Center"/>

                                            <!-- A.6 .instance-more（模板 :589，样式 :905-907 ＋ 尾部 :1030）：
                                                 列 4、20×20、radius 7，svg 15×15 -->
                                            <Button Grid.Column="6" Style="{StaticResource HpInstanceMore}"
                                                    ToolTip="更多" Tag="{Binding}" Click="RowMore_Click">
                                                <ContentControl Width="15" Height="15"
                                                                Style="{DynamicResource Icon.Ellipsis}"/>
                                            </Button>

                                            <!-- A.6 .instance-play（模板 :593-600，样式 :909-912 ＋ 尾部 :1030）：
                                                 列 5、40×34、radius 8；
                                                 :disabled＝launching（:595）→ 端口的启动中标志是 Busy
                                                 （Services/LaunchSession.cs:86）。
                                                 这一行在 DataTemplate 里，DataContext 是 VersionRow（没有 Busy），
                                                 所以要沿 VisualTree 取页面的 DataContext 才绑得到会话对象。 -->
                                            <Button Grid.Column="8" Style="{StaticResource HpInstancePlay}"
                                                    ToolTip="启动该实例" Tag="{Binding}"
                                                    IsEnabled="{Binding DataContext.Busy, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource InvBool}}"
                                                    Click="RowPlay_Click">
                                                <ContentControl Width="15" Height="15"
                                                                Style="{DynamicResource Icon.Play}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
            </StackPanel>

            <!-- 右列 .home-side（模板 :609，样式 :915 ＋ 尾部 :1030/:1033）：flex 列 / gap 16 / align-self start -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <!-- .account-panel 与 .skin-panel 拼成一张连体卡（尾部 :1030）：
                     account：radius 14 14 0 0 ＋ border-bottom 0 ＋ box-shadow none ＋ padding 16
                     skin：radius 0 0 14 14 ＋ margin-top -16 ＋ border-top 0 ＋ box-shadow none ＋ padding 16
                     两块之间**没有**分隔线（border-bottom:0 ＋ border-top:0），前一版多画了一条 1px；
                     负 16 让 account 的下内边距与 skin 的上内边距叠成一格 → 视觉间距正好是 16。
                     外框用一整圈 1px 表达两侧＋上＋下，与原版的两支各自描边等价。 -->
                <Border CornerRadius="14" Background="{DynamicResource Card}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <StackPanel>
                        <!-- .account-panel（模板 :610，样式 :917-918 ＋ 尾部 :1030/:1033）：padding 16 /
                             min-height 146（基础 :918，尾部只改了 radius/描边/阴影/padding，没动 min-height）。
                             box-sizing 是 border-box（styles.css:110），146 含上下 16 的内边距与它自己的
                             1px 上边框（border-bottom 是 0）→ 内容最小高 146 减 32 减 1 ＝ 113 -->
                        <StackPanel Margin="16" MinHeight="113">
                            <!-- .account-head（模板 :612 / :629，样式 :919 ＋ 尾部 :1030 的 gap 10） -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 有账户那一支（模板 :612-621）：Avatar :size="54" → 54×54、radius 12，
                                     外环 box-shadow 0 0 0 4px color-mix(text 8%, transparent)（:920）。
                                     盒阴影跟随元素自身的 border-radius ⇒ 是**圆角方环**不是圆环：
                                     外沿 54＋4＋4＝62、外圆角 12＋4＝16。
                                     未登录那一支（模板 :629-631）换成 .account-placeholder，头像整块不渲染 -->
                                <Grid x:Name="AccountAvatar" Grid.Column="0" Width="62" Height="62"
                                      Style="{StaticResource HpAccountAvatar}">
                                    <Border Width="62" Height="62" CornerRadius="16" BorderThickness="4"
                                            BorderBrush="{DynamicResource Fg}" Opacity="0.08"/>
                                    <Border Width="54" Height="54" CornerRadius="12"
                                            Background="{DynamicResource CardSoft}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image x:Name="AvatarImg" Width="54" Height="54"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                </Grid>
                                <!-- A.8 .account-placeholder（模板 :630，样式 :929）：54×54 /
                                     1px dashed border-strong / radius 12 / text-dim / 20px 问号 -->
                                <Grid Grid.Column="0" Style="{StaticResource HpAccountPlaceholder}">
                                    <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1"
                                               Stroke="{DynamicResource BorderStrong}"
                                               StrokeDashArray="4 2" StrokeDashCap="Flat"/>
                                    <TextBlock Text="?" FontSize="20" Foreground="{DynamicResource Fg2}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <!-- .account-copy strong（:922）：16px 单行截断；
                                         未登录那一支的文案是「未登录」（模板 :631） → FallbackValue -->
                                    <TextBlock Text="{Binding SelectedAccount.Name, FallbackValue=未登录}"
                                               FontSize="16" TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <!-- A.7 .account-copy span i（:924）：7×7 圆点 var(ok)，
                                             光环 box-shadow 0 0 0 3px var(ok-soft) → 13×13 的 OkSoft 底垫。
                                             未登录那一支（模板 :631）的 span 是 .offline-state，**没有 i**，
                                             所以光环＋小圆点整体由 HpAccountDot 的 DataTrigger
                                             跟着 SelectedAccount 收起，不需要代码切。 -->
                                        <Grid x:Name="AccountStateDot" Style="{StaticResource HpAccountDot}">
                                            <Ellipse Width="13" Height="13" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" Fill="{DynamicResource OkSoft}"/>
                                            <Ellipse Width="7" Height="7" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" Fill="{DynamicResource Ok}"/>
                                        </Grid>
                                        <TextBlock x:Name="AccountStatusText" Style="{StaticResource HpAccountStatus}"
                                                   Text="{Binding SelectedAccount.KindText, FallbackValue=请选择账户}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- .account-more（模板 :618，样式 :926-928）：30×30 / radius 8 / svg 17×17；
                                     hover（:927）字色转 text、底转 hover -->
                                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        ctl:CssRadius.Round="8" Click="AccountMenu_Click">
                                    <ContentControl Width="17" Height="17"
                                                    Style="{DynamicResource Icon.Ellipsis}"/>
                                </Button>
                            </Grid>

                            <!-- .account-provider（模板 :622-626 / :633-636，样式 :930-937）：
                                 grid 26px minmax(0,1fr) 15px / gap 10 / min-height 44 / margin-top 15 /
                                 padding 0 11 / radius 9 / 底 card-2 / 描边 1 / 12px / weight 550 / 字 text；
                                 hover（:933）描边转 border-strong；尾部 .account-provider > svg（:934）15×15 text-dim。
                                 .provider-mark（模板 :623 / :634，样式 :931-937）24×24 radius 6：
                                 微软是 22×22 的四色 svg（该分支底 transparent、radius 0），
                                 yggdrasil 渐变 #65bd78→#268e54，offline 是 card 底 ＋ text-dim 的字母，
                                 未登录那支是 ＋ 号。
                                 // 占位：端口没有按账户类型切分的分支（AccountRow.KindText 只给类型中文名），
                                 这里固定成微软正版那颗 mark 与「离线账号」文案，接线时按 type 换。 -->
                            <Button Style="{StaticResource BtnGhost}" MinHeight="44" Padding="11,0"
                                    ctl:CssRadius.Round="9" FontWeight="Medium"
                                    Margin="0,15,0,0" HorizontalContentAlignment="Stretch"
                                    Click="AddAccount_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                            Background="{DynamicResource CardSoft}">
                                        <ContentControl Width="22" Height="22"
                                                        Style="{DynamicResource Icon.Microsoft}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="离线账号" FontSize="12" FontWeight="Medium"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ContentControl Grid.Column="2" Width="15" Height="15"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Fg2}"
                                                    Style="{DynamicResource Icon.ChevronRight}"/>
                                </Grid>
                            </Button>

                            <!-- // 占位：账号切换列表。原版 .account-panel 里没有这个 ListBox
                                 （只有 v-if 的头像支与 v-else 的占位支），但 MainWindow.xaml.cs:895
                                 的转发属性要它，删掉就断线，所以保留；要按原版收掉请先改那一侧。 -->
                            <ListBox x:Name="AcctList" Style="{StaticResource CardList}"
                                     ItemContainerStyle="{StaticResource RowCard}" Margin="0,8,0,0"
                                     MaxHeight="190" ItemsSource="{Binding AccountList}"
                                     SelectedItem="{Binding SelectedAccount}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="7"
                                                    Background="{DynamicResource CardSoft}">
                                                <Image Source="{Binding Avatar}"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindText}" FontSize="11"
                                                           Foreground="{DynamicResource Fg2}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconBtn}"
                                                    Width="28" Height="28" Tag="{Binding}"
                                                    Click="RemoveAccount_Click">
                                                <ContentControl Width="14" Height="14"
                                                                Style="{DynamicResource Icon.Close2}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- .skin-panel（模板 :640，样式 :939 ＋ 尾部 :1030/:1033）：
                             padding 16 / flex none / min-height 0（尾部的 min-height:0 压过基础的 400）；
                             上边距 0 ＝ 与 account 的 16 下内边距合并（原版靠 margin-top -16） -->
                        <StackPanel Margin="16,0,16,16">
                            <!-- .skin-head（模板 :641，样式 :940-943）：padding 0 2 8 / flex align-start
                                 space-between；h3 14px/700，副标 10px text-dim，内层列 gap 3 -->
                            <Grid Margin="2,0,2,8">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="皮肤预览" FontSize="14" FontWeight="Bold"/>
                                    <!-- 原版副标是模型类型（模板 :642）：纤细模型 / 经典模型 / 动态角色 -->
                                    <TextBlock x:Name="SkinModelText" Text="纤细模型" FontSize="10"
                                               Foreground="{DynamicResource Fg2}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- .skin-refresh（模板 :643，样式 :926-928 ＋ :944）：30×30 / radius 8 /
                                     svg 17×17 / disabled opacity .4（原版 disabled＝skinLoading 或没有账户）。
                                     :945 的 .spinning（skinLoading 时给里面那个 svg 加 animation: spin .8s linear infinite）
                                     在本端口没有对应状态：ReloadSkin_Click 读的是本地 Assets/skin.png，同步返回，
                                     不存在「转圈等网络」的中间态 → 这条动画无处可挂，
                                     等皮肤改走远端拉取时再补（动效待办 §13）。 -->
                                <Button HorizontalAlignment="Right" Style="{StaticResource IconBtn}"
                                        Width="30" Height="30" ctl:CssRadius.Round="8"
                                        Click="ReloadSkin_Click">
                                    <ContentControl Width="17" Height="17"
                                                    Style="{DynamicResource Icon.Refresh}"/>
                                </Button>
                            </Grid>

                            <!-- .skin-stage（模板 :647，样式 :946 ＋ 尾部 :1030/:1033）：
                                 height 230（`.home-side .skin-stage` 的特异度压过 :1030 的 260 与基础 :946 的 300）/
                                 min-height 0 / overflow hidden / radius 12 /
                                 描边 1px color-mix(border 78%, transparent)（比 var(border) 淡一档，
                                 主题字典没有对应键，取 Line）/
                                 底＝径向(accent 13% 在 50% 82% 处、38% 处透明) 叠 竖向(transparent→bg 18%)。
                                 两层都用「实色底 ＋ 白到透明的 OpacityMask」表达：渐变的**色**必须来自主题键，
                                 GradientStop 里不能写 DynamicResource，所以形状交给蒙版、颜色交给 Background。
                                 13% 取最接近的 AccentSoft（14%）；bg 18% 取 Opacity 蒙版 0x2E。 -->
                            <Border Height="230" MinHeight="0" CornerRadius="12" BorderThickness="1"
                                    BorderBrush="{DynamicResource Line}" ClipToBounds="True">
                                <Grid>
                                    <!-- 底层：linear-gradient(180deg, transparent, bg 18%) -->
                                    <Border Background="{DynamicResource Bg}" IsHitTestVisible="False">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#00FFFFFF"/>
                                                <GradientStop Offset="1" Color="#2EFFFFFF"/>
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <!-- 上层：radial-gradient(circle at 50% 82%, accent 13%, transparent 38%) -->
                                    <Border Background="{DynamicResource AccentSoft}" IsHitTestVisible="False">
                                        <Border.OpacityMask>
                                            <RadialGradientBrush GradientOrigin="0.5,0.82" Center="0.5,0.82"
                                                                 RadiusX="0.38" RadiusY="0.38">
                                                <GradientStop Offset="0" Color="#FFFFFFFF"/>
                                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                                            </RadialGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <!-- .viewer3d（模板 :648，样式 :947）：height 100%、透明底、占满整块舞台；
                                         拖拽转向 / 滚轮缩放 / 行走动画都在 Controls/SkinDoll3D.cs 里 -->
                                    <ctl:SkinDoll3D x:Name="SkinDoll"/>

                                    <!-- A.9 .skin-overlay 三个分支（模板 :649-651）：z-index 2、贴舞台底 12。
                                         全部默认收起——原版这三条也只在 loading / 未登录 / 出错时出现。 -->
                                    <!-- v-if skinLoading（:649）：span.spin ＋「正在加载皮肤…」
                                         // 占位：LaunchSession 没有 skinLoading 数据源，等皮肤拉取接入再切 Visible -->
                                    <Button x:Name="SkinOverlayLoading" Style="{StaticResource HpSkinOverlay}"
                                            Panel.ZIndex="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                            Margin="12,0,12,12" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <!-- A.10 .spin 用共享样式（Themes/Controls.xaml:381 的 ContentControl 版）：
                                                 不在本页重定义，也不给 Border 写 Template（那是 MC4005） -->
                                            <ContentControl Style="{DynamicResource Spin}"/>
                                            <TextBlock Text="正在加载皮肤…" Margin="9,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- v-else-if !store.selectedAccount（:650）：.skin-overlay.action -->
                                    <Button x:Name="SkinOverlayAction" Style="{StaticResource HpSkinOverlay}"
                                            Panel.ZIndex="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                            Margin="12,0,12,12" Visibility="Collapsed"
                                            Content="登录后加载角色皮肤"/>
                                    <!-- v-else-if skinError（:651）：.skin-overlay.action.error，
                                         title 是原始错误文本 -->
                                    <Button x:Name="SkinOverlayError" Style="{StaticResource HpSkinOverlayError}"
                                            Panel.ZIndex="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                            Margin="12,0,12,12" Visibility="Collapsed"
                                            Content="皮肤加载失败，点击重试"/>
                                </Grid>
                            </Border>

                            <!-- .skin-tip（模板 :653，样式 :953-955 ＋ 尾部 :1033）：flex center gap 5 /
                                 width 100% / margin-top 8、margin-bottom 0 / 无边框透明底 /
                                 10px / weight 500 / text-dim；hover 字色转 accent-2；svg 12×12。
                                 原版的 click 是切到 skins（没有账户时切 accounts），
                                 需要外壳的导航入口 → Click 由主控接线。 -->
                            <Button HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                    Margin="0,8,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cp" Property="TextElement.Foreground"
                                                        Value="{DynamicResource AccentHi}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="拖动可旋转 · 行走动画" FontSize="10" FontWeight="Medium"
                                               Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                                    <ContentControl Width="12" Height="12" Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Fg2}"
                                                    Style="{DynamicResource Icon.ChevronRight}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ CreatorCard（components/CreatorCard.vue:11-33）============
                     原版这张卡是「参与测试及创作者」，鼠标进入才展开名字气泡。
                     本项目实际只有作者一个人（原版那串名字是官方 1.1.10 的测试名单，与本作无关），
                     所以标题与名单都改成单人；文案由作者本人指定要重写。其余度量照原版。
                     .creator-card：padding card-pad 20 / border 1 border / radius radius-lg 14 /
                     底 surface-content（＝Card）/ overflow hidden（:18）；
                     尾部 :1030 的 .home-creator：margin-top 0、box-shadow none、
                     描边色 color-mix(accent 26%, border)（主题字典没有该混合键，取 Line）。
                     整张卡可点：原版只有右上角 ↗ 是链接，作者要求点卡片任意处都开他的 B 站空间。 -->
                <Border x:Name="CreatorCard" Margin="0,16,0,0" Padding="20" CornerRadius="14"
                        Background="{DynamicResource Card}" Cursor="Hand" ClipToBounds="True"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        MouseLeftButtonUp="CreatorCard_Click">
                    <StackPanel>
                        <!-- .creator-heading：flex / center / space-between / gap 12（:19） -->
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <!-- .creator-toggle：14px / 600 / 字色 text（:20） -->
                                <TextBlock Text="创作者" FontSize="14" FontWeight="SemiBold"/>
                                <!-- small：display block / 11px / letter-spacing 1px / text-dim / margin-top 4（:21）。
                                     没重置字重，跟着 .creator-toggle 继承 600；
                                     WPF 的 TextBlock 没有 letter-spacing，字距差记进 UI_SPEC -->
                                <TextBlock Text="CREATOR" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,4,0,0" Foreground="{DynamicResource Fg2}"/>
                            </StackPanel>
                            <!-- 站内链 a.icon-btn：32×32 ＋ radius 6，内容是字符 ↗（:12） -->
                            <Button x:Name="CreatorLink" Style="{StaticResource IconBtn}" Width="32" Height="32"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    FontSize="16" Content="&#x2197;" Click="CreatorLink_Click"
                                    ToolTip="https://space.bilibili.com/526277131"/>
                        </Grid>
                        <!-- .creator-intro：12px / line-height 1.7 / text-dim / margin 12 0 0（:22），
                             原文是官方那串「好想做卡慕的狗啊…」，作者要求换成关于自己的文案 -->
                        <TextBlock FontSize="12" LineHeight="20.4" LineStackingStrategy="BlockLineHeight"
                                   Margin="0,12,0,0" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                                   Text="一个人把启动器从浏览器壳里搬出来，不为别的：它躺着不动也要占我几百兆。这里没有第二个作者，也没有客服；卡住了就提 issue，我看到就回。"/>
                        <!-- .creator-reveal：grid-template-rows 0fr→1fr ＋ opacity 0→1，240ms / 200ms（:29-30），
                             由 pointerenter / pointerleave / focusin / focusout 开合（:11）。
                             WPF 没有 0fr→1fr，用 MaxHeight 0→240 的动画等价表达（SetCreatorOpen）。 -->
                        <Border x:Name="CreatorReveal" MaxHeight="0" Opacity="0">
                            <!-- .creator-name-layer：wrap / gap 8 / padding 16 8 12 / max-height 240 / overflow auto（:23 ＋ :32） -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,16,8,12">
                                <WrapPanel x:Name="CreatorNames"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <!-- ====================================================================
             B. 浮层与模态：原版全是 Teleport 到 body 的 fixed 节点，所以与滚动主体平级。
             层级照抄原版的 z-index：.menu-overlay 8000（:957）/ .float-menu 8001（:958）/
             .modal-mask 10000（styles.css:530）/ 重启确认那层是模板 :759 内联的 10030。
             全部默认 Collapsed：原版的 v-if 在静止态本来就不渲染，位置（Canvas.Left/Top）与
             内容由代码接线。
             ==================================================================== -->

        <!-- B.11 .menu-overlay（模板 :662，样式 :957）：fixed inset 0 / z 8000，
             透明的「点外面关掉」捕获层，没有任何绘制内容 -->
        <Border x:Name="VersionMenuOverlay" Panel.ZIndex="8000" Background="Transparent"
                Visibility="Collapsed" MouseLeftButtonUp="MenuOverlay_Click"/>

        <!-- B.11 版本浮起菜单（模板 :663-688）：宽度是脚本 :385 的 versionMenu.width ＝ 230，
             top/left 由 :402-409 量触发按钮后写内联 → 挂 Canvas，代码改 Canvas.Left/Top -->
        <Canvas x:Name="VersionMenuHost" Panel.ZIndex="8001" Visibility="Collapsed">
            <Border x:Name="VersionMenu" Canvas.Left="0" Canvas.Top="0" Width="230"
                    Style="{StaticResource HpFloatMenu}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- :668 的开关行：文案随 folderListOpen 切（‹ 返回版本选择 / 文件夹列表 ›），
                             静止态是收起 →「文件夹列表 ›」 -->
                        <Button x:Name="VersionMenuToggleFolders" Style="{StaticResource HpMenuItem}"
                                Content="文件夹列表 ›" Click="VersionMenuFolders_Click"/>
                        <!-- v-if folderListOpen（:669-672） -->
                        <StackPanel x:Name="VersionMenuFolderBranch" Visibility="Collapsed">
                            <!-- // 占位：v-for folder in store.settings.folders（:670）。
                                 端口的 Settings（Wuhuicl.Core/Stores/Stores.cs:209-228）没有 folders 与
                                 activeFolder 字段，绑不出来；由代码按 HpMenuItem / HpMenuItemActive 造行
                                 （当前目录那行 .active＝底 accent-soft ＋ 字 accent-2），
                                 title 是目录路径，contextmenu 走原版的文件夹菜单。 -->
                            <StackPanel x:Name="VersionMenuFolderList"/>
                            <Button x:Name="VersionMenuAddFolder" Style="{StaticResource HpMenuItem}"
                                    Content="添加 / 管理文件夹"/>
                        </StackPanel>
                        <!-- v-else（:673-687）：收藏优先排序后的已安装实例（脚本 :383 sortedInstalled） -->
                        <StackPanel x:Name="VersionMenuVersionBranch">
                            <!-- // 占位：原版按 sortWithFavorite 排（脚本 :383），端口没有收藏数据源，
                                 所以这里直接绑 InstalledList 的原顺序 -->
                            <ItemsControl x:Name="VersionMenuVersionList" ItemsSource="{Binding InstalledList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- .menu-item（:674-685）：星标或占位条 ＋ versionLabel -->
                                        <Button Style="{StaticResource HpMenuItem}" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- v-if isFavorite（:682）：svg 12×12，fill currentColor。
                                                     // 占位：端口没有收藏数据 → 收起，接入后与下面的 spacer 互换 -->
                                                <ContentControl Width="12" Height="12" VerticalAlignment="Center"
                                                                Visibility="Collapsed"
                                                                Style="{DynamicResource Icon.Star}"/>
                                                <!-- v-else .menu-spacer（:683，样式 :965）：宽 12、flex none，
                                                     没有内容所以高度 0 -->
                                                <Border Width="12" Background="Transparent"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- .menu-empty（:686，样式 :966）：padding 20px 8px / 12px / 居中 / text-dim，
                                 只在没有已安装实例时渲染 -->
                            <TextBlock x:Name="VersionMenuEmpty" Text="暂无已安装实例"
                                       Padding="8,20" FontSize="12" Foreground="{DynamicResource Fg2}"
                                       TextAlignment="Center"
                                       Visibility="{Binding InstalledList.Count, Converter={StaticResource CountVis}, ConverterParameter=empty}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Canvas>

        <!-- B.12 .menu-overlay（模板 :692，样式 :957）：卡片菜单的关闭捕获层，同为 z 8000 -->
        <Border x:Name="CardMenuOverlay" Panel.ZIndex="8000" Background="Transparent"
                Visibility="Collapsed" MouseLeftButtonUp="MenuOverlay_Click"/>

        <!-- B.12 卡片浮起菜单（模板 :693-707）：.float-menu.card-float-menu（样式 :959-960）
             宽 232 / max-height 340 / 底 var(card-solid)，尾部兜底 #192225；
             card-solid 在主题字典里没有键，与 VpFloatMenu 同样取 Card——它本身 100% 不透明，
             所以 :958 的 blur(24) 在这块上是死代码（docs/UI_LAYERS.md A.1 表 #13）。
             位置由脚本 :421-426 量卡片后写内联。七项文案逐字取自 :698-706。 -->
        <Canvas x:Name="CardMenuHost" Panel.ZIndex="8001" Visibility="Collapsed">
            <Border x:Name="CardMenu" Canvas.Left="0" Canvas.Top="0" Width="232" MaxHeight="340"
                    Style="{StaticResource HpFloatMenu}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="CardMenuManage" Style="{StaticResource HpCardMenuItem}" Content="管理实例"/>
                        <Button x:Name="CardMenuLaunch" Style="{StaticResource HpCardMenuItem}" Content="启动实例"/>
                        <!-- :700 :disabled＝running || launching || restartBusy。
                             端口只有 GameRunning 与 Busy（Services/LaunchSession.cs:86-90），restartBusy 无数据源，
                             所以这里只表达「游戏在跑就禁用」，启动中的拦截由接线时补 Busy -->
                        <Button x:Name="CardMenuLaunchCommand" Style="{StaticResource HpCardMenuItem}"
                                IsEnabled="{Binding GameRunning, Converter={StaticResource InvBool}}"
                                ToolTip="新建允许命令的创造模式测试世界并自动进入（Minecraft 1.20+）"
                                Content="启动并创建命令世界"/>
                        <!-- :701 :disabled＝!running || restartBusy → 静止态（没有游戏在跑）本来就是禁用的 -->
                        <Button x:Name="CardMenuQuickRestart" Style="{StaticResource HpCardMenuItem}"
                                IsEnabled="{Binding GameRunning}" Content="快速重启游戏"/>
                        <!-- :702-704 文案在「收藏实例 / 取消收藏」之间切，端口没有收藏数据 → 取未收藏那支 -->
                        <Button x:Name="CardMenuFavorite" Style="{StaticResource HpCardMenuItem}" Content="收藏实例"/>
                        <Button x:Name="CardMenuOpenFolder" Style="{StaticResource HpCardMenuItem}" Content="打开文件夹"/>
                        <!-- :706 .menu-item.danger -->
                        <Button x:Name="CardMenuDelete" Style="{StaticResource HpCardMenuItemDanger}"
                                Content="删除实例"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Canvas>

        <!-- B.13 Java 选择器模态（模板 :740-756，样式 :772-781）：
             .modal-mask（z 10000 / flex 居中 / 底 mask / blur 10）
             ＋ .modal.java-picker（HomeView.vue:772 width min(580px, 100vw 减 40px) ＋ :773 的 actions 间距），
             .modal 本体的 radius 14 / padding 24 / 描边 1 / 阴影 lg 交给 HpModal。
             点遮罩关闭的条件是 !javaSaving（:740），端口没有 javaSaving → 由接线判断 -->
        <Border x:Name="JavaPickerMask" Panel.ZIndex="10000" Style="{StaticResource HpModalMask}"
                Visibility="Collapsed">
            <Border Style="{StaticResource HpModal}" Width="580" MaxWidth="580"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <!-- .modal-title（:742）：见 HpModalTitle 注释——渲染的是裸 h3 -->
                        <TextBlock x:Name="JavaPickerTitle" Style="{StaticResource HpModalTitle}"
                                   Text="选择 Java 运行环境"/>
                        <!-- .java-picker-description（:743）：`name · 仅修改此实例，不影响其他实例`，
                             name 就是当前实例的标签（脚本 :296）→ 绑 SelectedInstalled.Label -->
                        <TextBlock x:Name="JavaPickerDescription" Style="{StaticResource HpJavaDescription}"
                                   Text="{Binding SelectedInstalled.Label, StringFormat={}{0} · 仅修改此实例，不影响其他实例}"/>
                        <!-- 第 1 个 .java-option（:744）：value="@auto" -->
                        <RadioButton x:Name="JavaOptionAuto" Style="{StaticResource HpJavaOption}"
                                     GroupName="home-java">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HpJavaOptionStrong}" Text="自动选择"/>
                                <TextBlock Style="{StaticResource HpJavaOptionSmall}"
                                           Text="按游戏的真实版本要求匹配 Java，必要时自动下载"/>
                            </StackPanel>
                        </RadioButton>
                        <!-- 第 2 个 .java-option（:745）：value="@inherit"，small 是全局 Java 的实时文案。
                             端口只有全局 AutoJava / JavaPath（Settings 里没有实例级 Java 字段），
                             原版那句是 `javaAuto ? 当前全局：自动选择 : 当前全局：＋javaPath 或 匹配本地 Java`。
                             // 占位：等实例级 Java 接入——这里写死 javaAuto 为真那一支的文案，
                             由代码按 Settings.Value.AutoJava / JavaPath 改写 -->
                        <RadioButton x:Name="JavaOptionInherit" Style="{StaticResource HpJavaOption}"
                                     GroupName="home-java">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HpJavaOptionStrong}" Text="跟随全局设置"/>
                                <TextBlock x:Name="JavaOptionInheritHint" Style="{StaticResource HpJavaOptionSmall}"
                                           Text="当前全局：自动选择"/>
                            </StackPanel>
                        </RadioButton>
                        <!-- .java-list（:746-750，样式 :775）：max-height 32vh / 自身滚动 / margin-top 10。
                             32vh 没有视口单位可写，按 .modal 的可用高度收到 170，超出交给内层 ScrollViewer -->
                        <ScrollViewer MaxHeight="170" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- v-for java in javas（:747）：每行一个 .java-option，
                                     strong 是「Java 版本 · 架构」，small 是路径，radio 的 value 是路径。
                                     // 占位：LaunchSession 没有本地 Java 清单属性（JavaLocator.Scan 只在
                                     PlayAsync 内部调用，Services/LaunchSession.cs:384），不编造行；
                                     由代码按 HpJavaOption 往这个容器里加。 -->
                                <StackPanel x:Name="JavaOptionHost"/>
                                <!-- :748 的两段空态文案都来自原版，按 javaChecked 切换；无数据源 → 全收起 -->
                                <TextBlock x:Name="JavaPickerScanning" Style="{StaticResource HpJavaDescription}"
                                           Margin="0" Visibility="Collapsed" Text="正在扫描本地 Java…"/>
                                <TextBlock x:Name="JavaPickerNone" Style="{StaticResource HpJavaDescription}"
                                           Margin="0" Visibility="Collapsed"
                                           Text="未发现本地 Java，可使用自动选择，或在设置中添加 Java。"/>
                                <!-- :749 「当前指定：路径」：只有手填过且不在扫描结果里才出现 -->
                                <TextBlock x:Name="JavaPickerCurrent" Style="{StaticResource HpJavaDescription}"
                                           Margin="0" Visibility="Collapsed" Text="当前指定："/>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- .java-picker .modal-actions（:751-754，样式 :773）：gap 10 / margin-top 22。
                             按钮：.btn.btn-ghost 管理 Java（点了关掉弹窗再跳设置的 Java 段）/
                             .btn.btn-ghost 取消 / .btn.btn-gold 保存选择（javaSaving 时文案转「保存中…」） -->
                        <StackPanel Style="{StaticResource HpJavaActions}">
                            <Button x:Name="JavaManage" Style="{StaticResource BtnGhost}" Content="管理 Java"/>
                            <Button x:Name="JavaCancel" Style="{StaticResource BtnGhost}" Content="取消"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="JavaSave" Style="{StaticResource BtnGold}" Content="保存选择"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- B.14 强制重启确认（模板 :759-761）：.modal-mask 的内联 z-index 是 10030，压过 Java 选择器那层。
             .modal 走通用宽 min(460px, 100vw 减 48px) → 遮罩 padding 覆盖成 24,16 -->
        <Border x:Name="RestartMask" Panel.ZIndex="10030" Style="{StaticResource HpModalMask}"
                Padding="24,16" Visibility="Collapsed">
            <Border Style="{StaticResource HpModal}"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <!-- h3 无类名 → UA 的 1.17em 粗体，margin 0（全局复位） -->
                        <TextBlock Style="{StaticResource HpModalTitle}" Text="正常退出等待超时"/>
                        <!-- :760 正文：p 无外边距，字号继承 body 的 var(text-md) 14 -->
                        <TextBlock FontSize="14" TextWrapping="Wrap"
                                   Text="Minecraft 可能仍在保存世界。建议在游戏内保存退出，然后重试。"/>
                        <!-- :761 内联 style color: var(danger) -->
                        <TextBlock FontSize="14" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                   Text="强制结束可能丢失进度或损坏存档；只有你确认后才会执行。"/>
                        <!-- :761 内联 style display flex / gap 12 / justify flex-end；
                             两颗按钮的 :disabled＝restartBusy（脚本 :227），端口没有这个标志 → 保持可用 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button x:Name="RestartCancel" Style="{StaticResource BtnGhost}"
                                    Content="取消重启，继续等待"/>
                            <Button x:Name="RestartForce" Style="{StaticResource HpBtnDanger}"
                                    Margin="12,0,0,0" Content="确认强制结束并重启"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- B.15 ConfirmModal（components/ConfirmModal.vue:18-32，HomeView.vue:730-737 的调用参数）：
             .modal-mask（z 10000）＋ .modal ＋ .modal-title ＋ .confirm-text ＋ .modal-actions
             （全局基线：flex / align center / justify flex-end / gap 12 / margin-top 24，
             ui-system.css:40 还加了 flex-wrap:wrap） -->
        <Border x:Name="ConfirmDeleteMask" Panel.ZIndex="10000" Style="{StaticResource HpModalMask}"
                Padding="24,16" Visibility="Collapsed">
            <Border Style="{StaticResource HpModal}"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <!-- title＝:732 的「删除版本」 -->
                        <TextBlock Style="{StaticResource HpModalTitle}" Text="删除版本"/>
                        <!-- message＝:733 的模板串，中间的 id 是删除目标（removeModal.target?.id）。
                             端口没有「当前要删的实例」这个数据源（cardMenu.id 在代码侧），
                             // 占位：id 槽留空，由代码填进 ConfirmDeleteText -->
                        <TextBlock x:Name="ConfirmDeleteText" Style="{StaticResource HpConfirmText}"
                                   Text="确定要删除版本「」吗？该版本目录将移入系统回收站（共享依赖与资源保留）。"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <!-- ConfirmModal.vue:24 取消（busy 时禁用） -->
                            <Button x:Name="ConfirmDeleteCancel" Style="{StaticResource BtnGhost}" Content="取消"/>
                            <!-- ConfirmModal.vue:25-27 确认（busy 时文案「处理中…」，默认 confirmText 是确认删除） -->
                            <Button x:Name="ConfirmDeleteOk" Style="{StaticResource HpBtnDanger}"
                                    Margin="12,0,0,0" Content="确认删除"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
