<UserControl x:Class="Wuhuicl.App.Pages.FriendsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Wuhuicl.App.Controls">

    <!-- 联机页，复刻 KAMUCL-1.1.5/src/renderer/src/views/FriendConnectView.vue。
         这是「工具路由器」而不是页签页：页内状态 type ConnectPage = 'choose' | 'frp' | 'voxlink' | 'terracotta'
         （:11-12），点卡片进入方式页（pick() :43-45），方式页的「← 更换方式」再回 choose（:94）。
         与 Pages/ServersPage.xaml（ServersView.vue）是互不相干的两个 view：App.vue 里 friends 是主导航项、
         servers 是「资源管理」子项，所以本页没有任何页签带（.connect-tabs 只有 VoxLinkPanel.vue:402 自己在用）。

         层级：div.page.friend-connect-page（:49，max-width 1120 → 最终 1200 + container-type inline-size，:111 与 :161）
               > div.connect-page（:50，max-width 1120 / flex column gap sec-gap 28，connection.css:3）
               > div.connect-stage（:52，源码里没有任何样式，是普通 block，因此 sec-gap 28 落在它身上不生效，
                 块间距实际由 :161 的最终值提供：pick-head padding 0、卡片 gap 16、method-header margin-bottom 16）。
         WPF 表达：外层 ScrollViewer（页面自滚，同 ModsPage/KeysPage 的写法）
                   > Grid PageRoot MaxWidth 1200（friend-connect-page）
                   > StackPanel MaxWidth 1120（connect-page）
                   > ChooseView / MethodView 两个兄弟容器互斥显隐（对应 :54 与 :84 的 v-if/v-else）。

         container query：@container(min-width:960px) 量的是 friend-connect-page 自身的 inline-size（:161），
         所以断点用 PageRoot.ActualWidth 判定（同 ServersPage.xaml.cs 的 ApplyMetrics() 思路）；
         宽档 .pick-list 三列、窄档一列，由本页代码切 UniformGrid.Columns。

         过渡：原版两种模式之间是 Transition name="subpage" :duration="200"（:51）的右滑渐入，
         本轮按契约 §6.8 不做动画，只留 ChooseView / MethodView 两个命名容器接后续 Storyboard。

         数据：契约 §5 的 LaunchSession 白名单里没有任何联机方式、隧道、房间码字段，
         所以整页不写一条 Binding，三张卡片的文案逐字照抄 FriendConnectView.vue:15-40 的 methodCards，
         方式页正文按任务口径只铺小节标题占位（每块注释 // 占位：等联机功能接入）。

         注：下面 XML 注释里的 CSS 令牌一律去掉前导双横线书写（写 accent-soft 而不写 var 形式），
         XML 注释内不允许出现连续两个减号，否则 XAML 编译直接崩。 -->

    <UserControl.Resources>

        <!-- ============ .connect-page .btn：min-height ctl-h 36 / min-width row-h 42 / gap space-2 8 /
                     padding space-2 space-4 = 8 16（connection.css:11），字号 12px 被 :114 压成 13px ============ -->
        <Style x:Key="FriendBtnGhost" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="42"/>
        </Style>

        <!-- ============ .pick-card：width 100% / padding 20（:161 覆盖 :128 的 card-pad 20，同值）/
                     radius radius-lg 14 / border 1px border-strong / 底 surface-content（§2 体系里就是 Panel 的 Card 底）/
                     align-items flex-start（:126-131）；:161 明确 animation none + box-shadow none + hover 也无阴影，
                     所以卡片是平面的（契约 §6.4）。宽档 container 下 flex-direction column / gap 14px（:161）。
                     hover 只换描边为 color-mix(accent 55%, border-strong)（:142），WPF 没有 color-mix，退化成 accent 实色。 ============ -->
        <Style x:Key="PickCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <!-- :focus-visible 的 2px accent-2 描边 + outline-offset 3（:144）WPF 无 outline，留给键盘焦点样式统一处理 -->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .pick-icon：42×42 / margin-top 2 / radius radius-md 10 / accent-soft 底 / 图标色 accent /
                 内层 svg 22×22（:147-152）。:149 与 :159 的 .pick-icon/.pick-go hover 用的是
                 cubic-bezier(0.22,0.9,0.32,1.2) 这类回弹（overshoot）缓动，本轮不做动画（契约 §6.8），
                 但 :161 已把 hover 的 scale 压回 none，所以宽档本来就没有位移。 -->
        <Style x:Key="PickIconBadge" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- .pick-name em 徽标：font-style normal / 12px / weight 500 / padding 2px space-2 8 /
                 radius 999 / border 1px border-strong / 文字 text-dim（:155）。宽档 justify-self start（:161）。
                 注意它没有背景（不是 .tag 的 ChipBg），所以这里只描边不填底。 -->
        <Style x:Key="PickEmBadge" TargetType="Border">
            <Setter Property="ctl:CssRadius.Pill" Value="True"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ .connection-panel：radius radius-lg 14 / border 1 border / 底 surface-content（ui-system.css:27），
                     box-shadow 被 ui-system.css:78 关掉（connection.css:15 的 shadow 失效） ============ -->
        <Style x:Key="FriendPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <!-- .connection-panel-head：padding 12 20 / 下边线 1px（connection.css:16 + :114）；h2 16px/700（:114 覆盖 :17 的 13px） -->
        <Style x:Key="FriendPanelHead" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="20,12"/>
        </Style>

        <!-- 占位小节标题行：.connection-field 字号 14（connection.css:52 → ui-system.css:34 压成 text-md 14） -->
        <Style x:Key="FriendSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Lbl14}"/>
    </UserControl.Resources>

    <!-- .content：overflow-y auto + scrollbar-gutter stable（App.vue:2398-2404），padding 24 由宿主 Grid.Margin 给。
         滚动条槽用 Visible 对应 stable（契约 §6.5），槽宽 8 已由全局 ScrollBar 样式定好。 -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">

        <!-- .friend-connect-page：max-width 1120（:111）→ 最终 1200 + container-type inline-size（:161），margin 0 auto -->
        <Grid x:Name="PageRoot" MaxWidth="1200" HorizontalAlignment="Center" VerticalAlignment="Top" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- .connect-page：max-width 1120（connection.css:3），margin 0 auto -->
            <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

                <!-- ============================================================
                     choose 落地页（FriendConnectView.vue:54-81 的 v-if 分支）
                     ============================================================ -->
                <StackPanel x:Name="ChooseView">

                    <!-- .connection-header.pick-head：flex space-between align-center gap space-5 24 /
                             padding space-1 0（connection.css:6）→ :161 压成 padding 0，且模板 :55-61 里没有任何 action 按钮 -->
                    <StackPanel>
                        <!-- h1：基线 text-2xl 26px/700 + letter-spacing -.5px + margin space-1 0 space-2（connection.css:7）
                             → .content .connection-header h1 与 .pick-head h1 都取 text-title 24px
                             （ui-system.css:33 + FriendConnectView.vue:161）。WPF 的 TextBlock 没有 letter-spacing，
                             这 0.5px 的收紧表达不了，留给字体渲染。 -->
                        <TextBlock Style="{StaticResource H1}" Margin="0,4,0,8" LineHeight="32"
                                   Text="选择联机方式"/>
                        <!-- p：12px text-dim 行高 1.7（connection.css:8 + FriendConnectView.vue:124） -->
                        <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Fg2}"
                                   Text="选择适合自己的方式，按指引与好友一起游玩。"/>
                    </StackPanel>

                    <!-- .pick-list：基线是 flex column gap sec-gap 28（:125）→ 最终 grid minmax(0,1fr) / gap 16（:161），
                             @container(min-width:960px) 才变 repeat(3,minmax(0,1fr))（:161）。
                             这里用 UniformGrid，列数由 ApplyMetrics() 按 PageRoot 宽切 3 或 1。
                             gap 16 用卡片 Margin 表达：横向取「每格左右各 8」，所以相邻卡间距正好 16，
                             整行外侧各留 8（CSS 的 grid 没有这 8），单格因此比 repeat(3) 的 362.67px 少约 5px，是工程近似。
                             role=list / aria-label 联机方式列表（:63）WPF 无对应属性，留注释不映射。 -->
                    <UniformGrid x:Name="PickList" Columns="3">

                        <!-- ============ 卡片 1：FRP 内网穿透（methodCards :16-23） ============ -->
                        <Button Style="{StaticResource PickCard}" Tag="frp" Margin="8,0,8,16"
                                Click="Pick_Click">
                            <!-- 宽档 flex-direction column / gap 14px（:161）；窄档的横排 gap 24（:127）不另开分支，见页首注释 -->
                            <StackPanel>
                                <!-- .pick-icon 42×42，内层 svg 22×22（:147-152），margin-top 2（:147）。
                                     原图标是手写的信号柱 svg（:22，台账 UI_ICONS.md C26），§3 的 43 个图标里没有对应项，
                                     几何已按源补成 Icon.Bars，色给 accent（:147 的 color accent）。 -->
                                <Border Style="{StaticResource PickIconBadge}" Margin="0,2,0,0">
                                    <ContentControl Width="22" Height="22" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Accent}"
                                                    Style="{DynamicResource Icon.Bars}"/>
                                </Border>
                                <!-- .pick-copy：column gap space-2 8（:153）→ 宽档 gap 12px（:161） -->
                                <StackPanel Margin="0,14,0,0">
                                    <!-- .pick-name：display inline-flex gap 8（:154）→ 宽档 display grid / gap 8，
                                             字号 18px/700（:161 覆盖 :154 的 text-lg 16px），所以 em 徽标另起一行 -->
                                    <StackPanel>
                                        <TextBlock x:Name="PickName1" FontSize="18" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" Text="FRP 内网穿透"/>
                                        <Border Style="{StaticResource PickEmBadge}" Margin="0,8,0,0">
                                            <TextBlock FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource Fg2}" Text="公网隧道"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- .pick-desc：12px/1.8（:156）→ 最终 14px 行高 1.65（:161，ui-system.css:34 也压成 text-md）
                                             // 占位：等联机功能接入（文案照 FriendConnectView.vue:21） -->
                                    <TextBlock x:Name="PickDesc1" Margin="0,12,0,0" FontSize="14" LineHeight="23"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                               Text="注册樱花穿透（natfrp.com）并创建隧道，用官方 frpc 把本地世界映射到公网。填写访问密钥后选择或创建隧道；可用性取决于节点、账号权限和网络。"/>
                                    <!-- .pick-scene：12px accent-2 行高 1.7（:157）// 占位：等联机功能接入 -->
                                    <TextBlock Margin="0,12,0,0" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentHi}"
                                               Text="适合愿意配置隧道的玩家"/>
                                </StackPanel>
                                <!-- .pick-go：文字字形 →（:78），16px（:159 的 text-lg）、text-dim、opacity .4、
                                         translateX(-4px)，hover 才显形并滑入（:159，回弹缓动本轮不做）；
                                         宽档 align-self flex-end → 靠右（:161） -->
                                <TextBlock Margin="0,14,0,0" Text="→" FontSize="16" Opacity="0.4"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Fg2}"/>
                            </StackPanel>
                        </Button>

                        <!-- ============ 卡片 2：VoxLink 联机（methodCards :24-31） ============ -->
                        <Button Style="{StaticResource PickCard}" Tag="voxlink" Margin="8,0,8,16"
                                Click="Pick_Click">
                            <StackPanel>
                                <!-- 原图标是手柄 svg（:30，台账 C27：rect 2.5,7,19×10 rx5 + 两个点），
                                     补成 Icon.Gamepad（与导航项 Icon.Game 不是同一个形状，别混用） -->
                                <Border Style="{StaticResource PickIconBadge}" Margin="0,2,0,0">
                                    <ContentControl Width="22" Height="22" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Accent}"
                                                    Style="{DynamicResource Icon.Gamepad}"/>
                                </Border>
                                <StackPanel Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="PickName2" FontSize="18" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" Text="VoxLink 联机"/>
                                        <Border Style="{StaticResource PickEmBadge}" Margin="0,8,0,0">
                                            <TextBlock FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource Fg2}"
                                                       Text="6 位房间码 · 免公网 IP"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- // 占位：等联机功能接入（文案照 FriendConnectView.vue:29） -->
                                    <TextBlock x:Name="PickDesc2" Margin="0,12,0,0" FontSize="14" LineHeight="23"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                               Text="创建房间，把 6 位房间码发给好友即可开始连接。直连尝试 20 秒后，可由玩家主动选择 TURN 中继；连接成功后，按页面指引在游戏内输入地址。"/>
                                    <!-- // 占位：等联机功能接入 -->
                                    <TextBlock Margin="0,12,0,0" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentHi}"
                                               Text="适合所有普通玩家的连接方式"/>
                                </StackPanel>
                                <TextBlock Margin="0,14,0,0" Text="→" FontSize="16" Opacity="0.4"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Fg2}"/>
                            </StackPanel>
                        </Button>

                        <!-- ============ 卡片 3：陶瓦联机（methodCards :32-39） ============ -->
                        <Button Style="{StaticResource PickCard}" Tag="terracotta" Margin="8,0,8,16"
                                Click="Pick_Click">
                            <StackPanel>
                                <!-- 原图标是立方体 svg（:38，台账 C28：M12 3 4 7v10l8 4 8-4V7l-8-4Z），
                                     补成 Icon.Cube；
                                     该图标自带方块配色，不吃 Foreground，所以不再设 accent 色 -->
                                <Border Style="{StaticResource PickIconBadge}" Margin="0,2,0,0">
                                    <ContentControl Width="22" Height="22" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource Icon.Cube}"/>
                                </Border>
                                <StackPanel Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="PickName3" FontSize="18" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" Text="陶瓦联机"/>
                                        <Border Style="{StaticResource PickEmBadge}" Margin="0,8,0,0">
                                            <TextBlock FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource Fg2}"
                                                       Text="独立开源 · 开箱即用"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- // 占位：等联机功能接入（文案照 FriendConnectView.vue:37） -->
                                    <TextBlock x:Name="PickDesc3" Margin="0,12,0,0" FontSize="14" LineHeight="23"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                               Text="独立开源联机项目（GitHub burningtnt/Terracotta，基于 EasyTier，AGPL-3.0）：手动下载官方工具并校验，创建/加入房间开箱即用，连接效果取决于双方网络。"/>
                                    <!-- // 占位：等联机功能接入 -->
                                    <TextBlock Margin="0,12,0,0" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentHi}"
                                               Text="适合使用官方工具和房间码联机的玩家"/>
                                </StackPanel>
                                <TextBlock Margin="0,14,0,0" Text="→" FontSize="16" Opacity="0.4"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Fg2}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- ============================================================
                     方式页（FriendConnectView.vue:84-101 的 v-else 分支）
                     ============================================================ -->
                <StackPanel x:Name="MethodView" Visibility="Collapsed">

                    <!-- .connection-header.method-header：flex space-between / gap space-5 24 / padding space-1 0（connection.css:6）
                         → :112 改 flex-wrap nowrap、:161 加 margin-bottom 16。
                         .header-side 是 flex gap space-2 8 / flex none / margin-left auto / white-space nowrap（:114）；
                         @max-560 才换行（:115-119），这里按宽档的单行铺开。 -->
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- .header-copy：flex 1 / min-width 0 / overflow-wrap anywhere（:113） -->
                        <StackPanel Grid.Column="0">
                            <!-- h1 = currentCard.name，兜底文案「联机」（模板 :90）；字号同 ui-system.css:33 的 24px，
                                 margin 被 :161 的 .method-header h1 压成 0 0 6 -->
                            <TextBlock x:Name="MethodTitle" Style="{StaticResource H1}" Margin="0,0,0,6"
                                       LineHeight="32" TextTrimming="CharacterEllipsis" Text="联机"/>
                            <!-- p = 该卡片的 desc（模板 :91）；:161 把 .method-header p 压成 13px / 行高 1.6 / max-width 800 -->
                            <TextBlock x:Name="MethodDesc" FontSize="13" LineHeight="21" MaxWidth="800"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Fg2}" Text=""/>
                        </StackPanel>
                        <!-- .header-side 里只有一个 ghost 按钮，文案「← 更换方式」（:94），左箭头是文字字形（契约 §3） -->
                        <Button x:Name="BtnBack" Grid.Column="2" Style="{StaticResource FriendBtnGhost}"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Click="Back_Click" Content="← 更换方式"/>
                    </Grid>

                    <!-- ============ 面板占位（模板 :98-100 挂的三个异步组件） ============
                         // 占位：面板正文未接入（FrpPanel.vue / VoxLinkPanel.vue / TerracottaPanel.vue）
                         本轮只铺各面板真实的小节标题，把三层结构显影出来，正文各自另开工。 -->

                    <!-- FRP：FrpPanel.vue -->
                    <Border x:Name="MethodFrp" Style="{StaticResource FriendPanel}" Visibility="Collapsed">
                        <StackPanel>
                            <!-- .connection-panel-head：h2 我的隧道 + p 每条隧道独立连接，随时启停（FrpPanel.vue:117） -->
                            <Border Style="{StaticResource FriendPanelHead}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="我的隧道"/>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                               TextWrapping="Wrap" Text="每条隧道独立连接，随时启停。"/>
                                </StackPanel>
                            </Border>
                            <!-- .connection-panel-body：padding 20 / gap card-gap 16（connection.css:20 + :114）
                                 已接 natfrp（樱花穿透）真实后端：填 token → 读隧道列表 → 启停 frpc -->
                            <StackPanel Margin="20">
                                <TextBlock Style="{StaticResource FriendSectionTitle}"
                                           Text="樱花穿透账号"/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="填写访问密钥，读取账号中的隧道与节点。已连接的隧道不会被其他隧道的操作打断。"/>
                                <!-- 访问密钥 + 读取隧道（natfrp GET /v4/tunnels，Authorization: Bearer） -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="FrpTokenBox" PasswordChar="●" FontSize="13"
                                                 VerticalContentAlignment="Center" MaxLength="128"/>
                                    <Button x:Name="BtnFrpRefresh" Grid.Column="2" Style="{StaticResource BtnGold}"
                                            MinWidth="96" Click="FrpRefresh_Click" Content="读取隧道"/>
                                </Grid>
                                <!-- frpc 客户端路径：默认从 DataDir\frpc\ 自动找，也可手动选择 -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtFrpcPath" Style="{StaticResource Input}" FontSize="13"
                                             IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnFrpcBrowse" Grid.Column="2" Style="{StaticResource BtnGhost}"
                                            MinWidth="72" Click="FrpcBrowse_Click" Content="浏览…"/>
                                </Grid>
                                <TextBlock x:Name="FrpStatus" Margin="0,8,0,0" Style="{StaticResource Micro}"
                                           LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                           Text="frpc 客户端可在 natfrp.com「软件下载」获取；放到启动器数据目录的 frpc 文件夹，或点「浏览…」手动选择 frpc.exe。"/>
                                <!-- 隧道列表：FrpRefresh_Click 读取后由代码渲染（名称/节点/端口/状态/启停） -->
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="隧道列表"/>
                                <StackPanel x:Name="TunnelList" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TunnelEmpty" Margin="0,4,0,0" Style="{StaticResource Micro}"
                                           LineHeight="19" TextWrapping="Wrap"
                                           Text="尚未读取隧道。填写访问密钥后点击「读取隧道」。"/>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="节点参考"/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="查看各节点的状态与说明，在上方选择可用节点创建隧道。专业版节点需要对应账号权限。"/>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="自动恢复与连接说明"/>
                                <!-- details/summary（FrpPanel.vue:122）：折叠交互留给后续统一实现 // 占位：等联机功能接入 -->
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="游戏内直接连接显示的公网地址（remote_addr:remote_port）即可；关闭启动器不会停止正在运行的 frpc，可在隧道列表手动停止。"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- VoxLink：VoxLinkPanel.vue → 已接 VoxLink 真实后端（server-go 房间 API：
                         POST /room/create、/room/join、/room/leave、/room/heartbeat，见 Services/VoxLinkService.cs） -->
                    <Border x:Name="MethodVoxlink" Style="{StaticResource FriendPanel}" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource FriendPanelHead}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="VoxLink 联机"/>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                               TextWrapping="Wrap"
                                               Text="创建房间拿到 6 位房间码，好友输入房间码加入，无需公网 IP。"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="20">

                                <!-- VoxLink 服务器：默认官方 p2p.wuhui.icu（app-desktop/app.go defaultServerURL）；
                                     自建服务端默认端口 1145（server-go/main.go 的 VOXLINK_PORT） -->
                                <TextBlock Style="{StaticResource FriendSectionTitle}" Text="VoxLink 服务器"/>
                                <TextBox x:Name="TxtVoxServer" Style="{StaticResource Input}" FontSize="13" Margin="0,8,0,0"
                                         VerticalContentAlignment="Center" MaxLength="256"
                                         Text="https://p2p.wuhui.icu"/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="默认为官方服务器；自建 VoxLink 服务端填 http://地址:端口（Go 版默认端口 1145）。"/>

                                <!-- 创建房间：POST /room/create（name/hostPort/password）→ 房间码 + hostToken -->
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="创建房间"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtVoxName" Style="{StaticResource Input}" FontSize="13"
                                             MaxLength="20" VerticalContentAlignment="Center"/>
                                    <TextBox x:Name="TxtVoxPort" Grid.Column="2" Style="{StaticResource Input}" FontSize="13"
                                             MaxLength="5" VerticalContentAlignment="Center" Text="25565"/>
                                    <Button x:Name="BtnVoxCreate" Grid.Column="4" Style="{StaticResource BtnGold}"
                                            MinWidth="96" Click="VoxCreate_Click" Content="创建房间"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="VoxCreatePwdBox" PasswordChar="●" FontSize="13"
                                                 MaxLength="32" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg2}" Margin="0,0,0,0"
                                               Text="房间名 · 端口 · 密码（可选，房间名留空则用默认名）"/>
                                </Grid>

                                <!-- 房间码展示（create/join 成功后由代码填充；心跳保活中） -->
                                <Border x:Name="VoxRoomCard" Visibility="Collapsed" Margin="0,12,0,0"
                                        Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Micro}" Text="房间码，发给好友即可加入"/>
                                        <TextBlock x:Name="VoxRoomCode" FontSize="28" FontWeight="Bold"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource AccentHi}" Text="——"/>
                                        <TextBlock x:Name="VoxRoomInfo" Margin="0,2,0,0" Style="{StaticResource Micro}"
                                                   LineHeight="19" TextWrapping="Wrap" Text=""/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="BtnVoxLeave" Visibility="Collapsed" Margin="0,8,0,0"
                                        Style="{StaticResource BtnGhost}" MinWidth="96"
                                        HorizontalAlignment="Left" Click="VoxLeave_Click" Content="退出房间"/>

                                <!-- 加入房间：POST /room/join（code/password）→ clientToken + 房间公开信息 -->
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="加入房间"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtVoxCode" Style="{StaticResource Input}" FontSize="18" FontWeight="Bold"
                                             MaxLength="6" CharacterCasing="Upper" HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"/>
                                    <PasswordBox x:Name="TxtVoxJoinPwd" Grid.Column="2" PasswordChar="●" FontSize="13"
                                                 MaxLength="32" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnVoxJoin" Grid.Column="4" Style="{StaticResource BtnGold}"
                                            MinWidth="96" Click="VoxJoin_Click" Content="加入房间"/>
                                </Grid>
                                <TextBlock x:Name="VoxStatus" Margin="0,8,0,0" Style="{StaticResource Micro}"
                                           LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                           Text="创建房间前请先在游戏里对局域网开放世界（单人世界按 Esc → 对局域网开放）。"/>

                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="邀请好友的步骤"/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="1. 启动游戏并进入世界，选择「对局域网开放」（或启动服务端）；2. 在上方填端口（开放后游戏聊天栏会显示端口，服务端默认 25565），点「创建房间」；3. 把房间码发给好友，好友在本页输入房间码加入。"/>

                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="游戏内地址与加入指引"/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="创建成功后本页面板会显示本机地址 127.0.0.1:端口；好友加入成功后，在游戏内多人游戏 → 直接连接输入房主提供的地址即可。房间创建后由本页自动发送心跳保活，退出房间或关闭页面后房间会被服务端回收。"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Terracotta：TerracottaPanel.vue -->
                    <Border x:Name="MethodTerracotta" Style="{StaticResource FriendPanel}" Visibility="Collapsed">
                        <StackPanel>
                            <!-- 面板头取 :125 的 .tc-tool-heading strong「陶瓦工具」 -->
                            <Border Style="{StaticResource FriendPanelHead}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="陶瓦工具"/>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                               TextWrapping="Wrap"
                                               Text="手动下载官方工具并校验，版本状态见面板头右侧（TerracottaPanel.vue:125）。"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="20">
                                <!-- 真实小节标题 // 占位：等联机功能接入 -->
                                <TextBlock Style="{StaticResource FriendSectionTitle}" Text="创建房间"/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="先启动游戏并对局域网开放世界；陶瓦会自动完成其余工作（TerracottaPanel.vue:192）。"/>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="加入房间"/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Micro}" LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="房间码输入框与校验提示：格式 U/ 开头 + 四段各 4 位（TerracottaPanel.vue:200 与 :202）。"/>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="详细状态"/>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="关于陶瓦联机"/>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource FriendSectionTitle}"
                                           Text="陶瓦引擎日志"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
