<UserControl x:Class="Wuhuicl.App.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Wuhuicl.App.Controls"
             SizeChanged="Page_SizeChanged">

    <!-- 资源管理 · 模组。原版 ModsView.vue:9-15 只是个 16 行壳（title/rel/open-label/empty-text/icon），
         本体几何全在 components/FileManager.vue；资源包 / 光影包共用本页，靠 data-resource 切列集
         （FileManager.vue:332），所以这里做成一套壳 + ResourceKind。
         取值一律按 docs/UI_GEOMETRY_PAGES.md §4 + §0 的「最终值」，即尾部 :719-724 覆盖过 :494/:546/:565 等基础值。
         页内样式键统一 Fm 前缀，避开契约 §4 的画刷键名（tools/check_resource_keys.py 会撞名拦截）。
         文件列表要等 fs:list 接入，本轮四行都是占位；空态另做一份常备但 Visibility=Collapsed。 -->
    <UserControl.Resources>

        <!-- .fm-row：min-height 68 / padding 12px 0 / radius 0 / 透明底 — FileManager.vue:719 + :722（基线 :553-561 是 42 高 + radius 10） -->
        <Style x:Key="FmRow" TargetType="Border">
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- .fm-row:hover 的底色通道 130ms（ui-system.css:45 行组）：HoverFade 默认键 Hover、默认 130ms -->
            <Setter Property="ctl:HoverFade.Enabled" Value="True"/>
        </Style>

        <!-- .fm-name：font-weight 500 / 两行截断 — :577-586（-webkit-line-clamp:2）；
             字号取正文 14，两行上限 40≈2×(14×1.42)，按契约 §6.6 用 MaxHeight+Trimming 表达 clamp -->
        <Style x:Key="FmName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxHeight" Value="40"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- .fm-internal：display block / margin-top 4 — :494，最终 12px + 单行省略 — :719（基线 :494 是 11px） -->
        <Style x:Key="FmInternal" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- .fm-meta：12px / text-align right / nowrap / tabular-nums — :719（基线 :587-591；:592-594 的 fm-date 86px 右对齐被 :719 改成左对齐） -->
        <Style x:Key="FmMeta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- ====================================================================
             本轮补齐块（parity 台账：FileManager.vue 60 条规则缺 18 条）用的页内样式。
             键名统一 Mp 前缀（契约 §4：不能与主题画刷键同名，tools/check_resource_keys.py 会拦）。
             取值一律按「最终计算值」：:719-724 的压缩块排在 @media 之后、同权重后来者胜。
             ==================================================================== -->

        <!-- .empty（styles.css:515-524 叠 ui-system.css:44）：min-height 120 / padding 32px 16px /
             flex column 居中（justify-content center ＝ 竖直也要居中）/ gap 16 / 字色 text-dim。
             .fm-card 里 v-else-if 的三块 empty（FileManager.vue:414/:418/:423）走这一档。 -->
        <Style x:Key="MpEmpty" TargetType="Border">
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="Padding" Value="16,32"/>
        </Style>

        <!-- .card.empty（FileManager.vue:347）：同一个元素既挂 .card 又挂 .empty。
             .content .empty（两 class，ui-system.css:44）压过 .card（单 class，styles.css:450）的 padding 20，
             所以最终＝卡片描边（radius 14 / border 1 / Card 底 / 无阴影）+ min-height 120 + padding 32px 16px。 -->
        <Style x:Key="MpEmptyCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="Padding" Value="16,32"/>
        </Style>

        <!-- .upd-empty（FileManager.vue:361/:365/:390 + :649）：padding 最终 16px 0 ——
             :649 的 .upd-empty（scoped 后＝class+attribute 两权重）与 ui-system.css:44 的 .content .empty 打平，
             组件自己的 style 块在文档流里更靠后 → 取 16 0；min-height 120 / column 居中 / gap 16 仍来自 .empty。 -->
        <Style x:Key="MpUpdEmpty" TargetType="Border">
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="Padding" Value="0,16"/>
        </Style>

        <!-- .upd-row（FileManager.vue:372 + :659-671）：flex row 居中 / gap 12 / min-height row-h 42 /
             padding 8px 12px / radius radius-md 10 / hover 底 card-2。
             .upd-row.is-ok（:670）opacity .55 —— WPF 无 :class()，由代码侧把该行的 Opacity 设成 0.55。 -->
        <Style x:Key="MpUpdRow" TargetType="Border">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- .upd-row:hover 底 card-2（FileManager.vue:659-671）：HoverFade 淡入 CardSoft，130ms 取默认 -->
            <Setter Property="ctl:HoverFade.Enabled" Value="True"/>
            <Setter Property="ctl:HoverFade.BrushKey" Value="CardSoft"/>
        </Style>

        <!-- .status-strip（ui-system.css:41，FileManager.vue:412 引用）：flex row 居中 wrap / gap 12 /
             padding 12px 16px / radius radius-md 10 / 底 accent-soft / 13px / margin-bottom 12。
             .status-strip.error（ui-system.css:42）只把底换成 danger-soft，字色两态都是 text（＝Fg）→
             代码侧换 Background 即可，不需要第二个样式键。 -->
        <Style x:Key="MpStatusStrip" TargetType="Border">
            <Setter Property="Padding" Value="12,16"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <!-- Border 没有 FontSize / Foreground 依赖属性，继承型的字色字号要写成附加属性（契约 §6.6） -->
            <Setter Property="TextElement.FontSize" Value="13"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg}"/>
        </Style>

        <!-- details.fm-results（FileManager.vue:409 + :494）：card 底（radius 14 / border 1 / Card）
             + padding 12px 16px !important（:494 的 important 压过 .card 的 20，也压过 :719 的 .fm-card padding）
             + margin-bottom 16。页级 gap 12（:722）叠上去，块间留 12。 -->
        <Style x:Key="MpResultsCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="12,16"/>
        </Style>

        <!-- .fm-results summary（:409 + :494）：cursor pointer / 12px。这里没写 list-style:none，
             UA 的 disclosure 三角仍要画：照 SettingsPage 的 StSummary 配方内联 8×8 实心 marker，
             未展开朝右、展开朝下，字色继承（原版 ::marker 跟 summary 同色）。 -->
        <Style x:Key="MpSummary" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="mark" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M0,0 L4,4 L0,8 Z" Margin="0,0,6,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                </Path>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .fm-result-list p（:409 + :494）：flex row / justify-content space-between / gap 12 /
             12px / min-height 28 / align center。p.failed（:494）整行 danger。 -->
        <Style x:Key="MpResultRow" TargetType="Border">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="TextElement.FontSize" Value="12"/>
        </Style>

        <!-- .btn.btn-gold.btn-sm（FileManager.vue:392 一键更新选中 / DupCleanModal.vue:179 开始对比）：
             gold 的 accent 渐变底 + on-accent 字（Controls.xaml:195）叠 .btn-sm 的
             min-height 32（ui-system.css:17）/ padding 12px 4px / 13px / radius-sm 6。
             共享字典里只有 BtnGold 与 BtnSm 两个单 class 键，合成档只能在页内落一层。 -->
        <Style x:Key="MpBtnGoldSm" TargetType="Button" BasedOn="{StaticResource BtnGold}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ctl:CssRadius.Round" Value="6"/>
        </Style>

        <!-- ==================== 弹窗通用壳（styles.css:527-563 + ui-system.css:37-40） ==================== -->
        <!-- .modal-mask：fixed inset 0 / z 10000 / flex 居中 / 底 mask（主题里＝Overlay）/ blur 10。
             WPF 无视口单位：把 min(460px, 100vw 减 48) 与 calc(100vh 减 96) 的减项交给 mask 的 padding，
             子面板再怎么撑也越不出这块可用区；四个弹窗的减项不同（48/96、48/64、40/60、32/84vh）→ 实例上覆盖 Padding。
             backdrop-filter blur(10) 要宿主调 Services/MaskBlur.Attach 快照底层，XAML 表达不了（MainWindow 不归本页）。 -->
        <Style x:Key="MpModalMask" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Overlay}"/>
            <Setter Property="Padding" Value="24,48"/>
        </Style>
        <!-- .modal：width min(460px,100vw 减 48) / max-height calc(100vh 减 96)（ui-system.css:38 收成 100vw/vh 减 32）/
             overflow-y auto / 底 surface-raised（＝Card）/ border 1 border / radius radius-lg 14 / padding space-5 24 /
             shadow-lg（＝PopShadow） -->
        <Style x:Key="MpModal" TargetType="Border">
            <Setter Property="Width" Value="460"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect" Value="{DynamicResource PopShadow}"/>
        </Style>
        <!-- .mod-version-modal（ModVersionModal.vue:17）/ .migration-modal（ModMigrationModal.vue:37）：
             都把 .modal 的 padding 收到 0，改成列流 + overflow hidden，滚动区交给中间 body -->
        <Style x:Key="MpModalFlush" TargetType="Border" BasedOn="{StaticResource MpModal}">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- .modal-title（GameView.vue:2005-2009 ＝ DupCleanModal.vue:209-213 的同名 scoped 规则）：16px / 700。
             ConfirmModal 的 h3 没任何规则命中：UA h3 ＝ 1.17em（14×1.17≈16.4）+ bold，全局 * 复位把 margin 归零，
             三处最终都落在 16 粗体，共用这一档；下边距按各自实例给。 -->
        <Style x:Key="MpModalTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- .modal-actions（styles.css:557-563 + ui-system.css:40）：flex / align center / justify flex-end /
             gap 12 / margin-top 24（space-5）/ flex-wrap -->
        <Style x:Key="MpModalActions" TargetType="WrapPanel">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,24,0,0"/>
        </Style>
        <!-- 两个大弹窗的 header / footer（ModVersionModal.vue:17 / ModMigrationModal.vue:37）：
             flex row / gap 12 / align center / padding 20px 24px / flex-shrink 0；
             header 是 space-between + border-bottom 1，footer 是 flex-end + border-top 1 -->
        <Style x:Key="MpModalHead" TargetType="Border">
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="MpModalFoot" TargetType="Border">
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <!-- .game-tab（DupCleanModal.vue:121-122 + scoped :224-240）：inline-flex 居中 / padding 0 16 /
             height ctl-h 36 / 无边框 / radius 999（36 高上被浏览器收缩成 18）/ 透明底 / text-dim / 13px / 600。
             .game-tab.active（:241-244）：底 accent-grad、字 on-accent。 -->
        <Style x:Key="MpGameTab" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ctl:CssRadius.Round" Value="18"/>
        </Style>
        <Style x:Key="MpGameTabOn" TargetType="Button" BasedOn="{StaticResource MpGameTab}">
            <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        </Style>

        <!-- .dup-group（DupCleanModal.vue:132 + scoped :275-280）：border 1 / radius radius-md 10 /
             底 card-2 / padding 8px 12px。组间距走 .dup-list 的 gap 8（:265-271）。 -->
        <Style x:Key="MpDupGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- .dup-file（:137-152 + scoped :292-307）：flex 居中 / gap 8 / min-height 32 / padding 4px 8px /
             radius radius-sm 6 / 12px。选中保留项 .dup-file.keep（:302-304）底 accent-soft。 -->
        <Style x:Key="MpDupFile" TargetType="Border">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.FontSize" Value="12"/>
        </Style>

        <!-- .ver-chip（:169-177 + scoped :328-347）：inline-flex 居中 / gap 4 / padding 0 12 /
             min-height ctl-h 36 / border 1 / radius 999 / 底 card-2 / 12px / nowrap。
             内层 input 是 display:none（:348-350）→ 视觉上只有文字；active（:343-347）边 accent + 底 accent-soft + 字 accent-2。 -->
        <Style x:Key="MpVerChip" TargetType="Border">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ctl:CssRadius.Pill" Value="True"/>
            <Setter Property="TextElement.FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- .versions-list button（ModVersionModal.vue:15 + scoped :17）：flex column / width 100% /
             text-align left / padding 12 / border 1 border / radius 10 / margin-bottom 8 / gap 4 /
             底 card-2 / 字 text / overflow-wrap anywhere。active 换 accent-soft 底 + accent 描边。 -->
        <Style x:Key="MpVersionChoice" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        </Style>

        <!-- .migration-list article（ModMigrationModal.vue:30 + scoped :37）：flex / gap 12 / align center /
             padding 12px 0 / border-bottom 1px border。 -->
        <Style x:Key="MpMigrationRow" TargetType="Border">
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- .version-picker-trigger（MinecraftVersionPicker.vue:21 + scoped :26）：button.input ——
             .input（styles.css:304-317 叠 ui-system.css:15）min-height 36 / padding 8px 12px / radius 10 /
             底 card-2 / 14px，再加 flex / space-between / gap 12 / width 100% / text-align left -->
        <Style x:Key="MpPickerTrigger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="{DynamicResource CardSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <!-- 根层是 Grid（照 VersionsPage.xaml:282-285 / CommunityPage.xaml:231）：
         原版这四个弹窗都是 Teleport 到 body 的 position:fixed 节点（.modal-mask，styles.css:527-530，z-index 10000），
         放进 ScrollViewer 里会跟着一起滚并被视口裁掉，所以必须与 ScrollViewer 平级。
         面板只铺满 .content 这块区域（MainWindow.xaml:260 的 Grid），原版 inset 0 是整窗口——
         真铺满窗口要把这几块搬进 MainWindow，超出本页所有权。 -->
    <Grid x:Name="MpRoot">

    <!-- .content 是 scrollbar-gutter:stable（docs §0 App.vue:2398-2404）→ 槽常驻，契约 §6.5 -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">

        <!-- .page.resource-page：flex column + max-width 940 + margin 0 auto — FileManager.vue:500-506；
             页级 gap 最终 12px（:722 的 !important 压过 :503 的 sec-gap 变量 28 与 ui-system.css:10 的 16） -->
        <StackPanel MaxWidth="940" HorizontalAlignment="Center" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- ==================== .fm-head ====================
                 最终形态：列流 + align-items:stretch — :508（mods 单看 :511-517 仍是 row，这里按统一壳走列流，
                 资源包/光影（.resource-page）本来就是这个形态）；gap 16 — :719，margin 0 — :722 -->
            <!-- .fm-head：mods 是 row（align-items:flex-end + justify-between，FileManager.vue:507-517），
                 资源包/光影的 .resource-page 才切列流（:506-510）。行/列由 ApplyResourceKind 搬 FmActions。 -->
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- .page-head.fm-head-left（模板 :334）：.page-head 是 flex column / gap 4（styles.css:495），
                     并且 .content .page-head 还带 margin-bottom space-2 8（ui-system.css:6）——
                     .fm-head 是 align-items flex-end，所以这 8 会把标题从行底抬起 8px，与右侧按钮组错开；
                     .fm-head-left 自己 flex 1 / min-width 140（:517）。这里只包一个 h1，column 与 gap 不产生差别。
                     .page-title 24px/Bold — ui-system.css:12（契约 §2 PageTitle） -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <TextBlock x:Name="HeadTitle" Style="{StaticResource PageTitle}" Text="模组"/>
                    <!-- .fm-head .page-title small：13px / 400 / text-dim / margin-left 8 — :719。// 计数：真实文件数（RenderList 落 HeadCount） -->
                    <TextBlock x:Name="HeadCount" FontSize="13" Foreground="{DynamicResource Fg2}" Margin="8,0,0,0"
                               VerticalAlignment="Bottom" Text="0"/>
                </StackPanel>

                <!-- .fm-actions：flex row / gap 12（space-3 变量）/ flex-wrap — :533-539 -->
                <WrapPanel x:Name="FmActions" Grid.Row="0" Grid.Column="1"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <!-- v-if props.rel==='mods' — :336；非 mods 时由 ResourceKind 收起 -->
                    <Button x:Name="BtnCheckUpdate" Style="{StaticResource BtnGold}" Content="检测更新" Margin="0,0,12,0"/>
                    <Button x:Name="BtnOpen" Style="{StaticResource BtnGhost}" Content="打开模组文件夹" Margin="0,0,12,0"/>
                    <!-- 头部这个 .file-more：summary 是 .btn-ghost，字号被 :722 收成 14px。
                         整块 v-if props.rel==='mods'（:338）→ 非 mods 由 ApplyResourceKind 收起（HeadMoreHost） -->
                    <Grid x:Name="HeadMoreHost">
                        <Button x:Name="HeadMoreBtn" Style="{StaticResource BtnGhost}" Content="更多"
                                Tag="PopHeadMore" Click="More_Click"/>
                        <!-- .file-more-actions：absolute right:0 / top:100% / min-width 150 / padding 10 / gap 8 / radius 10 — :488 + :719
                             PopupCard 已给 radius 10 + border 1（契约 §2），这里把 padding 收到 10；
                             WPF 没有 right:0 对齐，靠 HorizontalOffset 把浮层右缘拉回按钮右缘（150-38≈112，此处取 110） -->
                        <Popup x:Name="PopHeadMore" PlacementTarget="{x:Reference HeadMoreBtn}" Placement="Bottom"
                               HorizontalOffset="-110" AllowsTransparency="True" Focusable="False" StaysOpen="False">
                            <Border Style="{StaticResource PopupCard}" MinWidth="150" Padding="10">
                                <StackPanel>
                                    <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch" Content="版本迁移"/>
                                    <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                            Content="清理重复" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </WrapPanel>
            </Grid>

            <!-- ==================== .fm-context ====================
                 flex / align-center / gap 12 / flex-wrap，margin-bottom 16 — :719。
                 第一行是「label(游戏实例) ＋ 非 mods 的刷新钮」，第二行是 .fm-path（flex-basis 100% 独占一行）。
                 原来这里写成竖排 StackPanel，刷新与路径各自掉到下一行，与原版差一整行。 -->
            <Grid x:Name="FmContext" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- label 的 flex 0 1 440px（:719）：基准 440、可收缩 —— Star + MaxWidth 等价 -->
                        <ColumnDefinition Width="*" MaxWidth="440"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- .fm-context>label：display grid / gap 6 / flex 0 1 440px / min-width 0 / 12px text-dim — :719 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="游戏实例" FontSize="12" Foreground="{DynamicResource Fg2}"/>
                        <!-- .fm-ver-select：SelectMenu 两行卡片，宽度撑满 440 的 label 轨
                             （label flex 0 1 440px — :719；截图量得卡宽 ≈436）。label 13px/600，
                             description 11px text-dim，右缘 14px chevron；radius 10 描边。 -->
                        <Button x:Name="VerSelect" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource Card}" CornerRadius="10"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="14"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="VerName" FontSize="13" FontWeight="Normal"
                                                           TextTrimming="CharacterEllipsis" Text="1.20.1 · Fabric 0.16.4"/>
                                                <TextBlock x:Name="VerDesc" FontSize="12" Foreground="{DynamicResource Fg2}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Text="1.20.1 · Fabric · 0.16.4 · 已隔离"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center"
                                                            Style="{DynamicResource Icon.ChevronDown}"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <!-- 占位：等版本列表接入（原版来自 activeInstalled，:48） -->
                        </Button>
                    </StackPanel>

                    <!-- v-if props.rel!=='mods' 的上下文刷新按钮 — :343；与 label 同一行、垂直居中，
                         文案「↻ 刷新」用的是原文字形 ↻（契约 §3）；mods 下由 ApplyResourceKind 收起 -->
                    <Button x:Name="BtnCtxRefresh" Grid.Column="2" Style="{StaticResource BtnGhost}"
                            Content="↻ 刷新" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- .fm-context .fm-path：flex-basis 100%（自己占一行）/ 无边框 / 12px text-dim / cursor:copy / overflow-wrap anywhere — :719
                     displayPath = 游戏根 + '/' + rel（:116，是正斜杠不是反斜杠），>80 字符中间省略是 :117 的逻辑 -->
                <TextBlock x:Name="PathText" Grid.Row="1" Style="{StaticResource Micro}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Cursor="Hand" ToolTip="点击复制完整路径（未接入）"
                           Text="versions/1.20.1-Fabric/mods"/>
            </Grid>

            <!-- ==================== 1. .card.empty（FileManager.vue:347-349） ====================
                 v-if !currentVersion：当前游戏文件夹里一个可选版本都没有时，整页只留这一张卡。
                 位置就压在 .fm-context 与 .upd-panel 之间（模板顺序 :341/:347/:352）。
                 描边卡（radius 14 / border 1 / Card 底 / 无阴影）＋ .empty 的 min-height 120 / padding 32px 16px /
                 column 居中 / gap 16 / 字色 text-dim，样式键 MpEmptyCard（见上方注释：.content .empty 压过 .card 的 padding）。
                 默认 Collapsed：currentVersion 要等版本上下文接入（LaunchSession 里还没有对应状态）。 -->
            <Border x:Name="NoVersionCard" Style="{StaticResource MpEmptyCard}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="14" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="当前游戏文件夹没有可选版本，请先到「游戏版本」页安装或选择版本"/>
                </StackPanel>
            </Border>

            <!-- ==================== 2. .upd-panel MOD 更新检测面板（FileManager.vue:352-398，样式 :634-710） ====================
                 v-if props.rel==='mods' && updatePanel.open（:352）：非 mods 由 ApplyResourceKind 强制收起，
                 mods 下等 updatePanel 数据接入（updatePanel.checking/error/report/selected 在 LaunchSession 里都还没有），
                 所以整块 Collapsed，内部各子块也各自 Collapsed，接线时只翻 Visibility。
                 卡底 padding card-pad 20 ＝ Panel 的默认 padding（:634-639），列流 gap space-3 12 用子块 margin-top 表达。 -->
            <Border x:Name="UpdPanel" Style="{StaticResource Panel}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>

                    <!-- .upd-head（:353-359 + :640-648）：flex row 居中 / gap 12 / 13px。
                         四子：strong（UA 700）/ span.muted / span.upd-head-spacer（flex:1，* 轨等价）/ .btn.btn-ghost.btn-sm。
                         文案逐字取自 :354-359。
                         // 字号说明：任务单写这条 muted 是 12px，但 CSS 里没有任何规则命中 .upd-head .muted
                         （.muted 只给颜色，styles.css:677），它继承 .upd-head 的 var(text-sm)＝13（:644）→ 取计算值 13。 -->
                    <Grid TextElement.FontSize="13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MOD 更新检测" FontWeight="Bold" VerticalAlignment="Center"/>
                        <!-- v-if updatePanel.report（:355）：共 N 个 · 可更新 M · 已最新 K [ · U 个未匹配来源]（:356）
                             // 占位：等检测报告接入，数值格式照 :356 -->
                        <TextBlock x:Name="UpdHeadSummary" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" Text="共 0 个 · 可更新 0 · 已最新 0"/>
                        <!-- .upd-head-spacer（:358 + :646）：flex 1，把右侧按钮推到行尾；这里占掉 * 轨 -->
                        <Button x:Name="BtnUpdCollapse" Grid.Column="3" Style="{StaticResource BtnSmGhost}"
                                Content="收起" Margin="12,0,0,0"/>
                    </Grid>

                    <!-- .upd-empty（:361-364，v-if updatePanel.checking）：.spin + 一行文案，gap 16（:361/:365 + :649） -->
                    <Border x:Name="UpdEmptyChecking" Style="{StaticResource MpUpdEmpty}"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource Spin}" HorizontalAlignment="Center"/>
                            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                                       Text="正在计算文件哈希并查询 Modrinth…"/>
                        </StackPanel>
                    </Border>

                    <!-- .upd-empty（:365-368，v-else-if updatePanel.error）：文案 + .btn.btn-ghost.btn-sm 重试 -->
                    <Border x:Name="UpdEmptyError" Style="{StaticResource MpUpdEmpty}"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- // 占位：错误文本等检测失败回调接入（原文是 检测失败：{{ updatePanel.error }}，:366） -->
                            <TextBlock x:Name="UpdErrorText" Margin="0" HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Text="检测失败："/>
                            <Button x:Name="BtnUpdRetry" Style="{StaticResource BtnSmGhost}" Content="重试"
                                    Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- .upd-list（:370 + :652-657）：flex column / max-height 300 / overflow-y auto。
                         里面是 N 个 .upd-entry（:371，无自有样式，只是 .upd-row 与 .upd-error-detail 的包装），
                         现在只铺一条几何正确的行壳，等 report.entries 接入后由代码复制填充。 -->
                    <ScrollViewer x:Name="UpdListScroll" Margin="0,12,0,0" MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="UpdList">
                            <StackPanel x:Name="UpdEntryShell" Visibility="Collapsed">
                                <Border x:Name="UpdRowShell" Style="{StaticResource MpUpdRow}">
                                    <!-- gap space-3 12 ＝ 列间 12 的固定轨（同本页 fm 行用 margin 的写法） -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- .upd-check（:373-379 + :673-676）：原生 checkbox，accent-color accent / flex-shrink 0。
                                             accent-color 在 WPF 里要换控件模板才生效，这里用共享 Check 档（方框 13px），
                                             颜色跟随主题留给控件层统一改。 -->
                                        <CheckBox x:Name="UpdCheckShell" Style="{StaticResource Check}"
                                                  VerticalAlignment="Center" ToolTip="选中后要更新的模组"/>
                                        <!-- .fm-file-icon（:381）：mods 作用域下 32×32（:719 的 data-resource=mods 规则压过 :719 前面的 36）。
                                             两态：有图标是 img（:576：填满 + object-fit contain + radius 6），没有是内联的 ◇ 字形；
                                             基色 color:var(accent)（:565-571），与本页其它图标格同一配方。 -->
                                        <Grid Grid.Column="2" Width="32" Height="32" Background="Transparent">
                                            <Border x:Name="UpdIconImgShell" Visibility="Collapsed"
                                                    CornerRadius="6" ClipToBounds="True">
                                                <Image x:Name="UpdIconPixel" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock x:Name="UpdIconFallback" Text="◇" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Accent}"/>
                                        </Grid>
                                        <!-- .upd-name（:381）：最终＝:496（column / gap 3 / min-width 0）与 :677
                                             （flex 1 / nowrap / 500 / ellipsis）的并集。
                                             strong 600、small 12px（:496）+ muted 色；容器字重 500 落到 small 上 -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdFileNameShell" FontSize="14" FontWeight="SemiBold"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="UpdModNameShell" FontSize="12" FontWeight="Medium"
                                                       Margin="0,3,0,0" Foreground="{DynamicResource Fg2}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- .upd-ver（:382 + :685-692）：12px（text-xs）/ shrink 0 / nowrap，
                                             里面的 b 是 accent-2（主题里＝AccentHi）；文案 当前 → 目标 -->
                                        <TextBlock Grid.Column="6" x:Name="UpdVerShell" FontSize="12" FontWeight="Normal"
                                                   VerticalAlignment="Center" TextWrapping="NoWrap"
                                                   Foreground="{DynamicResource Fg2}"><Run Text="未知 → "/><Run FontWeight="Bold" Foreground="{DynamicResource AccentHi}"/></TextBlock>
                                        <!-- .upd-spin（:383 + :693-696，itemState==='start'）：14×14 的 .spin；
                                             .upd-err（:384 + :697-701，itemState==='error'）：danger / 12px / shrink 0。两者互斥 -->
                                        <ContentControl x:Name="UpdSpinShell" Grid.Column="8" Style="{StaticResource Spin}"
                                                        Visibility="Collapsed"/>
                                        <TextBlock x:Name="UpdErrShell" Grid.Column="8" Text="失败" FontSize="12"
                                                   FontWeight="Normal" VerticalAlignment="Center" Visibility="Collapsed"
                                                   Foreground="{DynamicResource Danger}"/>
                                        <!-- .btn.btn-ghost.btn-sm（:385）：三态文案 更新 / 重试 / 已锁定 · 选版本 -->
                                        <Button x:Name="BtnUpdApplyOne" Grid.Column="10" Style="{StaticResource BtnSmGhost}"
                                                Content="更新"/>
                                    </Grid>
                                </Border>
                                <!-- .upd-error-detail（:387 + :658）：margin 0 12px 12px 40px / danger / 12px /
                                     line-height 1.6 / white-space pre-wrap / overflow-wrap anywhere -->
                                <TextBlock x:Name="UpdErrorDetailShell" Margin="40,0,12,12" FontSize="12"
                                           FontWeight="Normal" LineHeight="19.2" LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           Foreground="{DynamicResource Danger}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- .upd-empty（:390，v-else：有报告但没有可更新项）：只有一行文案 -->
                    <Border x:Name="UpdEmptyLatest" Style="{StaticResource MpUpdEmpty}"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg2}" Text="所有已匹配来源的 MOD 均为最新"/>
                        </StackPanel>
                    </Border>

                    <!-- .upd-foot（:391-396 + :702-710）：flex row 居中 gap 12 wrap，
                         .btn.btn-gold.btn-sm ＋ .muted（:708 收成 12px） -->
                    <WrapPanel x:Name="UpdFoot" Margin="0,12,0,0"
                               VerticalAlignment="Center" Visibility="Collapsed">
                        <!-- // 占位：括号里的数量来自 updatePanel.selected.size（:393） -->
                        <Button x:Name="BtnUpdApplyAll" Style="{StaticResource MpBtnGoldSm}" Content="一键更新选中（0）"
                                Margin="0,0,12,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Fg2}"
                                   Text="更新会先校验新文件哈希，失败时保留旧文件"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ==================== .fm-controls ====================
                 最终 grid-template-columns:minmax(180px,1fr) 160px 140px 38px — :719（基线 :494 末列是 auto）；
                 gap 10 / margin-bottom 16 — :494。断点 @max-1000 变 minmax(0,1fr) minmax(0,1fr) 38px（:724）与
                 @max-1150 / @max-700（:720）本轮不做：WPF 无媒体查询，需宿主自己按需改列集。 -->
            <Grid x:Name="FmControls" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <!-- .input.fm-search（:401）：36 高 / padding 12 8 / radius 10（契约 §2 Input）；WPF 无 placeholder → 覆盖文字。
                     这颗 TextBox 不钉高度会被量到 50 高（其它页同款输入框也是），先钉死 36 -->
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}" FontSize="13" Height="36"
                             VerticalAlignment="Top"
                             TextChanged="Search_TextChanged" ToolTip="搜索文件名或模组名称…"/>
                    <TextBlock x:Name="SearchHint" Text="搜索文件名或模组名称…" FontSize="13"
                               Foreground="{DynamicResource Fg3}" Margin="13,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <!-- 状态筛选 SelectMenu（:402 的四项）；宽度 160 来自 :719 的第二轨。筛选逻辑接 RenderList -->
                <ComboBox x:Name="CmbStatus" Grid.Column="1" Margin="10,0,0,0" Height="36" VerticalAlignment="Top" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem>全部状态</ComboBoxItem>
                    <ComboBoxItem>已启用</ComboBoxItem>
                    <ComboBoxItem>已禁用</ComboBoxItem>
                    <ComboBoxItem>已锁定</ComboBoxItem>
                </ComboBox>
                <!-- 排序 SelectMenu（:403 的三项）；宽度 140 来自 :719 的第三轨。排序逻辑接 RenderList -->
                <ComboBox x:Name="CmbSort" Grid.Column="2" Margin="10,0,0,0" Height="36" VerticalAlignment="Top" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem>名称排序</ComboBoxItem>
                    <ComboBoxItem>最近修改</ComboBoxItem>
                    <ComboBoxItem>文件大小</ComboBoxItem>
                </ComboBox>
                <!-- .fm-refresh：38 轨里的 .btn-ghost，内容是原文字形 ↻（:405，契约 §3 允许的字形） -->
                <Button x:Name="BtnRefresh" Grid.Column="3" Style="{StaticResource BtnGhost}" Width="38" Height="36" Padding="0"
                        FontSize="16" Content="↻" ToolTip="刷新文件列表"/>
            </Grid>

            <!-- ==================== .fm-batch ====================
                 原版 position:sticky / top:0 / z-index:6 — :491（:494 再压一次），WPF 没有 sticky：先按普通行做，
                 真正吸附要宿主把这一条挪到滚动视口外或用浮层。padding 12px 16px / gap 8 / flex-wrap / margin-bottom 16 — :494；
                 v-if selection.size && props.rel==='mods' — :407 -->
            <Border Style="{StaticResource Panel}" Padding="12,16" Margin="0,0,0,16"
                    Visibility="Collapsed">
                <WrapPanel>
                    <!-- v-if selection.size（:407）默认没有选中项 → 整条隐藏；占位：等批量选择接入 -->
                    <TextBlock Text="已选 2 项" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="全选筛选结果（4）" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="批量启用" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="批量禁用" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="锁定版本" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="解除锁定" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="清空选择"/>
                </WrapPanel>
            </Border>

            <!-- ==================== catalogError 段落（FileManager.vue:408） ====================
                 v-if catalogError：模组目录（mods:catalog）读失败时挂在批量条与批量结果之间的一行提示。
                 元素是 p.muted —— 全局 * 复位把 p 的 margin 归零（styles.css:110-114），.muted 只给颜色
                 （:677），字号继承正文 14（body 的 var(text-md)，:126）。默认 Collapsed，等 catalog 接入。 -->
            <TextBlock x:Name="CatalogErrorLine" FontSize="14" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                       Visibility="Collapsed"><Run Text="模组识别或锁定记录读取失败："/><Run x:Name="CatalogErrorRun"/><Run Text="。可刷新重试，写入操作仍会由后端校验。"/></TextBlock>

            <!-- ==================== 3. .fm-results（FileManager.vue:409，样式 :494） ====================
                 details.card，v-if batchResults.length（上一次批量启用/禁用/锁定的回包）；:open 只在有失败项时为真，
                 所以这里默认收起（IsChecked=False）。
                 padding 12px 16px !important + margin-bottom 16 —— important 压过 .card 的 20（:454），也压过 :719；
                 summary 12px + cursor pointer（UA 三角仍要画，这里没写 list-style:none）；
                 .fm-result-list max-height 180 / overflow auto / overscroll-behavior contain；
                 每条 p：flex row / justify space-between / gap 12 / 12px / min-height 28 / 居中，
                 p.failed 整行 danger，strong overflow-wrap anywhere。
                 折叠交互由 summary 的 ToggleButton 直接驱动列表 Visibility（等价 details 的原生开合）。 -->
            <Border x:Name="FmResults" Style="{StaticResource MpResultsCard}" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <ToggleButton x:Name="FmResultsSummary" Style="{StaticResource MpSummary}"
                                  Content="上次批量操作：0 项成功 · 0 项失败"/>
                    <!-- // 占位：成功/失败计数与逐条结果都来自 batchResults（:140 的 mods:setEnabled / mods:setLocked 回包） -->
                    <ScrollViewer x:Name="FmResultsList" MaxHeight="180" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=FmResultsSummary, Converter={StaticResource BoolVis}}">
                        <StackPanel x:Name="FmResultRows">
                            <Border x:Name="FmResultRowShell" Style="{StaticResource MpResultRow}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FmResultFileName" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <!-- r.ok ? '已完成' : r.error（:409）；失败时整行（含这条 span）转 danger -->
                                    <TextBlock x:Name="FmResultReason" Grid.Column="2" FontSize="12"
                                               FontWeight="Normal" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ==================== .fm-card ====================
                 padding 0 16 !important / overflow visible — :719（基线 :545-547 是 padding 8）；
                 CSS 的 padding:0 16px 是上下 0、左右 16 —— 表头紧贴卡顶，行内容左右缩进 16；
                 卡片平面无阴影（契约 §6.4 + §2 Panel：radius 14 / border 1 / Card 底）。
                 v-if currentVersion（:411）：没版本时整卡不渲染，只剩上面那张 .card.empty。
                 :class 的 shader-empty（:411，光影包且列表为空且不在读取且无错误）由 ApplyResourceKind 切
                 底色与描边（第 5 项，见那里的注释）。 -->
            <Border x:Name="FmCard" Style="{StaticResource Panel}" Padding="16,0" Margin="0,0,0,12">
                <!-- .fm-list：flex column / overflow visible — :490 + :548-551 -->
                <StackPanel>

                    <!-- ==================== 4. .status-strip（FileManager.vue:412，样式 ui-system.css:41-42） ====================
                         .fm-card 的第一个子元素，v-if entries.length && (loading || loadError)：
                         刷新中或刷新失败时上面那张列表还留着旧数据，所以这条带子压在表格上方。
                         flex row 居中 wrap / gap 12 / padding 12px 16px / radius radius-md 10 / 底 accent-soft /
                         13px / margin-bottom 12。右侧 .btn.btn-ghost.btn-sm「重试」是 v-if loadError（:412）→ 默认收起。
                         .status-strip.error（ui-system.css:42）：底换 danger-soft、字色仍是 text，
                         所以代码侧只改 StatusStrip.Background（DynamicResource 引用见 MpStatusStrip）。 -->
                    <Border x:Name="StatusStrip" Style="{StaticResource MpStatusStrip}"
                            Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <!-- 两态文案（:412）：正在刷新，暂时保留上次的文件列表… / 刷新失败：{{ loadError }} -->
                            <TextBlock x:Name="StatusStripText" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="正在刷新，暂时保留上次的文件列表…"/>
                            <Button x:Name="BtnStatusRetry" Style="{StaticResource BtnSmGhost}" Content="重试"
                                    Margin="12,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- .fm-table-head：与行同一套 mods 列集（18 32 minmax(0,1fr) 88 132 42 40 / gap 12）
                         + 第 2 个子跨 2/4 — :719；min-height 36 / 12px text-dim / 下边线 1px — :719 -->
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" MinHeight="36">
                        <Grid x:Name="FmHead">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/><ColumnDefinition Width="12"/><ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="88"/><ColumnDefinition Width="12"/><ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="12"/><ColumnDefinition Width="42"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <!-- 表头全选：:checked / :indeterminate（:427）→ WPF 用 IsThreeState + IsChecked={x:Null} 表示半选 -->
                            <CheckBox Style="{StaticResource Check}" Tag="mods-only" IsThreeState="True"
                                      VerticalAlignment="Center" ToolTip="选择当前页模组"/>
                            <!-- mods：grid-column:2/4 ——「名称」压在图标轨+gap+名称轨上，文字左缘对齐图标轨左缘（:719）；
                                 非 mods（资源包/光影）：表头是 36 1fr 88 132 40 五轨，「名称」在名称轨上（:427 的 v-else 占位＋名称） -->
                            <TextBlock Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Micro}" Tag="mods-only"
                                       Text="名称" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource Micro}" Tag="packs-only"
                                       Text="名称" VerticalAlignment="Center"/>
                            <!-- .fm-table-head>span:nth-child(3){text-align:right} — :719 -->
                            <TextBlock Grid.Column="6" Style="{StaticResource Micro}"
                                       Text="大小" TextAlignment="Right" VerticalAlignment="Center"/>
                            <!-- .fm-date{text-align:left} — :719 -->
                            <TextBlock Grid.Column="8" Style="{StaticResource Micro}"
                                       Text="修改时间" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="10" Style="{StaticResource Micro}" Tag="mods-only"
                                       Text="启用" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="12" Style="{StaticResource Micro}"
                                       Text="操作" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ============ 文件列表行 ============
                         行由代码侧按真实文件列表生成（ModsPage.xaml.cs 的 BuildRow）：
                         结构逐项对齐被替换的四行占位行（FmRow 外框 + 13 轨 Grid + Check 复选框 /
                         FmFile 图标 / FmName 名称(含 FmInternal 状态第二行) / FmMeta 大小·日期 /
                         Switch 启用开关 / ⋯ + PopupCard 菜单），插入点在本注释与「卡内三种 empty」之间。 -->
                    <!-- ============ 卡内三种 empty（与列表 v-else-if 互斥，:414 / :418-422 / :423-425）============
                         .content .empty：min-height 120 / padding 32px 16px — ui-system.css:44（压过 styles.css:521 的 48/24）；
                         flex column / align-items center / justify-content center / gap 16 / text-dim — styles.css:515-524；
                         样式键 MpEmpty（光影页的 min-height 变体见第 5 项，由 Page_SizeChanged 落 min(380px,45vh)）。
                         三块都常备但 Collapsed，等 fs:list / 搜索筛选接入。 -->

                    <!-- v-else-if loadError && !entries.length（:414-417）：一行文案 + .btn.btn-ghost.btn-sm 重试（:416） -->
                    <Border x:Name="EmptyLoadError" Style="{StaticResource MpEmpty}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- // 占位：原文是 读取失败：{{ loadError }}（:415），错误文本等 fs:list 接入 -->
                            <TextBlock x:Name="EmptyLoadErrorText" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Fg2}" Text="读取失败："/>
                            <Button x:Name="BtnEmptyRetry" Style="{StaticResource BtnSmGhost}" Content="重试"
                                    Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- v-else-if !entries.length（:418-422）：内联图标 + 空态文案，光影包再补一条 small.muted（:421） -->
                    <Border x:Name="EmptyBlock" Style="{StaticResource MpEmpty}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- .empty-icon：44×44 / color:var(accent) / opacity .8 — :621-631；
                                 图形取各壳传进来的 props.icon（ModsView:4-5 方块 / PacksView:4-5 文件夹 /
                                 ShadersView:4-5 太阳），由 ApplyResourceKind 切 EmptyIcon -->
                            <ContentControl x:Name="EmptyIcon" Width="44" Height="44" Opacity="0.8"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource Accent}" Style="{DynamicResource Icon.Mods}"/>
                            <TextBlock x:Name="EmptyText" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,0"
                                       TextAlignment="Center" Foreground="{DynamicResource Fg2}"
                                       Text="暂无模组，将 .jar 文件放入 mods 文件夹"/>
                            <!-- <small v-if="props.rel === 'shaderpacks'" class="muted">（:421）：UA small＝80%（14×0.8＝11.2），
                                 .muted 只给颜色（styles.css:677）；只有光影包渲染这一行，gap 16 同上 -->
                            <TextBlock x:Name="EmptyShadersHint" FontSize="11.2" Margin="0,16,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center" Foreground="{DynamicResource Fg2}" Visibility="Collapsed"
                                       Text="将光影包 ZIP 放入上方文件夹，然后刷新列表。"/>
                        </StackPanel>
                    </Border>

                    <!-- v-else-if !filtered.length（:423-425）：只有一行文案，没有图标也没有按钮 -->
                    <Border x:Name="EmptyNoMatch" Style="{StaticResource MpEmpty}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Fg2}"
                                       Text="当前搜索或筛选条件没有匹配的文件"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== .fm-pagination ====================
                 flex / justify-content:flex-end / gap 12 / padding 8px 0 / 13px；.muted{margin-right:auto} — :498-499
                 （muted 顶到最左、按钮组靠右，用 1×Auto 两列等价表达）；原版 v-if pageCount>1（:453），本轮为让几何可见常开；
                 PAGE_SIZE=100 — :39 -->
            <Grid Margin="0,0,0,12" Visibility="Collapsed">
                <!-- v-if pageCount>1（:453），单页时整条不渲染 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 占位：等分页接入（原版是 共 {{filtered.length}} 项 · 每页 {{PAGE_SIZE}} 项，:454） -->
                <TextBlock Style="{StaticResource PageSub}" Text="共 4 项 · 每页 100 项" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSm}" Content="上一页"/>
                    <TextBlock FontSize="13" Text="1 / 1" Margin="12,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnSm}" Content="下一页" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>

    <!-- ====================================================================
         6. 本组件挂载的四个弹窗（FileManager.vue:459 ModVersionModal / :460 ModMigrationModal /
         :462 ConfirmModal / :472 DupCleanModal）。四个都是 v-if 门控的 fixed 层，
         没数据时整层 Collapsed；内部纯数据驱动的列表（版本候选 / 模组条目 / 重复组）
         只铺一条几何正确的行壳，等接口接入后由代码复制填充。
         ==================================================================== -->

    <!-- ==================== 6a. ConfirmModal（:462-469 → components/ConfirmModal.vue:19-31） ====================
         门控：delModal.open（:463）。除正文外零自有几何（docs/UI_GEOMETRY_PAGES.md:299），
         全走通用 .modal-mask + .modal（styles.css:527-563）＋ ui-system.css:37-40。
         标题是 h3.modal-title，这里没有任何规则命中它：UA h3＝1.17em（14×1.17≈16.4）+ bold，
         全局 * 复位把 margin 归零（styles.css:110-114）→ 标题与正文之间没有间隙，照抄。
         .confirm-text（ConfirmModal.vue:35-39）：14px（text-md）/ line-height 1.7（＝23.8）/ word-break break-all。
         .modal-actions（styles.css:557-563 叠 ui-system.css:40）：flex / justify flex-end / gap 12 / margin-top 24 / wrap。 -->
    <Border x:Name="ConfirmModalHost" Panel.ZIndex="10000" Style="{StaticResource MpModalMask}" Visibility="Collapsed">
        <Border Style="{StaticResource MpModal}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" FontSize="16.4" FontWeight="Bold" TextWrapping="Wrap" Text="删除文件"/>
                    <!-- // 占位：引号里的文件名是 delModal.target.name（:465），等删除流程接入 -->
                    <TextBlock x:Name="ConfirmText" FontSize="14" LineHeight="23.8" LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap" Text="确定要删除「」吗？文件将移入系统回收站，可从回收站恢复。"/>
                    <WrapPanel Style="{StaticResource MpModalActions}">
                        <Button x:Name="BtnConfirmCancel" Style="{StaticResource BtnGhost}" Content="取消" Margin="0,0,12,0"/>
                        <Button x:Name="BtnConfirmDelete" Style="{StaticResource BtnDanger}" Content="确认删除"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>

    <!-- ==================== 6b. ModVersionModal（:459 → components/ModVersionModal.vue:15-17） ====================
         门控：v-if="switchFile && currentVersion"。
         .modal.mod-version-modal（scoped :17）：width min(920px,100vw 减 48) / max-height calc(100vh 减 64) /
         padding 0 / flex column / overflow hidden → 用三行 Grid（header / 滚动 body / footer）表达，
         减项交给 mask 的 Padding 24,32。header 与 footer 同一套 padding 20px 24px + 1px 分隔线。 -->
    <Border x:Name="ModVersionModalHost" Panel.ZIndex="10000" Style="{StaticResource MpModalMask}"
            Padding="24,32" Visibility="Collapsed">
        <Border Style="{StaticResource MpModalFlush}" Width="920" MaxWidth="920">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header（:15 的 header ＋ scoped :17 的 header 规则）：flex / gap 12 / align center /
                     justify space-between / padding 20px 24px / border-bottom 1。h2 21px / margin 0；
                     header p（文件名）margin 7px 0 + overflow-wrap anywhere；小字是 UA small＝11px 档 -->
                <Border Grid.Row="0" Style="{StaticResource MpModalHead}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="21" FontWeight="Bold" Text="切换模组版本"/>
                            <!-- // 占位：props.fileName（:459 由 switchFile 传入） -->
                            <TextBlock x:Name="ModVersionFileName" FontSize="14" Margin="0,7" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg2}"/>
                            <!-- v-if choices（:15）：{{mcVersion}} · {{loader}} · 当前 {{currentVersion}}。
                                 UA small＝80%（14×0.8＝11.2），.muted 只给颜色 -->
                            <TextBlock x:Name="ModVersionMeta" FontSize="11.2" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg2}" Visibility="Collapsed"/>
                        </StackPanel>
                        <Button x:Name="BtnModVersionClose" Grid.Column="2" Style="{StaticResource BtnGhost}"
                                Content="×" ToolTip="关闭"/>
                    </Grid>
                </Border>

                <!-- .version-content（scoped :17）：min-height 0 / overflow auto / padding 20px 24px -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20">
                    <!-- template v-if choices（:15）：没拿到 choices 之前整列布局不渲染，只有上面的 .empty 在 -->
                    <Grid x:Name="ModVersionColumns" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- .versions-list（scoped :17）：max-height 430 / overflow auto / overscroll contain。
                             条目是 button：flex column / width 100% / text-align left / padding 12 / border 1 /
                             radius 10 / margin-bottom 8 / gap 4 / 底 card-2 / overflow-wrap anywhere。
                             // 占位：choices.files 是 mods:versionChoices 的回包，这里只留一条行壳 -->
                        <ScrollViewer Grid.Column="0" MaxHeight="430" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="VersionsList">
                                <Button x:Name="VersionChoiceShell" Style="{StaticResource MpVersionChoice}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="VersionChoiceVersion" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="VersionChoiceRelease" FontSize="11" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
                                        <TextBlock x:Name="VersionChoiceFile" FontSize="11" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
                                    </StackPanel>
                                </Button>
                                <!-- v-if !choices.files.length（:15）：14px（继承 body，这里没写 small/p 的字号规则） -->
                                <TextBlock x:Name="VersionsListEmpty" FontSize="14" TextWrapping="Wrap"
                                           Visibility="Collapsed" Text="此游戏版本与加载器下没有其他可下载文件。"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- .version-detail（scoped :17）：min-width 0 -->
                        <StackPanel Grid.Column="2">
                            <!-- .empty（v-if loading，:15）：走 .content .empty 那档（MpEmpty），文案逐字 -->
                            <Border x:Name="ModVersionLoading" Style="{StaticResource MpEmpty}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" TextAlignment="Center" Foreground="{DynamicResource Fg2}"
                                               HorizontalAlignment="Center" Text="正在识别来源并查询适配版本…"/>
                                </StackPanel>
                            </Border>
                            <!-- .error（scoped :17：color danger / padding-bottom 15）＋ v-if !choices 的 .btn.btn-ghost 重试 -->
                            <Border x:Name="ModVersionError" Padding="0,0,0,15" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ModVersionErrorText" FontSize="14" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Danger}"/>
                                    <Button x:Name="BtnModVersionRetry" Style="{StaticResource BtnGhost}" Content="重试"
                                            Margin="12,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <!-- v-if checking（:15）：.version-detail p ＝ 12px / overflow-wrap anywhere + muted -->
                            <TextBlock x:Name="ModVersionChecking" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{DynamicResource Fg2}" Text="正在检查前置并获取版本说明…"/>
                            <!-- template v-else-if plan（:15）：本次更改 / 前置 / 确认 / 版本说明 -->
                            <StackPanel x:Name="ModVersionPlan" Visibility="Collapsed">
                                <TextBlock FontSize="14" FontWeight="Bold" Text="本次更改"/>
                                <!-- p v-for plan.files：.tag（新增前置 / 替换模组）+ 文件名，12px
                                     // 占位：plan.files 来自 mods:versionPlan -->
                                <StackPanel x:Name="ModVersionPlanRows" Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="Collapsed">
                                    <Border Style="{StaticResource Tag}" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource TagText}" Text="替换模组"/>
                                    </Border>
                                    <TextBlock x:Name="ModVersionPlanFile" FontSize="12" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- .warning（scoped :17）：底 accent-soft / radius 10 / padding 12。
                                     里面是 v-for plan.warnings 的 p（12px）+ 确认勾选（label 文本继承 14） -->
                                <Border x:Name="ModVersionWarning" Background="{DynamicResource AccentSoft}"
                                        CornerRadius="10" Padding="12" Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="ModVersionWarningText" FontSize="12" TextWrapping="Wrap"/>
                                        <CheckBox x:Name="ChkModVersionConfirmed" Content="我已了解并确认本次更改"
                                                  FontSize="14" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,8,0,0" Text="版本说明"/>
                                <!-- pre（scoped :17）：white-space pre-wrap / overflow-wrap anywhere / font 12px 行高 1.8 -->
                                <TextBlock x:Name="ModVersionChangelog" FontSize="12" LineHeight="21.6"
                                           LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- v-else（:15）：初次进弹窗（无 checking 无 plan）就是这一行 -->
                            <TextBlock x:Name="ModVersionPickHint" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg2}" Text="选择一个适配版本，查看说明与必要前置。"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- footer（scoped :17）：flex / gap 12 / align center / padding 20px 24px / border-top 1 /
                     justify flex-end；footer small ＝ margin-right auto（把按钮组推到右）+ UA small＝80%×14＝11.2 -->
                <Border Grid.Row="2" Style="{StaticResource MpModalFoot}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11.2" VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"
                                   Text="校验后替换，保留启停状态"/>
                        <Button x:Name="BtnModVersionCancel" Grid.Column="2" Style="{StaticResource BtnGhost}" Content="取消"/>
                        <Button x:Name="BtnModVersionApply" Grid.Column="4" Style="{StaticResource BtnGold}" Content="确认切换"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>

    <!-- ==================== 6c. ModMigrationModal（:460 → components/ModMigrationModal.vue:23-37） ====================
         门控：v-if="migrationOpen && currentVersion"。
         .modal.migration-modal（scoped :37）：width min(880px,100vw 减 40) / max-height calc(100vh 减 60) /
         padding 0 / flex column / overflow hidden → 同样三行 Grid，减项交给 mask 的 Padding 20,30。 -->
    <Border x:Name="ModMigrationModalHost" Panel.ZIndex="10000" Style="{StaticResource MpModalMask}"
            Padding="20,30" Visibility="Collapsed">
        <Border Style="{StaticResource MpModalFlush}" Width="880" MaxWidth="880">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header（:24 + scoped :37）：flex / align center / gap 12 / padding 20px 24px /
                     justify space-between / border-bottom 1。h2 22px margin 0；
                     .migration-modal p（scoped :37）margin 6px 0 / line-height 1.65（14×1.65＝23.1） -->
                <Border Grid.Row="0" Style="{StaticResource MpModalHead}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Text="版本迁移"/>
                            <TextBlock FontSize="14" LineHeight="23.1" LineStackingStrategy="BlockLineHeight"
                                       Margin="0,6" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                       Text="将当前模组迁移到新的隔离实例，原版本保持完整。"/>
                        </StackPanel>
                        <Button x:Name="BtnMigrationClose" Grid.Column="2" Style="{StaticResource BtnGhost}"
                                Content="×" ToolTip="关闭版本迁移"/>
                    </Grid>
                </Border>

                <!-- .migration-body（scoped :37）：padding 20px 24px / overflow auto / min-height 0 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20">
                    <StackPanel>
                        <!-- .migration-route（:26 + scoped :37）：grid 1fr 30px 1fr / gap 18 / align center /
                             底 card-2 / radius 14 / padding 18；子 div 是 flex column gap 8 -->
                        <Border Background="{DynamicResource CardSoft}" CornerRadius="14" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="11.2" Foreground="{DynamicResource Fg2}" Text="当前版本"/>
                                    <!-- // 占位：source.name || source.id（props.source，:459） -->
                                    <TextBlock x:Name="MigrationSourceName" FontSize="14" FontWeight="Bold"
                                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <!-- // 占位：{{source.mcVersion}} · {{source.loader}} -->
                                    <TextBlock x:Name="MigrationSourceSub" FontSize="14" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4">
                                    <!-- label（flex column gap 5）＋ .version-picker-trigger（MinecraftVersionPicker.vue:21） -->
                                    <StackPanel>
                                        <TextBlock FontSize="14" Text="目标 Minecraft 版本"/>
                                        <!-- .version-picker-trigger（MinecraftVersionPicker.vue:21）：
                                             span 文字 + span ⌄，justify-content space-between ＝ * 轨 + Auto 轨 -->
                                        <Button x:Name="MigrationPickerTrigger" Style="{StaticResource MpPickerTrigger}"
                                                Margin="0,5,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 空值时原版显示占位文案「选择目标游戏版本」（{{modelValue||'选择目标游戏版本'}}） -->
                                                <TextBlock x:Name="MigrationPickerText" Text="选择目标游戏版本"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="⌄" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock FontSize="14" Text="加载器"/>
                                        <!-- SelectMenu（:26 的四项）：本页的 SelectMenu 一律按 ComboBox 落 -->
                                        <ComboBox x:Name="MigrationLoader" Margin="0,5,0,0" SelectedIndex="0">
                                            <ComboBoxItem>Fabric</ComboBoxItem>
                                            <ComboBoxItem>Forge</ComboBoxItem>
                                            <ComboBoxItem>NeoForge</ComboBoxItem>
                                            <ComboBoxItem>Quilt</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- .migration-hint（:27 + scoped :37）：13px / text-dim / padding 10px 0，
                             再叠 .migration-modal p 的 margin 6px 0（同权重、scoped 在后 → 两条都生效） -->
                        <TextBlock FontSize="13" LineHeight="21.5" LineStackingStrategy="BlockLineHeight"
                                   Margin="0,6" Padding="0,10" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                   Text="迁移模组及必要前置，保留启停状态。新实例自动安装游戏与加载器；存档、资源包和配置文件仍保留在原实例。"/>

                        <!-- v-if error（:28）：.migration-error ＝ danger / padding 10px 0 -->
                        <TextBlock x:Name="MigrationError" FontSize="14" TextWrapping="Wrap" Padding="0,10"
                                   Visibility="Collapsed" Foreground="{DynamicResource Danger}"/>
                        <!-- v-if checking（:28）：.migration-loading ＝ flex / align center / gap 10 / padding 20px 0 -->
                        <StackPanel x:Name="MigrationLoading" Orientation="Horizontal" Margin="0,20"
                                    Visibility="Collapsed">
                            <ContentControl Style="{StaticResource Spin}" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="正在检查每个模组的适配版本与前置依赖…"/>
                        </StackPanel>

                        <!-- template v-if plan（:29-31）：摘要 / 搜索框 / 逐条列表 / 确认区。
                             // 占位：plan 来自 mods:migrationPlan，未接入 → 整块 Collapsed -->
                        <StackPanel x:Name="MigrationPlan" Visibility="Collapsed">
                            <!-- .migration-summary（:29 + scoped :37）：flex / align center / gap 12 / wrap / padding 12px 0 -->
                            <WrapPanel Margin="0,12">
                                <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="检查完成"/>
                                <TextBlock x:Name="MigrationOkCount" FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Text="0 个可迁移"/>
                                <TextBlock x:Name="MigrationDepCount" FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Text="0 个新增前置"/>
                                <Button x:Name="BtnMigrationShowMissing" Style="{StaticResource BtnSmGhost}"
                                        Content="0 个未匹配"/>
                            </WrapPanel>
                            <!-- input.input（:29）：36 高 / padding 8 12 / radius 10 ＝ 共享 Input；占位文字靠覆盖层（WPF 无原生 placeholder） -->
                            <Grid>
                                <TextBox x:Name="MigrationSearch" Style="{StaticResource Input}" FontSize="14"/>
                                <TextBlock Text="搜索本地文件名或模组名称" FontSize="14" Foreground="{DynamicResource Fg3}"
                                           Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <!-- .migration-list article（:30 + scoped :37）：flex / gap 12 / align center /
                                 padding 12px 0 / border-bottom 1。图标格 36×36 radius 8（img 或 .migration-icon 的 ◇）；
                                 .migration-mod：flex column gap 4 / flex 1 / min-width 0，strong 14px、small 12px；
                                 行尾 .tag（禁用保留 / 新增前置 / 可迁移）。
                                 // 占位：rows 是 plan.entries 的过滤结果，这里只留一条行壳 -->
                            <StackPanel x:Name="MigrationList" Margin="0,12,0,0">
                                <Border x:Name="MigrationRowShell" Style="{StaticResource MpMigrationRow}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36" Background="Transparent">
                                            <Border x:Name="MigrationIconImgShell" Visibility="Collapsed"
                                                    CornerRadius="8" ClipToBounds="True">
                                                <Image x:Name="MigrationIconPixel" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock x:Name="MigrationIconFallback" Text="◇" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="MigrationRowName" FontSize="14" FontWeight="Bold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock x:Name="MigrationRowModName" FontSize="12" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
                                            <TextBlock x:Name="MigrationRowTarget" FontSize="12" Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock x:Name="MigrationRowReason" FontSize="12" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" Visibility="Collapsed"
                                                       Foreground="{DynamicResource Danger}"/>
                                        </StackPanel>
                                        <Border Grid.Column="4" Style="{StaticResource Tag}" VerticalAlignment="Center">
                                            <TextBlock x:Name="MigrationRowTagText" Style="{StaticResource TagText}"
                                                       Text="可迁移"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <!-- .migration-warning（:31 + scoped :37）：margin-top 16 / padding 16 / radius 12 /
                                 border 1 border-strong / 底 color-mix(accent 9%, card)。
                                 主题里没有这一档：Accent8＝accent 8% 的 alpha 版，叠在 Card 底上就是 8% accent + 92% card，
                                 与原版差 1 个百分点（gen_theme_mixins.py 的产物，不能在本页新增画刷键） -->
                            <Border x:Name="MigrationWarning" Margin="0,16,0,0" Padding="16" CornerRadius="12"
                                    Background="{DynamicResource Accent8}" BorderBrush="{DynamicResource BorderStrong}"
                                    BorderThickness="1" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                                               Text="以下情况需要你确认"/>
                                    <TextBlock x:Name="MigrationWarningMissing" FontSize="14" LineHeight="23.1"
                                               LineStackingStrategy="BlockLineHeight" Margin="0,6" TextWrapping="Wrap"
                                               Text="0 个模组没有匹配的适配文件，会复制到新实例并保持禁用，不会丢失原文件。"/>
                                    <!-- // 占位：plan.warnings 逐条（:31） -->
                                    <TextBlock x:Name="MigrationWarningText" FontSize="14" LineHeight="23.1"
                                               LineStackingStrategy="BlockLineHeight" Margin="0,6" TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                    <!-- label（flex / gap 8 / align center / margin-top 10）＋ input[type=checkbox] -->
                                    <CheckBox x:Name="ChkMigrationConfirmed" Content="我已了解这些情况，确认继续迁移"
                                              FontSize="14" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- footer（:33 + scoped :37）：flex / align center / gap 12 / padding 20px 24px /
                     border-top 1 / justify flex-end；footer span ＝ margin-right auto + 12px -->
                <Border Grid.Row="2" Style="{StaticResource MpModalFoot}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- footer>span：margin-right auto（顶到最左）+ 12px（scoped :37） -->
                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg2}" Text="下载完成并校验后生成目标实例"/>
                        <Button x:Name="BtnMigrationCancel" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="取消"/>
                        <!-- v-if !plan（:33） -->
                        <Button x:Name="BtnMigrationInspect" Grid.Column="3" Style="{StaticResource BtnGold}" Content="检查兼容性"/>
                        <!-- v-else（:33）的两颗：重新检查 + 确认迁移 -->
                        <Button x:Name="BtnMigrationRecheck" Grid.Column="5" Style="{StaticResource BtnGhost}"
                                Content="重新检查" Visibility="Collapsed"/>
                        <Button x:Name="BtnMigrationStart" Grid.Column="7" Style="{StaticResource BtnGold}"
                                Content="确认迁移" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>

    <!-- ==================== 6d. DupCleanModal（:472-480 → components/DupCleanModal.vue:116-199） ====================
         门控：v-if="props.rel === 'mods' && dupOpen && currentVersion"（:473）→ 非 mods 由 ApplyResourceKind 强制收起。
         .modal.dup-modal（scoped :204-208）：width 560px / max-height 84vh / overflow-y auto，其余走通用 .modal。
         84vh WPF 无视口单位 → Page_SizeChanged 里按本页 ActualHeight 的 84% 落 MaxHeight。
         .dup-header（:118 + scoped :202-203）：flex / align center / justify space-between / gap 12 / margin-bottom 16，
         里面的 .modal-title 被压回 margin 0（:203）。 -->
    <Border x:Name="DupCleanModalHost" Panel.ZIndex="10000" Style="{StaticResource MpModalMask}" Visibility="Collapsed">
        <Border x:Name="DupModal" Style="{StaticResource MpModal}" Width="560" MaxWidth="560">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource MpModalTitle}" VerticalAlignment="Center"
                                       Text="清理重复 MOD"/>
                            <Button x:Name="BtnDupClose" Grid.Column="2" Style="{StaticResource BtnGhost}"
                                    Content="✕" ToolTip="关闭清理重复模组"/>
                        </Grid>
                    </Border>

                    <!-- .dup-tabs（:120 + scoped :214-223）：inline-flex / gap 4 / padding 4 / border 1 /
                         radius 999（36+8 高上收缩＝半高）/ 底 card-2 / margin-bottom 12 -->
                    <Border HorizontalAlignment="Left" Margin="0,0,0,12" Background="{DynamicResource CardSoft}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="4"
                            ctl:CssRadius.Pill="True">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnDupTabSingle" Style="{StaticResource MpGameTabOn}" Content="本版本清理"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="BtnDupTabCross" Style="{StaticResource MpGameTab}" Content="跨版本查重"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 单版本页签（template v-if tab==='single'，:126-163） ==================== -->
                    <StackPanel x:Name="DupSinglePanel">
                        <!-- .dup-loading（:127 + scoped :245-251）：flex / align center / gap 12 / justify center / padding 24px 0 -->
                        <StackPanel x:Name="DupLoading" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,24" Visibility="Collapsed">
                            <ContentControl Style="{StaticResource Spin}" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg2}" Text="正在解析 MOD 文件…"/>
                        </StackPanel>
                        <!-- .dup-empty（:128 + scoped :252-259）：flex column 居中 / gap 8 / padding 32px 0 / 居中排版 -->
                        <Border x:Name="DupEmpty" Padding="0,32" Visibility="Collapsed">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                       Text="该版本没有重复的 MOD ✓"/>
                        </Border>
                        <!-- .dup-hint（:130 + scoped :260-264）：12px / line-height 1.6 / margin 0 0 12 + .muted 色 -->
                        <TextBlock x:Name="DupHint" FontSize="12" LineHeight="19.2" LineStackingStrategy="BlockLineHeight"
                                   Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}" Visibility="Collapsed"
                                   Text="发现 0 组重复 MOD（同一 mod id 多文件共存）。每组选择一个保留版本，其余将移入系统回收站："/>
                        <!-- .dup-list（:131 + scoped :265-271）：flex column / gap 8 / max-height 380 / overflow-y auto。
                             // 占位：groups 来自 findModDuplicates，只留一组几何正确的壳 -->
                        <ScrollViewer x:Name="DupListScroll" MaxHeight="380" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel x:Name="DupGroups">
                                <Border x:Name="DupGroupShell" Style="{StaticResource MpDupGroup}">
                                    <StackPanel>
                                        <!-- .dup-group-head（:133 + scoped :281-287）：flex 居中 / gap 8 / min-height 28 / margin-bottom 4 -->
                                        <Grid MinHeight="28" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DupGroupName" FontSize="13" FontWeight="Bold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="DupGroupId" Grid.Column="2" FontSize="14"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <!-- .dup-file（:137-152 + scoped :292-314）：flex 居中 / gap 8 / min-height 32 /
                                             padding 4px 8px / radius 6 / 12px；keep 态底 accent-soft（:302）。
                                             子：radio（accent-color）→ .dup-file-name（flex1 / min-width 0 / break-all / 等宽 12px）
                                             → v{{f.version}}（muted）→ v-if f.latest 的 .tag「最新」 -->
                                        <StackPanel x:Name="DupFileShell" Visibility="Collapsed">
                                            <Border Style="{StaticResource MpDupFile}" Background="{DynamicResource AccentSoft}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton x:Name="DupKeepRadio" VerticalAlignment="Center"
                                                                 GroupName="DupKeep"/>
                                                    <TextBlock x:Name="DupFileName" Grid.Column="2" FontSize="12"
                                                               FontWeight="Normal" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="DupFileVersion" Grid.Column="4" FontSize="12"
                                                               FontWeight="Normal" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Fg2}" Text="v?"/>
                                                    <Border x:Name="DupLatestTag" Grid.Column="6" Style="{StaticResource Tag}"
                                                            Visibility="Collapsed">
                                                        <TextBlock Style="{StaticResource TagText}" Text="最新"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- .modal-actions（:155-161，样式 styles.css:557-563）＋ .del-count（scoped :318-321：
                             margin-right auto / 12px）；justify flex-end 在有 del-count 时等价于把它顶到最左 -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DupDeleteCount" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg2}" Text="将删除 0 个文件"/>
                            <Button x:Name="BtnDupCancel" Grid.Column="1" Style="{StaticResource BtnGhost}"
                                    Content="取消" Margin="0,0,12,0"/>
                            <Button x:Name="BtnDupDelete" Grid.Column="3" Style="{StaticResource BtnDanger}"
                                    Content="确认删除（0）"/>
                        </Grid>
                    </StackPanel>

                    <!-- ==================== 跨版本页签（template v-else，:166-195） ==================== -->
                    <StackPanel x:Name="DupCrossPanel" Visibility="Collapsed">
                        <!-- .modal-label（:167 + scoped :351-355）：13px / text-dim / margin 0 0 8 -->
                        <TextBlock FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"
                                   Text="勾选要对比的版本（≥2 个）"/>
                        <!-- .cross-versions（:168 + scoped :322-327）：flex / wrap / gap 8 / margin-bottom 12。
                             .ver-chip（:169-177）：36 高胶囊 / padding 0 12 / border 1 / 底 card-2 / 12px，
                             内层 input 是 display:none（:348-350）→ 只渲染版本号文本。
                             // 占位：store.installed 过滤后的版本，只留一枚壳 -->
                        <WrapPanel x:Name="DupCrossVersions" Margin="0,0,0,12">
                            <Border x:Name="DupVerChipShell" Style="{StaticResource MpVerChip}" Margin="0,0,8,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DupVerChipText" FontSize="12" VerticalAlignment="Center"
                                           Text="1.20.1-Fabric"/>
                            </Border>
                        </WrapPanel>
                        <!-- .btn.btn-gold.btn-sm（:179） -->
                        <Button x:Name="BtnDupScanCross" Style="{StaticResource MpBtnGoldSm}" Content="开始对比"
                                HorizontalAlignment="Left"/>
                        <!-- .dup-list.dup-list-cross（:182 + scoped :272-274）：margin-top 12，余下与单版本同一档 -->
                        <ScrollViewer x:Name="DupCrossScroll" MaxHeight="380" Margin="0,12,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">
                            <StackPanel x:Name="DupCrossGroups">
                                <Border x:Name="DupCrossGroupShell" Style="{StaticResource MpDupGroup}">
                                    <StackPanel>
                                        <Grid MinHeight="28" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DupCrossGroupName" Grid.Column="0" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Style="{StaticResource Tag}" HorizontalAlignment="Right">
                                                <TextBlock x:Name="DupCrossGroupTag" Style="{StaticResource TagText}"
                                                           Text="×2 个版本"/>
                                            </Border>
                                        </Grid>
                                        <!-- .dup-file.cross-row（:189-192 + scoped :315-317）：与单版本同一档，只是 cursor:default，
                                             两列：.dup-file-name（版本 id，等宽 12px）+ muted（文件名） -->
                                        <StackPanel x:Name="DupCrossRowShell" Visibility="Collapsed">
                                            <Border Style="{StaticResource MpDupFile}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="DupCrossRowVersion" FontSize="12" FontWeight="Normal"
                                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="DupCrossRowFile" Grid.Column="2" FontSize="12"
                                                               FontWeight="Normal" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource Fg2}"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
    </Grid>
</UserControl>
