<UserControl x:Class="Wuhuicl.App.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 资源管理 · 模组。原版 ModsView.vue:9-15 只是个 16 行壳（title/rel/open-label/empty-text/icon），
         本体几何全在 components/FileManager.vue；资源包 / 光影包共用本页，靠 data-resource 切列集
         （FileManager.vue:332），所以这里做成一套壳 + ResourceKind。
         取值一律按 docs/UI_GEOMETRY_PAGES.md §4 + §0 的「最终值」，即尾部 :719-724 覆盖过 :494/:546/:565 等基础值。
         页内样式键统一 Fm 前缀，避开契约 §4 的画刷键名（tools/check_resource_keys.py 会撞名拦截）。
         文件列表要等 fs:list 接入，本轮四行都是占位；空态另做一份常备但 Visibility=Collapsed。 -->
    <UserControl.Resources>

        <!-- .fm-row：min-height 68 / padding 12px 0 / radius 0 / 透明底 — FileManager.vue:719 + :722（基线 :553-561 是 42 高 + radius 10） -->
        <Style x:Key="FmRow" TargetType="Border">
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <!-- .fm-row:hover 的底是 hover 变量（写作 var(hover)）— :722（基线 :562-564 用 card-2 变量） -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- .fm-name：font-weight 500 / 两行截断 — :577-586（-webkit-line-clamp:2）；
             字号取正文 14，两行上限 40≈2×(14×1.42)，按契约 §6.6 用 MaxHeight+Trimming 表达 clamp -->
        <Style x:Key="FmName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxHeight" Value="40"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- .fm-internal：display block / margin-top 4 — :494，最终 12px + 单行省略 — :719（基线 :494 是 11px） -->
        <Style x:Key="FmInternal" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- .fm-meta：12px / text-align right / nowrap / tabular-nums — :719（基线 :587-591；:592-594 的 fm-date 86px 右对齐被 :719 改成左对齐） -->
        <Style x:Key="FmMeta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </UserControl.Resources>

    <!-- .content 是 scrollbar-gutter:stable（docs §0 App.vue:2398-2404）→ 槽常驻，契约 §6.5 -->
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">

        <!-- .page.resource-page：flex column + max-width 940 + margin 0 auto — FileManager.vue:500-506；
             页级 gap 最终 12px（:722 的 !important 压过 :503 的 sec-gap 变量 28 与 ui-system.css:10 的 16） -->
        <StackPanel MaxWidth="940" HorizontalAlignment="Center" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

            <!-- ==================== .fm-head ====================
                 最终形态：列流 + align-items:stretch — :508（mods 单看 :511-517 仍是 row，这里按统一壳走列流，
                 资源包/光影（.resource-page）本来就是这个形态）；gap 16 — :719，margin 0 — :722 -->
            <!-- .fm-head：mods 是 row（align-items:flex-end + justify-between，FileManager.vue:507-517），
                 资源包/光影的 .resource-page 才切列流（:506-510）。行/列由 ApplyResourceKind 搬 FmActions。 -->
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- .fm-head-left{flex:1;min-width:140px}；.page-title 24px/Bold — ui-system.css:12（契约 §2 PageTitle） -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="HeadTitle" Style="{StaticResource PageTitle}" Text="模组"/>
                    <!-- .fm-head .page-title small：13px / 400 / text-dim / margin-left 8 — :719。// 占位：等资源管理接入（resourceCount） -->
                    <TextBlock FontSize="13" Foreground="{DynamicResource Fg2}" Margin="8,0,0,0"
                               VerticalAlignment="Bottom" Text="4"/>
                </StackPanel>

                <!-- .fm-actions：flex row / gap 12（space-3 变量）/ flex-wrap — :533-539 -->
                <WrapPanel x:Name="FmActions" Grid.Row="0" Grid.Column="1"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <!-- v-if props.rel==='mods' — :336；非 mods 时由 ResourceKind 收起 -->
                    <Button x:Name="BtnCheckUpdate" Style="{StaticResource BtnGold}" Content="检测更新" Margin="0,0,12,0"/>
                    <Button x:Name="BtnOpen" Style="{StaticResource BtnGhost}" Content="打开模组文件夹" Margin="0,0,12,0"/>
                    <!-- 头部这个 .file-more：summary 是 .btn-ghost，字号被 :722 收成 14px -->
                    <Grid>
                        <Button x:Name="HeadMoreBtn" Style="{StaticResource BtnGhost}" Content="更多"
                                Tag="PopHeadMore" Click="More_Click"/>
                        <!-- .file-more-actions：absolute right:0 / top:100% / min-width 150 / padding 10 / gap 8 / radius 10 — :488 + :719
                             PopupCard 已给 radius 10 + border 1（契约 §2），这里把 padding 收到 10；
                             WPF 没有 right:0 对齐，靠 HorizontalOffset 把浮层右缘拉回按钮右缘（150-38≈112，此处取 110） -->
                        <Popup x:Name="PopHeadMore" PlacementTarget="{x:Reference HeadMoreBtn}" Placement="Bottom"
                               HorizontalOffset="-110" AllowsTransparency="True" Focusable="False" StaysOpen="False">
                            <Border Style="{StaticResource PopupCard}" MinWidth="150" Padding="10">
                                <StackPanel>
                                    <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch" Content="版本迁移"/>
                                    <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                            Content="清理重复" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </WrapPanel>
            </Grid>

            <!-- ==================== .fm-context ====================
                 flex / align-center / gap 12 / flex-wrap，margin-bottom 16 — :719；:722 又把 head/context/controls 的 margin 归零，
                 这里保留 16（任务口径），页级 12 的 gap 由它承担 -->
            <StackPanel Margin="0,0,0,12">
                <!-- .fm-context>label：display grid / gap 6 / flex 0 1 440px / min-width 0 / 12px text-dim — :719 -->
                <StackPanel MaxWidth="440">
                    <TextBlock Text="游戏实例" FontSize="12" Foreground="{DynamicResource Fg2}"/>
                    <!-- .fm-ver-select：SelectMenu 两行卡片，宽度撑满 440 的 label 轨
                         （label flex 0 1 440px — :719；截图量得卡宽 ≈436）。label 13px/600，
                         description 11px text-dim，右缘 14px chevron；radius 10 描边。 -->
                    <Button x:Name="VerSelect" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource Card}" CornerRadius="10"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="14"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="VerName" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Text="1.20.1 · Fabric 0.16.4"/>
                                            <TextBlock x:Name="VerDesc" FontSize="11" Foreground="{DynamicResource Fg2}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Text="1.20.1 · Fabric · 0.16.4 · 已隔离"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center"
                                                        Style="{DynamicResource Icon.ChevronDown}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <!-- 占位：等版本列表接入（原版来自 activeInstalled，:48） -->
                    </Button>
                </StackPanel>

                <!-- v-if props.rel!=='mods' 的上下文刷新按钮 — :343（文案「↻ 刷新」用的是原文字形 ↻，契约 §3）；mods 下收起 -->
                <Button x:Name="BtnCtxRefresh" Style="{StaticResource BtnGhost}" Content="↻ 刷新"
                        HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>

                <!-- .fm-context .fm-path：flex-basis 100%（自己占一行）/ 无边框 / 12px text-dim / cursor:copy / overflow-wrap anywhere — :719
                     displayPath 的「>80 字符中间省略」是 :117 的逻辑，不是样式；文案占位，等路径拼接接入 -->
                <TextBlock x:Name="PathText" Style="{StaticResource Micro}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Cursor="Hand" ToolTip="点击复制完整路径（未接入）"
                           Text="versions\1.20.1-Fabric\mods"/>
            </StackPanel>

            <!-- ==================== .fm-controls ====================
                 最终 grid-template-columns:minmax(180px,1fr) 160px 140px 38px — :719（基线 :494 末列是 auto）；
                 gap 10 / margin-bottom 16 — :494。断点 @max-1000 变 minmax(0,1fr) minmax(0,1fr) 38px（:724）与
                 @max-1150 / @max-700（:720）本轮不做：WPF 无媒体查询，需宿主自己按需改列集。 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <!-- .input.fm-search（:401）：36 高 / padding 12 8 / radius 10（契约 §2 Input）；WPF 无 placeholder → 覆盖文字 -->
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}" FontSize="13"
                             TextChanged="Search_TextChanged" ToolTip="搜索文件名或模组名称…"/>
                    <TextBlock x:Name="SearchHint" Text="搜索文件名或模组名称…" FontSize="13"
                               Foreground="{DynamicResource Fg3}" Margin="13,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <!-- 状态筛选 SelectMenu（:402 的四项）；宽度 160 来自 :719 的第二轨 -->
                <ComboBox Grid.Column="1" Margin="10,0,0,0" FontSize="13" SelectedIndex="0">
                    <ComboBoxItem>全部状态</ComboBoxItem>
                    <ComboBoxItem>已启用</ComboBoxItem>
                    <ComboBoxItem>已禁用</ComboBoxItem>
                    <ComboBoxItem>已锁定</ComboBoxItem>
                </ComboBox>
                <!-- 排序 SelectMenu（:403 的三项）；宽度 140 来自 :719 的第三轨 -->
                <ComboBox Grid.Column="2" Margin="10,0,0,0" FontSize="13" SelectedIndex="0">
                    <ComboBoxItem>名称排序</ComboBoxItem>
                    <ComboBoxItem>最近修改</ComboBoxItem>
                    <ComboBoxItem>文件大小</ComboBoxItem>
                </ComboBox>
                <!-- .fm-refresh：38 轨里的 .btn-ghost，内容是原文字形 ↻（:405，契约 §3 允许的字形） -->
                <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Width="38" Height="36" Padding="0"
                        FontSize="16" Content="↻" ToolTip="刷新文件列表（未接入）"/>
            </Grid>

            <!-- ==================== .fm-batch ====================
                 原版 position:sticky / top:0 / z-index:6 — :491（:494 再压一次），WPF 没有 sticky：先按普通行做，
                 真正吸附要宿主把这一条挪到滚动视口外或用浮层。padding 12px 16px / gap 8 / flex-wrap / margin-bottom 16 — :494；
                 v-if selection.size && props.rel==='mods' — :407 -->
            <Border Style="{StaticResource Panel}" Padding="12,16" Margin="0,0,0,16"
                    Visibility="Collapsed">
                <WrapPanel>
                    <!-- v-if selection.size（:407）默认没有选中项 → 整条隐藏；占位：等批量选择接入 -->
                    <TextBlock Text="已选 2 项" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="全选筛选结果（4）" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="批量启用" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="批量禁用" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="锁定版本" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="解除锁定" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BtnSm}" Content="清空选择"/>
                </WrapPanel>
            </Border>

            <!-- MOD 更新检测面板 .upd-panel（:352-410 + :634-710）、批量结果 .fm-results（:409 + :494）、
                 刷新中的 .status-strip（:412 + docs §0 ui-system.css:41）都依赖未接入的数据，本轮不铺。 -->

            <!-- ==================== .fm-card ====================
                 padding 0 16 !important / overflow visible — :719（基线 :545-547 是 padding 8）；
                 卡片平面无阴影（契约 §6.4 + §2 Panel：radius 14 / border 1 / Card 底） -->
            <Border Style="{StaticResource Panel}" Padding="0,16" Margin="0,0,0,12">
                <!-- .fm-list：flex column / overflow visible — :490 + :548-551 -->
                <StackPanel>

                    <!-- .fm-table-head：与行同一套 mods 列集（18 32 minmax(0,1fr) 88 132 42 40 / gap 12）
                         + 第 2 个子跨 2/4 — :719；min-height 36 / 12px text-dim / 下边线 1px — :719 -->
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" MinHeight="36">
                        <Grid x:Name="FmHead">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <!-- 表头全选：:checked / :indeterminate（:427）→ WPF 用 IsThreeState + IsChecked={x:Null} 表示半选 -->
                            <CheckBox Style="{StaticResource Check}" Tag="mods-only" IsThreeState="True"
                                      VerticalAlignment="Center" ToolTip="选择当前页模组"/>
                            <!-- grid-column:2/4 ——「名称」压在图标轨+名称轨上，文字左缘对齐图标轨左缘（:719） -->
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Micro}"
                                       Text="名称" VerticalAlignment="Center"/>
                            <!-- .fm-table-head>span:nth-child(3){text-align:right} — :719 -->
                            <TextBlock Grid.Column="3" Style="{StaticResource Micro}" Margin="12,0,0,0"
                                       Text="大小" TextAlignment="Right" VerticalAlignment="Center"/>
                            <!-- .fm-date{text-align:left} — :719 -->
                            <TextBlock Grid.Column="4" Style="{StaticResource Micro}" Margin="12,0,0,0"
                                       Text="修改时间" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Style="{StaticResource Micro}" Margin="12,0,0,0" Tag="mods-only"
                                       Text="启用" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Style="{StaticResource Micro}" Margin="12,0,0,0"
                                       Text="操作" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ============ 行 1（占位：等资源管理接入，原版 entries 来自 fs:list，:74） ============ -->
                    <Border Style="{StaticResource FmRow}">
                        <Grid x:Name="FmRow1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/><ColumnDefinition Width="132"/><ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <!-- .fm-row input[type=checkbox]{accent-color:var(accent)} — :494；契约 §2 Check 的方框是 13px，比原版 18 小 -->
                            <CheckBox Style="{StaticResource Check}" Tag="mods-only" VerticalAlignment="Center"/>
                            <!-- .fm-file-icon：mods 下 32×32 — :719（基线 :565-571 是 36×36 + color:var(accent)）；
                                 图标色给宿主 ContentControl，符合契约 §6.7。原版这里是内联 file SVG（:436-439），
                                 契约 §3 白名单里没有 file 形，用 Icon.Mods 代替。 -->
                            <ContentControl Grid.Column="1" Width="32" Height="32" Tag="file-icon"
                                            VerticalAlignment="Center" Foreground="{DynamicResource Accent}"
                                            Style="{DynamicResource Icon.Mods}"/>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FmName}" Text="fabric-api-0.98.0+1.20.1.jar"/>
                                </StackPanel>
                                <!-- 状态胶囊用 .fm-disabled-tag 配方：12px / padding 1 8 / radius 999 / card-2 底 / text-3 字 / line 描边 — :612-620
                                     （原版 mods 行是把「已禁用 / 已锁定」写在 .fm-internal 第二行 :441，7 列里没有状态轨，所以这里挂在名称右缘） -->
                            </Grid>
                            <!-- .fm-meta（大小）：12px 右对齐 nowrap — :719；e.isDir ? '文件夹' : fmtSize — :443 -->
                            <TextBlock Grid.Column="3" Style="{StaticResource FmMeta}" Margin="12,0,0,0" Text="2.4 MB"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource FmMeta}" Margin="12,0,0,0"
                                       TextAlignment="Left" Text="2025-06-12"/>
                            <!-- 启用开关列（42 轨内）：.switch 40×22（docs §0 styles.css:356-401）+ .fm-toggle flex-shrink 0 — :496/:602 -->
                            <CheckBox Grid.Column="5" Style="{StaticResource Switch}" Tag="mods-only" IsChecked="True"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="禁用模组"/>
                            <Grid Grid.Column="6">
                                <!-- .file-more summary：.btn.btn-ghost.btn-sm + font-size 18 / min-width 36 — :486 + :448；⋯ 是原文字形（契约 §3） -->
                                <Button x:Name="MoreBtn1" Style="{StaticResource BtnSm}" MinWidth="36" Padding="0"
                                        FontSize="18" Content="⋯" Tag="PopRow1" Click="More_Click" ToolTip="更多操作"/>
                                <!-- .file-more-actions：absolute right:0 / top:100% / min-width 150 / padding 10 / gap 8 / radius 10 — :488 + :719
                                     菜单项原版是 .btn-sm（32 高），契约 §2 指定用 MenuItem2（34 高）→ 取契约值 -->
                                <Popup x:Name="PopRow1" PlacementTarget="{x:Reference MoreBtn1}" Placement="Bottom"
                                       HorizontalOffset="-110" AllowsTransparency="True" Focusable="False" StaysOpen="False">
                                    <Border Style="{StaticResource PopupCard}" MinWidth="150" Padding="10">
                                        <StackPanel>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch" Content="锁定"/>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                                    Content="版本" Margin="0,8,0,0"/>
                                            <!-- .file-more-actions .fm-remove{border-top:1px;margin-top:4px} — :489 -->
                                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,4,0,0"/>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                                    Content="删除" Margin="0,4,0,0" Foreground="{DynamicResource Danger}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ 行 2：选中态演示（占位：等资源管理接入） ============
                         .fm-row:has(>input:checked){background:color-mix(in srgb,var(accent) 5%,transparent)} — :719
                         WPF 没有 :has()、也没有 color-mix，这里用白名单里的 AccentSoft（≈accent 14%）代替，色会比原版重一档；
                         真正接线时应由数据行的容器样式给 5% 的自定义底。 -->
                    <Border Style="{StaticResource FmRow}" Background="{DynamicResource AccentSoft}">
                        <Grid x:Name="FmRow2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/><ColumnDefinition Width="132"/><ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource Check}" Tag="mods-only" IsChecked="True" VerticalAlignment="Center"/>
                            <ContentControl Grid.Column="1" Width="32" Height="32" Tag="file-icon"
                                            VerticalAlignment="Center" Foreground="{DynamicResource Accent}"
                                            Style="{DynamicResource Icon.Mods}"/>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FmName}" Text="sodium-fabric-0.5.8+mc1.20.1.jar"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Column="3" Style="{StaticResource FmMeta}" Margin="12,0,0,0" Text="1.2 MB"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource FmMeta}" Margin="12,0,0,0"
                                       TextAlignment="Left" Text="2025-05-28"/>
                            <CheckBox Grid.Column="5" Style="{StaticResource Switch}" Tag="mods-only" IsChecked="True"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="禁用模组"/>
                            <Grid Grid.Column="6">
                                <Button x:Name="MoreBtn2" Style="{StaticResource BtnSm}" MinWidth="36" Padding="0"
                                        FontSize="18" Content="⋯" Tag="PopRow2" Click="More_Click" ToolTip="更多操作"/>
                                <Popup x:Name="PopRow2" PlacementTarget="{x:Reference MoreBtn2}" Placement="Bottom"
                                       HorizontalOffset="-110" AllowsTransparency="True" Focusable="False" StaysOpen="False">
                                    <Border Style="{StaticResource PopupCard}" MinWidth="150" Padding="10">
                                        <StackPanel>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch" Content="已锁定"/>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                                    Content="版本" Margin="0,8,0,0"/>
                                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,4,0,0"/>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                                    Content="删除" Margin="0,4,0,0" Foreground="{DynamicResource Danger}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ 行 3：已禁用（.fm-row-disabled — :605-611；opacity 被 :722 放回 1，只保留名称删除线） ============ -->
                    <Border Style="{StaticResource FmRow}">
                        <Grid x:Name="FmRow3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/><ColumnDefinition Width="132"/><ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource Check}" Tag="mods-only" VerticalAlignment="Center"/>
                            <ContentControl Grid.Column="1" Width="32" Height="32" Tag="file-icon"
                                            VerticalAlignment="Center" Foreground="{DynamicResource Accent}"
                                            Style="{DynamicResource Icon.Mods}"/>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <!-- .fm-row-disabled .fm-name{text-decoration:line-through} — :608-611 -->
                                    <TextBlock Style="{StaticResource FmName}" Text="OptiFine_1.20.1_HD_U_I6.jar"/>
                                    <TextBlock Style="{StaticResource FmInternal}" Text="已禁用"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Column="3" Style="{StaticResource FmMeta}" Margin="12,0,0,0" Text="8.6 MB"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource FmMeta}" Margin="12,0,0,0"
                                       TextAlignment="Left" Text="2024-12-03"/>
                            <CheckBox Grid.Column="5" Style="{StaticResource Switch}" Tag="mods-only" IsChecked="False"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="启用模组"/>
                            <Grid Grid.Column="6">
                                <Button x:Name="MoreBtn3" Style="{StaticResource BtnSm}" MinWidth="36" Padding="0"
                                        FontSize="18" Content="⋯" Tag="PopRow3" Click="More_Click" ToolTip="更多操作"/>
                                <Popup x:Name="PopRow3" PlacementTarget="{x:Reference MoreBtn3}" Placement="Bottom"
                                       HorizontalOffset="-110" AllowsTransparency="True" Focusable="False" StaysOpen="False">
                                    <Border Style="{StaticResource PopupCard}" MinWidth="150" Padding="10">
                                        <StackPanel>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch" Content="锁定"/>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                                    Content="版本" Margin="0,8,0,0"/>
                                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,4,0,0"/>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                                    Content="删除" Margin="0,4,0,0" Foreground="{DynamicResource Danger}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ 行 4：已锁定（catalog[name].locked — :441/:448） ============ -->
                    <Border Style="{StaticResource FmRow}">
                        <Grid x:Name="FmRow4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/><ColumnDefinition Width="132"/><ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource Check}" Tag="mods-only" VerticalAlignment="Center"/>
                            <ContentControl Grid.Column="1" Width="32" Height="32" Tag="file-icon"
                                            VerticalAlignment="Center" Foreground="{DynamicResource Accent}"
                                            Style="{DynamicResource Icon.Mods}"/>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FmName}" Text="iris-fabric-1.7.0+1.20.1.jar"/>
                                    <TextBlock Style="{StaticResource FmInternal}" Text="已锁定"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Column="3" Style="{StaticResource FmMeta}" Margin="12,0,0,0" Text="3.1 MB"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource FmMeta}" Margin="12,0,0,0"
                                       TextAlignment="Left" Text="2025-06-01"/>
                            <CheckBox Grid.Column="5" Style="{StaticResource Switch}" Tag="mods-only" IsChecked="True"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="禁用模组"/>
                            <Grid Grid.Column="6">
                                <Button x:Name="MoreBtn4" Style="{StaticResource BtnSm}" MinWidth="36" Padding="0"
                                        FontSize="18" Content="⋯" Tag="PopRow4" Click="More_Click" ToolTip="更多操作"/>
                                <Popup x:Name="PopRow4" PlacementTarget="{x:Reference MoreBtn4}" Placement="Bottom"
                                       HorizontalOffset="-110" AllowsTransparency="True" Focusable="False" StaysOpen="False">
                                    <Border Style="{StaticResource PopupCard}" MinWidth="150" Padding="10">
                                        <StackPanel>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch" Content="已锁定"/>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                                    Content="版本" Margin="0,8,0,0"/>
                                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,4,0,0"/>
                                            <Button Style="{StaticResource MenuItem2}" HorizontalAlignment="Stretch"
                                                    Content="删除" Margin="0,4,0,0" Foreground="{DynamicResource Danger}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ 空态（与列表 v-else-if 互斥，:418-422）：常备但收起，方便对照两套布局 ============
                         .content .empty：min-height 120 / padding 32px 16px — ui-system.css:44（压过 styles.css:515-524 的 48/24）；
                         flex column / align center / gap 16 — styles.css:515-524；
                         光影页变体 .shader-empty .empty{min-height:min(380px,45vh)} — :719，本轮只做 mods。
                         另：没有可选版本时的 .card.empty 文案（:347-349）同样依赖数据，这里不铺。 -->
                    <Border x:Name="EmptyBlock" Visibility="Collapsed" MinHeight="120" Padding="16,32">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- .empty-icon：44×44 / color:var(accent) / opacity .8 — :621-631；图标取 ModsView.vue:4-5 的方块形 → Icon.Mods -->
                            <ContentControl Width="44" Height="44" Opacity="0.8" HorizontalAlignment="Center"
                                            Foreground="{DynamicResource Accent}" Style="{DynamicResource Icon.Mods}"/>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource PageSub}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,16,0,0"
                                       Text="暂无模组，将 .jar 文件放入 mods 文件夹"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== .fm-pagination ====================
                 flex / justify-content:flex-end / gap 12 / padding 8px 0 / 13px；.muted{margin-right:auto} — :498-499
                 （muted 顶到最左、按钮组靠右，用 1×Auto 两列等价表达）；原版 v-if pageCount>1（:453），本轮为让几何可见常开；
                 PAGE_SIZE=100 — :39 -->
            <Grid Margin="0,0,0,12" Visibility="Collapsed">
                <!-- v-if pageCount>1（:453），单页时整条不渲染 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 占位：等分页接入（原版是 共 {{filtered.length}} 项 · 每页 {{PAGE_SIZE}} 项，:454） -->
                <TextBlock Style="{StaticResource PageSub}" Text="共 4 项 · 每页 100 项" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSm}" Content="上一页"/>
                    <TextBlock FontSize="13" Text="1 / 1" Margin="12,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnSm}" Content="下一页" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
